# Ingest — API contract 'Grandma Avatar 1.0.0 (AsyncAPI 3.1)' (grandma.asyncapi.yaml), 2026-10-10. Grow.
# DERIVED DOCUMENT: generated from canvas + model; everything new is dkg:Inferred,
# sourced to the contract. Existing nodes are NOT re-sourced (no false corroboration).
##############################################################################
:Art_API_GrandmaAvatar_AAS a dkg:Artifact ;
    rdfs:label "Grandma Avatar — AsyncAPI 3.1, version 1.0.0 (grandma.asyncapi.yaml)" ;
    rdfs:comment "AsyncAPI draft for the AI responder. Calls the upstream context 'Cook Assistance'. Consumes HelpRequested from queue cook-assistance.help-requested.grandma-avatar bound to exchange 'cook-assistance' on routing key help.requested; publishes HelpProvided to exchange 'cook-assistance', routing key help.provided. Requests naming only CHEF are acknowledged and not answered. helpProviderType always GRANDMA_AVATAR. HelpProvided payload has no helpRequestStatus. Quality: fast answers; persistent delivery. Its securitySchemes description QUOTES THE CANVAS CREDENTIAL while saying it is not reproduced — not copied into this graph." ;
    dkg:mentions :Ctx_GrandmaAvatarAI ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Msg_API_GA_Sub_HelpRequested a dkg:Message ; skos:prefLabel "consumes HelpRequested" ; dkg:to :Ctx_GrandmaAvatarAI ; dkg:messageKind "evt" ;
    dkg:carries "queue cook-assistance.help-requested.grandma-avatar · exchange cook-assistance · routing key help.requested · message HelpRequested" ; dkg:mentions :Ev_HelpRequested, :Msg_APC_GA_In_HelpRequested ;
    dkg:source :Art_API_GrandmaAvatar_AAS ; dkg:locator "operations.onHelpRequested" ; dkg:confidence dkg:Inferred .
:Msg_API_GA_Pub_HelpProvided a dkg:Message ; skos:prefLabel "publishes HelpProvided" ; dkg:from :Ctx_GrandmaAvatarAI ; dkg:messageKind "evt" ;
    dkg:carries "exchange cook-assistance · routing key help.provided · message HelpProvided · payload Help (no helpRequestStatus)" ; dkg:mentions :Ev_HelpProvided, :Msg_APC_GA_Out_HelpProvided ;
    dkg:source :Art_API_GrandmaAvatar_AAS ; dkg:locator "operations.publishHelpProvided" ; dkg:confidence dkg:Inferred .
:R_API_AvatarIgnoresChefOnly a dkg:Rule ; skos:prefLabel "The Grandma Avatar does not answer requests whose only preferred provider is CHEF" ; rdfs:comment "contract reading of 'chef help is provided exclusively'" ;
    dkg:inContext :Ctx_GrandmaAvatarAI ; dkg:mentions :Con_Chef_HRProvider ; dkg:source :Art_API_GrandmaAvatar_AAS ; dkg:locator "operations.onHelpRequested" ; dkg:confidence dkg:Inferred .
:Q_CredentialOnCanvases rdfs:comment "grandma.asyncapi.yaml: server URL is clean, but the securitySchemes description quotes the canvas's amqps user:password form verbatim while claiming it is 'deliberately not reproduced'. Redacted here; the file itself still carries it." ; dkg:source :Art_API_GrandmaAvatar_AAS .
:Q_HelpEventName rdfs:comment "Grandma Avatar AsyncAPI consumes 'HelpRequested'; the Cooking Assistance AsyncAPI publishes 'HelpRequestCreated' — the canvases' naming split is now a wiring split (see contradiction)." ; dkg:source :Art_API_GrandmaAvatar_AAS .

# --- CONTRADICTION: where Help requests are published vs consumed ---
:As_Wire_HRC_CA a dkg:Assertion ;
    rdf:subject :Msg_API_CA_Pub_HelpRequestCreated ; rdf:predicate dkg:carries ;
    rdf:object "exchange cooking-assistance · routing key cooking-assistance.help-request.created · HelpRequestCreated" ;
    rdfs:comment "Cooking Assistance AsyncAPI: publisher side" ;
    dkg:source :Art_API_CookingAssistance_AAS ; dkg:confidence dkg:Inferred .
:As_Wire_HR_GA a dkg:Assertion ;
    rdf:subject :Msg_API_GA_Sub_HelpRequested ; rdf:predicate dkg:carries ;
    rdf:object "exchange cook-assistance · routing key help.requested · HelpRequested" ;
    rdfs:comment "Grandma Avatar AsyncAPI: consumer side — different exchange, routing key and message name; as written, no message would arrive" ;
    dkg:source :Art_API_GrandmaAvatar_AAS ; dkg:confidence dkg:Inferred ;
    dkg:contradicts :As_Wire_HRC_CA .
# --- CONTRADICTION: where Help provided is published vs consumed ---
:As_Wire_HP_GA a dkg:Assertion ;
    rdf:subject :Msg_API_GA_Pub_HelpProvided ; rdf:predicate dkg:carries ;
    rdf:object "exchange cook-assistance · routing key help.provided" ;
    rdfs:comment "Grandma Avatar AsyncAPI: publishes the avatar's Help here" ;
    dkg:source :Art_API_GrandmaAvatar_AAS ; dkg:confidence dkg:Inferred .
:As_Wire_HP_CA a dkg:Assertion ;
    rdf:subject :Msg_API_CA_Sub_HelpProvided ; rdf:predicate dkg:carries ;
    rdf:object "queue cooking-assistance.help-provided bound to exchange cooking-assistance" ;
    rdfs:comment "Cooking Assistance AsyncAPI: consumes HelpProvided from its own exchange, where the avatar does not publish" ;
    dkg:source :Art_API_CookingAssistance_AAS ; dkg:confidence dkg:Inferred ;
    dkg:contradicts :As_Wire_HP_GA .

