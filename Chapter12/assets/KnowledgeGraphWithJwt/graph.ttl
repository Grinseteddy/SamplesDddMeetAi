:D_ADR0004 dkg:honors :Prin_AP0006_SyncForUIs, :Prin_AP0008_FineGrainedAccessRights .

:As_ADR0004_honors_AP0006 a dkg:Assertion ; rdf:subject :D_ADR0004 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0006_SyncForUIs ;
    dkg:citedBy "explicit" ;
    rdfs:comment "REST option: 'Advantages: It is supported by principles (see AP0006)'." ;
    dkg:source :Art_ADR_ADR0004 ; dkg:confidence dkg:OnArtifact .

:As_ADR0004_honors_AP0008 a dkg:Assertion ; rdf:subject :D_ADR0004 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0008_FineGrainedAccessRights ;
    dkg:citedBy "by-elimination" ;
    rdfs:comment "AP0008 is cited as a disadvantage of the rejected GraphQL option ('It contradicts a fine-grained control of access rights (see AP0008)'); REST's own Consequences row shows Security = 'Fine grained'. REST honors AP0008 only because the alternative was marked as contradicting it, not because REST cites AP0008 for itself." ;
    dkg:source :Art_ADR_ADR0004 ; dkg:confidence dkg:Implied .

##############################################################################

:Q_ADR0005_UIComposition a dkg:Question ;
    skos:prefLabel "How will the micro-UIs of the Bounded Contexts be composed into one application?" ;
    dkg:source :Art_ADR_ADR0005 ; dkg:locator "Context" ; dkg:confidence dkg:Implied .

:D_ADR0005 a dkg:Decision ;
    skos:prefLabel "Orchestrator UI" ; dkg:decisionId "ADR0005" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-10"^^xsd:date ; dkg:decidedBy "Annegret Junker" ;
    dkg:decidedOption "We will use an orchestrator for the UI or Larder. It ingests the micro UIs of the Bounded Context and provides an AppShell." ;
    dkg:consideredOption "Orchestrator", "Choreography" ;
    dkg:consequence "Implementation: Larger effort in AppShell", "Team independence: All teams depend on AppShell team." ;
    dkg:rationale "Guided Cooking Workflows and Catastrophe & Rescue Management need an orchestrator to drive state transitions and conditional modal branching across Meal Preparation, Cooking Assistance, Media and Grandma Avatar AI; Unified View Aggregation & Gating synthesizes live data from Recipe Catalog, Meal Preparation and Cooking Assistance while enforcing rules from Consent Management and a Paywall; Choreography for Decoupled Extras lets passive elements (Notification toasts, Sharing feed updates, Ads promotions) subscribe to events like MealPrepared or ThanksGiven." ;
    dkg:sourceFormat "full-form" ; dkg:answers :Q_ADR0005_UIComposition ;
    dkg:mentions :Ctx_MealPreparation, :Ctx_CookingAssistance, :Ctx_Media, :Act_GrandmaAvatar,
        :Ctx_ConsentManagement, :Ctx_RecipeCatalog, :Ctx_Notification, :Ctx_Sharing ;
    dkg:source :Art_ADR_ADR0005 ; dkg:locator "ADR0005" ; dkg:confidence dkg:OnArtifact .

:D_ADR0005 dkg:overrides :Prin_AP0005b_MicroUIs ; dkg:honors :Prin_AP0002_AsyncBeforeSync .

:As_ADR0005_overrides_AP0005b a dkg:Assertion ; rdf:subject :D_ADR0005 ; rdf:predicate dkg:overrides ; rdf:object :Prin_AP0005b_MicroUIs ;
    dkg:acknowledged false ;
    rdfs:comment "AP0005b's rationale: 'The teams developing the Bounded Contexts must be as independent as possible.' ADR0005's own Consequences table: 'Team independence: All teams depend on AppShell team.' The document cites no principle by id anywhere, so the override reads as made without checking AP0005 rather than as a deliberate, named exception." ;
    dkg:source :Art_ADR_ADR0005 ; dkg:confidence dkg:Implied .

:As_ADR0005_honors_AP0002 a dkg:Assertion ; rdf:subject :D_ADR0005 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0002_AsyncBeforeSync ;
    dkg:citedBy "incidental" ;
    rdfs:comment "'Choreography for Decoupled Extras' driver: passive UI elements 'subscribe to events like MealPrepared or ThanksGiven via lightweight UI choreography to avoid coupling with the main cooking pipeline' — event-driven, decoupled, and explicitly framed as avoiding coupling, though AP0002 is never cited by id." ;
    dkg:source :Art_ADR_ADR0005 ; dkg:confidence dkg:Implied .

