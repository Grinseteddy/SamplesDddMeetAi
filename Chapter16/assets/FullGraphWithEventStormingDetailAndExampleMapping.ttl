:Art_API_Notifications_AAS a dkg:Artifact ;
    rdfs:label "Notifications — AsyncAPI 3.1, version 1.0.0 (notifications.asyncapi.yaml)" ;
    rdfs:comment "AsyncAPI draft for the Notifications context 'of the Community Cooking platform'. Consumes HelpRequested (queue notifications.help-requested, messageType help.requested) and HelpProvided (queue notifications.help-provided, messageType help.provided), both 'bound to the Cooking Assistance exchange' without naming it or the routing keys. One notification per preferred provider group on HelpRequested; to the help requester on HelpProvided. correlationId carries the helpRequestId. Requires helpRequestStatus on HelpProvided. title ≤120 (Cooking Assistance contract: ≤200)." ;
    dkg:mentions :Ctx_Notification ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Msg_API_NOT_Sub_HelpRequested a dkg:Message ; skos:prefLabel "consumes HelpRequested" ; dkg:to :Ctx_Notification ; dkg:messageKind "evt" ;
    dkg:carries "queue notifications.help-requested · 'Cooking Assistance exchange' (unnamed) · messageType help.requested · HelpRequested" ; dkg:mentions :Ev_HelpRequested, :Msg_APC_NOT_In_HelpRequested ;
    dkg:source :Art_API_Notifications_AAS ; dkg:locator "operations.consumeHelpRequested" ; dkg:confidence dkg:Inferred .
:Msg_API_NOT_Sub_HelpProvided a dkg:Message ; skos:prefLabel "consumes HelpProvided" ; dkg:to :Ctx_Notification ; dkg:messageKind "evt" ;
    dkg:carries "queue notifications.help-provided · messageType help.provided · HelpProvided (helpRequestStatus required)" ; dkg:mentions :Ev_HelpProvided, :Msg_APC_NOT_In_HelpProvided ;
    dkg:source :Art_API_Notifications_AAS ; dkg:locator "operations.consumeHelpProvided" ; dkg:confidence dkg:Inferred .

# --- CONTRADICTION: is helpRequestStatus part of HelpProvided? ---
:As_HPPayload_NOT a dkg:Assertion ;
    rdf:subject :Msg_API_NOT_Sub_HelpProvided ; rdf:predicate dkg:carries ;
    rdf:object "HelpProvided requires helpRequestStatus (ANSWERED)" ;
    rdfs:comment "Notifications AsyncAPI (and Cooking Assistance AsyncAPI, publisher) require it" ;
    dkg:source :Art_API_Notifications_AAS, :Art_API_CookingAssistance_AAS ; dkg:confidence dkg:Inferred .
:As_HPPayload_GA a dkg:Assertion ;
    rdf:subject :Msg_API_GA_Pub_HelpProvided ; rdf:predicate dkg:carries ;
    rdf:object "HelpProvided without helpRequestStatus" ;
    rdfs:comment "Grandma Avatar AsyncAPI: the property does not exist in its payload, so its messages fail the Notifications schema" ;
    dkg:source :Art_API_GrandmaAvatar_AAS ; dkg:confidence dkg:Inferred ;
    dkg:contradicts :As_HPPayload_NOT .
:Q_ContractLimitsDiffer a dkg:Question ; skos:prefLabel "Whose text limits hold for help payloads?" ;
    rdfs:comment "Same Help Request / Help payloads, different invented limits: title ≤200 (Cooking Assistance, Grandma AsyncAPI) vs ≤120 (Notifications AsyncAPI); substitute name ≤100 vs ≤120; the Cooking Assistance OpenAPI says no maximum lengths are invented. No artifact sets any limit." ; dkg:mentions :Con_HelpRequest ;
    dkg:source :Art_API_Notifications_AAS ; dkg:locator "schemas HelpRequestedPayload.title / SubstituteIngredient.name" ; dkg:confidence dkg:Inferred .
:Art_API_Notifications_AAS dkg:raises :Q_ContractLimitsDiffer .
:Q_PlatformName a dkg:Question ; skos:prefLabel "Is the platform 'Larder' or 'Community Cooking'?" ;
    rdfs:comment "Notifications AsyncAPI describes 'the Notifications bounded context of the Community Cooking platform'; every other artifact says Larder." ; dkg:mentions :Q_LarderTwoSenses ;
    dkg:source :Art_API_Notifications_AAS ; dkg:locator "info.description" ; dkg:confidence dkg:Inferred .
:Art_API_Notifications_AAS dkg:raises :Q_PlatformName .
:Q_ThanksRecipients rdfs:comment "Async contracts trace one help journey 'request → help → thanks' by correlationId; the Thanks model holds no help or correlation reference." ; dkg:source :Art_API_Notifications_AAS .

