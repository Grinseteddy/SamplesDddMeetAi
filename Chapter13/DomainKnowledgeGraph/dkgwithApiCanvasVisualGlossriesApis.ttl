########## API Product Canvases — operation → model, reified (Inferred) ##########

:As_Op_CookingAssistance_POST_HelpRequests_specifies_Cmd_RequestHelp a dkg:Assertion ;
    rdf:subject :Op_CookingAssistance_POST_HelpRequests ; rdf:predicate dkg:specifies ; rdf:object :Cmd_RequestHelp ;
    rdfs:comment "POST of a Help request vs board command 'Request help'" ;
    dkg:source :Art_APC_CookingAssistance ; dkg:confidence dkg:Inferred .

:As_Op_CookingAssistance_POST_Helps_specifies_Cmd_ProvideHelp a dkg:Assertion ;
    rdf:subject :Op_CookingAssistance_POST_Helps ; rdf:predicate dkg:specifies ; rdf:object :Cmd_ProvideHelp ;
    rdfs:comment "POST of a Help vs board command 'Provide help'" ;
    dkg:source :Art_APC_CookingAssistance ; dkg:confidence dkg:Inferred .

:As_Op_Sharing_POST_Thanks_specifies_Cmd_ProvideThanks a dkg:Assertion ;
    rdf:subject :Op_Sharing_POST_Thanks ; rdf:predicate dkg:specifies ; rdf:object :Cmd_ProvideThanks ;
    rdfs:comment "POST of thanks vs board command 'Provide thanks'" ;
    dkg:source :Art_APC_Sharing ; dkg:confidence dkg:Inferred .

:As_Op_CookProfile_POST_Cooks_specifies_Cmd_RegisterCook a dkg:Assertion ;
    rdf:subject :Op_CookProfile_POST_Cooks ; rdf:predicate dkg:specifies ; rdf:object :Cmd_RegisterCook ;
    rdfs:comment "POST creating a cook ('201: Link to created cook') vs board command 'Register cook'" ;
    dkg:source :Art_APC_CookProfile ; dkg:confidence dkg:Inferred .

:As_Op_RecipeCatalog_GET_Recipes_specifies_Cmd_SearchRecipes a dkg:Assertion ;
    rdf:subject :Op_RecipeCatalog_GET_Recipes ; rdf:predicate dkg:specifies ; rdf:object :Cmd_SearchRecipes ;
    rdfs:comment "GET filtered by Diet, Meal, Ingredients vs board command 'Search recipes'; value proposition says 'Search recipes by meal, ingredients, and diets'" ;
    dkg:source :Art_APC_RecipeCatalog ; dkg:confidence dkg:Inferred .

:As_Op_MealPreparation_POST_Preparations_specifies_Cmd_PrepareMeal a dkg:Assertion ;
    rdf:subject :Op_MealPreparation_POST_Preparations ; rdf:predicate dkg:specifies ; rdf:object :Cmd_PrepareMeal ;
    rdfs:comment "POST starting a preparation from a recipe vs board command 'Prepare meal'" ;
    dkg:source :Art_APC_MealPreparation ; dkg:confidence dkg:Inferred .

:As_Op_RecipeCatalog_GET_RecipesByRecipeId_specifies_Msg_RecipeCatalog_MealPlanning a dkg:Assertion ;
    rdf:subject :Op_RecipeCatalog_GET_RecipesByRecipeId ; rdf:predicate dkg:specifies ; rdf:object :Msg_RecipeCatalog_MealPlanning ;
    rdfs:comment "context-map arrow 1 leaves Recipe Catalog's OHS carrying 'Recipe'; this GET returns '200: recipe'" ;
    dkg:source :Art_APC_RecipeCatalog ; dkg:confidence dkg:Inferred .

:As_Op_MealPreparation_POST_Preparations_specifies_Msg_MealPlanning_MealPreparation a dkg:Assertion ;
    rdf:subject :Op_MealPreparation_POST_Preparations ; rdf:predicate dkg:specifies ; rdf:object :Msg_MealPlanning_MealPreparation ;
    rdfs:comment "context-map arrow 11 has its arrowhead on Meal Preparation's OHS carrying 'Recipe, Menu'; this POST takes 'recipe' (Menu is not on the canvas)" ;
    dkg:source :Art_APC_MealPreparation ; dkg:confidence dkg:Inferred .

:As_Op_ConsentManagement_GET_Consents_specifies_Msg_ConsentManagement_Sharing a dkg:Assertion ;
    rdf:subject :Op_ConsentManagement_GET_Consents ; rdf:predicate dkg:specifies ; rdf:object :Msg_ConsentManagement_Sharing ;
    rdfs:comment "context-map arrow 14 leaves Consent Management's OHS carrying 'Consent' to Sharing's CF; GET by subject returns consents" ;
    dkg:source :Art_APC_ConsentManagement ; dkg:confidence dkg:Inferred .

:As_Op_ConsentManagement_GET_ConsentsByConsentId_specifies_Msg_ConsentManagement_Sharing a dkg:Assertion ;
    rdf:subject :Op_ConsentManagement_GET_ConsentsByConsentId ; rdf:predicate dkg:specifies ; rdf:object :Msg_ConsentManagement_Sharing ;
    rdfs:comment "context-map arrow 14, as above; single consent by id" ;
    dkg:source :Art_APC_ConsentManagement ; dkg:confidence dkg:Inferred .

:As_Op_ConsentManagement_POST_Consents_specifies_Msg_CookProfile_ConsentManagement a dkg:Assertion ;
    rdf:subject :Op_ConsentManagement_POST_Consents ; rdf:predicate dkg:specifies ; rdf:object :Msg_CookProfile_ConsentManagement ;
    rdfs:comment "context-map arrow 13 carries 'Consent' from Cook Profile to Consent Management — but the map says it LEAVES Cook Profile's OHS, while the canvas puts the endpoint on Consent Management. Direction of the OHS is contested" ;
    dkg:source :Art_APC_ConsentManagement ; dkg:confidence dkg:Inferred .


########## API Product Canvases — open questions raised by the ingest ##########

:Q_APC_SharingListReturnsConsents a dkg:Question ;
    skos:prefLabel "GET /thanks answers '200: consents' — a copy from the Consent Management canvas, or does listing thanks really return consents?" ;
    dkg:source :Art_APC_Sharing ;
    dkg:locator "/thanks row, GET, 200" ;
    dkg:mentions :Con_Thanks ;
    dkg:mentions :Con_Consent ;
    dkg:confidence dkg:Inferred .
:Op_Sharing_GET_Thanks dkg:raises :Q_APC_SharingListReturnsConsents .

:Q_APC_LinkToChangedRecipient a dkg:Question ;
    skos:prefLabel "Two PATCH operations answer '200: Link to changed recipient' (Meal Planning /meal-plans/{mealPlanId}, Recipe Catalog /recipes/{recipeId}) — what is the 'recipient'? Template leftover, or a concept no workshop named?" ;
    dkg:source :Art_APC_MealPlanning ;
    dkg:locator "/meal-plans/{mealPlanId} row, PATCH, 200" ;
    dkg:confidence dkg:Inferred .
:Op_MealPlanning_PATCH_MealPlansByMealPlanId dkg:raises :Q_APC_LinkToChangedRecipient .
:Op_RecipeCatalog_PATCH_RecipesByRecipeId dkg:raises :Q_APC_LinkToChangedRecipient .

:Q_APC_PatchHelpReturnsHelpRequest a dkg:Question ;
    skos:prefLabel "PATCH /helps/{helpId} answers '200: Link to changed help request' — the help, or its help request?" ;
    dkg:source :Art_APC_CookingAssistance ;
    dkg:locator "/helps/{helpId} row, PATCH, 200" ;
    dkg:mentions :Con_Help ;
    dkg:mentions :Con_HelpRequest ;
    dkg:confidence dkg:Inferred .
:Op_CookingAssistance_PATCH_HelpsByHelpId dkg:raises :Q_APC_PatchHelpReturnsHelpRequest .

:Q_APC_AggregateIdParameter a dkg:Question ;
    skos:prefLabel "DELETE /help-requests/{helpRequestId} takes 'Aggregate ID' where its siblings take 'help Request Id' — same identifier, or a different one?" ;
    dkg:source :Art_APC_CookingAssistance ;
    dkg:locator "/help-requests/{helpRequestId} row, DELETE" ;
    dkg:mentions :Con_HelpRequest ;
    dkg:confidence dkg:Inferred .
:Op_CookingAssistance_DELETE_HelpRequestsByHelpRequestId dkg:raises :Q_APC_AggregateIdParameter .

:Q_APC_TemplateProtocol a dkg:Question ;
    skos:prefLabel "Four canvases (Consent Management, Cooking Assistance, Notifications, Sharing) still say 'e.g. http' / 'e.g. RESTful oriented' — undecided, or simply not filled in? The other five say https / RESTful." ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "header" ;
    dkg:confidence dkg:Inferred .
:Api_ConsentManagement dkg:raises :Q_APC_TemplateProtocol .
:Api_CookingAssistance dkg:raises :Q_APC_TemplateProtocol .
:Api_Notifications dkg:raises :Q_APC_TemplateProtocol .
:Api_Sharing dkg:raises :Q_APC_TemplateProtocol .

:Q_APC_HelpVsHelpResponse a dkg:Question ;
    skos:prefLabel "The Cooking Assistance API's noun is 'Help' (/helps); the context map (arrows 3, 5, 6, 9, 12) and the board carry 'Help response'. One concept under two names, or two?" ;
    dkg:source :Art_APC_CookingAssistance ;
    dkg:locator "/helps rows" ;
    dkg:mentions :Con_Help ;
    dkg:mentions :Con_HelpResponse ;
    dkg:confidence dkg:Inferred .
:Op_CookingAssistance_POST_Helps dkg:raises :Q_APC_HelpVsHelpResponse .
:Op_CookingAssistance_GET_HelpsByHelpId dkg:raises :Q_APC_HelpVsHelpResponse .

:Q_APC_ImageVsPictures a dkg:Question ;
    skos:prefLabel "The Media API calls its noun 'image' / 'media'; the glossary says 'Picture', the context map and board 'Pictures', the stories 'Catastrophe Pictures'. Which name wins, and is 'media' wider than pictures?" ;
    dkg:source :Art_APC_Media ;
    dkg:locator "/images rows" ;
    dkg:mentions :Con_Picture ;
    dkg:mentions :Con_Pictures ;
    dkg:mentions :Con_CatastrophePictures ;
    dkg:confidence dkg:Inferred .
:Op_Media_POST_Images dkg:raises :Q_APC_ImageVsPictures .
:Op_Media_GET_ImagesByMediaId dkg:raises :Q_APC_ImageVsPictures .
:Op_Media_GET_Images dkg:raises :Q_APC_ImageVsPictures .

:Q_APC_NotificationCreation a dkg:Question ;
    skos:prefLabel "No operation on the Notifications canvas creates a notification (GET, DELETE, PUT status only). Is creation asynchronous only — context-map arrow 6 from Cooking Assistance is dashed — and if so, where is its contract?" ;
    dkg:source :Art_APC_Notifications ;
    dkg:locator "whole canvas" ;
    dkg:mentions :Con_Notification ;
    dkg:confidence dkg:Inferred .
:Api_Notifications dkg:raises :Q_APC_NotificationCreation .

:Q_APC_MealPlanningProvidesMenuIngredientsRecipe a dkg:Question ;
    skos:prefLabel "Context-map arrow 2 leaves Meal Planning's OHS carrying 'Menu, Ingredients, Recipe' to Cooking Assistance, and arrow 10 leaves Meal Preparation's OHS carrying 'Menu, Recipe'. Neither canvas exposes Menu, Ingredients or Recipe — inside the meal plan / preparation, or missing endpoints?" ;
    dkg:source :Art_APC_MealPlanning ;
    dkg:locator "whole canvas" ;
    dkg:mentions :Con_Menu ;
    dkg:mentions :Con_Ingredients ;
    dkg:mentions :Con_Recipe ;
    dkg:confidence dkg:Inferred .
:Api_MealPlanning dkg:raises :Q_APC_MealPlanningProvidesMenuIngredientsRecipe .
:Api_MealPreparation dkg:raises :Q_APC_MealPlanningProvidesMenuIngredientsRecipe .

:Q_APC_HelpResponseNoEndpoint a dkg:Question ;
    skos:prefLabel "Context-map arrows 3, 9 and 12 land on the OHS of Meal Planning, Meal Preparation and Sharing carrying 'Help response'; none of those three canvases has an operation that accepts one." ;
    dkg:source :Art_APC_MealPreparation ;
    dkg:locator "whole canvas" ;
    dkg:mentions :Con_HelpResponse ;
    dkg:confidence dkg:Inferred .
:Api_MealPlanning dkg:raises :Q_APC_HelpResponseNoEndpoint .
:Api_MealPreparation dkg:raises :Q_APC_HelpResponseNoEndpoint .
:Api_Sharing dkg:raises :Q_APC_HelpResponseNoEndpoint .

:Q_APC_PicturesArrowsVsMediaEndpoint a dkg:Question ;
    skos:prefLabel "Context-map arrows 7 and 8 (Media → Cooking Assistance, Media → Sharing: Pictures) land on the receivers' OHS, but the canvases put the endpoint on Media (GET /images, GET /images/{mediaId}); Cooking Assistance and Sharing expose nothing for pictures." ;
    dkg:source :Art_APC_Media ;
    dkg:locator "/images rows" ;
    dkg:mentions :Con_Pictures ;
    dkg:confidence dkg:Inferred .
:Op_Media_GET_Images dkg:raises :Q_APC_PicturesArrowsVsMediaEndpoint .
:Op_Media_GET_ImagesByMediaId dkg:raises :Q_APC_PicturesArrowsVsMediaEndpoint .

:Q_APC_HowToStepVsStep a dkg:Question ;
    skos:prefLabel "Recipe Catalog and Meal Preparation both expose 'howToStep'; the glossary holds 'Step' and 'Preparation Step Explanation'. Is a howToStep the glossary's Step — and is Meal Preparation's howToStep a copy of Recipe Catalog's?" ;
    dkg:source :Art_APC_RecipeCatalog ;
    dkg:locator "/recipes/{recipeId}/how-to-steps rows" ;
    dkg:mentions :Con_Step ;
    dkg:mentions :Con_PreparationStepExplanation ;
    dkg:confidence dkg:Inferred .
:Op_RecipeCatalog_GET_RecipesByRecipeIdHowToSteps dkg:raises :Q_APC_HowToStepVsStep .
:Op_MealPreparation_GET_PreparationsByPreparationIdHowToStepsByStepId dkg:raises :Q_APC_HowToStepVsStep .

:Q_APC_StepNavigationAndEvents a dkg:Question ;
    skos:prefLabel "PATCH …/how-to-steps/next and /previous take a 'stepId' parameter that is not in their path, and answer with a howToStep. The board's 'Step competeted', 'Step unclear' and 'Catastrophe happened' have no contract on this canvas — is advancing a step the board's 'Step completed', and where are the other two?" ;
    dkg:source :Art_APC_MealPreparation ;
    dkg:locator "how-to-steps/next and /previous rows" ;
    dkg:mentions :Con_Step ;
    dkg:confidence dkg:Inferred .
:Op_MealPreparation_PATCH_PreparationsByPreparationIdHowToStepsNext dkg:raises :Q_APC_StepNavigationAndEvents .
:Op_MealPreparation_PATCH_PreparationsByPreparationIdHowToStepsPrevious dkg:raises :Q_APC_StepNavigationAndEvents .

:Q_APC_CreateMealPlanCommand a dkg:Question ;
    skos:prefLabel "POST /meal-plans — is it the board's 'Plan meal' or 'Plan dinner'? The canvas says 'Supports cooks when planning a dinner' and 'Set up meal plan'." ;
    dkg:source :Art_APC_MealPlanning ;
    dkg:locator "/meal-plans row, POST" ;
    dkg:mentions :Con_MealPlan ;
    dkg:mentions :Con_Dinner ;
    dkg:confidence dkg:Inferred .
:Op_MealPlanning_POST_MealPlans dkg:raises :Q_APC_CreateMealPlanCommand .

:Q_APC_UploadImageVsTakePictures a dkg:Question ;
    skos:prefLabel "POST /images uploads an image; the board's command is 'Take pictures'. Same intent (the cook's photo reaches the platform), or is taking pictures outside the system?" ;
    dkg:source :Art_APC_Media ;
    dkg:locator "/images row, POST" ;
    dkg:mentions :Con_Pictures ;
    dkg:confidence dkg:Inferred .
:Op_Media_POST_Images dkg:raises :Q_APC_UploadImageVsTakePictures .

:Q_APC_CookProfileCommodity a dkg:Question ;
    skos:prefLabel "The Cook Profile canvas carries a pink 'Commodity - only for requirements' sticky. No Capability Map or Core Domain Chart in the graph classifies Cook Profile yet — generic subdomain to buy?" ;
    dkg:source :Art_APC_CookProfile ;
    dkg:locator "Core functions, pink sticky" ;
    dkg:mentions :Con_Cook ;
    dkg:confidence dkg:Inferred .
:Api_CookProfile dkg:raises :Q_APC_CookProfileCommodity .

:Q_APC_UserVsCookInOneApi a dkg:Question ;
    skos:prefLabel "POST /cooks takes a 'User' and answers 'Link to created cook'; PATCH and DELETE take a 'Cook'. The glossary records User renamedTo Cook — does the rename happen at registration, inside this one API?" ;
    dkg:source :Art_APC_CookProfile ;
    dkg:locator "/cooks row, POST" ;
    dkg:mentions :Con_User ;
    dkg:mentions :Con_Cook ;
    dkg:confidence dkg:Inferred .
:Op_CookProfile_POST_Cooks dkg:raises :Q_APC_UserVsCookInOneApi .
:Op_CookProfile_PATCH_CooksByCookId dkg:raises :Q_APC_UserVsCookInOneApi .

:Q_APC_UnnamedParameterNouns a dkg:Question ;
    skos:prefLabel "Parameters no workshop named: subject, Requester, Status, type, Name, email, Diet, Occasion, business object id/type, Receiver, giver, recipient. 'Diet' and 'Occasion' especially look like domain terms the glossary lacks; 'owner', 'requester', 'provider', 'giver' in the guard stickies are roles with no Actor." ;
    dkg:source :Art_APC_MealPlanning ;
    dkg:locator "Parameters columns" ;
    dkg:confidence dkg:Inferred .
:Op_MealPlanning_GET_MealPlans dkg:raises :Q_APC_UnnamedParameterNouns .
:Op_RecipeCatalog_GET_Recipes dkg:raises :Q_APC_UnnamedParameterNouns .
:Op_Sharing_GET_Thanks dkg:raises :Q_APC_UnnamedParameterNouns .
:Op_CookingAssistance_GET_HelpRequests dkg:raises :Q_APC_UnnamedParameterNouns .

:Q_APC_ConsentText a dkg:Question ;
    skos:prefLabel "'consent-text' / 'consent-texts' is a noun only the Consent Management canvas uses — what is it, and who writes it ('Creation and change of consent texts only via backend')?" ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/consent-texts rows" ;
    dkg:mentions :Con_Consent ;
    dkg:confidence dkg:Inferred .
:Op_ConsentManagement_GET_ConsentsConsentTexts dkg:raises :Q_APC_ConsentText .

:Q_APC_SingleIngredientReturnsIngredients a dkg:Question ;
    skos:prefLabel "GET /recipes/{recipeId}/ingredients/{ingredientId} answers '200: Ingredients' (plural) for a single ingredient — typo, or does it return a list?" ;
    dkg:source :Art_APC_RecipeCatalog ;
    dkg:locator "/ingredients/{ingredientId} row, GET" ;
    dkg:mentions :Con_Ingredient ;
    dkg:mentions :Con_Ingredients ;
    dkg:confidence dkg:Inferred .
:Op_RecipeCatalog_GET_RecipesByRecipeIdIngredientsByIngredientId dkg:raises :Q_APC_SingleIngredientReturnsIngredients .

:Q_APC_RevokeConsentCommand a dkg:Question ;
    skos:prefLabel "DELETE /consents/{consentId} is labelled 'Revokes consent', and the core function is 'Creates and revokes consent' — but no board or story has a 'Revoke consent' command or a 'Consent revoked' event." ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/{consentId} row, DELETE" ;
    dkg:mentions :Con_Consent ;
    dkg:confidence dkg:Inferred .
:Op_ConsentManagement_DELETE_ConsentsByConsentId dkg:raises :Q_APC_RevokeConsentCommand .

# canvases bear on two questions the context map already raised
:Op_ConsentManagement_POST_Consents dkg:raises :Q_ArrowDirectionOnContextMap .
:Op_MealPreparation_POST_Preparations dkg:raises :Q_ArrowDirectionOnContextMap .
:Api_CookingAssistance dkg:raises :Q_HelpEventsInTwoContexts .

##############################################################################
# INGEST — API Product Canvases (asynchronous), 3 canvases  (2026-10-03)
# Hand-transcribed pictures. Events Receive → Operation action "receive";
# Events Send → Operation action "send"; orange sticky → dkg:ApiMessage;
# yellow Payload sticky in the same position below → dkg:Schema (payload).
# No channel, exchange, queue or routing key is on any canvas: no dkg:Channel
# is minted. Server lines carry a username and password — REDACTED here.
##############################################################################

########## Async API Product Canvas — Notifications ##########

:Art_AAPC_Notifications a dkg:AsyncApiSpec ;
    rdfs:label "Notifications — API Product Canvas (asynchronous), version 1.0.0" ;
    rdfs:comment "Two image files of the same canvas supplied (ce5c12ce-image.jpg, 9d1bc00e-image.jpg) — transcriptions identical, ingested once. 2 events received, 0 sent. Server 'amqps://app_prod:<password redacted>@://larder.org' (credentials on the canvas; address malformed: '@://'). Contact annegret.junker@larder.org." ;
    dkg:specFormat "API Product Canvas (asynchronous)" ;
    dkg:ingestedAt "2026-10-03"^^xsd:date .

:Api_NotificationsAsync a dkg:Api ;
    skos:prefLabel "Notifications" ;
    rdfs:comment "Value propositions: Providing of notifications to Cooks, based on events notifications are created. Core functions: Providing of notifications; Mark notifications as read, delete notifications. Async protocol as written: 'RabbitMQ'; Architecture pattern: 'event-driven architecture'. Quality requirements and Notes recorded as dkg:Rule. dkg:inContext is Inferred: the title 'Notifications' is not the context's label 'Notification' (same assignment as the synchronous canvas)." ;
    dkg:interactionStyle "async" ;
    dkg:apiVersion "1.0.0" ;
    dkg:protocol "amqps" ;
    dkg:inContext :Ctx_Notification ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "header" ;
    dkg:confidence dkg:OnArtifact .

:Amsg_HelpRequested a dkg:ApiMessage ;
    skos:prefLabel "Help requested" ;
    dkg:payloadSchema :Sch_NotificationsAsync_HelpRequest ;
    dkg:exposedBy :Api_NotificationsAsync ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "Events Receive, sticky 1" ;
    dkg:confidence dkg:OnArtifact .
:Amsg_HelpRequested dkg:specifies :Ev_HelpRequested .    # exact label — Implied

:Amsg_HelpProvided a dkg:ApiMessage ;
    skos:prefLabel "Help provided" ;
    dkg:payloadSchema :Sch_NotificationsAsync_HelpProvided ;
    dkg:exposedBy :Api_NotificationsAsync ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "Events Receive, sticky 2" ;
    dkg:confidence dkg:OnArtifact .
:Amsg_HelpProvided dkg:specifies :Ev_HelpProvided .      # exact label — Implied

:Op_NotificationsAsync_Receive_HelpRequested a dkg:Operation ;
    skos:prefLabel "receive Help requested" ;
    dkg:action "receive" ;
    dkg:messageKind "evt" ;
    dkg:carriesMessage :Amsg_HelpRequested ;
    dkg:exposedBy :Api_NotificationsAsync ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "Events Receive, sticky 1" ;
    dkg:confidence dkg:OnArtifact .
:Op_NotificationsAsync_Receive_HelpProvided a dkg:Operation ;
    skos:prefLabel "receive Help provided" ;
    dkg:action "receive" ;
    dkg:messageKind "evt" ;
    dkg:carriesMessage :Amsg_HelpProvided ;
    dkg:exposedBy :Api_NotificationsAsync ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "Events Receive, sticky 2" ;
    dkg:confidence dkg:OnArtifact .

:Sch_NotificationsAsync_HelpRequest a dkg:Schema ;
    skos:prefLabel "Help request" ;
    dkg:schemaRole "payload" ;
    dkg:exposedBy :Api_NotificationsAsync ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "Payload (receive), sticky 1" ;
    dkg:confidence dkg:OnArtifact .
:Sch_NotificationsAsync_HelpRequest dkg:specifies :Con_HelpRequest .   # payload named for a noun, exact — Implied

:Sch_NotificationsAsync_HelpProvided a dkg:Schema ;
    skos:prefLabel "Help provided" ;
    rdfs:comment "Payload named like the event itself, not like a noun; the producers' payload for Help provided is 'help' / 'Help'. Not linked to any Concept." ;
    dkg:schemaRole "payload" ;
    dkg:exposedBy :Api_NotificationsAsync ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "Payload (receive), sticky 2" ;
    dkg:confidence dkg:OnArtifact .

:R_NotificationsAsync_NotificationsAreExclusivelyCreatedOnEvents a dkg:Rule ;
    skos:prefLabel "Notifications are exclusively created on events" ;
    rdfs:comment "Quality requirement on the canvas." ;
    dkg:inContext :Ctx_Notification ;
    dkg:mentions :Con_Notification ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "Quality requirements, bullet 1" ;
    dkg:confidence dkg:OnArtifact .
:R_NotificationsAsync_AggregationInFrontend a dkg:Rule ;
    skos:prefLabel "Aggregation functionality like showing the number of notifications needs to be handled in the frontend" ;
    rdfs:comment "Notes field on the canvas." ;
    dkg:inContext :Ctx_Notification ;
    dkg:mentions :Con_Notification ;
    dkg:source :Art_AAPC_Notifications ;
    dkg:locator "Notes" ;
    dkg:confidence dkg:OnArtifact .
:Api_NotificationsAsync dkg:dependsOn :R_NotificationsAsync_NotificationsAreExclusivelyCreatedOnEvents , :R_NotificationsAsync_AggregationInFrontend .

