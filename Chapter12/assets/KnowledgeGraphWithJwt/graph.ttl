:Q_CookIdToBoundedContexts_SADR0007b a dkg:Question ;
    skos:prefLabel "How to provide cookId to Bounded Contexts?" ;
    dkg:source :Art_ADRLog_SadrsLarder ; dkg:locator "SADR0007 (second occurrence), Question" ; dkg:confidence dkg:OnArtifact .

:D_SADR0007b a dkg:Decision ;
    skos:prefLabel "JWT with cookId" ; dkg:decisionId "SADR0007" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-20"^^xsd:date ; dkg:decidedBy "Junker" ;
    dkg:decidedOption "JWT Token contains identity of Cook as cookId" ;
    dkg:consideredOption "JWT", "header", "property in each request" ;
    dkg:sourceFormat "small-log" ; dkg:answers :Q_CookIdToBoundedContexts_SADR0007b ;
    dkg:mentions :Act_Cook, :Ctx_CookProfile ;
    dkg:defect "Shares id 'SADR0007' with the unrelated 'Capability Map with Legend' row — see the Artifact's dkg:defect. Disambiguated as SADR0007b." ;
    rdfs:comment "Not scored against any Principle: carrying cookId in a JWT is a mechanism choice orthogonal to sync-vs-async transport, UI-vs-BC scope, and access-rights granularity as those principles are actually worded here — scoring it would be keyword overlap ('token' near 'access control'), not content. Kept Silent rather than forced. Concretely, this is the project's first answer to how identity crosses into every Bounded Context — see report §7." ;
    dkg:source :Art_ADRLog_SadrsLarder ; dkg:locator "SADR0007 (second occurrence)" ; dkg:confidence dkg:OnArtifact .
