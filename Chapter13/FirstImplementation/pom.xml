<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>org.larder</groupId>
    <artifactId>larder-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Larder</name>
    <description>Larder as a modular monolith: one Maven module per Bounded Context (ADR0001).</description>

    <modules>
        <module>platform</module>
        <module>bounded-contexts</module>
        <module>app-shell</module>
        <module>larder-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <larder.contracts.dir>${maven.multiModuleProjectDirectory}/contracts</larder.contracts.dir>
        <openapi-generator.version>7.10.0</openapi-generator.version>
        <archunit.version>1.3.0</archunit.version>
        <swagger-annotations.version>2.2.25</swagger-annotations.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.larder.platform</groupId>
                <artifactId>platform-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.larder.platform</groupId>
                <artifactId>platform-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.larder.platform</groupId>
                <artifactId>platform-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.larder.platform</groupId>
                <artifactId>platform-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.larder.platform</groupId>
                <artifactId>platform-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations</artifactId>
                <version>${swagger-annotations.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
