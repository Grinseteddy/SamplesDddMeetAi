:Con_RecipeId dkg:proposedSameAs :Con_Recipe_HR ; rdfs:comment "proposedSameAs Con_Recipe_HR: the Help Request model's 'recipe' reference has the identical example 7cf09822-… — a reference to this id (but see Q_ExampleUUIDsReused: the Meal preparation model uses the same UUID as its preparation Id)" .
:Con_Owner_Recipe dkg:proposedSameAs :Con_Owner ; rdfs:comment "proposedSameAs Con_Owner: same word, value object on the Meal Plan model — both presumably reference a cook; kept apart because they belong to different aggregates" .
:Con_Owner_Recipe dkg:proposedSameAs :Con_CookId ; rdfs:comment "proposedSameAs Con_CookId: example UUID f64e07f0-… is the Cook model's cook Id example (weak: that UUID is reused across unrelated ids)" .
:Con_RecipeName dkg:proposedSameAs :Con_Name ; rdfs:comment "proposedSameAs Con_Name: same word 'name' on the Cook model — different aggregate, almost certainly different concept; listed so the room confirms" .
:Con_IngredientName dkg:proposedSameAs :Con_Name ; rdfs:comment "proposedSameAs Con_Name: same word 'Name' (Cook canvas parameter / Cook model) — different aggregate" .
:Con_IngredientId dkg:proposedSameAs :Con_Ingredients_HR ; rdfs:comment "proposedSameAs Con_Ingredients_HR: the Help Request model's 'ingredients' reference — reference to ingredient ids?" .
:Con_HowToStep_Recipe dkg:proposedSameAs :Con_HowToStep ; rdfs:comment "proposedSameAs Con_HowToStep: same word (case-folded) but Help Request 'howTo Step' is a reference VO, this is the entity — the reference points at it" .
:Con_HowToStep_Recipe dkg:proposedSameAs :Con_Step ; rdfs:comment "proposedSameAs Con_Step: glossary v2 'Step' (Recipe contains Step 1..*) — same cardinality 1..*; two words, one concept?" .
:Con_HowToStep_Recipe dkg:proposedSameAs :Con_MealPreparationStep ; rdfs:comment "proposedSameAs Con_MealPreparationStep: story C 'Meal Preparation Step'" .
:Con_StepDescription dkg:proposedSameAs :Con_Description ; rdfs:comment "proposedSameAs Con_Description: same word 'description' on the Help Request model — different aggregate" .
:Con_MealType_Recipe dkg:proposedSameAs :Con_MealType_MP ; rdfs:comment "proposedSameAs Con_MealType_MP: identical value set breakfast / lunch / dinner / supper on the Meal Plan model — one value type shared by two aggregates?" .
:Con_Servings_Recipe dkg:proposedSameAs :Con_Servings ; rdfs:comment "proposedSameAs Con_Servings: same word on the Meal Plan model (example 6 there, 4 here) — recipe servings vs planned servings, which Q_IngredientsFromServings wants to relate" .
:Con_FurtherImage dkg:proposedSameAs :Con_Picture ; rdfs:comment "proposedSameAs Con_Picture: glossary 'Picture' is contained 0..10 by Help Request, Help, Thanks — same 0..10 here" .
:Q_ExampleUUIDsReused rdfs:comment "Recipe model: recipe Id 7cf09822-… matches the Help Request model's recipe example (consistent reference) and the Meal preparation model's preparation Id (reuse); owner f64e07f0-… is the cook Id example; howToStep Id 65610dee-… matches the Meal preparation model (consistent)." ; dkg:source :Art_Glossary_Recipe .
:Q_IngredientsFromServings rdfs:comment "Recipe model gives a recipe its own servings (example 4) and ingredient quantities (Value + Unit) — the inputs a scaling rule would need; the Meal Plan model's servings example is 6." ; dkg:source :Art_Glossary_Recipe .
:Q_ImagesOrMedia rdfs:comment "Recipe model: main image, further Image and illustration are all URLs under https://larder.org/media/images/… — 'images' in the path, 'media' as the host context." ; dkg:source :Art_Glossary_Recipe .

##############################################################################
# Ingest — API Product Canvas 'Recipe Catalog' v1.0.0 (image 2), 2026-10-10. Grow.
# Canvas about Ctx_RecipeCatalog: enriched, not re-minted. No credential on this canvas.
##############################################################################
:Art_APC_RecipeCatalog a dkg:Artifact ;
    rdfs:label "Recipe Catalog — API Product Canvas (sync) v1.0.0 (image 2)" ;
    rdfs:comment "API Product Canvas (Junker & Lazzaretti). https, RESTful; server https://larder.org/recipe-catalog. 8 paths, 17 operations; purple stickies 'Only owner can change' (PATCH ×3, PUT) and 'Only owner can delete' (DELETE ×3). Only success responses transcribed per row; DELETE /recipes/{recipeId} lists no 404. No events sent or received. Small ▸/▲ marks between ingredient rows and between how-to-step rows — meaning unknown." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Ctx_RecipeCatalog dkg:source :Art_APC_RecipeCatalog ; dkg:locator "canvas title" ;
    rdfs:comment "Enriched by the API Product Canvas 'Recipe Catalog': REST API at https://larder.org/recipe-catalog over recipes, their ingredients, how-to steps and meal." .
:Con_Recipe dkg:inContext :Ctx_RecipeCatalog ; dkg:source :Art_APC_RecipeCatalog ; dkg:locator "request of POST /recipes, PATCH /recipes/{recipeId}" .
:Con_Recipes dkg:source :Art_APC_RecipeCatalog ; dkg:locator "response of GET /recipes ('200: recipes')" ;
    rdfs:comment "Auto-merged: canvas response 'recipes' = BMC Key Resource 'Recipes' (exact after case-folding)." .
:Con_RecipeId a dkg:Concept ; dkg:source :Art_APC_RecipeCatalog ; dkg:locator "parameter of /recipes/{recipeId}…" ;
    rdfs:comment "Auto-merged: canvas parameter 'recipe Id' = Recipe model 'recipe Id' (exact)." .
:Con_Ingredient dkg:inContext :Ctx_RecipeCatalog ; dkg:source :Art_APC_RecipeCatalog ; dkg:locator "request of POST/PATCH …/ingredients" .
:Con_IngredientId a dkg:Concept ; skos:altLabel "ingredient Id" ; dkg:source :Art_APC_RecipeCatalog ; dkg:locator "parameter of …/ingredients/{ingredientId}" ;
    rdfs:comment "Auto-merged: canvas 'ingredient Id' = model 'ingredientId' (same word, space only)." .
:Con_HowToStepId dkg:source :Art_APC_RecipeCatalog ; dkg:locator "parameter of …/how-to-steps/{howToStepId}" .
:Con_HowToStep_MPC dkg:source :Art_APC_RecipeCatalog ; dkg:locator "request of POST/PATCH …/how-to-steps; responses" ;
    rdfs:comment "Auto-merged: Recipe Catalog canvas 'howToStep' = Meal Preparation canvas 'howToStep' (exact)." .
:Con_HowToStep_MPC dkg:proposedSameAs :Con_HowToStep_Recipe ; rdfs:comment "proposedSameAs Con_HowToStep_Recipe: canvases write 'howToStep', the Recipe model 'howto Step'" .
:Con_Diet dkg:inContext :Ctx_RecipeCatalog ; dkg:source :Art_APC_RecipeCatalog ; dkg:locator "parameter of GET /recipes" .
:Con_Ingredients_RC a dkg:Concept ; skos:prefLabel "Ingredients" ; rdfs:comment "parameter of GET /recipes; also responses of GET …/ingredients and GET …/ingredients/{ingredientId} (plural on a single-item GET)" ;
    dkg:inContext :Ctx_RecipeCatalog ; dkg:source :Art_APC_RecipeCatalog ; dkg:locator "parameter of GET /recipes" ; dkg:confidence dkg:OnArtifact .
:Con_Ingredients_RC dkg:proposedSameAs :Con_Ingredients ; rdfs:comment "proposedSameAs Con_Ingredients: stories/board 'Ingredients' (work object / read model) vs canvas parameter — cross-class" .
:Con_Meal_RC a dkg:Concept ; skos:prefLabel "Meal" ; rdfs:comment "parameter of GET /recipes; request of PUT …/meals; response of GET …/meals" ;
    dkg:inContext :Ctx_RecipeCatalog ; dkg:source :Art_APC_RecipeCatalog ; dkg:locator "parameter of GET /recipes" ; dkg:confidence dkg:OnArtifact .
:Con_Meal_RC dkg:proposedSameAs :Con_MealType_Recipe ; rdfs:comment "proposedSameAs Con_MealType_Recipe: a recipe has one 'meal' (breakfast…supper) — what PUT /meals sets" .
:Con_Meal_RC dkg:proposedSameAs :Con_Meal ; rdfs:comment "proposedSameAs Con_Meal: glossary 'Meal' — same word, likely the other concept (one word, two concepts, already split on the Meal Plan model)" .
:VP_ManageRecipes a dkg:ValueProposition ; skos:prefLabel "Manage recipes" ;
    dkg:inContext :Ctx_RecipeCatalog ; dkg:source :Art_APC_RecipeCatalog ; dkg:locator "Value propositions, bullet 1" ; dkg:confidence dkg:OnArtifact .
:VP_SearchRecipesByMealIngredientsDiets a dkg:ValueProposition ; skos:prefLabel "Search recipes by meal, ingredients, and diets" ;
    dkg:inContext :Ctx_RecipeCatalog ; dkg:mentions :Con_Meal_RC, :Con_Ingredients_RC, :Con_Diet ;
    dkg:source :Art_APC_RecipeCatalog ; dkg:locator "Value propositions, bullet 2" ; dkg:confidence dkg:OnArtifact .
:VP_SearchRecipesByMealIngredientsDiets dkg:proposedSameAs :VP_EasyToFindRecipes ; rdfs:comment "proposedSameAs VP_EasyToFindRecipes: BMC value proposition 'Easy to find recipes'" .
:VP_SearchRecipesByMealIngredientsDiets dkg:proposedSameAs :VP_RecipesForSpecializedNutritionRequirements ; rdfs:comment "proposedSameAs VP_RecipesForSpecializedNutritionRequirements: BMC — search by diet serves it" .
:Cap_SearchRecipe a dkg:Capability ; skos:prefLabel "Search recipe" ;
