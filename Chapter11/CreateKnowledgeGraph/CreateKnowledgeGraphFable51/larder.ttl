:Q_BlueStickyMeaning a dkg:Question ;
    skos:prefLabel "What does the blue sticky colour on the brainstorm mean?" ;
    rdfs:comment "8 stickies: Larder tracker, Voice control, Historical recipes, Dinner-party planner, Food pairing, Smart kitchen, Allergenes, Fridge-photo recipe generation. Later-added? AI-proposed? Parked?" ;
    dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .

##############################################################################
# INGEST 2 — Impact Map, ImpactMappingWithAiStep3.jpg — 2026-09-10
# Columns GOAL · ACTORS · IMPACT · DELIVERABLES. Deliverables carry a dark-blue
# number (1/2/3) read as a priority; recorded in rdfs:comment, not as votes.
# Two actor stickies and eight impacts and four deliverables are green rather
# than yellow/blue; colour meaning not on the picture. Spellings kept verbatim
# ("dietry", "Propects", "Convertable").
# The actor→impact fan is largely unreadable; only followable lines are
# recorded (Implied). Unrecorded wiring is a Question, not an edge.
##############################################################################

:Art_ImpactMap a dkg:ImpactMap ;
    rdfs:label "Larder impact map (ImpactMappingWithAiStep3.jpg)" ;
    rdfs:comment "1 goal, 9 actors, 14 impacts, 16 deliverables with priority numbers 1–3." ;
    dkg:ingestedAt "2026-09-10"^^xsd:date .

:Goal_LarderPayingMembers a dkg:Goal ;
    skos:prefLabel "Larder - recipe sharing platform with min. 2,500 paying members in two years" ;
    dkg:metric "min. 2,500 paying members in two years" ;
    dkg:mentions :Idea_Larder ;
    dkg:source :Art_ImpactMap ; dkg:locator "GOAL" ; dkg:confidence dkg:OnArtifact .

# --- actors ---
:Act_Single a dkg:Actor ; skos:prefLabel "Single" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 1" ; dkg:confidence dkg:OnArtifact .
:Act_YoungFamily a dkg:Actor ; skos:prefLabel "Young family" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 2" ; dkg:confidence dkg:OnArtifact .
:Act_CookAsAuthor a dkg:Actor ; skos:prefLabel "Cook as author" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 3" ; dkg:confidence dkg:OnArtifact .
:Act_KitchenWareRetailer a dkg:Actor ; skos:prefLabel "Kitchen ware retailer" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 4" ; dkg:confidence dkg:OnArtifact .
:Act_ChefsAsSeniorPartner a dkg:Actor ; skos:prefLabel "Chefs as senior partner" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 5" ; dkg:confidence dkg:OnArtifact .
:Act_GroceryStore a dkg:Actor ; skos:prefLabel "Grocery store" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 6" ; dkg:confidence dkg:OnArtifact .
:Act_PhotoBookService a dkg:Actor ; skos:prefLabel "Photo book service" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 7" ; dkg:confidence dkg:OnArtifact .
:Act_Propects a dkg:Actor ; skos:prefLabel "Propects" ; rdfs:comment "green sticky; diagram spelling, presumably Prospects" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 8" ; dkg:confidence dkg:OnArtifact .
:Act_Convertable a dkg:Actor ; skos:prefLabel "Convertable" ; rdfs:comment "green sticky; diagram spelling" ; dkg:source :Art_ImpactMap ; dkg:locator "ACTORS 9" ; dkg:confidence dkg:OnArtifact .

# --- impacts ---
:Imp_FollowsDietryPlans a dkg:Impact ; skos:prefLabel "follows dietry plans" ; rdfs:comment "green; diagram spelling" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 1" ; dkg:confidence dkg:OnArtifact .
:Imp_ShopEasilyWithDiscount a dkg:Impact ; skos:prefLabel "Shop easily ingredients and tools with discount" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 2" ; dkg:confidence dkg:OnArtifact .
:Imp_UseOfCommunitySharedRecipes a dkg:Impact ; skos:prefLabel "Use of community shared recipes" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 3" ; dkg:confidence dkg:OnArtifact .
:Imp_FindEasilyRecipes a dkg:Impact ; skos:prefLabel "Find easily recipes" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 4" ; dkg:confidence dkg:OnArtifact .
:Imp_SupportsUnexperiencedMembers a dkg:Impact ; skos:prefLabel "supports unexperienced members" ; rdfs:comment "green" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 5" ; dkg:confidence dkg:OnArtifact .
:Imp_UseEffectiveLimitedBudget a dkg:Impact ; skos:prefLabel "Use effective limited budget" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 6" ; dkg:confidence dkg:OnArtifact .
:Imp_LearnCooking a dkg:Impact ; skos:prefLabel "Learn cooking" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 7" ; dkg:confidence dkg:OnArtifact .
:Imp_PublishTheirOwnCookbook a dkg:Impact ; skos:prefLabel "Publish their own cookbook" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 8" ; dkg:confidence dkg:OnArtifact .
:Imp_CookbooksMakeCurious a dkg:Impact ; skos:prefLabel "Cookbooks make curious" ; rdfs:comment "green" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 9" ; dkg:confidence dkg:OnArtifact .
:Imp_FollowCooks a dkg:Impact ; skos:prefLabel "Follow cooks" ; rdfs:comment "green" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 10" ; dkg:confidence dkg:OnArtifact .
:Imp_ConvertToPaidPlan a dkg:Impact ; skos:prefLabel "convert to paid plan" ; rdfs:comment "green" ; dkg:impactedActor :Act_Propects ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 11" ; dkg:confidence dkg:OnArtifact .
:Imp_PaidMemberRenews a dkg:Impact ; skos:prefLabel "paid member renews" ; rdfs:comment "green" ; dkg:impactedActor :Act_Convertable ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 12" ; dkg:confidence dkg:OnArtifact .
:Imp_SeePremiumContent a dkg:Impact ; skos:prefLabel "see premium content" ; rdfs:comment "green" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 13" ; dkg:confidence dkg:OnArtifact .
:Imp_PayForAds a dkg:Impact ; skos:prefLabel "pay for ads" ; rdfs:comment "green" ; dkg:towardsGoal :Goal_LarderPayingMembers ; dkg:source :Art_ImpactMap ; dkg:locator "IMPACT 14" ; dkg:confidence dkg:OnArtifact .

# actor→impact edges that could be followed (Implied — read off a crossing bundle)
:Imp_PublishTheirOwnCookbook dkg:impactedActor :Act_CookAsAuthor .
:Imp_ShopEasilyWithDiscount dkg:impactedActor :Act_Single, :Act_YoungFamily .
:Imp_FollowsDietryPlans dkg:impactedActor :Act_Single, :Act_YoungFamily .
:Imp_PayForAds dkg:impactedActor :Act_KitchenWareRetailer, :Act_GroceryStore, :Act_PhotoBookService .

# --- deliverables (priority number in comment) ---
:Del_NutritionRequirementManagement a dkg:Deliverable ; skos:prefLabel "Nutrition requirement management" ; rdfs:comment "priority 1; green" ; dkg:realises :Imp_FollowsDietryPlans ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 1" ; dkg:confidence dkg:OnArtifact .
:Del_DirectOrdering a dkg:Deliverable ; skos:prefLabel "Direct ordering" ; rdfs:comment "priority 1" ; dkg:realises :Imp_ShopEasilyWithDiscount ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 2" ; dkg:confidence dkg:OnArtifact .
:Del_KitchenToolOrdering a dkg:Deliverable ; skos:prefLabel "Kitchen tool ordering" ; rdfs:comment "priority 2" ; dkg:realises :Imp_ShopEasilyWithDiscount ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 3" ; dkg:confidence dkg:OnArtifact .
:Del_CookingClub a dkg:Deliverable ; skos:prefLabel "Cooking club" ; rdfs:comment "priority 2" ; dkg:realises :Imp_UseOfCommunitySharedRecipes ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 4" ; dkg:confidence dkg:OnArtifact .
:Del_Content a dkg:Deliverable ; skos:prefLabel "Content" ; rdfs:comment "priority 1" ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 5" ; dkg:confidence dkg:OnArtifact .
:Del_Rating a dkg:Deliverable ; skos:prefLabel "Rating" ; rdfs:comment "priority 1" ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 6" ; dkg:confidence dkg:OnArtifact .
:Del_MealChooser a dkg:Deliverable ; skos:prefLabel "Meal Chooser" ; rdfs:comment "priority 2" ; dkg:realises :Imp_UseEffectiveLimitedBudget ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 7" ; dkg:confidence dkg:OnArtifact .
:Del_AIProposals a dkg:Deliverable ; skos:prefLabel "AI proposals" ; rdfs:comment "priority 2" ; dkg:realises :Imp_UseEffectiveLimitedBudget ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 8" ; dkg:confidence dkg:OnArtifact .
:Del_Timer a dkg:Deliverable ; skos:prefLabel "Timer" ; rdfs:comment "priority 3" ; dkg:realises :Imp_LearnCooking ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 9" ; dkg:confidence dkg:OnArtifact .
:Del_GrandmaGrandpaAI a dkg:Deliverable ; skos:prefLabel "Grandma / Grandpa AI" ; rdfs:comment "priority 3" ; dkg:realises :Imp_LearnCooking, :Imp_SupportsUnexperiencedMembers ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 10" ; dkg:confidence dkg:OnArtifact .
:Del_Planner a dkg:Deliverable ; skos:prefLabel "Planner" ; rdfs:comment "priority 1" ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 11" ; dkg:confidence dkg:OnArtifact .
:Del_FamousChefsPartner a dkg:Deliverable ; skos:prefLabel "Famous chefs partner" ; rdfs:comment "priority 2" ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 12" ; dkg:confidence dkg:OnArtifact .
:Del_CookbookPublishing a dkg:Deliverable ; skos:prefLabel "Cookbook publishing" ; rdfs:comment "priority 1" ; dkg:realises :Imp_PublishTheirOwnCookbook ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 13" ; dkg:confidence dkg:OnArtifact .
:Del_MemberManagement a dkg:Deliverable ; skos:prefLabel "Member management" ; rdfs:comment "priority 1; green" ; dkg:realises :Imp_ConvertToPaidPlan, :Imp_PaidMemberRenews ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 14" ; dkg:confidence dkg:OnArtifact .
:Del_PaywallForPremiumContent a dkg:Deliverable ; skos:prefLabel "Paywall for premium content" ; rdfs:comment "priority 1; green" ; dkg:realises :Imp_SeePremiumContent ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 15" ; dkg:confidence dkg:OnArtifact .
:Del_AdsManagement a dkg:Deliverable ; skos:prefLabel "Ads management" ; rdfs:comment "priority 1; green" ; dkg:realises :Imp_PayForAds ; dkg:source :Art_ImpactMap ; dkg:locator "DELIVERABLES 16" ; dkg:confidence dkg:OnArtifact .

:Q_ImpactMapWiring a dkg:Question ;
    skos:prefLabel "Which impacts hang off Single, Young family, Chefs as senior partner, Grocery store, Photo book service — and which impacts do Content, Rating, Planner, Famous chefs partner realise?" ;
    rdfs:comment "The line bundle between ACTORS and IMPACT, and into Content/Rating/Planner/Famous chefs partner, is not followable on the photo. Only clearly traceable lines were recorded." ;
    dkg:source :Art_ImpactMap ; dkg:confidence dkg:OnArtifact .

# --- merge ledger edges (Idea → Deliverable, proposed only) ---
:Idea_CookingClub dkg:proposedSameAs :Del_CookingClub ; rdfs:comment "brainstorm 'Cooking Club' / impact-map 'Cooking club'; case differs" .
:Idea_Timer dkg:proposedSameAs :Del_Timer ; rdfs:comment "identical label, Idea vs Deliverable" .
:Idea_MealChooser dkg:proposedSameAs :Del_MealChooser ; rdfs:comment "identical label, Idea vs Deliverable" .
:Idea_CookbookPublishing dkg:proposedSameAs :Del_CookbookPublishing ; rdfs:comment "identical label, Idea vs Deliverable" .
:Idea_Rating dkg:proposedSameAs :Del_Rating ; rdfs:comment "identical label, Idea vs Deliverable" .
:Idea_DietaryRequirements dkg:proposedSameAs :Del_NutritionRequirementManagement ; rdfs:comment "'Dietary requirements' sticky vs 'Nutrition requirement management' deliverable" .
:Idea_OrderIngredientsDirectly dkg:proposedSameAs :Del_DirectOrdering ; rdfs:comment "'Order ingredients directly' vs 'Direct ordering'" .
:Idea_KitchenTools dkg:proposedSameAs :Del_KitchenToolOrdering ; rdfs:comment "'Kitchen tools' (Shopping) vs 'Kitchen tool ordering'" .
:Idea_FamousChefsAsPartner dkg:proposedSameAs :Del_FamousChefsPartner, :Act_ChefsAsSeniorPartner ; rdfs:comment "one sticky became a deliverable AND an actor on the impact map" .
:Idea_AskGrandma dkg:proposedSameAs :Del_GrandmaGrandpaAI ; rdfs:comment "'Ask grandma' / 'Grandpa shows how to do it' vs 'Grandma / Grandpa AI'; the brainstorm never says AI" .
:Idea_GrandpaShowsHowToDoIt dkg:proposedSameAs :Del_GrandmaGrandpaAI .
:Idea_DinnerPartyPlanner dkg:proposedSameAs :Del_Planner ; rdfs:comment "brainstorm cluster 'Planner' + sticky 'Dinner-party planner' vs deliverable 'Planner'" .
:Idea_Budget dkg:proposedSameAs :Imp_UseEffectiveLimitedBudget ; rdfs:comment "an Idea that resurfaced as an Impact, not a deliverable" .
:Idea_CookingSkillLearning dkg:proposedSameAs :Imp_LearnCooking ; rdfs:comment "an Idea that resurfaced as an Impact" .
:Idea_Followers dkg:proposedSameAs :Imp_FollowCooks ; rdfs:comment "an Idea that resurfaced as an Impact" .

##############################################################################
# INGEST 3 — Wardley Map, WardleyMapEvolution.jpg — 2026-09-10
# Four users at the top, seven needs beneath, 24 components on the chain.
# Axis: Genesis | Custom | Product (+rental) | Commodity (+utility).
# Sketched, not measured: no dkg:visibility. No movement arrows drawn.
# Components on or within a sticky-width of a stage line get dkg:Inferred.
# The user→need and need→component fans are partly unreadable; recorded
# where a single line is followable, otherwise in Q_WardleyWiring.
##############################################################################

:Art_Wardley a dkg:WardleyMap ;
    rdfs:label "Larder Wardley map (WardleyMapEvolution.jpg)" ;
    rdfs:comment "4 users, 7 needs, 24 components. No movement arrows, no inertia marks, no pipelines." ;
    dkg:ingestedAt "2026-09-10"^^xsd:date .

# --- users (anchors) ---
:Act_YoungFamilies a dkg:Actor ; skos:prefLabel "Young families" ; dkg:source :Art_Wardley ; dkg:locator "top row 1" ; dkg:confidence dkg:OnArtifact .
:Act_Singles a dkg:Actor ; skos:prefLabel "Singles" ; dkg:source :Art_Wardley ; dkg:locator "top row 2" ; dkg:confidence dkg:OnArtifact .
:Act_HomeCook a dkg:Actor ; skos:prefLabel "Home cook" ; dkg:source :Art_Wardley ; dkg:locator "top row 3" ; dkg:confidence dkg:OnArtifact .
:Act_Prospect a dkg:Actor ; skos:prefLabel "Prospect" ; dkg:source :Art_Wardley ; dkg:locator "top row 4" ; dkg:confidence dkg:OnArtifact .

# --- needs ---
:Goal_BetterCookingSkills a dkg:UserNeed ; skos:prefLabel "Better cooking skills" ; dkg:source :Art_Wardley ; dkg:locator "need 1" ; dkg:confidence dkg:OnArtifact .
:Goal_EfficientUsageOfGroceries a dkg:UserNeed ; skos:prefLabel "Efficient usage of groceries" ; dkg:source :Art_Wardley ; dkg:locator "need 2" ; dkg:confidence dkg:OnArtifact .
:Goal_CreateContent a dkg:UserNeed ; skos:prefLabel "Create content" ; dkg:source :Art_Wardley ; dkg:locator "need 3" ; dkg:confidence dkg:OnArtifact .
:Goal_RateContent a dkg:UserNeed ; skos:prefLabel "Rate content" ; dkg:source :Art_Wardley ; dkg:locator "need 4" ; dkg:confidence dkg:OnArtifact .
:Goal_SearchRecipesWithNutritionMeals a dkg:UserNeed ; skos:prefLabel "Search recipes with nutrition, meals, ..." ; dkg:source :Art_Wardley ; dkg:locator "need 5" ; dkg:confidence dkg:OnArtifact .
:Goal_SupportCooking a dkg:UserNeed ; skos:prefLabel "Support cooking" ; dkg:source :Art_Wardley ; dkg:locator "need 6" ; dkg:confidence dkg:OnArtifact .
:Goal_BecomeAMember a dkg:UserNeed ; skos:prefLabel "Become a member" ; dkg:source :Art_Wardley ; dkg:locator "need 7" ; dkg:confidence dkg:OnArtifact .

:Act_Prospect dkg:dependsOn :Goal_BecomeAMember .

# --- components, visible row ---
:Cap_AskGrandmaGrandpa a dkg:Component ; skos:prefLabel "Ask Grandma / Grandpa" ; dkg:evolution dkg:CustomBuilt ; rdfs:comment "sits on the Custom line; stage Inferred" ; dkg:supports :Goal_BetterCookingSkills ; dkg:dependsOn :Cap_SpecificAI ; dkg:source :Art_Wardley ; dkg:locator "visible row 1" ; dkg:confidence dkg:Inferred .
:Cap_AskChef a dkg:Component ; skos:prefLabel "Ask chef" ; dkg:evolution dkg:CustomBuilt ; dkg:supports :Goal_BetterCookingSkills ; dkg:dependsOn :Cap_RemoteMeeting, :Cap_Chat ; dkg:source :Art_Wardley ; dkg:locator "visible row 2" ; dkg:confidence dkg:OnArtifact .
:Cap_Competitions a dkg:Component ; skos:prefLabel "Competitions" ; dkg:evolution dkg:CustomBuilt ; dkg:supports :Goal_BetterCookingSkills ; dkg:dependsOn :Cap_RemoteMeeting, :Cap_Chat ; dkg:source :Art_Wardley ; dkg:locator "visible row 3" ; dkg:confidence dkg:OnArtifact .
:Cap_AskCommunity a dkg:Component ; skos:prefLabel "Ask community" ; dkg:evolution dkg:CustomBuilt ; rdfs:comment "touches the Product line; stage Inferred" ; dkg:supports :Goal_BetterCookingSkills ; dkg:dependsOn :Cap_RemoteMeeting, :Cap_Chat ; dkg:source :Art_Wardley ; dkg:locator "visible row 4" ; dkg:confidence dkg:Inferred .
:Cap_Refrigerator a dkg:Component ; skos:prefLabel "Refrigerator" ; dkg:evolution dkg:Product ; dkg:supports :Goal_EfficientUsageOfGroceries ; dkg:dependsOn :Cap_RecipeDatabase ; dkg:source :Art_Wardley ; dkg:locator "visible row 5" ; dkg:confidence dkg:OnArtifact .
:Cap_Nutrition a dkg:Component ; skos:prefLabel "Nutrition" ; dkg:evolution dkg:Product ; dkg:supports :Goal_SearchRecipesWithNutritionMeals ; dkg:dependsOn :Cap_RecipeDatabase ; dkg:source :Art_Wardley ; dkg:locator "visible row 6" ; dkg:confidence dkg:OnArtifact .
:Cap_Meal a dkg:Component ; skos:prefLabel "Meal" ; dkg:evolution dkg:Product ; dkg:supports :Goal_SearchRecipesWithNutritionMeals ; dkg:dependsOn :Cap_RecipeDatabase ; dkg:source :Art_Wardley ; dkg:locator "visible row 7" ; dkg:confidence dkg:OnArtifact .
:Cap_WriteRecipe a dkg:Component ; skos:prefLabel "Write recipe" ; dkg:evolution dkg:Commodity ; rdfs:comment "sits on the Commodity line; stage Inferred" ; dkg:supports :Goal_CreateContent ; dkg:dependsOn :Cap_RecipeDatabase ; dkg:source :Art_Wardley ; dkg:locator "visible row 8" ; dkg:confidence dkg:Inferred .
:Cap_UploadMedia a dkg:Component ; skos:prefLabel "Upload media" ; dkg:evolution dkg:Commodity ; dkg:supports :Goal_CreateContent ; dkg:dependsOn :Cap_MediaStorage ; dkg:source :Art_Wardley ; dkg:locator "visible row 9" ; dkg:confidence dkg:OnArtifact .
:Cap_Timer a dkg:Component ; skos:prefLabel "Timer" ; dkg:evolution dkg:Commodity ; dkg:supports :Goal_SupportCooking ; dkg:dependsOn :Cap_Mobile ; dkg:source :Art_Wardley ; dkg:locator "visible row 10" ; dkg:confidence dkg:OnArtifact .
:Cap_FreeHandControl a dkg:Component ; skos:prefLabel "Free hand control" ; dkg:evolution dkg:Commodity ; dkg:supports :Goal_SupportCooking ; dkg:dependsOn :Cap_Mobile ; dkg:source :Art_Wardley ; dkg:locator "visible row 11" ; dkg:confidence dkg:OnArtifact .
:Cap_MemberManagement a dkg:Component ; skos:prefLabel "Member Management" ; dkg:evolution dkg:Commodity ; dkg:supports :Goal_BecomeAMember ; dkg:dependsOn :Cap_IDM ; dkg:source :Art_Wardley ; dkg:locator "visible row 12" ; dkg:confidence dkg:OnArtifact .

# --- middle rows ---
:Cap_AdvancedSearch a dkg:Component ; skos:prefLabel "Advanced Search" ; dkg:evolution dkg:CustomBuilt ; dkg:supports :Goal_SearchRecipesWithNutritionMeals ; dkg:dependsOn :Cap_SpecificAI, :Cap_RecipeDatabase ; dkg:source :Art_Wardley ; dkg:locator "row 2" ; dkg:confidence dkg:OnArtifact .
:Cap_RateContent a dkg:Component ; skos:prefLabel "Rate content" ; dkg:evolution dkg:Product ; dkg:supports :Goal_RateContent ; dkg:dependsOn :Cap_RatingDatabase ; dkg:source :Art_Wardley ; dkg:locator "row 2" ; dkg:confidence dkg:OnArtifact .
