:Art_Glossary_Notification a dkg:VisualGlossary ;
    rdfs:label "Notification model — aggregate and value objects (image 3)" ;
    rdfs:comment "Aggregate Notification contains notification Id 1, Receiver 1..*, title 1, text 1, link 1, status 1 (values NEW, READ). 1 invariant on Receiver. Link example https://larder.org/cook-assistance/help-requests/23a8eeed-… uses the Help Request model's help request Id example and a 'cook-assistance' path (the sync canvas server says 'cooking-assistance')." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Con_Notification a dkg:AggregateRoot ; dkg:source :Art_Glossary_Notification ; dkg:locator "dark yellow box 'Notification'" ;
    rdfs:comment "Auto-merged: model aggregate 'Notification' = existing 'Notification' (exact)." .
