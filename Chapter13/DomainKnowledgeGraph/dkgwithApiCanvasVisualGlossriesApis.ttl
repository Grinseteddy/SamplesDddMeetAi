:As_VG_ThanksPicturesCardinality a dkg:Assertion ;
    rdf:subject :Rel_Thanks_Pictures ; rdf:predicate dkg:contradicts ; rdf:object :Rel_ThanksContainsPicture_v2 ;
    rdfs:comment "Thanks aggregate: 'Thanks contains 1 pictures' (mandatory, one). Visual Glossary Enhanced: 'Thanks contains 0..10 Picture' (optional, up to ten)." ;
