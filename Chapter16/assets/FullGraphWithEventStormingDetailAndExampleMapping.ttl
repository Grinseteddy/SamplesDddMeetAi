##############################################################################
# Ingest — EventStorming DETAIL board 'Cooking Assistance: help with a meal plan'
# (EventStormingDetail.jpg), 2026-10-27. GROW. Overlap vs board v1 / v2:
# share 28%, cover 14% → new artifact (process-level board of one context),
# not a revision of the big-picture boards.
# Colour convention as read (no legend on the board):
#   yellow + person = actor · blue + ⌘ = command · pale yellow + briefcase =
#   business object · orange + fan = event · green + eye = read model ·
#   grey + monitor = UI / screen · pink + gear = external system ·
#   lilac + shield = rule / invariant (Implied — the shield is unexplained) ·
#   large pink, no icon = hotspot (Implied).
# Lanes: Recipe Catalog and Notification (top), Cooking Assistance (main).
# Two rows in Cooking Assistance: request → provide (top), cancel (bottom).
# Sequence numbers below are this board's own (1 Help requested, 2 Cook
# notified, 3 Help provided, 4 Help request cancelled); merged events keep
# their big-board numbers and get a locator only.
##############################################################################
:Art_ESDetail_CookingAssistance_2026_10 a dkg:EventStormingBoard ;
    rdfs:label "Cooking Assistance — EventStorming detail board: help with a meal plan (EventStormingDetail.jpg)" ;
    rdfs:comment "Process-level board of one context. 4 events, 3 commands, 3 actors (Cook drawn twice), 1 external system, 2 business objects (one drawn twice), 3 read models (one drawn twice), 2 UI stickies, 11 lilac shield stickies, 1 hotspot. Only the meal-plan kind of help is on it; substitutes, step explanation and catastrophe are not. No legend; no policy, aggregate or state stickies except 'Help REQUESTED' (lilac, shield)." ;
    dkg:ingestedAt "2026-10-27"^^xsd:date .

# --- Lanes (existing contexts, enriched) ---
:Ctx_CookingAssistance dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: main lane, label bottom right" .
:Ctx_RecipeCatalog dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: top-left lane" .
:Ctx_Notification dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: top lane" .

# --- Actors and external system (auto-merged) ---
:Act_Cook_DS dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: actor left of 'Request help meal plan'; actor above 'Provide Help'" ;
    rdfs:comment "Auto-merged: detail board actor 'Cook' (drawn twice — once as requester, once beside Chef as a provider) = story/board actor 'Cook'. Board v1 named the providing cook 'Community Cook'." .
:Act_Chef dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: actor above 'Provide Help'" ;
    rdfs:comment "Auto-merged: detail board actor 'Chef' = story A / board actor 'Chef' (exact)." .
:Act_GrandmaAvatar dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: pink gear sticky 'Grand ma Avatar' below 'Help Meal plan'" ;
    rdfs:comment "Auto-merged: detail board pink+gear 'Grandma Avatar' = existing external system (exact; written across three lines)." .

# --- Commands ---
:Cmd_RequestHelpMealPlan a dkg:Command ; skos:prefLabel "Request help meal plan" ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 1, blue ⌘" ; dkg:confidence dkg:OnArtifact .
:Cmd_RequestHelpMealPlan dkg:performedBy :Act_Cook_DS ; dkg:produces :Con_HelpRequestMealPlan ; dkg:triggers :Ev_HelpRequested .
:Cmd_RequestHelpMealPlan dkg:proposedSameAs :Cmd_RequestHelp ; rdfs:comment "proposedSameAs Cmd_RequestHelp: the big board's 'Request help', narrowed here to the meal-plan kind" .
:Cmd_RequestHelpMealPlan dkg:proposedSameAs :Msg_APC_CAS_02 ; rdfs:comment "proposedSameAs Msg_APC_CAS_02: POST /help-requests on the sync canvas (cross-class)" .

:Cmd_ProvideHelp dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 1, blue ⌘ 'Provide Help'" ;
    rdfs:comment "Auto-merged: detail board 'Provide Help' = big-board command 'Provide help' (case-folded)." .
:Cmd_ProvideHelp dkg:performedBy :Act_Cook_DS, :Act_Chef, :Act_GrandmaAvatar ;
    dkg:reads :Con_HelpRequestMealPlan_RM ; dkg:produces :Con_HelpMealPlan_ESD ; dkg:triggers :Ev_HelpProvided .

:Cmd_CancelHelpRequest a dkg:Command ; skos:prefLabel "Cancel help request" ;
    rdfs:comment "No actor drawn on this row. The two shield stickies beside it name two candidates: the Cook and the System." ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 2, blue ⌘" ; dkg:confidence dkg:OnArtifact .
:Cmd_CancelHelpRequest dkg:produces :Con_HelpRequestMealPlan ; dkg:triggers :Ev_HelpRequestCancelled .
:Cmd_CancelHelpRequest dkg:proposedSameAs :Msg_APC_CAS_05 ; rdfs:comment "proposedSameAs Msg_APC_CAS_05: DELETE /help-requests/{helpRequestId} on the sync canvas (cross-class)" .

# --- Events ---
:Ev_HelpRequested dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: event 1 (row 1, Cooking Assistance)" ;
    rdfs:comment "Auto-merged: detail board 'Help requested' = board/map/canvas event (exact)." .
:Ev_HelpRequested dkg:hasState "Help REQUESTED" .
:As_State_HelpRequested_ESD a dkg:Assertion ; rdf:subject :Ev_HelpRequested ; rdf:predicate dkg:hasState ; rdf:object "Help REQUESTED" ;
    rdfs:comment "Detail board: 'Help REQUESTED' in the capitals board v2 used for state stickies, but drawn lilac with a shield like the rules around it — read as a state, not certain." ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:confidence dkg:Implied .
:Ev_CookNotified a dkg:DomainEvent ; skos:prefLabel "Cook notified" ;
    dkg:sequence 2 ; dkg:inContext :Ctx_Notification ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: event 2 (Notification lane), arrow from 'Help requested'" ; dkg:confidence dkg:OnArtifact .
:Ev_HelpProvided dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: event 3 (row 1, Cooking Assistance)" ;
    rdfs:comment "Auto-merged: detail board 'Help provided' = board/map/canvas event (exact). No arrow to Notification on this board." .
:Ev_HelpRequestCancelled a dkg:DomainEvent ; skos:prefLabel "Help request cancelled" ;
    dkg:sequence 4 ; dkg:inContext :Ctx_CookingAssistance ;
    rdfs:comment "Alternative to 'Help provided' (row 2). No state sticky; the Help Request model's status values (Open, Answered, Closed) have no 'Cancelled'." ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: event 4 (row 2)" ; dkg:confidence dkg:OnArtifact .
:Ev_HelpRequested dkg:precedes :Ev_CookNotified, :Ev_HelpProvided, :Ev_HelpRequestCancelled .

# --- Business objects ---
:Con_HelpRequestMealPlan a dkg:BusinessObject ; skos:prefLabel "Help request Meal plan" ;
    rdfs:comment "drawn twice: produced by 'Request help meal plan' and by 'Cancel help request'" ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 1 and row 2, pale yellow briefcase" ; dkg:confidence dkg:OnArtifact .
:Con_HelpMealPlan_ESD a dkg:BusinessObject ; skos:prefLabel "Help Meal plan" ;
    rdfs:comment "What 'Provide Help' produces — the answer. Split from glossary v2's 'Help Meal plan', which is a kind of Help Request (one word, two concepts)." ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 1, pale yellow briefcase after 'Provide Help'" ; dkg:confidence dkg:OnArtifact .

# --- Read models ---
:Con_Recipe dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: Recipe Catalog lane, green eye 'Recipe'" ;
    rdfs:comment "Auto-merged: detail board read model 'Recipe' (Recipe Catalog lane) = 'Recipe' (exact; already a ReadModel and in Recipe Catalog)." .
:Con_HelpRequestMealPlan_RM a dkg:ReadModel ; skos:prefLabel "Help request Meal plan" ;
    rdfs:comment "read model (green); drawn twice, after 'Help requested' and after 'Help request cancelled'" ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 1 and row 2, green eye" ; dkg:confidence dkg:OnArtifact .
:Con_HelpMealPlan_RM a dkg:ReadModel ; skos:prefLabel "Help Meal plan" ;
    rdfs:comment "read model (green) after 'Help provided'" ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 1, green eye after 'Help provided'" ; dkg:confidence dkg:OnArtifact .

# --- UI stickies (dkg has no UI class; typed as Concept) ---
:UI_ShowHelpRequest a dkg:Concept ; skos:prefLabel "Show help request" ;
    rdfs:comment "UI / screen sticky (grey, monitor icon); shows read model 'Help request Meal plan' to Cook and Chef" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_HelpRequestMealPlan_RM ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 1, grey monitor" ; dkg:confidence dkg:OnArtifact .
:UI_ShowHelp a dkg:Concept ; skos:prefLabel "Show help" ;
    rdfs:comment "UI / screen sticky (grey, monitor icon); shows read model 'Help Meal plan'" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_HelpMealPlan_RM ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 1, far right, grey monitor" ; dkg:confidence dkg:OnArtifact .

# --- Arrows that cross lanes ---
:Msg_ESD_RecipeToHelpRequest a dkg:Message ; skos:prefLabel "Recipe Catalog → Cooking Assistance: Recipe" ;
    dkg:from :Ctx_RecipeCatalog ; dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ; dkg:carries "Recipe" ;
    dkg:mentions :Con_Recipe, :Con_HelpRequestMealPlan ;
    rdfs:comment "arrow from read model 'Recipe' into business object 'Help request Meal plan'. Context maps v1–v3 draw no Recipe Catalog → Cooking Assistance arrow; recipes reach Cooking Assistance only via Meal Planning / Meal Preparation POSTs." ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "curved arrow across the top lane border" ; dkg:confidence dkg:OnArtifact .
:Msg_ESD_HelpRequestedToNotification a dkg:Message ; skos:prefLabel "Cooking Assistance → Notification: Help requested" ;
    dkg:from :Ctx_CookingAssistance ; dkg:to :Ctx_Notification ; dkg:messageKind "?" ; dkg:carries "Help requested → Cook notified" ;
    dkg:mentions :Ev_HelpRequested, :Ev_CookNotified ;
    rdfs:comment "straight arrow from event 'Help requested' up to event 'Cook notified'. Agrees with context map v2/v3 (async, CF at Notification) and the Notifications canvases." ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "vertical arrow across the top lane border" ; dkg:confidence dkg:OnArtifact .

# --- Rules (lilac + shield) ---
:R_ESD_ChefNeedsToBeSelected a dkg:Rule ; skos:prefLabel "Chef needs to be selected" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Chef, :Con_PreferredProvider ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky row 1, 2nd" ; dkg:confidence dkg:Implied .
:R_ESD_OnlyPremiumAskChef a dkg:Rule ; skos:prefLabel "Only premium users allowed to ask Chef" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Chef, :Con_Premium_SubscriptionTier ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky row 1, 3rd" ; dkg:confidence dkg:Implied .
:R_ESD_ChefOnlyWhenPremium a dkg:Rule ; skos:prefLabel "Chef can only be asked when cook is premium user." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Chef, :Con_Premium_SubscriptionTier ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky row 1, 4th" ; dkg:confidence dkg:Implied .
:R_ESD_ChefOnlyWhenPremium dkg:proposedSameAs :R_ESD_OnlyPremiumAskChef ; rdfs:comment "proposedSameAs R_ESD_OnlyPremiumAskChef: the same rule written twice side by side on one board" .
:R_ESD_ChefReviewsGrandmaPlan a dkg:Rule ; skos:prefLabel "Chef can review a dinner plan of Grandma Avartar." ;
    rdfs:comment "'Avartar' as written" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Chef, :Act_GrandmaAvatar, :Con_HelpMealPlan_ESD ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky below 'Help REQUESTED'" ; dkg:confidence dkg:Implied .
:R_ESD_ChefReviewsGrandmaPlan dkg:contradicts :R_HR_ChefHelpExclusive ;
    rdfs:comment "contradicts R_HR_ChefHelpExclusive IF 'exclusively' means Chef is the sole provider — the reading both Cooking Assistance contracts and the Grandma Avatar AsyncAPI took. A Chef reviewing the Avatar's plan puts two providers on one meal-plan request." .
:R_ESD_HelpMealPlanProviders a dkg:Rule ; skos:prefLabel "Help Meal plan can be provided by Chef, community, or Grandma" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_HelpMealPlan_ESD, :Act_Chef, :Act_Community, :Act_GrandmaAvatar ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky right, 1st" ; dkg:confidence dkg:Implied .
:R_ESD_CookCannotAnswerOwn a dkg:Rule ; skos:prefLabel "Cook cannot answer their own request" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Cook_DS, :Con_HelpRequestMealPlan ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky right, 2nd" ; dkg:confidence dkg:Implied .
:R_ESD_CookCannotAnswerOwn dkg:contradicts :R_H_CookCanAnswerOwnExceptChef ;
    rdfs:comment "Detail board: 'Cook cannot answer their own request'. Help model: 'A cook can answer their own request - except for Chef requests'." .
:R_ESD_CookCanAcceptAnswer a dkg:Rule ; skos:prefLabel "Cook can accept the answer" ;
    rdfs:comment "No accept command or event on the board." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Cook_DS, :Con_HelpMealPlan_ESD, :Con_IsAccepted ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky right, 3rd" ; dkg:confidence dkg:Implied .
:R_ESD_CookCanAcceptAnswer dkg:proposedSameAs :R_HR2_AtLeastOneHelpAccepted ; rdfs:comment "proposedSameAs R_HR2_AtLeastOneHelpAccepted: Help Request v2 needs an accepted Help; the Help model has isAccepted" .
:R_ESD_SystemCancelsOnTimeout a dkg:Rule ; skos:prefLabel "System cancels request when answer takes too long" ;
    rdfs:comment "reads like a policy (whenever an answer is late → Cancel help request), but drawn as a shield sticky, not a policy" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Cmd_CancelHelpRequest ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky row 2, 1st" ; dkg:confidence dkg:Implied .
:R_ESD_CookCanCancelOnTimeout a dkg:Rule ; skos:prefLabel "Cook can cancel their request when answer takes too long" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Cook_DS, :Cmd_CancelHelpRequest ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: shield sticky row 2, 2nd" ; dkg:confidence dkg:Implied .
:R_ESD_CookCanCancelOnTimeout dkg:proposedSameAs :R_OnlyInStatusOpen ; rdfs:comment "proposedSameAs R_OnlyInStatusOpen: sync canvas allows DELETE only while open; the board adds a timeout condition, not a status" .
:R_ESD_HelpMealPlanProviders dkg:proposedSameAs :R_HR_ChefSupportOnlyForMenuProposal ; rdfs:comment "proposedSameAs R_HR_ChefSupportOnlyForMenuProposal: both tie Chef to the meal-plan / menu-proposal kind" .

# --- Hotspot ---
:HS_ESD_DefineTimeouts a dkg:Hotspot ; skos:prefLabel "Define timeouts" ;
    rdfs:comment "large pink sticky, no icon — read as a hotspot. Both cancel rules depend on 'too long', which no artifact defines." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :R_ESD_SystemCancelsOnTimeout, :R_ESD_CookCanCancelOnTimeout ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "detail board: row 2, right of the cancel rules" ; dkg:confidence dkg:Implied .
:Art_ESDetail_CookingAssistance_2026_10 dkg:raises :HS_ESD_DefineTimeouts .

# --- Merge ledger: proposals ---
:Con_HelpMealPlan_ESD dkg:proposedSameAs :Con_HelpMealPlan ;
    rdfs:comment "proposedSameAs Con_HelpMealPlan: SAME LABEL, NOT MERGED. Glossary v2 'Help Meal plan' is a kind of Help Request (the question); on this board it is what Provide Help produces (the answer). One word, two concepts." .
:Con_HelpMealPlan_ESD dkg:proposedSameAs :Con_MenuProposal ; rdfs:comment "proposedSameAs Con_MenuProposal: the Help model's answer body for a meal plan is 'menu proposal'" .
:Con_HelpMealPlan_ESD dkg:proposedSameAs :Con_Help ; rdfs:comment "proposedSameAs Con_Help: the Help aggregate, narrowed to answerType Menu proposal" .
:Con_HelpRequestMealPlan dkg:proposedSameAs :Con_HelpMealPlan ; rdfs:comment "proposedSameAs Con_HelpMealPlan: glossary v2 'Help Meal plan' is the meal-plan kind of Help Request — this board calls that 'Help request Meal plan'" .
:Con_HelpRequestMealPlan dkg:proposedSameAs :Con_HelpRequest ; rdfs:comment "proposedSameAs Con_HelpRequest: the Help Request aggregate with type Menu proposal" .
:Con_HelpRequestMealPlan_RM dkg:proposedSameAs :Con_HelpRequestMealPlan ; rdfs:comment "proposedSameAs Con_HelpRequestMealPlan: same label, read model vs business object on this board" .
:Con_HelpRequestMealPlan_RM dkg:proposedSameAs :Con_HelpRequest_RM ; rdfs:comment "proposedSameAs Con_HelpRequest_RM: big board read model 'Help request'" .
:Con_HelpMealPlan_RM dkg:proposedSameAs :Con_HelpMealPlan_ESD ; rdfs:comment "proposedSameAs Con_HelpMealPlan_ESD: same label, read model vs business object on this board" .
:Con_HelpMealPlan_RM dkg:proposedSameAs :Con_HelpResponse_RM ; rdfs:comment "proposedSameAs Con_HelpResponse_RM: big board read model 'Help response'" .
:Ev_CookNotified dkg:proposedSameAs :Con_Notification ; rdfs:comment "proposedSameAs Con_Notification: event vs the Notification aggregate it presumably creates (cross-class)" .
:Ev_HelpRequestCancelled dkg:proposedSameAs :Msg_APC_CAS_05 ; rdfs:comment "proposedSameAs Msg_APC_CAS_05: DELETE /help-requests — the canvas deletes, the board cancels (cross-class)" .
:UI_ShowHelp dkg:proposedSameAs :Msg_APC_CAS_08 ; rdfs:comment "proposedSameAs Msg_APC_CAS_08: GET /helps/{helpId} (cross-class)" .
:UI_ShowHelpRequest dkg:proposedSameAs :Msg_APC_CAS_03 ; rdfs:comment "proposedSameAs Msg_APC_CAS_03: GET /help-requests/{helpRequestId} (cross-class)" .

# --- Questions this board raises ---
:Q_ESD_CookNotifiedWho a dkg:Question ; skos:prefLabel "Which cook is notified when help is requested?" ;
    rdfs:comment "Detail board: 'Help requested' → 'Cook notified'. Notification model v1/v2: 'Help requests go to whole community or Chef' (audience single / community). The requester, a community cook, or every cook? And why no notification on 'Help provided', which the Notifications canvases receive?" ;
    dkg:inContext :Ctx_Notification ; dkg:mentions :Ev_CookNotified, :R_HelpRequestsGoToCommunityOrChef ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "Notification lane" ; dkg:confidence dkg:Implied .
:Art_ESDetail_CookingAssistance_2026_10 dkg:raises :Q_ESD_CookNotifiedWho .
:Q_ESD_CancelActor a dkg:Question ; skos:prefLabel "Who cancels a help request — the Cook, the System, or both?" ;
    rdfs:comment "'Cancel help request' has no actor; one rule says the System cancels on timeout, the other that the Cook may cancel on timeout. Is a Cook cancel without timeout allowed (the sync canvas allows delete any time while open)?" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Cmd_CancelHelpRequest, :R_ESD_SystemCancelsOnTimeout, :R_ESD_CookCanCancelOnTimeout ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "row 2" ; dkg:confidence dkg:Implied .
:Art_ESDetail_CookingAssistance_2026_10 dkg:raises :Q_ESD_CancelActor .
:Q_ESD_AcceptNoCommand a dkg:Question ; skos:prefLabel "Where is accepting an answer on the timeline?" ;
    rdfs:comment "'Cook can accept the answer' has no command or event. Help model: isAccepted; Help Request v2: 'At least one Help must be accepted' and a Closed status that nothing reaches (Q_HRClosedTransition)." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :R_ESD_CookCanAcceptAnswer, :Q_HRClosedTransition ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "shield sticky right, 3rd" ; dkg:confidence dkg:Implied .
:Art_ESDetail_CookingAssistance_2026_10 dkg:raises :Q_ESD_AcceptNoCommand .
:Q_ESD_CancelledStatus a dkg:Question ; skos:prefLabel "Is 'cancelled' a Help Request status?" ;
    rdfs:comment "Board: 'Help request cancelled'. Help Request model v2: Open / Answered / Closed. Contracts: OPEN / ANSWERED, and DELETE removes the request." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Ev_HelpRequestCancelled, :Con_Status, :Q_HelpRequestStateNames ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "event 4" ; dkg:confidence dkg:Implied .
:Art_ESDetail_CookingAssistance_2026_10 dkg:raises :Q_ESD_CancelledStatus .
:Q_ESD_RecipeIntoMealPlanRequest a dkg:Question ; skos:prefLabel "Does a meal-plan help request carry a recipe?" ;
    rdfs:comment "Detail board draws Recipe (Recipe Catalog) flowing into 'Help request Meal plan'. Help Request model: recipe 0..1, mandatory only for Preparation Step Explanation and Ingredient Substitute — not named for Menu proposal. Context maps draw no Recipe Catalog → Cooking Assistance arrow." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Msg_ESD_RecipeToHelpRequest, :R_HR_RecipeMandatoryForPSEAndIS ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "arrow Recipe → Help request Meal plan" ; dkg:confidence dkg:Implied .
:Art_ESDetail_CookingAssistance_2026_10 dkg:raises :Q_ESD_RecipeIntoMealPlanRequest .
:Q_ESD_ShieldLegend a dkg:Question ; skos:prefLabel "What does the lilac shield sticky mean — invariant, policy, or state?" ;
    rdfs:comment "Eleven shield stickies mix invariants ('Cook cannot answer…'), a timer policy ('System cancels…') and a state word ('Help REQUESTED'). No legend; the per-aggregate models use purple + lock for invariants." ;
    dkg:mentions :Q_GlossaryMarkers ;
    dkg:source :Art_ESDetail_CookingAssistance_2026_10 ; dkg:locator "all lilac stickies" ; dkg:confidence dkg:OnArtifact .
:Art_ESDetail_CookingAssistance_2026_10 dkg:raises :Q_ESD_ShieldLegend .

# --- Effect on existing questions (recorded, none closed) ---
:Q_PremiumVsPaying rdfs:comment "Detail board (2026-10-27): 'Only premium users allowed to ask Chef' / 'Chef can only be asked when cook is premium user.' — the first artifact to say what premium buys: access to Chefs." ; dkg:source :Art_ESDetail_CookingAssistance_2026_10 .
:Q_HelpRequestAtWhom rdfs:comment "Detail board: 'Help Meal plan can be provided by Chef, community, or Grandma'; 'Chef needs to be selected'; and a Chef may review the Avatar's plan." ; dkg:source :Art_ESDetail_CookingAssistance_2026_10 .
:Q_HelpProvidedCommand rdfs:comment "Detail board draws 'Provide Help' → 'Help provided' only — supports 'Provide help' over 'Request help' for event 16 of the big board." ; dkg:source :Art_ESDetail_CookingAssistance_2026_10 .
:Q_HRClosedTransition rdfs:comment "Detail board: 'Cook can accept the answer' — a candidate for what closes a request, with no event drawn." ; dkg:source :Art_ESDetail_CookingAssistance_2026_10 .
:Q_HelpMealSticky rdfs:comment "Detail board uses 'Help Meal plan' for the answer to a meal-plan request — a plausible reading of context map v3's 'Help Meal' sticky." ; dkg:source :Art_ESDetail_CookingAssistance_2026_10 .
:Q_NoStatesNoHotspots rdfs:comment "Detail board has its first hotspot: 'Define timeouts'." ; dkg:source :Art_ESDetail_CookingAssistance_2026_10 .

##############################################################################
# Ingest — three EventStorming DETAIL boards, siblings of the meal-plan board
# (2026-10-27, second batch), ingested in the order given:
#   A  Catastrophe            B  Ingredient substitution    C  Preparation step
# GROW. Overlap (A vs meal-plan detail board): share 70%, cover 45% → the test
# reads PARTITION; rejected: each board is the SAME template drawn for another
# kind of help, and the meal-plan board keeps its own content. Treated as new
# sibling artifacts. Template stickies with identical labels (events, Provide
# Help, Cancel help request, Show help…, rules, Define timeouts) are auto-merged
# into the nodes minted from the meal-plan board and gain a source per board.
# Colour convention as on the meal-plan board. No Chef actor on any of A–C.
##############################################################################
:Art_ESDetail_Catastrophe_2026_10 a dkg:EventStormingBoard ;
    rdfs:label "Cooking Assistance — EventStorming detail board: help with a catastrophe (image 1, batch 2)" ;
    rdfs:comment "Sibling of the meal-plan detail board. Recipe → Help request Catastrophe arrow labelled 'can be provided not mandatory'. Provider row: Cook + Grandma Avatar, no Chef. Carries three stickies naming OTHER help types: rule 'No Chef support for Preparation step Catastrophe', rule 'Help Preparation step can be provided by community, or Grandma', and on the cancel row business object 'Help request Preparation step' and read model 'Help request Ingredient' — recorded as written." ;
    dkg:ingestedAt "2026-10-27"^^xsd:date .
:Art_ESDetail_IngredientSubstitution_2026_10 a dkg:EventStormingBoard ;
    rdfs:label "Cooking Assistance — EventStorming detail board: help with ingredient substitution (image 2, batch 2)" ;
    rdfs:comment "Sibling of the meal-plan detail board. Recipe Catalog read model 'Recipe Ingredient' (unlabelled arrow). Spells both 'Help request Ingredients' (row 1 business object) and 'Help request Ingredient' (read models, cancel row). Provider row: Cook + Grandma Avatar, no Chef." ;
    dkg:ingestedAt "2026-10-27"^^xsd:date .
:Art_ESDetail_PreparationStep_2026_10 a dkg:EventStormingBoard ;
    rdfs:label "Cooking Assistance — EventStorming detail board: help with a preparation step (image 3, batch 2)" ;
    rdfs:comment "Sibling of the meal-plan detail board. Recipe Catalog read model 'Recipe Preparation step' (unlabelled arrow). Rule sticky reads 'No Chef support for Preparation step preparation step' (doubled). Cancel-row read model is 'Help request Ingredient' while its business object is 'Help request Preparation step'. Provider row: Cook + Grandma Avatar, no Chef." ;
    dkg:ingestedAt "2026-10-27"^^xsd:date .

