:Idea_CookingVideos a dkg:Idea ; skos:prefLabel "Cooking Videos" ; dkg:inCluster :Cluster_ContentCreation ; dkg:source :Art_Brainstorm ; dkg:locator "Content Creation" ; dkg:confidence dkg:OnArtifact .
:Idea_MakingPhotos a dkg:Idea ; skos:prefLabel "Making Photos" ; dkg:inCluster :Cluster_ContentCreation ; dkg:source :Art_Brainstorm ; dkg:locator "Content Creation" ; dkg:confidence dkg:OnArtifact .
