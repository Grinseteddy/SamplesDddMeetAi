########## API Product Canvas (synchronous) — Sharing ##########

:Art_APC_Sharing a dkg:SyncApiSpec ;
    rdfs:label "Sharing — API Product Canvas (synchronous), version 1.0.0" ;
    rdfs:comment "SharingApiProductCanvasSynchronous.jpg. 5 operations. Server https://larder.org/sharing. Contact annegret.junker@larder.org." ;
    dkg:specFormat "API Product Canvas (synchronous)" ;
    dkg:ingestedAt "2026-10-03"^^xsd:date .

:Api_Sharing a dkg:Api ;
    skos:prefLabel "Sharing" ;
    rdfs:comment "Value propositions: For the moment only thanks. Core functions: Provide thanks visible to other community cooks. Sync protocol as written: 'e.g. http'; Architecture pattern as written: 'e.g. RESTful oriented'. Both still carry the template's 'e.g.' text, so no dkg:protocol is recorded. dkg:inContext is Implied: the canvas title names the context." ;
    dkg:interactionStyle "sync" ;
    dkg:apiVersion "1.0.0" ;
    dkg:inContext :Ctx_Sharing ;
    dkg:source :Art_APC_Sharing ;
    dkg:locator "header" ;
    dkg:confidence dkg:OnArtifact .

:Sch_Sharing_Consents a dkg:Schema ;
    skos:prefLabel "consents" ;
    dkg:schemaRole "read" ;
    dkg:exposedBy :Api_Sharing ;
    dkg:source :Art_APC_Sharing ;
    dkg:locator "/thanks GET 200" ;
    dkg:confidence dkg:OnArtifact .

:Sch_Sharing_Thanks a dkg:Schema ;
    skos:prefLabel "thanks" ;
    dkg:schemaRole "read" ;
    dkg:schemaRole "request" ;
    dkg:exposedBy :Api_Sharing ;
    dkg:source :Art_APC_Sharing ;
    dkg:locator "/thanks POST request" ;
    dkg:locator "/thanks/{thanksId} GET 200" ;
    dkg:locator "/thanks/{thanksId} PATCH request" ;
    dkg:confidence dkg:OnArtifact .
:Sch_Sharing_Thanks dkg:specifies :Con_Thanks .    # exact (folded) label match — Implied

:R_Sharing_OnlyGiverAllowed a dkg:Rule ;
    skos:prefLabel "only giver allowed" ;
    dkg:inContext :Ctx_Sharing ;
    dkg:source :Art_APC_Sharing ;
    dkg:locator "/thanks/{thanksId} DELETE row" ;
    dkg:confidence dkg:OnArtifact .

:Op_Sharing_GET_Thanks a dkg:Operation ;
    skos:prefLabel "GET /thanks" ;
    rdfs:comment "parameters: giver, recipient · request: — · success: 200: consents · errors: 400, 401, 403, 500, default" ;
