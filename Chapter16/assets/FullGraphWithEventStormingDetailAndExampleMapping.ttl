# Ingest — API contract 'Consent Management API 1.0.0 (OpenAPI 3.1)' (consent-management.openapi.yaml), 2026-10-10. Grow.
# DERIVED DOCUMENT: generated from canvas + model; everything new is dkg:Inferred,
# sourced to the contract. Existing nodes are NOT re-sourced (no false corroboration).
##############################################################################
:Art_API_ConsentManagement_OAS a dkg:Artifact ;
    rdfs:label "Consent Management API — OpenAPI 3.1, version 1.0.0 (consent-management.openapi.yaml)" ;
    rdfs:comment "OpenAPI draft from the Consent Management canvas and Consent model. OAuth2 (consents:read/write, proposed), audience company-internal. subject query parameter required. POST takes subject + consentTextId reference; server generates consentId, givenAt, revokedAt. DELETE = logical revocation (record stays readable, idempotent). Consent embeds a snapshot of the accepted consent text. Glossary timestamp examples normalised. Example consent text: 'I allow to use my photos in public thanks and recipes.'" ;
    dkg:mentions :Ctx_ConsentManagement ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:R_API_ConsentRevocationLogical a dkg:Rule ; skos:prefLabel "Revoking a consent keeps the record (revokedAt set, still readable)" ; rdfs:comment "contract proposal for DELETE /consents/{consentId}; canvas says only 'Revokes consent'" ;
    dkg:inContext :Ctx_ConsentManagement ; dkg:mentions :Con_Consent ; dkg:source :Art_API_ConsentManagement_OAS ; dkg:locator "DELETE /consents/{consentId}; x-design-assumptions" ; dkg:confidence dkg:Inferred .
:Q_ConsentTextSnapshot a dkg:Question ; skos:prefLabel "Must a consent keep the wording accepted at grant time when the backend text changes?" ;
    rdfs:comment "Contract proposes a snapshot; text versioning is not specified by any artifact." ; dkg:mentions :Con_ConsentText ;
    dkg:source :Art_API_ConsentManagement_OAS ; dkg:locator "x-design-assumptions" ; dkg:confidence dkg:Inferred .
:Art_API_ConsentManagement_OAS dkg:raises :Q_ConsentTextSnapshot .
:Q_ConsentForMentioning rdfs:comment "Consent Management OpenAPI: the only consent wording in any artifact is the contract's example 'I allow to use my photos in public thanks and recipes.' — about photos, not about being mentioned. Neither confirms nor settles which consent the Thanks invariant needs." ; dkg:source :Art_API_ConsentManagement_OAS .

