    dkg:operationId "consumeHelpRequested" ;
    skos:altLabel "Consume Help requested events from Cooking Assistance" ;
    dkg:onChannel :Ch_NotificationsAsync_HelpRequestedQueue .

:Op_NotificationsAsync_Receive_HelpProvided dkg:source :Art_AsyncAPI_NotificationsAsync ;
    dkg:locator "operations.consumeHelpProvided" ;
    dkg:operationId "consumeHelpProvided" ;
    skos:altLabel "Consume Help provided events from Cooking Assistance" ;
    dkg:onChannel :Ch_NotificationsAsync_HelpProvidedQueue .


########## API specifications — contradictions between the three AsyncAPI documents ##########

:As_SPEC_CAPublishesHelpRequestCreated a dkg:Assertion ;
    rdf:subject :Ch_CookingAssistanceAsync_HelpRequestCreatedRoutingKey ; rdf:predicate dkg:carriesMessage ; rdf:object :Amsg_HelpRequestCreated ;
    rdfs:comment "Cooking Assistance publishes 'HelpRequestCreated' on exchange 'cooking-assistance', routing key 'cooking-assistance.help-request.created'." ;
    dkg:source :Art_AsyncAPI_CookingAssistanceAsync ; dkg:confidence dkg:OnArtifact .
:As_SPEC_GAConsumesHelpRequested a dkg:Assertion ;
    rdf:subject :Ch_GrandmaAvatar_HelpRequestedQueue ; rdf:predicate dkg:carriesMessage ; rdf:object :Amsg_HelpRequested_GrandmaAvatar ;
    rdfs:comment "Grandma Avatar consumes 'HelpRequested' from queue 'cook-assistance.help-requested.grandma-avatar', bound to the 'Cook Assistance exchange' on routing key 'help.requested' — and says Cook Assistance publishes HelpRequested." ;
    dkg:source :Art_AsyncAPI_GrandmaAvatar ; dkg:confidence dkg:OnArtifact ;
    dkg:contradicts :As_SPEC_CAPublishesHelpRequestCreated .
:As_SPEC_NotifConsumesHelpRequested a dkg:Assertion ;
    rdf:subject :Ch_NotificationsAsync_HelpRequestedQueue ; rdf:predicate dkg:carriesMessage ; rdf:object :Amsg_HelpRequested ;
    rdfs:comment "Notifications consumes 'HelpRequested' (amqp messageType 'help.requested') from queue 'notifications.help-requested', bound to the Cooking Assistance exchange." ;
    dkg:source :Art_AsyncAPI_NotificationsAsync ; dkg:confidence dkg:OnArtifact ;
    dkg:contradicts :As_SPEC_CAPublishesHelpRequestCreated .

:As_SPEC_CAPublishesHelpProvided a dkg:Assertion ;
    rdf:subject :Ch_CookingAssistanceAsync_HelpProvidedRoutingKey ; rdf:predicate dkg:carriesMessage ; rdf:object :Amsg_HelpProvided_CookingAssistance ;
    rdfs:comment "Cooking Assistance publishes 'HelpProvided' on exchange 'cooking-assistance', routing key 'cooking-assistance.help.provided', and consumes it from queue 'cooking-assistance.help-provided'." ;
    dkg:source :Art_AsyncAPI_CookingAssistanceAsync ; dkg:confidence dkg:OnArtifact .
:As_SPEC_GAPublishesHelpProvided a dkg:Assertion ;
    rdf:subject :Ch_GrandmaAvatar_HelpProvidedExchange ; rdf:predicate dkg:carriesMessage ; rdf:object :Amsg_HelpProvided_GrandmaAvatar ;
    rdfs:comment "Grandma Avatar publishes 'HelpProvided' on exchange 'cook-assistance' (not 'cooking-assistance'), routing key 'help.provided' (not 'cooking-assistance.help.provided')." ;
    dkg:source :Art_AsyncAPI_GrandmaAvatar ; dkg:confidence dkg:OnArtifact ;
    dkg:contradicts :As_SPEC_CAPublishesHelpProvided .

:Q_SPEC_BrokerTopologyDisagrees a dkg:Question ;
    skos:prefLabel "The three AsyncAPI documents describe three topologies: exchange 'cooking-assistance' vs 'cook-assistance'; routing keys 'cooking-assistance.help-request.created' / 'cooking-assistance.help.provided' vs 'help.requested' / 'help.provided'; message 'HelpRequestCreated' sent vs 'HelpRequested' received. As written, no consumer receives what Cooking Assistance publishes, and Cooking Assistance does not receive the Grandma Avatar's Help. Who owns the exchange, and which names are the contract?" ;
    dkg:source :Art_AsyncAPI_CookingAssistanceAsync , :Art_AsyncAPI_GrandmaAvatar , :Art_AsyncAPI_NotificationsAsync ; dkg:locator "channels + bindings" ;
    dkg:confidence dkg:Inferred .
:Api_CookingAssistanceAsync dkg:raises :Q_SPEC_BrokerTopologyDisagrees .
:Api_GrandmaAvatar dkg:raises :Q_SPEC_BrokerTopologyDisagrees .
:Api_NotificationsAsync dkg:raises :Q_SPEC_BrokerTopologyDisagrees .
:Api_CookingAssistanceAsync dkg:raises :Q_AAPC_HelpRequestCreatedVsHelpRequested .   # persists from the canvases into the specs

:Q_SPEC_HelpProvidedConsumersWithoutApi a dkg:Question ;
    skos:prefLabel "Cooking Assistance's AsyncAPI says 'Consumers such as Meal Planning, Meal Preparation and Sharing react to' HelpProvided — none of those three contexts has an AsyncAPI document or a receive operation. Planned consumers, or the context map's 'Help response' arrows 3, 9, 12 waiting for a contract?" ;
    dkg:source :Art_AsyncAPI_CookingAssistanceAsync ; dkg:locator "operations.publishHelpProvided" ;
    dkg:mentions :Con_Help ;
    dkg:confidence dkg:Inferred .
:Op_CookingAssistanceAsync_Send_HelpProvided dkg:raises :Q_SPEC_HelpProvidedConsumersWithoutApi .

:Q_SPEC_HelpPayloadDrift a dkg:Question ;
    skos:prefLabel "Three HelpProvidedPayload schemas for one event: Cooking Assistance and Notifications require helpRequestStatus (ANSWERED); the Grandma Avatar's omits it and fixes helpProviderType to GRANDMA_AVATAR — while its description says the shapes are 'the same as in Cook Assistance'. Notifications also caps title/answerTitle at 120 characters, the producers at 200. One contract, or three?" ;
    dkg:source :Art_AsyncAPI_CookingAssistanceAsync , :Art_AsyncAPI_GrandmaAvatar , :Art_AsyncAPI_NotificationsAsync ; dkg:locator "components.schemas.HelpProvidedPayload" ;
    dkg:mentions :Con_Help ;
    dkg:confidence dkg:Inferred .
:Sch_GrandmaAvatar_HelpProvidedPayload dkg:raises :Q_SPEC_HelpPayloadDrift .
:Sch_CookingAssistanceAsync_HelpProvidedPayload dkg:proposedSameAs :Sch_GrandmaAvatar_HelpProvidedPayload , :Sch_NotificationsAsync_HelpProvidedPayload .
:Sch_CookingAssistanceAsync_HelpRequestCreatedPayload dkg:proposedSameAs :Sch_GrandmaAvatar_HelpRequestedPayload , :Sch_NotificationsAsync_HelpRequestedPayload .

########## API specifications — vocabulary drift between the OpenAPI documents ##########

:Q_SPEC_MealEnumEncodings a dkg:Question ;
    skos:prefLabel "The meal of the day is encoded three ways: Meal Planning 'breakfast … supper' (lower case), Recipe Catalog and Cooking Assistance 'BREAKFAST … SUPPER', the AsyncAPIs 'MealType'. Meal Planning's diet filter is free text; Recipe Catalog's Diet is the enum VEGETARIAN / VEGAN / NORMAL. A course in Meal Planning refers to a recipe, so the two must meet." ;
    dkg:source :Art_OpenAPI_MealPlanning , :Art_OpenAPI_RecipeCatalog , :Art_OpenAPI_CookingAssistance ; dkg:locator "components.schemas.Meal / Diet" ;
    dkg:mentions :Con_MealPlan_Meal , :Con_Recipe_Meal , :Con_Recipe_Diet ;
    dkg:confidence dkg:Inferred .
:Sch_MealPlanning_Meal dkg:raises :Q_SPEC_MealEnumEncodings .
:Sch_RecipeCatalog_Meal dkg:raises :Q_SPEC_MealEnumEncodings .

:Q_SPEC_NewFieldsNotInGlossary a dkg:Question ;
    skos:prefLabel "Fields the specs add that no glossary draws: Thanks › recipients[].recipientId, createdAt / updatedAt (Thanks, Help Request, Help), Media › links may be empty (glossary 0..*, but 'media' required), Notification › 'receivers' (glossary 'Receiver'). Run schema-glossary-consistency for the field-level diff — the graph holds schema names only." ;
    dkg:source :Art_OpenAPI_Sharing , :Art_OpenAPI_CookingAssistance , :Art_OpenAPI_Notifications ; dkg:locator "components.schemas" ;
    dkg:confidence dkg:Inferred .
:Sch_Sharing_Recipient dkg:raises :Q_SPEC_NewFieldsNotInGlossary .

:Q_SPEC_LinkHostMismatch a dkg:Question ;
    skos:prefLabel "The Notifications OpenAPI's link example points at https://larder.org/cook-assistance/help-requests/…, but the Cooking Assistance API is served at https://larder.org/cooking-assistance. 'Cook Assistance' (board, Grandma Avatar spec) vs 'Cooking Assistance' (map, canvases, specs) is still unsettled." ;
    dkg:source :Art_OpenAPI_Notifications , :Art_AsyncAPI_GrandmaAvatar ; dkg:locator "Notification.link; info.description" ;
    dkg:mentions :Con_Notification_Link ;
    dkg:confidence dkg:Inferred .
:Sch_Notifications_Notification dkg:raises :Q_SPEC_LinkHostMismatch .
:Api_GrandmaAvatar dkg:raises :Q_AAPC_GrandmaAvatarName .   # spec: 'the AI responder inside Cook Assistance'
