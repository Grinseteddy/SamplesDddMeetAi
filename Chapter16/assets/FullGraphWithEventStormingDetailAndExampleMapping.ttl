# --- merge ledger ---
:Con_MealType_MP dkg:proposedSameAs :Con_Meal ; rdfs:comment "proposedSameAs Con_Meal: glossary 'Meal' vs a kind-of-meal value set — likely different" .
:Con_CourseMeal dkg:proposedSameAs :Con_Meal ; rdfs:comment "proposedSameAs Con_Meal: glossary v2 'Course contains Meal' — same role, but the cardinality contradicts (see below)" .
:Con_Dinner_MealType dkg:proposedSameAs :Con_Dinner ; rdfs:comment "proposedSameAs Con_Dinner: story A / glossary v2 'Dinner' (has Menu 1) vs a value of plan-level meal (one word, two concepts?)" .
:Con_CourseStep dkg:proposedSameAs :Con_Step ; rdfs:comment "proposedSameAs Con_Step: glossary v2 'Step' is a recipe step (Recipe contains Step 1..*); here a course's place in the serving order (example 2)" .
:Con_Owner dkg:proposedSameAs :Con_CookId ; rdfs:comment "proposedSameAs Con_CookId: owner of a meal plan is presumably a cook; example UUID differs from the cook Id example" .
:Con_MealPlanId rdfs:comment "Example UUID identical to cook Id / requester / subject examples — a copy-paste, or the same identifier on purpose?" .

# --- CONTRADICTION: Course contains Meal ---
:As_CourseContainsMeal_G2 a dkg:Assertion ;
    rdf:subject :Rel_CourseContainsMeal ; rdf:predicate dkg:cardinality ; rdf:object "1..*" ;
    rdfs:comment "Glossary v2: Course contains Meal 1..*" ;
    dkg:source :Art_Glossary_2026_10_v2 ; dkg:confidence dkg:OnArtifact .
:As_CourseContainsMeal_MP a dkg:Assertion ;
    rdf:subject :Rel_MP_CourseContainsCourseMeal ; rdf:predicate dkg:cardinality ; rdf:object "1" ;
    rdfs:comment "Meal Plan model: course contains meal 1" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:confidence dkg:OnArtifact ;
    dkg:contradicts :As_CourseContainsMeal_G2 .

# --- questions ---
:Q_MenuDinnerGone a dkg:Question ;
    skos:prefLabel "Where did Dinner → Menu → Course go?" ;
    rdfs:comment "Glossary v2: Dinner has Menu 1, Menu has Course 1..*, Course contains Meal 1..*. Meal Plan model: Meal Plan contains course 1..10 directly; no Menu; 'dinner' is now a value of the plan's meal type. Board: Dinner planned produces Menu; context maps carry Menu." ;
    dkg:source :Art_Glossary_MealPlan, :Art_Glossary_2026_10_v2 ; dkg:locator "whole model" ; dkg:confidence dkg:Implied .
:Art_Glossary_MealPlan dkg:raises :Q_MenuDinnerGone .
:Q_TwoMeals a dkg:Question ;
    skos:prefLabel "Which 'meal' is meant — breakfast/lunch/dinner/supper, or the dish in a course?" ;
    rdfs:comment "The Meal Plan model uses 'meal' for both; stories and boards use 'Meal' for the thing a cook prepares and burns." ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "two green 'meal' boxes" ; dkg:confidence dkg:OnArtifact .
:Art_Glossary_MealPlan dkg:raises :Q_TwoMeals .

