##############################################################################
# INGEST — EventStorming board, two photos (EventStormingI.jpg + EventStormingII.jpg)  (2026-09-20)
##############################################################################

:Art_ESBoard a dkg:EventStormingBoard ;
    rdfs:label "EventStorming board, two photos (EventStormingI.jpg + EventStormingII.jpg)" ;
    rdfs:comment "21 events; 10 bubbles on the wall = 7 distinct names (Meal Planning, Cook Assistance, Meal Preparation, Media each drawn twice). Colours as read: orange event, blue command, yellow actor (person icon), green read model (eye), pale yellow business object (briefcase), pink external system (gear), lilac = status words (e.g. 'Plan STALLED'). No aggregates, no policies, no red hotspots." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Ctx_CookProfile dkg:source :Art_ESBoard ;
    dkg:locator "ES-I bubble 1" .
:Ctx_MealPlanning dkg:source :Art_ESBoard ;
    dkg:locator "ES-I bubble 2" ;
    dkg:locator "ES-I bubble 4" .
:Ctx_MealPreparation dkg:source :Art_ESBoard ;
    dkg:locator "ES-II bubble 1" ;
    dkg:locator "ES-II bubble 4" .
:Ctx_Media dkg:source :Art_ESBoard ;
    dkg:locator "ES-II bubble 2" ;
    dkg:locator "ES-II bubble 5" .
:Ctx_CookAssistance a dkg:BoundedContext ;
    skos:prefLabel "Cook Assistance" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "ES-I bubble 3" ;
    dkg:locator "ES-II bubble 3" ;
    rdfs:comment "drawn twice on the board, same commands, objects and responders" ;
    dkg:confidence dkg:OnArtifact .
:Ctx_CookAssistance dkg:proposedSameAs :Ctx_CookingAssistance .
# ^ board says 'Cook Assistance', map says 'Cooking Assistance'; both hold Help requested / Help provided / Help request / Help response
