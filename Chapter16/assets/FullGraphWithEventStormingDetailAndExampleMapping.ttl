    rdfs:comment "Notification status — kept apart from Help Request 'status' and Cook 'status'" ;
    dkg:source :Art_APC_Notifications_Sync ; dkg:locator "parameter of GET /notifications/; body of PUT …/status" ; dkg:confidence dkg:OnArtifact .
:Con_Status_Notif dkg:proposedSameAs :Con_Status ; rdfs:comment "proposedSameAs Con_Status: same word, third aggregate (Notification NEW/READ vs Help Request Open/Answered vs Cook active/inActive/premium)" .
:Con_NotificationId a dkg:Concept ; skos:prefLabel "Notification Id" ; dkg:source :Art_APC_Notifications_Sync ; dkg:locator "parameter of /notifications/{notificationId}" ; dkg:confidence dkg:OnArtifact .
