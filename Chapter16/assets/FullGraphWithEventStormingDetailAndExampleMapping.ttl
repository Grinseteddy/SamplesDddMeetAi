:Art_ImpactMap_2026_10 a dkg:ImpactMap ;
    rdfs:label "Larder impact map (attached image)" ;
    rdfs:comment "Four columns GOAL / ACTORS / IMPACT / DELIVERABLES. 1 goal (no metric), 7 actors, 7 impacts, 12 deliverables. Actor→impact lines cross heavily; uncertain readings are reified with dkg:Implied." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .

:Goal_Larder a dkg:Goal ;
    skos:prefLabel "Larder - recipe sharing platform with min. 2,500 paying members in two years" ; skos:altLabel "Larder - recipe sharing platform with min. 2,500 members in two years" ; skos:altLabel "Larder" ;
    rdfs:comment "No metric stated on the map." ;
    dkg:source :Art_ImpactMap_2026_10 ; dkg:locator "GOAL column" ;
    dkg:confidence dkg:OnArtifact .

