@prefix dkg:  <https://w3id.org/dkg/ns#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/dkg/ns> a owl:Ontology ;
    rdfs:label "Domain Knowledge Graph vocabulary" ;
    rdfs:comment """A small vocabulary for holding the results of collaborative
modelling workshops — brainstorms, Business Model Canvases, Wardley Maps, Impact
Maps, Domain Stories, Visual Glossaries, EventStorming boards (Big Picture and
detail level), Event Models,
Bounded Context Canvases, ADR logs — and the API specifications (OpenAPI,
AsyncAPI) that each bounded context eventually publishes, in ONE browsable graph. The IRI is an identifier, not a promise that it
resolves. Point it at your own namespace if you have one; change it here and
nowhere else.""" .

##############################################################################
# 1. The spine — the classes that make cross-artifact browsing possible
#
# Everything a workshop produces lands in one of these. Artifact-specific
# classes below are subclasses, so a query over the spine sees the whole graph
# and a query over a subclass sees one artifact's contribution.
##############################################################################

dkg:Node a owl:Class ;
    rdfs:label "Node" ;
    rdfs:comment "Anything the graph holds. Every Node carries at least one dkg:source and exactly one dkg:confidence." .

dkg:Concept a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Concept" ;
    rdfs:comment "A domain noun. THE merge target: when two artifacts say the same word, they meet here. Terms, work objects, aggregates and business objects are all Concepts." .

dkg:Actor a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Actor" ;
    rdfs:comment "A person, role, team, customer segment or system that does something or is done to. Merge target across BMC segments, impact-map actors, story actors and board actors." .

dkg:Capability a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Capability" ;
    rdfs:comment "Something the business can do. Wardley components and BMC key activities land here." .

dkg:Activity a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Activity" ;
    rdfs:comment "A verb performed by an Actor on a Concept. Domain-story activities, commands." .

dkg:Occurrence a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Occurrence" ;
    rdfs:comment "Something that happened, in the past tense. Domain events." .

dkg:Goal a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Goal" ;
    rdfs:comment "A measurable business outcome. Impact-map WHY, Wardley user need, North Star." .

dkg:Deliverable a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Deliverable" ;
    rdfs:comment "Something a team could build or do. Impact-map WHAT, and where brainstorm ideas usually settle." .

dkg:BoundedContext a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Bounded Context" ;
    rdfs:comment "A boundary inside which one model and one language hold. Board bubbles, story lanes, Event Model swimlanes." .

dkg:Question a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Question" ;
    rdfs:comment "Something the artifacts do not settle. Hotspots, open questions, contested calls. First-class: a graph that cannot hold doubt will launder it." .

dkg:Rule a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "Rule" ;
    rdfs:comment "An invariant, guard or policy the business would state as a rule." .

##############################################################################
# 2. Provenance
##############################################################################

dkg:Artifact a owl:Class ;
    rdfs:label "Artifact" ;
    rdfs:comment "One source document, board, photo or session — the thing a statement came from." .

dkg:Brainstorm             a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:BusinessModelCanvas    a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:WardleyMap             a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:ImpactMap              a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:DomainStory            a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:VisualGlossary         a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:EventStormingBoard     a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:EventModel             a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:CapabilityMap          a owl:Class ; rdfs:subClassOf dkg:Artifact .
dkg:CoreDomainChart        a owl:Class ; rdfs:subClassOf dkg:Artifact .

dkg:source a owl:ObjectProperty ;
    rdfs:label "source" ; rdfs:range dkg:Artifact ;
    rdfs:comment "REQUIRED on every Node. Repeat it: a Concept that three artifacts mention carries three sources, and that count is the browsable measure of corroboration." .

dkg:locator a owl:DatatypeProperty ;
    rdfs:label "locator" ;
    rdfs:comment "Where in the artifact: a sentence number, sticky position, event number, canvas block. Makes a finding checkable against the wall." .

dkg:ingestedAt a owl:DatatypeProperty ; rdfs:range xsd:date .

dkg:revisionOf a owl:ObjectProperty ; rdfs:range dkg:Artifact ;
    rdfs:label "revision of" ;
    rdfs:comment "Artifact → the earlier artifact it redraws. Same team, same picture, later date. A revision re-ingest matches nodes within this lineage by label, adds the revision as a source on what is unchanged, and reports added / removed / changed. Nothing is deleted." .
dkg:absentFrom a owl:ObjectProperty ; rdfs:range dkg:Artifact ;
    rdfs:label "absent from" ;
    rdfs:comment "Node → a revision of one of its own sources that no longer shows it. The node stays; this edge records that the team dropped it, which is a finding, not a deletion." .

# Confidence — deliberately the same three words the rest of this toolkit uses.
dkg:confidence a owl:ObjectProperty ; rdfs:label "confidence" .
dkg:OnArtifact a dkg:ConfidenceLevel ; rdfs:label "on-artifact" ;
    rdfs:comment "A sticky, box or arrow says so. Transcription, not interpretation." .
dkg:Implied    a dkg:ConfidenceLevel ; rdfs:label "implied" ;
    rdfs:comment "Not written, but the artifact does not make sense otherwise." .
dkg:Inferred   a dkg:ConfidenceLevel ; rdfs:label "inferred" ;
    rdfs:comment "Domain knowledge from outside the artifacts. Needs a human to confirm before anyone builds on it." .

##############################################################################
# 3. Statements about statements — reification for provenance and disagreement
##############################################################################
#
# Direct triples are the default. Reify ONLY when (a) the edge is asserted by
# more than one artifact, (b) two artifacts disagree, or (c) the edge is
# contested. Reifying everything makes the graph unreadable and browsing is the
# point. Standard rdf:Statement is reused rather than reinvented.

dkg:Assertion a owl:Class ; rdfs:subClassOf rdf:Statement ;
    rdfs:label "Assertion" ;
    rdfs:comment "A reified edge carrying its own dkg:source, dkg:confidence and optionally dkg:contradicts." .

dkg:contradicts a owl:ObjectProperty ; rdfs:range dkg:Assertion ;
    rdfs:label "contradicts" ;
    rdfs:comment "Two artifacts assert incompatible things. NEVER resolve this silently — a contradiction between a Wardley Map and an EventStorming board is a finding worth more than the graph itself." .

##############################################################################
# 4. Identity and language
##############################################################################

# Merged nodes keep every spelling ever seen:
#   skos:prefLabel  the agreed ubiquitous term (or the newest artifact's)
#   skos:altLabel   every other spelling, one per artifact
#   dkg:spelledOn   which artifact used which spelling
dkg:spelling a owl:Class ; rdfs:label "Spelling" ;
    rdfs:comment "A label as one artifact wrote it, with the artifact that wrote it. Use when a rename is itself the finding (Catastrophe/Catastrophe, Cook/User)." .
dkg:spelledOn a owl:ObjectProperty ; rdfs:range dkg:Artifact .
dkg:literal   a owl:DatatypeProperty .

dkg:proposedSameAs a owl:ObjectProperty ; rdfs:label "proposed same as" ;
    rdfs:comment "A merge candidate NOT yet confirmed by a human. Never collapse two IRIs on this basis; the merge ledger exists so the room decides." .

dkg:renamedTo a owl:ObjectProperty ; rdfs:label "renamed to" ;
    rdfs:comment "A noun re-modelled across a boundary: User renamedTo Cook. Boundary evidence, not a synonym." .

##############################################################################
# 5. The cross-artifact spine properties — what makes this a map and not a pile
##############################################################################

dkg:mentions a owl:ObjectProperty ;
    rdfs:label "mentions" ;
    rdfs:comment "Any Node → Concept. The cheapest and most useful edge in the graph: it is what lets you ask 'everything that touches Meal plan' across a canvas, a story and a board." .

dkg:supports a owl:ObjectProperty ;
    rdfs:label "supports" ;
    rdfs:comment "Capability/Deliverable → Goal or ValueProposition. The strategy-to-build trace." .

dkg:realises a owl:ObjectProperty ;
    rdfs:label "realises" ;
    rdfs:comment "Deliverable → Impact. Impact-map WHAT to HOW." .

dkg:dependsOn a owl:ObjectProperty ;
    rdfs:label "depends on" ;
    rdfs:comment "Wardley value-chain edge, and any other 'needs this to work'." .

dkg:inContext a owl:ObjectProperty ; rdfs:range dkg:BoundedContext ;
    rdfs:label "in context" ;
    rdfs:comment "A Node belongs inside a boundary. A Node with two of these is a straddler — query for it." .

dkg:performedBy a owl:ObjectProperty ; rdfs:range dkg:Actor ;
    rdfs:label "performed by" .

dkg:actsOn a owl:ObjectProperty ; rdfs:range dkg:Concept ;
    rdfs:label "acts on" .

dkg:precedes a owl:ObjectProperty ;
    rdfs:label "precedes" ;
    rdfs:comment "Sequence: story sentence n → n+1, event n → n+1. Ordering is evidence; keep it." .

dkg:raises a owl:ObjectProperty ; rdfs:range dkg:Question ;
    rdfs:label "raises" .

dkg:sequence a owl:DatatypeProperty ; rdfs:range xsd:integer .

##############################################################################
# 6. Artifact-specific classes
##############################################################################

# --- Brainstorm -------------------------------------------------------------
dkg:Idea a owl:Class ; rdfs:subClassOf dkg:Deliverable ;
    rdfs:comment "One sticky from an ideation session. Stays an Idea until another artifact picks it up — an Idea nothing ever references again is the brainstorm's own answer about itself." .
dkg:Cluster a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "A group of ideas the room drew. The room's own clustering, not a re-clustering." .
dkg:inCluster a owl:ObjectProperty ; rdfs:range dkg:Cluster .
dkg:votes a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:comment "Dot-vote count if the board has one. Do not invent a score." .

# --- Business Model Canvas --------------------------------------------------
dkg:CustomerSegment      a owl:Class ; rdfs:subClassOf dkg:Actor .
dkg:ValueProposition     a owl:Class ; rdfs:subClassOf dkg:Node .
dkg:Channel              a owl:Class ; rdfs:subClassOf dkg:Node .
dkg:CustomerRelationship a owl:Class ; rdfs:subClassOf dkg:Node .
dkg:RevenueStream        a owl:Class ; rdfs:subClassOf dkg:Node .
dkg:KeyResource          a owl:Class ; rdfs:subClassOf dkg:Node .
dkg:KeyActivity          a owl:Class ; rdfs:subClassOf dkg:Capability .
dkg:KeyPartner           a owl:Class ; rdfs:subClassOf dkg:Actor .
dkg:CostStructure        a owl:Class ; rdfs:subClassOf dkg:Node .
dkg:servesSegment  a owl:ObjectProperty ; rdfs:range dkg:CustomerSegment .
dkg:deliveredVia   a owl:ObjectProperty ; rdfs:range dkg:Channel .
dkg:paidBy         a owl:ObjectProperty ; rdfs:range dkg:RevenueStream .

# --- Wardley Map ------------------------------------------------------------
dkg:UserNeed  a owl:Class ; rdfs:subClassOf dkg:Goal .
dkg:Component a owl:Class ; rdfs:subClassOf dkg:Capability .
dkg:evolution a owl:ObjectProperty ; rdfs:label "evolution" .
dkg:Genesis a dkg:EvolutionStage ; rdfs:label "genesis" .
dkg:CustomBuilt a dkg:EvolutionStage ; rdfs:label "custom-built" .
dkg:Product a dkg:EvolutionStage ; rdfs:label "product" .
dkg:Commodity a dkg:EvolutionStage ; rdfs:label "commodity" .
dkg:visibility a owl:DatatypeProperty ; rdfs:range xsd:decimal ;
    rdfs:comment "Height on the value chain, 0..1. Record only if the map is measured rather than sketched." .
dkg:movesTo a owl:ObjectProperty ; rdfs:range dkg:EvolutionStage ;
    rdfs:comment "A drawn movement arrow. A prediction the graph can later be checked against." .

# --- Impact Map -------------------------------------------------------------
dkg:Impact a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "A behaviour change in an Actor — HOW. Not a feature." .
dkg:impactedActor a owl:ObjectProperty ; rdfs:range dkg:Actor .
dkg:towardsGoal   a owl:ObjectProperty ; rdfs:range dkg:Goal .
dkg:metric a owl:DatatypeProperty ;
    rdfs:comment "The Goal's measure. A Goal with no metric is a wish — leave the property off and let the query find it." .

# --- Domain Story -----------------------------------------------------------
dkg:Sentence   a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "One numbered actor → activity → work-object sentence." .
dkg:WorkObject a owl:Class ; rdfs:subClassOf dkg:Concept .
dkg:Lane       a owl:Class ; rdfs:subClassOf dkg:BoundedContext .

# --- Visual Glossary --------------------------------------------------------
dkg:Term          a owl:Class ; rdfs:subClassOf dkg:Concept .
dkg:Entity        a owl:Class ; rdfs:subClassOf dkg:Term .
dkg:ValueObject   a owl:Class ; rdfs:subClassOf dkg:Term .
dkg:AggregateRoot a owl:Class ; rdfs:subClassOf dkg:Entity .
dkg:Relationship  a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "A labelled, counted edge between two Terms, reified because the cardinality and the verb both matter." .
dkg:from a owl:ObjectProperty .
dkg:to   a owl:ObjectProperty .
dkg:verb a owl:DatatypeProperty .
dkg:cardinality a owl:DatatypeProperty ;
    rdfs:comment "Verbatim: '1', '0..1', '1..*', '0..25'. Never normalise a range the glossary drew." .
dkg:cardinalityGiven a owl:DatatypeProperty ; rdfs:range xsd:boolean ;
    rdfs:comment "true = the glossary drew this number. false = derived. Confusing the two turns a guess into a business rule." .

# --- EventStorming / Event Model --------------------------------------------
dkg:DomainEvent    a owl:Class ; rdfs:subClassOf dkg:Occurrence .
dkg:Command        a owl:Class ; rdfs:subClassOf dkg:Activity .
dkg:Aggregate      a owl:Class ; rdfs:subClassOf dkg:Concept .
dkg:ReadModel      a owl:Class ; rdfs:subClassOf dkg:Concept .
dkg:BusinessObject a owl:Class ; rdfs:subClassOf dkg:Concept .
dkg:Policy         a owl:Class ; rdfs:subClassOf dkg:Rule .
dkg:ExternalSystem a owl:Class ; rdfs:subClassOf dkg:Actor .
dkg:Hotspot        a owl:Class ; rdfs:subClassOf dkg:Question .
dkg:PivotalEvent   a owl:Class ; rdfs:subClassOf dkg:DomainEvent .
dkg:Slice          a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "Event Model vertical slice: state change, state view, automation or translation." .
dkg:sliceKind a owl:DatatypeProperty .
dkg:Swimlane a owl:Class ; rdfs:subClassOf dkg:BoundedContext .

dkg:triggers  a owl:ObjectProperty ; rdfs:comment "Command → DomainEvent, or Policy → Command." .
dkg:emittedBy a owl:ObjectProperty ; rdfs:range dkg:Aggregate .
dkg:reads     a owl:ObjectProperty ; rdfs:range dkg:ReadModel .
dkg:produces  a owl:ObjectProperty ; rdfs:range dkg:BusinessObject .
dkg:reactsTo  a owl:ObjectProperty ; rdfs:domain dkg:Policy ; rdfs:range dkg:Occurrence .
dkg:hasState  a owl:DatatypeProperty ;
    rdfs:comment "A status word from a state sticky. Only from a sticky — a reconstructed state machine is dkg:Inferred and belongs in the invariant sheet, not silently here." .

# --- EventStorming detail level (Process-Level / Design-Level) ---------------
#
# A detail board zooms into ONE bounded context (or one process placed inside
# named contexts) and adds the grammar: read model → actor/policy → command →
# aggregate → event(s) → read models. The board is scoped; the scope is a fact
# the ingest asks the user for and records once, on the artifact.

dkg:EventStormingDetailBoard a owl:Class ; rdfs:subClassOf dkg:EventStormingBoard ;
    rdfs:comment "A Process-Level or Design-Level EventStorming board. MUST carry dkg:scopedTo — the bounded context(s) it zooms into, named by the user, never guessed. A subclass of EventStormingBoard so a query over boards sees it; the revision test compares it only with detail boards of the same scope." .
dkg:DetailDesignBrief a owl:Class ; rdfs:subClassOf dkg:Artifact ;
    rdfs:comment "The Detail Design Brief that event-storming-detail-interpreter writes about one detail board. A derived analysis: what it reads off the board ('on board') is the board's; what it constructs (inferred invariants, lifecycles, policy classifications, completeness findings) is dkg:Inferred, sourced to the brief." .

dkg:scopedTo a owl:ObjectProperty ; rdfs:domain dkg:Artifact ; rdfs:range dkg:BoundedContext ;
    rdfs:label "scoped to" ;
    rdfs:comment "Artifact → the bounded context it is about. Required on a detail board; the ingest asks for it when the request does not name it. One per context when a board was split by region." .
dkg:refines a owl:ObjectProperty ; rdfs:domain dkg:Artifact ; rdfs:range dkg:Artifact ;
    rdfs:label "refines" ;
    rdfs:comment "Artifact → the artifact it zooms into or analyses: a detail board → the Big Picture board; a Detail Design Brief → its detail board. NOT dkg:revisionOf — the coarser artifact stays current." .
dkg:flavour a owl:DatatypeProperty ;
    rdfs:comment "'Process-Level' or 'Design-Level', as read: no aggregates on the board → Process-Level." .

dkg:AggregateCandidate a owl:Class ; rdfs:subClassOf dkg:Concept ;
    rdfs:comment "A yellow 'system' sticky that receives commands but is not (yet) drawn as an aggregate. Never promoted to dkg:Aggregate by the ingest; a later revision of the board does that, and the report says so." .
dkg:Invariant a owl:Class ; rdfs:subClassOf dkg:Rule ;
    rdfs:comment "A rule an aggregate protects when it handles a command: 'max 2 bikes per rider'. Label verbatim from the constraint note. OnArtifact only from a note on the board; everything a brief or an invariant sheet reconstructs is dkg:Inferred." .
dkg:Transition a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "One state change of one aggregate: fromState → toState via an event. Emitted from a board only when state stickies are drawn; a reconstructed lifecycle is dkg:Inferred, sourced to the analysis." .

dkg:handledBy a owl:ObjectProperty ; rdfs:domain dkg:Command ;
    rdfs:label "handled by" ;
    rdfs:comment "Command → the Aggregate, AggregateCandidate or ExternalSystem it lands on. Exactly one per command is the grammar; none or two is a finding check_graph.py reports, never something the ingest repairs." .
dkg:updates a owl:ObjectProperty ; rdfs:range dkg:ReadModel ;
    rdfs:label "updates" ;
    rdfs:comment "DomainEvent → ReadModel it projects into. A read model nothing updates is a missing producer — often a missing context." .
dkg:triggerKind a owl:DatatypeProperty ;
    rdfs:comment "On a Command (or a DomainEvent with no command): 'actor', 'policy', 'time' or 'external', as drawn. Left off when the board shows nothing." .
dkg:outcome a owl:DatatypeProperty ;
    rdfs:comment "On a DomainEvent: 'success' or 'failure' — the branch it is on below its command. OnArtifact from a drawn branch, Implied from wording alone." .
dkg:condition a owl:DatatypeProperty ;
    rdfs:comment "A Policy's 'and <condition>' clause, verbatim. A condition with no dkg:reads is a policy deciding blind." .
dkg:policyScope a owl:DatatypeProperty ;
    rdfs:comment "'within-aggregate', 'cross-aggregate' or 'cross-context' — an analysis's classification of a Policy. Asserted only by a Detail Design Brief, so reified and dkg:Inferred." .
dkg:guards      a owl:ObjectProperty ; rdfs:domain dkg:Rule ; rdfs:range dkg:Command ;
    rdfs:comment "Invariant → the Command it must hold for." .
dkg:enforcedBy  a owl:ObjectProperty ; rdfs:domain dkg:Rule ;
    rdfs:comment "Invariant → the Aggregate that protects it. An invariant that needs data from two aggregates is a boundary finding." .
dkg:rejectsWith a owl:ObjectProperty ; rdfs:domain dkg:Rule ; rdfs:range dkg:DomainEvent ;
    rdfs:comment "Invariant → the failure event the board shows when it is violated." .
dkg:ofAggregate a owl:ObjectProperty ; rdfs:domain dkg:Transition .
dkg:fromState   a owl:DatatypeProperty ; rdfs:domain dkg:Transition .
dkg:toState     a owl:DatatypeProperty ; rdfs:domain dkg:Transition .
dkg:via         a owl:ObjectProperty ; rdfs:domain dkg:Transition ; rdfs:range dkg:DomainEvent .

# --- Bounded Context Canvas --------------------------------------------------
dkg:BoundedContextCanvas a owl:Class ; rdfs:subClassOf dkg:Artifact ;
    rdfs:comment "A structured, one-context-at-a-time write-up (DDD Crew): purpose, strategic classification, domain roles, inbound/outbound communication, ubiquitous language, business decisions, assumptions, verification metrics and open questions. Its own four provenance markers — (given)/(derived)/(proposed)/(unknown) — are read field by field and mapped onto dkg:confidence there; they are never applied uniformly to the whole document." .

dkg:Message a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "One row of a canvas's inbound or outbound communication table: a command, query or event crossing this context's border, with the collaborator on the other end. The same business concept named on two rows with two collaborators is two Messages, not one — the repetition is a coupling fact the canvas is making on purpose." .
dkg:messageKind a owl:DatatypeProperty ;
    rdfs:comment "Verbatim: 'cmd', 'qry', 'evt', or '?' when the canvas itself could not tell. Never resolve a '?' by guessing which it must be. Also set on an API dkg:Operation, where it is mechanical and therefore dkg:Implied: GET → 'qry', POST/PUT/PATCH/DELETE → 'cmd'; an AsyncAPI operation whose message is named in the past tense → 'evt', otherwise left off. Having the same word on both sides is what lets check_graph.py see a canvas 'evt' exposed as a synchronous call." .
dkg:carries a owl:DatatypeProperty ;
    rdfs:comment "What a Message carries, in the canvas's own words — usually copied from a border contract's 'crosses' line." .
dkg:domainRole a owl:DatatypeProperty ;
    rdfs:comment "One of the canvas's fixed vocabulary for what a context behaves like: Specification model, Execution model, Audit model, Approver, Enforcer, Gateway, Interchange, Analysis, Draft, Engagement creator, Segregated core. Multi-valued; one triple per role." .
dkg:businessModel a owl:DatatypeProperty ;
    rdfs:comment "How a context earns its place, from the canvas's strategic-classification field: revenue generator, engagement creator, compliance enforcer, cost reducer. Multi-valued, and often (proposed)." .

# --- Small ADR / decision log ------------------------------------------------
dkg:ADRLog a owl:Class ; rdfs:subClassOf dkg:Artifact ;
    rdfs:comment "A lightweight architecture-decision log, one row per decision: a date, an id, a status, a question, the options that were on the table and which one was chosen." .
dkg:Decision a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "One row of an ADR log. Deliberately NOT a subclass of dkg:Rule: many rows govern the model or its notation rather than the business, and forcing every one into Rule would misrepresent the ones that are naming or legend conventions. Where a decided option IS an enforceable business rule, propose a link to the matching dkg:Rule rather than assuming one." .
dkg:status a owl:DatatypeProperty ;
    rdfs:comment "Verbatim status word from the log's own column: Adopted, Superseded, Proposed, Rejected, Deprecated — whatever the log itself uses. Never normalise to a fixed set." .
dkg:decidedOption a owl:DatatypeProperty ;
    rdfs:comment "The option text the decision chose, copied verbatim from the row's Decision column." .
dkg:consideredOption a owl:DatatypeProperty ;
    rdfs:comment "One option that was on the table, including ones not chosen. Multi-valued — one triple per option the row actually enumerates; do not split an Options cell into options it never separated itself." .
dkg:decidedAt a owl:DatatypeProperty ; rdfs:range xsd:date .
dkg:decidedBy a owl:DatatypeProperty ;
    rdfs:comment "The author or owner recorded on the log row, verbatim." .
dkg:answers a owl:ObjectProperty ; rdfs:range dkg:Question ;
    rdfs:label "answers" ;
    rdfs:comment "Decision → Question it resolves. THE edge that connects a decision log to the rest of the graph. A Decision with no dkg:answers is a decision the graph cannot show the point of, and check_graph.py will surface it as an orphan on purpose." .
dkg:supersedes a owl:ObjectProperty ;
    rdfs:comment "Decision → Decision it replaces, or — on a revision re-ingest — a Relationship or Assertion → the earlier one it deliberately changed (a cardinality redrawn, a classification moved). Both stay in the graph; supersession is history, not deletion. Distinct from dkg:contradicts: contradicts is two artifacts disagreeing, supersedes is one artifact changing its mind." .

# --- API specifications — a context's synchronous and asynchronous interface --
#
# The last rung of the ladder. Everything above it says what the team MODELLED;
# an OpenAPI or AsyncAPI document says what will be BUILT. The graph keeps the
# two apart on purpose: a board Command and the POST that carries it are two
# nodes from two worlds, joined by dkg:specifies, so the graph can show the
# command nobody exposed and the endpoint nobody modelled.

dkg:ApiSpecification a owl:Class ; rdfs:subClassOf dkg:Artifact ;
    rdfs:comment "A machine-readable interface contract for ONE bounded context: an OpenAPI document, an AsyncAPI document, a protobuf service file, a GraphQL schema. Not a derived analysis — what the file says, it says on-artifact. But what it says ABOUT THE DOMAIN (which command an operation carries, which event a message publishes, which term a schema spells) is one team's reading, so every link from it into the model is a claim to check, never a merge." .
dkg:SyncApiSpec  a owl:Class ; rdfs:subClassOf dkg:ApiSpecification ;
    rdfs:comment "Request/response: OpenAPI (REST), protobuf/gRPC, GraphQL SDL. The caller waits." .
dkg:AsyncApiSpec a owl:Class ; rdfs:subClassOf dkg:ApiSpecification ;
    rdfs:comment "Message-driven: AsyncAPI over Kafka, AMQP, MQTT, WebSocket. The producer does not wait, and does not know who reads." .
dkg:specFormat a owl:DatatypeProperty ;
    rdfs:comment "Verbatim: 'OpenAPI 3.1.0', 'AsyncAPI 3.1.0', 'proto3', 'GraphQL SDL'." .

dkg:Api a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:label "API" ;
    rdfs:comment "The interface one specification describes — its info block: title, version, audience, protocol. Carries EXACTLY ONE dkg:inContext: an API belongs to the context that provides it (sync) or that sends and receives on it (async). check_graph.py treats an Api with no context as an error and one with two as a finding — a spec that straddles a boundary is a boundary the spec ignores. The context is never read off the file alone; the ingester names it and dkg:confidence says how sure that naming is." .
dkg:interactionStyle a owl:DatatypeProperty ;
    rdfs:comment "'sync' or 'async'. Set once on the Api; its Operations inherit it. The property that lets a query answer, per context: what can be called, and what is published." .
dkg:apiId a owl:DatatypeProperty ;
    rdfs:comment "OpenAPI x-api-id, verbatim. Stable across versions by house convention, so two Apis with one apiId are ONE API at two versions — a revision (dkg:revisionOf), never a second interface. The revision test for a spec is this field first, label overlap second." .
dkg:apiVersion a owl:DatatypeProperty ; rdfs:comment "info.version, verbatim." .
dkg:audience   a owl:DatatypeProperty ; rdfs:comment "OpenAPI x-audience, verbatim: external-public, external-partner, company-internal, component-internal." .
dkg:protocol   a owl:DatatypeProperty ;
    rdfs:comment "From servers: 'https', 'kafka', 'amqp', 'mqtt', 'grpc'. The one deployment fact worth holding, because it is the integration mechanism the rest of the graph cannot name. Hosts, partitions, retention, exchanges stay in the spec." .

dkg:Operation a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "One thing a caller or a broker can do with the API: an OpenAPI operation (operationId), a gRPC rpc, a GraphQL field, or an AsyncAPI operation (send / receive). The spec-side counterpart of a board Command, a story Activity or a canvas Message — linked with dkg:specifies, never merged with any of them." .
dkg:operationId a owl:DatatypeProperty ; rdfs:comment "Verbatim key: operationId, rpc name, field name, AsyncAPI operation key." .
dkg:httpMethod  a owl:DatatypeProperty ; rdfs:comment "GET, POST, PUT, PATCH, DELETE — verbatim, upper-cased." .
dkg:path        a owl:DatatypeProperty ; rdfs:comment "The path template verbatim: '/catalog-entries/{catalogEntryId}'." .
dkg:action      a owl:DatatypeProperty ;
    rdfs:comment "AsyncAPI 3: 'send' or 'receive', FROM THE PERSPECTIVE OF THE CONTEXT THE API BELONGS TO. A 'receive' operation is this context consuming a message some other context produces — border evidence, and usually the most interesting line in the ingest." .
dkg:requiresScope a owl:DatatypeProperty ;
    rdfs:comment "One per OAuth scope the operation demands, verbatim. Scopes often name roles; a scope that spells an Actor's name is worth a ledger row, not an automatic edge." .
dkg:exposedBy a owl:ObjectProperty ; rdfs:range dkg:Api ;
    rdfs:comment "Operation / Channel / ApiMessage / Schema → the Api that defines it. Structural: it does not count as connecting a node to the MODEL, so a Schema with only this edge is still reported as unlinked." .

dkg:Channel a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "An AsyncAPI channel: WHERE messages flow — a topic, a queue, a routing key. Says nothing about direction; the Operation on it does." .
dkg:address a owl:DatatypeProperty ; rdfs:comment "The channel address verbatim: 'task-management/tasks', 'task.{eventType}'." .
dkg:onChannel a owl:ObjectProperty ; rdfs:range dkg:Channel ; rdfs:comment "AsyncAPI Operation → the Channel it sends to or receives from." .

dkg:ApiMessage a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "A message as an AsyncAPI document defines it (components.messages): name, title, headers, payload. The CONTRACT for a fact — not the fact itself (the board's dkg:DomainEvent) and not the border row (the canvas's dkg:Message). Three nodes from three artifacts, joined by dkg:specifies. Collapsing them would lose the one question the graph exists to answer here: does the board have an event the API never publishes, or the API a message the board never saw?" .
dkg:carriesMessage a owl:ObjectProperty ; rdfs:range dkg:ApiMessage ;
    rdfs:comment "Channel or Operation → an ApiMessage that can appear there." .

dkg:Schema a owl:Class ; rdfs:subClassOf dkg:Node ;
    rdfs:comment "A named schema: components.schemas.<Key>, a protobuf message, a GraphQL type. An API noun. dkg:specifies the Concept it spells when the stem (Key minus a role suffix such as Create/Update/Response/Payload) matches a term the glossary or board holds; a Schema that matches nothing is reported unlinked on purpose — a noun the API introduced that no workshop ever named. Fields stay OUT of the graph: schema-glossary-consistency reads them, field by field, against the glossary." .
dkg:schemaRole a owl:DatatypeProperty ;
    rdfs:comment "read | create | update | request | response | payload | header | error | other — read off the house-style suffix, so dkg:Implied. The verbatim key stays in skos:prefLabel." .
dkg:requestSchema  a owl:ObjectProperty ; rdfs:range dkg:Schema ; rdfs:comment "Operation → the Schema of its request body." .
dkg:responseSchema a owl:ObjectProperty ; rdfs:range dkg:Schema ; rdfs:comment "Operation → the Schema of its success response (200/201)." .
dkg:payloadSchema  a owl:ObjectProperty ; rdfs:range dkg:Schema ; rdfs:comment "ApiMessage → the Schema of its payload." .

dkg:specifies a owl:ObjectProperty ;
    rdfs:label "specifies" ;
    rdfs:comment "Operation → Command / Activity / canvas Message; ApiMessage → DomainEvent / canvas Message; Schema → Concept. 'This contract is the formal form of that model element.' A DIRECT triple only on an exact match after normalisation — case, spacing and punctuation folded, because a spec writes TaskCreated where a sticky wrote Task created, and a camelCase identifier is a spelling of a phrase, not a different word. Even then it is dkg:Implied, never on-artifact: the spec does not cite the sticky. Anything looser is a dkg:Assertion with rdf:predicate dkg:specifies and dkg:Inferred, listed in the merge ledger for the room. Never a merge — the two nodes keep their own classes, sources and confidence. check_graph.py reads this edge for two findings: a model element with no contract, and a contract whose style contradicts the model (a canvas 'evt' behind a synchronous operation; a 'qry' on a message channel)." .
