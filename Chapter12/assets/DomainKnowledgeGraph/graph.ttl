:Q_ArrowDirectionOnContextMap a dkg:Question ;
    skos:prefLabel "Arrows on the context map sometimes leave an OHS and sometimes land on one — do they show data flow, call direction, or upstream→downstream?" ;
    dkg:source :Art_ContextMap ;
    dkg:locator "legend + arrows 1–14" ;
    dkg:confidence dkg:Implied .
:Q_HelpEventsInTwoContexts a dkg:Question ;
    skos:prefLabel "Help requested / Help provided and Help request / Help response are drawn inside both Grandma Avatar AI and Cooking Assistance — who owns them?" ;
    dkg:source :Art_ContextMap ;
    dkg:locator "two bubbles" ;
    dkg:mentions :Con_HelpRequest ;
    dkg:mentions :Con_HelpResponse ;
    dkg:confidence dkg:Implied .
:Q_IngredientsOwner a dkg:Question ;
    skos:prefLabel "Ingredients is a business object in both Recipe Catalog and Meal Planning — one owner or two concepts?" ;
    dkg:source :Art_ContextMap ;
    dkg:locator "two bubbles" ;
    dkg:mentions :Con_Ingredients ;
    dkg:confidence dkg:Implied .
:Q_RobotMarker a dkg:Question ;
    skos:prefLabel "What does the robot icon on 'Meal planning stalled' mean — raised by the system, or sticky proposed by an assistant?" ;
    dkg:source :Art_ContextMap ;
    dkg:locator "Meal Planning bubble" ;
    dkg:confidence dkg:Implied .
:Ev_MealPlanningStalled dkg:raises :Q_RobotMarker .
:Q_ConsentNowhereElse a dkg:Question ;
    skos:prefLabel "Consent Management, Consent and Notification appear on the context map only — which session produced them?" ;
    dkg:source :Art_ContextMap ;
    dkg:locator "left column" ;
    dkg:mentions :Con_Consent ;
    dkg:mentions :Con_Notification ;
    dkg:confidence dkg:Implied .


##############################################################################
# INGEST — Domain Story 'Grandma' — copy with optional boxes (DddMeetsAi_-_Copy_of_Grandma.jpg)  (2026-09-20)
##############################################################################

:Art_Story_GrandmaCopy a dkg:DomainStory ;
    rdfs:label "Domain Story 'Grandma' — copy with optional boxes (DddMeetsAi_-_Copy_of_Grandma.jpg)" ;
    rdfs:comment "6 sentences, no lanes drawn. Three boxes labelled 'optional' around the Pictures work objects. Sentence 6 says 'Grandma', not 'Grandma Avatar'. Sentences 2, 5, 6 split into a/b." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Act_Cook a dkg:Actor ;
    skos:prefLabel "Cook" ;
    dkg:source :Art_Story_GrandmaCopy ;
    dkg:locator "actor pictogram" ;
    dkg:confidence dkg:OnArtifact .
:Act_GrandmaAvatar a dkg:Actor ;
    skos:prefLabel "Grandma Avatar" ;
    dkg:source :Art_Story_GrandmaCopy ;
    dkg:locator "actor pictogram" ;
    dkg:confidence dkg:OnArtifact .
:Act_Grandma a dkg:Actor ;
    skos:prefLabel "Grandma" ;
    dkg:source :Art_Story_GrandmaCopy ;
    dkg:locator "actor pictogram" ;
    dkg:confidence dkg:OnArtifact .
