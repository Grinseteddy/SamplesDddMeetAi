# --- Changed arrows: v1 message kept, v2 message supersedes it ---
:Msg_CM2_01_RecipeCatalog_MealPlanning a dkg:Message ; skos:prefLabel "Recipe Catalog → Meal Planning: GET Recipe" ;
    dkg:from :Ctx_RecipeCatalog ; dkg:to :Ctx_MealPlanning ; dkg:messageKind "?" ;
    dkg:carries "GET Recipe" ; dkg:mentions :Con_Recipe ;
    dkg:supersedes :Msg_CM_01_RecipeCatalog_MealPlanning ;
    rdfs:comment "synchronous; pattern box: OHS at Recipe Catalog; HTTP verb sticky: GET; vs v1: adds GET" ;
    dkg:source :Art_ContextMap_2026_10_v2 ; dkg:locator "arrow 1" ; dkg:confidence dkg:OnArtifact .
:Msg_CM2_02_MealPlanning_CookingAssistance a dkg:Message ; skos:prefLabel "Meal Planning → Cooking Assistance: POST Menu (RM), Ingredietens (RM), Recipe (RM), Help request" ;
    dkg:from :Ctx_MealPlanning ; dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "POST Menu (RM), Ingredietens (RM), Recipe (RM), Help request" ; dkg:mentions :Con_Menu_RM, :Con_Ingredients_RM, :Con_Recipe, :Con_HelpRequest ;
    dkg:supersedes :Msg_CM_02_MealPlanning_CookingAssistance ;
    rdfs:comment "synchronous; pattern box: OHS at Meal Planning; HTTP verb sticky: POST; vs v1: adds POST and Help request; payload group now on the other side of the arrow pair; payload paired with this arrow by position" ;
    dkg:source :Art_ContextMap_2026_10_v2 ; dkg:locator "arrow 2" ; dkg:confidence dkg:Implied .
