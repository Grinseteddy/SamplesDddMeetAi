########## Async API Product Canvases — reified links (Inferred) ##########

:As_AmsgHelpRequestCreated_specifies_EvHelpRequested a dkg:Assertion ;
    rdf:subject :Amsg_HelpRequestCreated ; rdf:predicate dkg:specifies ; rdf:object :Ev_HelpRequested ;
    rdfs:comment "Cooking Assistance SENDS 'Help request created'; the board, Notifications and Grandma Avatar all say 'Help requested'. Payload 'help Request' = 'Help request'. Probably one fact under two names — the room decides which name the contract uses." ;
    dkg:source :Art_AAPC_CookingAssistance ; dkg:confidence dkg:Inferred .
:As_AmsgHelpRequestCreated_sameAs_AmsgHelpRequestedGA a dkg:Assertion ;
    rdf:subject :Amsg_HelpRequestCreated ; rdf:predicate dkg:proposedSameAs ; rdf:object :Amsg_HelpRequested_GrandmaAvatar ;
    rdfs:comment "Context-map arrow 4 (Cooking Assistance → Grandma Avatar AI: Help request, dashed) is the only crossing that could carry it; producer and consumer name the message differently." ;
    dkg:source :Art_AAPC_GrandmaAvatar ; dkg:confidence dkg:Inferred .

:As_AmsgHelpRequestCreated_specifies_Arrow4 a dkg:Assertion ;
    rdf:subject :Amsg_HelpRequestCreated ; rdf:predicate dkg:specifies ; rdf:object :Msg_CookingAssistance_GrandmaAvatarAI ;
    rdfs:comment "context-map arrow 4 (asynchronous) carries 'Help request' from Cooking Assistance to Grandma Avatar AI; this is the message Cooking Assistance sends with payload 'help Request'" ;
    dkg:source :Art_AAPC_CookingAssistance ; dkg:confidence dkg:Inferred .
:As_AmsgHelpRequestedGA_specifies_Arrow4 a dkg:Assertion ;
    rdf:subject :Amsg_HelpRequested_GrandmaAvatar ; rdf:predicate dkg:specifies ; rdf:object :Msg_CookingAssistance_GrandmaAvatarAI ;
    rdfs:comment "receiving side of context-map arrow 4" ;
    dkg:source :Art_AAPC_GrandmaAvatar ; dkg:confidence dkg:Inferred .
:As_AmsgHelpProvidedGA_specifies_Arrow5 a dkg:Assertion ;
    rdf:subject :Amsg_HelpProvided_GrandmaAvatar ; rdf:predicate dkg:specifies ; rdf:object :Msg_GrandmaAvatarAI_CookingAssistance ;
    rdfs:comment "context-map arrow 5 (asynchronous) carries 'Help response' from Grandma Avatar AI to Cooking Assistance; the canvas sends 'Help provided' with payload 'Help'" ;
    dkg:source :Art_AAPC_GrandmaAvatar ; dkg:confidence dkg:Inferred .
:As_AmsgHelpProvidedCA_specifies_Arrow5 a dkg:Assertion ;
    rdf:subject :Amsg_HelpProvided_CookingAssistance ; rdf:predicate dkg:specifies ; rdf:object :Msg_GrandmaAvatarAI_CookingAssistance ;
    rdfs:comment "receiving side of context-map arrow 5" ;
    dkg:source :Art_AAPC_CookingAssistance ; dkg:confidence dkg:Inferred .
:As_AmsgHelpRequested_specifies_Arrow6 a dkg:Assertion ;
    rdf:subject :Amsg_HelpRequested ; rdf:predicate dkg:specifies ; rdf:object :Msg_CookingAssistance_Notification ;
    rdfs:comment "context-map arrow 6 (asynchronous) carries 'Help request, Help response' from Cooking Assistance to Notification; Notifications receives 'Help requested' — but Cooking Assistance sends 'Help request created'" ;
    dkg:source :Art_AAPC_Notifications ; dkg:confidence dkg:Inferred .
:As_AmsgHelpProvided_specifies_Arrow6 a dkg:Assertion ;
    rdf:subject :Amsg_HelpProvided ; rdf:predicate dkg:specifies ; rdf:object :Msg_CookingAssistance_Notification ;
    rdfs:comment "context-map arrow 6; Notifications receives 'Help provided', Cooking Assistance sends 'Help provided'" ;
    dkg:source :Art_AAPC_Notifications ; dkg:confidence dkg:Inferred .

########## Async API Product Canvases — open questions ##########

:Q_AAPC_HelpRequestCreatedVsHelpRequested a dkg:Question ;
    skos:prefLabel "Cooking Assistance sends 'Help request created'; Notifications and Grandma Avatar receive 'Help requested' (the board's event). Nobody receives what is sent, and nobody sends what is received — which name does the contract use?" ;
    dkg:source :Art_AAPC_CookingAssistance ; dkg:locator "Events Send, sticky 1" ;
    dkg:mentions :Con_HelpRequest ;
    dkg:confidence dkg:Inferred .
:Op_CookingAssistanceAsync_Send_HelpRequestCreated dkg:raises :Q_AAPC_HelpRequestCreatedVsHelpRequested .
:Op_NotificationsAsync_Receive_HelpRequested dkg:raises :Q_AAPC_HelpRequestCreatedVsHelpRequested .
:Op_GrandmaAvatar_Receive_HelpRequested dkg:raises :Q_AAPC_HelpRequestCreatedVsHelpRequested .

:Q_AAPC_WhoPublishesHelpProvided a dkg:Question ;
    skos:prefLabel "'Help provided' is SENT by both Cooking Assistance and Grandma Avatar, and Cooking Assistance also RECEIVES it. One event with two publishers, or two events (AI help vs community/chef help)? And does Cooking Assistance re-publish the Grandma Avatar's event?" ;
    dkg:source :Art_AAPC_CookingAssistance ; dkg:locator "Events Receive sticky 1 + Events Send sticky 2" ;
    dkg:mentions :Con_Help ;
    dkg:confidence dkg:Inferred .
:Op_CookingAssistanceAsync_Send_HelpProvided dkg:raises :Q_AAPC_WhoPublishesHelpProvided .
:Op_CookingAssistanceAsync_Receive_HelpProvided dkg:raises :Q_AAPC_WhoPublishesHelpProvided .
:Op_GrandmaAvatar_Send_HelpProvided dkg:raises :Q_AAPC_WhoPublishesHelpProvided .
:Op_NotificationsAsync_Receive_HelpProvided dkg:raises :Q_AAPC_WhoPublishesHelpProvided .

:Q_AAPC_NotificationsHelpProvidedPayload a dkg:Question ;
    skos:prefLabel "Notifications expects the payload of 'Help provided' to be 'Help provided'; both publishers send 'help' / 'Help'. Contract drift, or a different payload?" ;
    dkg:source :Art_AAPC_Notifications ; dkg:locator "Payload (receive), sticky 2" ;
    dkg:mentions :Con_Help ;
    dkg:confidence dkg:Inferred .
:Amsg_HelpProvided dkg:raises :Q_AAPC_NotificationsHelpProvidedPayload .

:Q_AAPC_GrandmaAvatarName a dkg:Question ;
    skos:prefLabel "The canvas is titled 'Grandma Avatar' and its note says 'Cook Assistance'; the context map calls the contexts 'Grandma Avatar AI' and 'Cooking Assistance'. Which names are the contexts' names?" ;
    dkg:source :Art_AAPC_GrandmaAvatar ; dkg:locator "title + Notes" ;
    dkg:mentions :Con_GrandmaAvatar ;
    dkg:confidence dkg:Inferred .
:Api_GrandmaAvatar dkg:raises :Q_AAPC_GrandmaAvatarName .

:Q_AAPC_NoChannels a dkg:Question ;
    skos:prefLabel "None of the three async canvases names an exchange, queue or routing key — on RabbitMQ, where does each message flow, and who owns the exchange?" ;
    dkg:source :Art_AAPC_CookingAssistance ; dkg:locator "whole canvas" ;
    dkg:confidence dkg:Inferred .
:Api_NotificationsAsync dkg:raises :Q_AAPC_NoChannels .
:Api_CookingAssistanceAsync dkg:raises :Q_AAPC_NoChannels .
:Api_GrandmaAvatar dkg:raises :Q_AAPC_NoChannels .

:Q_AAPC_UnpublishedBoardEvents a dkg:Question ;
    skos:prefLabel "Only the two help events have an async contract. No canvas publishes Cook registered, Dinner planned, Meal plan setteled, Recipe selected, Meal preparation started, Catastrophe happened, Step unclear, Step competeted, Meal prepared, Meal rescued, Pictures taken, Thanks given … — internal facts, or async canvases still to draw?" ;
    dkg:source :Art_AAPC_Notifications ; dkg:locator "Events Send (empty)" ;
    dkg:confidence dkg:Inferred .
:Api_NotificationsAsync dkg:raises :Q_AAPC_UnpublishedBoardEvents .

# bearing on questions already in the graph
:Api_GrandmaAvatar dkg:raises :Q_APC_HelpVsHelpResponse .        # its note says 'help response', its sticky says 'Help'
:Api_CookingAssistanceAsync dkg:raises :Q_HelpEventsInTwoContexts .
:Api_GrandmaAvatar dkg:raises :Q_HelpEventsInTwoContexts .
:Api_CookingAssistanceAsync dkg:raises :Q_APC_TemplateProtocol .  # template text left in Quality requirements / Notes

