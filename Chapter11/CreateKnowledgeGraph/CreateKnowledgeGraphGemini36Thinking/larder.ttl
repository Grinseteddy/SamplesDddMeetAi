# =============================================================================
# Bounded Contexts & Strategic Domains
# =============================================================================

larder:CoreDomain a dkg:BoundedContext ; rdfs:label "Core Domain" .
larder:SupportingDomain a dkg:BoundedContext ; rdfs:label "Supporting Domain" .
larder:GenericDomain a dkg:BoundedContext ; rdfs:label "Generic Domain" .

larder:phase_onboarding a dkg:BoundedContext ; rdfs:label "Onboarding Phase" .
larder:phase_cooking a dkg:BoundedContext ; rdfs:label "Cooking Phase" .
