:Cap_ContentCreation dkg:proposedSameAs :Cluster_ContentCreation ; rdfs:comment "exact label; KeyActivity vs brainstorm Cluster (cross-class)" .
:Cap_ContentRating dkg:proposedSameAs :Cluster_ContentRating ; rdfs:comment "exact label; KeyActivity vs brainstorm Cluster" .
:Cap_CookingSupport dkg:proposedSameAs :Cluster_CookingSupport, :Goal_SupportCooking, :VP_CookingSupport ; rdfs:comment "one phrase as cluster, key activity, value proposition and Wardley need" .
:Cap_RecipeSearch dkg:proposedSameAs :Cluster_RecipeSearch, :Cap_AdvancedSearch ; rdfs:comment "exact label with the brainstorm cluster; Wardley draws 'Advanced Search'" .
:VP_AIProposals dkg:proposedSameAs :Del_AIProposals ; rdfs:comment "exact label; VP vs Deliverable" .
:VP_Planner dkg:proposedSameAs :Del_Planner, :Cluster_Planner ; rdfs:comment "exact label; VP vs Deliverable vs Cluster" .
:VP_EasyToFindRecipes dkg:proposedSameAs :Imp_FindEasilyRecipes, :Goal_SearchRecipesWithNutritionMeals ; rdfs:comment "VP vs impact vs Wardley need" .
:VP_RecipesForSpecializedNutritionRequirements dkg:proposedSameAs :Del_NutritionRequirementManagement, :Imp_FollowsDietryPlans .
:RS_MonthlyMemberFee dkg:proposedSameAs :Imp_ConvertToPaidPlan ; rdfs:comment "the revenue stream the impact-map goal counts" .
