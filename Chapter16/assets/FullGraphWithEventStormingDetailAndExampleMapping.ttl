    dkg:source :Art_Glossary_HelpRequest ; dkg:confidence dkg:OnArtifact .

# --- invariants (purple 🔒) ---
:R_HR_ChefSupportOnlyForMenuProposal a dkg:Rule ; skos:prefLabel "Chef support only for menu proposal" ;
    dkg:mentions :Con_HelpRequest, :Con_Type, :Con_Chef_HRProvider ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "beside 'Menu proposal' (type)" ; dkg:confidence dkg:OnArtifact .
:R_HR_RecipeMandatoryForPSEAndIS a dkg:Rule ; skos:prefLabel "Mandatory — Preparation Step Explanation — Ingredient Substitute" ;
    dkg:mentions :Con_HelpRequest, :Con_Recipe_HR, :Con_Type ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "three stickies beside 'recipe' 0..1" ; dkg:confidence dkg:OnArtifact .
:R_HR_HowToStepOnlyForPSE a dkg:Rule ; skos:prefLabel "Only for type — Preparation Step Explanation" ;
    dkg:mentions :Con_HelpRequest, :Con_HowToStep, :Con_Type ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "two stickies beside 'howTo Step' 0..1" ; dkg:confidence dkg:OnArtifact .
:R_HR_IngredientsOnlyForIS a dkg:Rule ; skos:prefLabel "Only for type — Ingredient Substitute" ;
    dkg:mentions :Con_HelpRequest, :Con_Ingredients_HR, :Con_Type ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "two stickies beside 'ingredients' 0..*" ; dkg:confidence dkg:OnArtifact .
:R_HR_ChefHelpExclusive a dkg:Rule ; skos:prefLabel "Chef help is porovided exclusively" ;
    dkg:mentions :Con_HelpRequest, :Con_PreferredProvider, :Con_Chef_HRProvider ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "beside 'Chef' (preferred Provider); spelling as written" ; dkg:confidence dkg:OnArtifact .
:R_HR_ChefOnlyForMenuProposal a dkg:Rule ; skos:prefLabel "Only for type — Menu proposal" ;
    dkg:mentions :Con_HelpRequest, :Con_PreferredProvider, :Con_Type ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "two stickies beside 'Chef' (preferred Provider)" ; dkg:confidence dkg:OnArtifact .
:R_HR_AnsweredNeedsHelp a dkg:Rule ; skos:prefLabel "At least one Help must answer it" ;
    dkg:mentions :Con_HelpRequest, :Con_Status, :Con_Help ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "beside 'Answered' (status)" ; dkg:confidence dkg:OnArtifact .

# --- cross-artifact proposals ---
:Con_Recipe_HR dkg:proposedSameAs :Con_Recipe ; rdfs:comment "proposedSameAs Con_Recipe: a value-object reference to a Recipe vs the glossary term itself" .
:Con_Ingredients_HR dkg:proposedSameAs :Con_Ingredients ; rdfs:comment "proposedSameAs Con_Ingredients: references vs the story/board work object" .
:Con_HowToStep dkg:proposedSameAs :Con_Step ; rdfs:comment "proposedSameAs Con_Step: glossary v2 'Step' (Recipe contains Step 1..*)" .
:Con_Requester dkg:proposedSameAs :Con_Subject ;
    rdfs:comment "proposedSameAs Con_Subject: the two models give the identical example UUID f64e07f0-… for 'requester' and for consent 'subject' — the cook who requests help is the cook who consents" .
:Con_Description dkg:proposedSameAs :Con_MealPreparationCatastrophe ;
    rdfs:comment "weak: the example description ('Scones are burned and mother in law is coming in 30 minutes') is story E's burnt meal plus story A's parents-in-law dinner" .

# --- CONTRADICTION: who a Help Request goes to ---
:As_HR_AtCommunityAndGrandma_G2 a dkg:Assertion ;
    rdf:subject :Con_HelpRequest ; rdf:predicate dkg:mentions ; rdf:object :Con_HelpProvider ;
    rdfs:comment "Glossary v1 and v2: 'Help Request at 1 Community' AND 'Help Request at 1 Grandma Avatar' — both mandatory, no Chef." ;
    dkg:source :Art_Glossary_2026_10, :Art_Glossary_2026_10_v2 ; dkg:confidence dkg:OnArtifact .
:As_HR_PreferredProvider_Model a dkg:Assertion ;
    rdf:subject :Con_HelpRequest ; rdf:predicate dkg:mentions ; rdf:object :Con_HelpProvider ;
    rdfs:comment "Help Request model: 'contains preferred Provider 1..2', values Chef | Grandma Avatar | Community; Chef only for type Menu proposal, and exclusively." ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:confidence dkg:OnArtifact ;
    dkg:contradicts :As_HR_AtCommunityAndGrandma_G2 .
:Q_HelpRequestAtWhom rdfs:comment "Help Request model: 'preferred Provider 1..2' from Chef | Grandma Avatar | Community — recorded as dkg:contradicts against the glossary's two mandatory 'at 1' ends." ; dkg:source :Art_Glossary_HelpRequest .

# --- Questions this model raises ---
:Q_TypeValuesVsHelpContents a dkg:Question ;
    skos:prefLabel "Are Ingredient Substitute, Preparation Step Explanation, Steps to Mitigate Catastrophe and Menu proposal kinds of request, or contents of a help?" ;
    rdfs:comment "Glossary v1/v2: Help CONTAINS them, and Help Request has its own subtypes (Meal Preparation Catastrophe, Help for Meal Preparation Step, Help with Ingredients, Help Meal plan). Help Request model: they are the values of Help Request's 'type'. Kept as separate nodes, proposed same." ;
    dkg:source :Art_Glossary_HelpRequest, :Art_Glossary_2026_10_v2 ; dkg:locator "type value set" ; dkg:confidence dkg:Implied .
:Art_Glossary_HelpRequest dkg:raises :Q_TypeValuesVsHelpContents .
:Q_HelpRequestStateNames a dkg:Question ;
    skos:prefLabel "Open / Answered, or REQUESTED / PROVIDED?" ;
    rdfs:comment "Help Request model status values: Open, Answered. Board v2 state stickies: Help REQUESTED, Help PROVIDED. Sync canvas invariant: 'Only in status open'." ;
    dkg:source :Art_Glossary_HelpRequest, :Art_ESBoard_2026_10_v2 ; dkg:locator "status value set; board v2 Cook Assistance lanes" ; dkg:confidence dkg:Implied .
:Art_Glossary_HelpRequest dkg:raises :Q_HelpRequestStateNames .
:Q_HelpRequestMealAndPictures a dkg:Question ;
    skos:prefLabel "Where did 'belongs 1 Meal' and 'contains Picture 0..10' go?" ;
    rdfs:comment "Glossary v2: Help Request belongs 1 Meal and contains Picture 0..10. The Help Request model has neither — it has recipe 0..1 instead. Story E sends Pictures with the help request." ;
    dkg:source :Art_Glossary_HelpRequest, :Art_Glossary_2026_10_v2 ; dkg:locator "whole model" ; dkg:confidence dkg:Implied .
:Art_Glossary_HelpRequest dkg:raises :Q_HelpRequestMealAndPictures .
:Q_ChefNotInGlossary rdfs:comment "Help Request model: Chef is a preferred Provider only for type Menu proposal, and 'Chef help is porovided exclusively'; sync canvas: Chef's help is visible only to the original requester." ; dkg:source :Art_Glossary_HelpRequest, :Art_APC_CookingAssistance_Sync .
:Q_StateOwner rdfs:comment "Help Request model makes Help Request the aggregate and draws its status values (Open, Answered) — one of the board's state owners now has an aggregate sticky." ; dkg:source :Art_Glossary_HelpRequest .

