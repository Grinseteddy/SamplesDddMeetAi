{
  "name": "cook-assistance",
  "version": "0.1.0",
  "private": true,
  "description": "Cook Assistance bounded context of Larder \u2014 built with the implementation blueprint and EXACT Coding",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "npm --prefix tools/codegen run generate",
    "pretest": "npm run generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\" \"tools/**/*.mjs\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tools/**/*.mjs\" \"*.{js,ts,json}\"",
    "test:acceptance": "NODE_OPTIONS='--import tsx' cucumber-js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "12.2.1",
    "@testcontainers/rabbitmq": "12.2.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@asyncapi/parser": "3.6.3",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.2.0",
    "express": "5.2.1",
    "express-openapi-validator": "5.6.2",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1"
  }
}
