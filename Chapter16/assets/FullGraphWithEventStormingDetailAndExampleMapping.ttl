    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → description" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequest dkg:mentions :Con_Description .
:Rel_HR_ContainsRecipe_HR a dkg:Relationship ; skos:prefLabel "Help Request contains recipe" ;
    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_Recipe_HR ; dkg:cardinality "0..1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → recipe" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequest dkg:mentions :Con_Recipe_HR .
:Rel_HR_ContainsHowToStep a dkg:Relationship ; skos:prefLabel "Help Request contains howTo Step" ;
    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_HowToStep ; dkg:cardinality "0..1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → howTo Step" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequest dkg:mentions :Con_HowToStep .
:Rel_HR_ContainsIngredients_HR a dkg:Relationship ; skos:prefLabel "Help Request contains ingredients" ;
    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_Ingredients_HR ; dkg:cardinality "0..*" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → ingredients" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequest dkg:mentions :Con_Ingredients_HR .
:Rel_HR_ContainsPreferredProvider a dkg:Relationship ; skos:prefLabel "Help Request contains preferred Provider" ;
    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_PreferredProvider ; dkg:cardinality "1..2" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → preferred Provider" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequest dkg:mentions :Con_PreferredProvider .
:Rel_HR_ContainsStatus a dkg:Relationship ; skos:prefLabel "Help Request contains status" ;
    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_Status ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → status" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequest dkg:mentions :Con_Status .

