    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_Type ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → type" ; dkg:confidence dkg:OnArtifact .
