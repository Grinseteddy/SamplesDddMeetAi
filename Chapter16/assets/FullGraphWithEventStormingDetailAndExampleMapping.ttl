# Ingest — API contract 'Notifications API 1.0.0 (OpenAPI 3.1)' (notifications.openapi.yaml), 2026-10-10. Grow.
# DERIVED DOCUMENT: generated from canvas + model; everything new is dkg:Inferred,
# sourced to the contract. Existing nodes are NOT re-sourced (no false corroboration).
##############################################################################
:Art_API_Notifications_OAS a dkg:Artifact ;
    rdfs:label "Notifications API — OpenAPI 3.1, version 1.0.0 (notifications.openapi.yaml)" ;
    rdfs:comment "OpenAPI draft derived from the Notifications sync canvas and Notification model. Server normalised to https://larder.org (canvas: https://larder.org/notifications). Provisional bearer auth, audience component-internal, house-style version header. receiver: array of UUIDs, minItems 1; status NEW/READ shared across receivers; PUT …/status accepts READ only; DELETE removes the aggregate for all receivers, 204 also when absent. Lists design assumptions for domain review." ;
    dkg:mentions :Ctx_Notification ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Q_NotifPerReceiverState a dkg:Question ; skos:prefLabel "Is a notification's read status and deletion per receiver or shared?" ;
    rdfs:comment "The model has one status per Notification but 1..* receivers; the contract keeps one shared status and aggregate-wide delete and flags receiver-specific read tracking/dismissal as an unresolved domain choice." ; dkg:mentions :Con_Status_Notif, :Con_Notification ;
    dkg:source :Art_API_Notifications_OAS ; dkg:locator "x-design-assumptions; PUT/DELETE descriptions" ; dkg:confidence dkg:Inferred .
:Art_API_Notifications_OAS dkg:raises :Q_NotifPerReceiverState .
:Q_NotifCommunityChefResolution a dkg:Question ; skos:prefLabel "How is 'the whole community or Chef' resolved into receiver ids?" ;
    rdfs:comment "Receiver is a cook UUID; the rule 'Help requests go to whole community or Chef' names groups. The contract leaves community-versus-Chef identity resolution unspecified." ; dkg:mentions :R_HelpRequestsGoToCommunityOrChef ;
    dkg:source :Art_API_Notifications_OAS ; dkg:locator "schemas.Receiver; x-design-assumptions" ; dkg:confidence dkg:Inferred .
:Art_API_Notifications_OAS dkg:raises :Q_NotifCommunityChefResolution .
:Q_NotificationOperationsGaps rdfs:comment "Notifications OpenAPI: interprets the missing 404 on DELETE as 'already absent returns 204'; PUT status without notificationId parameter fixed by adding the path id." ; dkg:source :Art_API_Notifications_OAS .

