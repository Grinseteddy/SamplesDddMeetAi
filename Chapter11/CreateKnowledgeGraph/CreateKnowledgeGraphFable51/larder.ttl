# POST-INGEST — ledger completions and cross-artifact contradictions found
# after all eight artifacts were in. 2026-09-10
##############################################################################
:Cmd_Share dkg:proposedSameAs :Cmd_Shares ; rdfs:comment "Competition story 'share' (plural actor) vs 'shares' elsewhere" .
:Con_Recipe dkg:proposedSameAs :Con_RecipeCatalog_ES ; rdfs:comment "entry vs catalogue" .
:Con_Rating dkg:proposedSameAs :Cap_RatingDatabase .
:Con_MealPreparationSkill dkg:proposedSameAs :Con_MealPreparation, :Idea_CookingSkillLevel ; rdfs:comment "Competition story's 'Meal Preparation Skill' vs brainstorm 'Cooking skill level'" .
:Act_CommunityCook rdfs:comment "board responder role; not proposed against 'Cook' — a different role on the same board (responder vs requester)" .
:Con_Catastrophe_ES dkg:proposedSameAs :Con_CatastrophePictures ; rdfs:comment "read model 'Catastrophe' vs story 'Catastrophe Pictures' — containment, probably two concepts" .

# Capability map calls Content Creation CORE; the Wardley map places every
# content-creation component (Write recipe, Upload media) at COMMODITY.
:As_ContentCreationCore_CM a dkg:Assertion ; rdf:subject :Cap_ContentCreation_CM ; rdf:predicate rdfs:comment ; rdf:object "core" ;
    dkg:source :Art_CapMap ; dkg:confidence dkg:OnArtifact ; dkg:contradicts :As_CreateContentCommodity_W .
:As_CreateContentCommodity_W a dkg:Assertion ; rdf:subject :Cap_WriteRecipe ; rdf:predicate dkg:evolution ; rdf:object dkg:Commodity ;
    rdfs:comment "Write recipe and Upload media, the components under the need 'Create content', sit in the Commodity band" ;
    dkg:source :Art_Wardley ; dkg:confidence dkg:Inferred ; dkg:contradicts :As_ContentCreationCore_CM .

# Capability map calls Grandma / Grandpa CORE; the impact map gives
# 'Grandma / Grandpa AI' the LOWEST priority (3) of all deliverables.
:As_GrandmaCore_CM a dkg:Assertion ; rdf:subject :Cap_GrandmaGrandpa_CM ; rdf:predicate rdfs:comment ; rdf:object "core" ;
    dkg:source :Art_CapMap ; dkg:confidence dkg:OnArtifact ; dkg:contradicts :As_GrandmaPriority3_IM .
:As_GrandmaPriority3_IM a dkg:Assertion ; rdf:subject :Del_GrandmaGrandpaAI ; rdf:predicate rdfs:comment ; rdf:object "priority 3" ;
    rdfs:comment "the deliverable the four domain stories and the board revolve around carries the lowest priority number on the impact map" ;
    dkg:source :Art_ImpactMap ; dkg:confidence dkg:OnArtifact ; dkg:contradicts :As_GrandmaCore_CM .

# Board: Grandma Avatar is an EXTERNAL SYSTEM (pink gear). Stories: a person-
# pictogram actor who is asked, provides, and is thanked.
:As_AvatarExternalSystem_ES a dkg:Assertion ; rdf:subject :Act_GrandmaAvatar ; rdf:predicate rdf:type ; rdf:object dkg:ExternalSystem ;
    dkg:source :Art_ES ; dkg:confidence dkg:OnArtifact ; dkg:contradicts :As_AvatarPersonActor_Story .
:As_AvatarPersonActor_Story a dkg:Assertion ; rdf:subject :Act_GrandmaAvatar ; rdf:predicate rdf:type ; rdf:object dkg:Actor ;
    rdfs:comment "drawn with the person pictogram in stories Grandma and GrandmaII; thanked in sentence 6 like a human responder" ;
    dkg:source :Art_StoryGrandma, :Art_StoryGrandmaII ; dkg:confidence dkg:OnArtifact ; dkg:contradicts :As_AvatarExternalSystem_ES .
