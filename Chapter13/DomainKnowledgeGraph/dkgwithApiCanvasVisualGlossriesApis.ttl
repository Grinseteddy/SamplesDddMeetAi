:Q_GrandmaPriority3 a dkg:Question ;
    skos:prefLabel "'Grandma / Grandpa AI' is priority 3 (lowest) on the impact map, yet it is the subject of 3 of 6 stories, a context on the map and the responder on the board — is the modelling effort aimed where the strategy is?" ;
    dkg:source :Art_ImpactMap ;
    dkg:locator "DELIVERABLES column, sticky 10" ;
    dkg:mentions :Act_GrandmaAvatar ;
    dkg:confidence dkg:Implied .
:Del_GrandmaGrandpaAI dkg:raises :Q_GrandmaPriority3 .
:Q_ImpactLinesUntraceable a dkg:Question ;
    skos:prefLabel "Which actor has which impact? The actor→impact lines cannot be traced on the picture." ;
    dkg:source :Art_ImpactMap ;
    dkg:locator "between ACTORS and IMPACT" ;
    dkg:confidence dkg:Implied .
:Q_NoHelpDeliverable a dkg:Question ;
    skos:prefLabel "No deliverable names a community help request / response flow ('Cooking club'? 'Content'?) — which deliverable are Cooking Assistance, Media, Sharing and Notification realising?" ;
    dkg:source :Art_ImpactMap ;
    dkg:locator "DELIVERABLES column" ;
    dkg:mentions :Con_HelpRequest ;
    dkg:confidence dkg:Implied .
:Q_ImpactsThatAreBusinessOutcomes a dkg:Question ;
    skos:prefLabel "'Cookbooks make curious', 'supports unexperienced members' — whose behaviour changes?" ;
    dkg:source :Art_ImpactMap ;
    dkg:locator "green impacts" ;
    dkg:confidence dkg:Implied .

##############################################################################
# INGEST — API Product Canvases (synchronous), 9 canvases  (2026-10-03)
# Hand-transcribed (canvases are pictures, not YAML). Every node OnArtifact;
# schema→concept links are direct only on an exact (case/space/hyphen-folded)
# match and Implied; everything looser is a reified dkg:Assertion, Inferred.
##############################################################################

########## API Product Canvas (synchronous) — Consent Management ##########

:Art_APC_ConsentManagement a dkg:SyncApiSpec ;
    rdfs:label "Consent Management — API Product Canvas (synchronous), version 1.0.0" ;
    rdfs:comment "ConsentManagementApiProductCanvasSynchronous.jpg. 6 operations. Server https://larder.org/consent-management. Contact annegret.junker@larder.org." ;
    dkg:specFormat "API Product Canvas (synchronous)" ;
    dkg:ingestedAt "2026-10-03"^^xsd:date .

:Api_ConsentManagement a dkg:Api ;
    skos:prefLabel "Consent Management" ;
    rdfs:comment "Value propositions: Manages consents of the platform. Core functions: Creates and revokes consent. Sync protocol as written: 'e.g. http'; Architecture pattern as written: 'e.g. RESTful oriented'. Both still carry the template's 'e.g.' text, so no dkg:protocol is recorded. dkg:inContext is Implied: the canvas title names the context." ;
    dkg:interactionStyle "sync" ;
    dkg:apiVersion "1.0.0" ;
    dkg:inContext :Ctx_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "header" ;
    dkg:confidence dkg:OnArtifact .

:Sch_ConsentManagement_Consents a dkg:Schema ;
    skos:prefLabel "consents" ;
    dkg:schemaRole "read" ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents GET 200" ;
    dkg:confidence dkg:OnArtifact .
:As_Sch_ConsentManagement_Consents_specifies_Con_Consent a dkg:Assertion ;
    rdf:subject :Sch_ConsentManagement_Consents ; rdf:predicate dkg:specifies ; rdf:object :Con_Consent ;
    rdfs:comment "collection response of Consent; plural of the business object" ;
    dkg:source :Art_APC_ConsentManagement ; dkg:confidence dkg:Inferred .

:Sch_ConsentManagement_Consent a dkg:Schema ;
    skos:prefLabel "consent" ;
    dkg:schemaRole "read" ;
    dkg:schemaRole "request" ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents POST request" ;
    dkg:locator "/consents/{consentId} GET 200" ;
    dkg:confidence dkg:OnArtifact .
:Sch_ConsentManagement_Consent dkg:specifies :Con_Consent .    # exact (folded) label match — Implied

:Sch_ConsentManagement_ConsentTexts a dkg:Schema ;
    skos:prefLabel "consent-texts" ;
    dkg:schemaRole "read" ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/consent-texts GET 200" ;
    dkg:confidence dkg:OnArtifact .

:Sch_ConsentManagement_ConsentText a dkg:Schema ;
    skos:prefLabel "consent-text" ;
    dkg:schemaRole "read" ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/consent-texts/{consentTextId} GET 200" ;
    dkg:confidence dkg:OnArtifact .

:R_ConsentManagement_CreationAndChangeOfConsentTextsOnlyViaBackend a dkg:Rule ;
    skos:prefLabel "Creation and change of consent texts only via backend" ;
    dkg:inContext :Ctx_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/consent-texts GET row" ;
    dkg:confidence dkg:OnArtifact .

:Op_ConsentManagement_GET_Consents a dkg:Operation ;
    skos:prefLabel "GET /consents" ;
    rdfs:comment "parameters: subject · request: — · success: 200: consents · errors: 400, 401, 403, 500, default" ;
    dkg:httpMethod "GET" ;
    dkg:path "/consents" ;
    dkg:messageKind "qry" ;
    dkg:responseSchema :Sch_ConsentManagement_Consents ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents row, GET" ;
    dkg:confidence dkg:OnArtifact .

:Op_ConsentManagement_POST_Consents a dkg:Operation ;
    skos:prefLabel "POST /consents" ;
    rdfs:comment "parameters: — · request: consent · success: 201: Link to created consent · errors: 400, 401, 403, 500, default" ;
    dkg:httpMethod "POST" ;
    dkg:path "/consents" ;
    dkg:messageKind "cmd" ;
    dkg:requestSchema :Sch_ConsentManagement_Consent ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents row, POST" ;
    dkg:confidence dkg:OnArtifact .
:Op_ConsentManagement_POST_Consents dkg:mentions :Con_Consent .

:Op_ConsentManagement_GET_ConsentsByConsentId a dkg:Operation ;
    skos:prefLabel "GET /consents/{consentId}" ;
    rdfs:comment "parameters: consent Id · request: — · success: 200: consent · errors: 400, 401, 403, 404, 500, default" ;
    dkg:httpMethod "GET" ;
    dkg:path "/consents/{consentId}" ;
    dkg:messageKind "qry" ;
    dkg:responseSchema :Sch_ConsentManagement_Consent ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/{consentId} row, GET" ;
    dkg:confidence dkg:OnArtifact .
:Op_ConsentManagement_GET_ConsentsByConsentId dkg:mentions :Con_Consent .

:Op_ConsentManagement_DELETE_ConsentsByConsentId a dkg:Operation ;
    skos:prefLabel "DELETE /consents/{consentId}" ;
    skos:altLabel "Revokes consent" ;
    rdfs:comment "parameters: consent Id · request: — · success: 204 · errors: 400, 401, 403, 404, 500, default" ;
    dkg:httpMethod "DELETE" ;
    dkg:path "/consents/{consentId}" ;
    dkg:messageKind "cmd" ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/{consentId} row, DELETE" ;
    dkg:confidence dkg:OnArtifact .

:Op_ConsentManagement_GET_ConsentsConsentTexts a dkg:Operation ;
    skos:prefLabel "GET /consents/consent-texts" ;
    rdfs:comment "parameters: — · request: — · success: 200: consent-texts · errors: 400, 401, 403, 500, default" ;
    dkg:httpMethod "GET" ;
    dkg:path "/consents/consent-texts" ;
    dkg:messageKind "qry" ;
    dkg:responseSchema :Sch_ConsentManagement_ConsentTexts ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/consent-texts row, GET" ;
    dkg:confidence dkg:OnArtifact .
:Op_ConsentManagement_GET_ConsentsConsentTexts dkg:dependsOn :R_ConsentManagement_CreationAndChangeOfConsentTextsOnlyViaBackend .    # guard sticky drawn in this operation's row

:Op_ConsentManagement_GET_ConsentsConsentTextsByConsentTextId a dkg:Operation ;
    skos:prefLabel "GET /consents/consent-texts/{consentTextId}" ;
    rdfs:comment "parameters: consent Text Id · request: — · success: 200: consent-text · errors: 400, 401, 403, 404, 500, default" ;
    dkg:httpMethod "GET" ;
    dkg:path "/consents/consent-texts/{consentTextId}" ;
    dkg:messageKind "qry" ;
    dkg:responseSchema :Sch_ConsentManagement_ConsentText ;
    dkg:exposedBy :Api_ConsentManagement ;
    dkg:source :Art_APC_ConsentManagement ;
    dkg:locator "/consents/consent-texts/{consentTextId} row, GET" ;
    dkg:confidence dkg:OnArtifact .

########## API Product Canvas (synchronous) — Cooking Assistance ##########

:Art_APC_CookingAssistance a dkg:SyncApiSpec ;
    rdfs:label "Cooking Assistance — API Product Canvas (synchronous), version 1.0.0" ;
    rdfs:comment "CookingAssistanceApiProductCanvasSynchronous.jpg. 10 operations. Server https://larder.org/cooking-assistance. Contact annegret.junker@larder.org. Five purple stickies carry a padlock icon." ;
    dkg:specFormat "API Product Canvas (synchronous)" ;
    dkg:ingestedAt "2026-10-03"^^xsd:date .

:Api_CookingAssistance a dkg:Api ;
    skos:prefLabel "Cooking Assistance" ;
    rdfs:comment "Value propositions: Provides help for cooks in planning and preparation of meals and dinners. Core functions: Cooks can create help requests and select who can answer them, help providers are community, AI, and chefs. Sync protocol as written: 'e.g. http'; Architecture pattern as written: 'e.g. RESTful oriented'. Both still carry the template's 'e.g.' text, so no dkg:protocol is recorded. dkg:inContext is Implied: the canvas title names the context." ;
    dkg:interactionStyle "sync" ;
    dkg:apiVersion "1.0.0" ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_APC_CookingAssistance ;
    dkg:locator "header" ;
    dkg:confidence dkg:OnArtifact .

:Sch_CookingAssistance_HelpRequests a dkg:Schema ;
    skos:prefLabel "help requests" ;
    dkg:schemaRole "read" ;
    dkg:exposedBy :Api_CookingAssistance ;
    dkg:source :Art_APC_CookingAssistance ;
    dkg:locator "/help-requests GET 200" ;
    dkg:confidence dkg:OnArtifact .
:As_Sch_CookingAssistance_HelpRequests_specifies_Con_HelpRequest a dkg:Assertion ;
    rdf:subject :Sch_CookingAssistance_HelpRequests ; rdf:predicate dkg:specifies ; rdf:object :Con_HelpRequest ;
    rdfs:comment "collection response of Help request; plural" ;
    dkg:source :Art_APC_CookingAssistance ; dkg:confidence dkg:Inferred .

:Sch_CookingAssistance_HelpRequest a dkg:Schema ;
    skos:prefLabel "Help request" ;
    skos:altLabel "help Request" ;
    dkg:schemaRole "read" ;
    dkg:schemaRole "request" ;
    dkg:exposedBy :Api_CookingAssistance ;
