:Cap_GenAI a dkg:Component ; skos:prefLabel "Gen AI" ; dkg:evolution dkg:Commodity ; rdfs:comment "sits on the Commodity line; stage Inferred" ; dkg:dependsOn :Cap_Cloud ; dkg:source :Art_Wardley ; dkg:locator "row 4" ; dkg:confidence dkg:Inferred .
:Cap_MediaStorage a dkg:Component ; skos:prefLabel "Media Storage" ; dkg:evolution dkg:Commodity ; dkg:dependsOn :Cap_Cloud ; dkg:source :Art_Wardley ; dkg:locator "row 4" ; dkg:confidence dkg:OnArtifact .
:Cap_RecipeDatabase a dkg:Component ; skos:prefLabel "Recipe database" ; dkg:evolution dkg:Product ; dkg:dependsOn :Cap_Cloud ; dkg:source :Art_Wardley ; dkg:locator "row 5" ; dkg:confidence dkg:OnArtifact .
:Cap_RatingDatabase a dkg:Component ; skos:prefLabel "Rating Database" ; dkg:evolution dkg:Product ; dkg:dependsOn :Cap_Cloud ; dkg:source :Art_Wardley ; dkg:locator "row 5" ; dkg:confidence dkg:OnArtifact .
:Cap_Cloud a dkg:Component ; skos:prefLabel "Cloud" ; dkg:evolution dkg:Commodity ; dkg:source :Art_Wardley ; dkg:locator "bottom row" ; dkg:confidence dkg:OnArtifact .
:Cap_Mobile a dkg:Component ; skos:prefLabel "Mobile" ; dkg:evolution dkg:Commodity ; dkg:source :Art_Wardley ; dkg:locator "bottom row" ; dkg:confidence dkg:OnArtifact .

:Q_WardleyWiring a dkg:Question ;
    skos:prefLabel "Which users own which needs on the Wardley map, and which of Refrigerator / Nutrition / Meal feed Remote meeting and Chat?" ;
    rdfs:comment "The user→need fan (except Prospect→Become a member) and several long diagonals into Remote meeting/Chat and Recipe database cannot be attributed to a single origin on the photo." ;
    dkg:source :Art_Wardley ; dkg:confidence dkg:OnArtifact .

# --- merge ledger ---
:Act_YoungFamilies dkg:proposedSameAs :Act_YoungFamily ; rdfs:comment "plural on the Wardley map, singular on the impact map" .
:Act_Singles dkg:proposedSameAs :Act_Single ; rdfs:comment "plural vs singular" .
:Act_Prospect dkg:proposedSameAs :Act_Propects ; rdfs:comment "Wardley 'Prospect' vs impact-map 'Propects' (misspelt plural)" .
:Cap_Timer dkg:proposedSameAs :Del_Timer, :Idea_Timer ; rdfs:comment "same word; Component vs Deliverable vs Idea (cross-class)" .
:Cap_MemberManagement dkg:proposedSameAs :Del_MemberManagement ; rdfs:comment "'Member Management' vs 'Member management'; Component vs Deliverable" .
:Cap_AskGrandmaGrandpa dkg:proposedSameAs :Del_GrandmaGrandpaAI, :Idea_AskGrandma ; rdfs:comment "the Wardley component is Custom-built; the deliverable says AI; the brainstorm sticky does not" .
:Cap_AskChef dkg:proposedSameAs :Act_ChefsAsSeniorPartner ; rdfs:comment "Component vs Actor — a capability named after who provides it" .
:Cap_Competitions dkg:proposedSameAs :Idea_SponsorContest ; rdfs:comment "'Competitions' vs 'Sponsor contest'" .
:Cap_RateContent dkg:proposedSameAs :Del_Rating, :Idea_Rating ; rdfs:comment "'Rate content' vs 'Rating'" .
:Cap_Nutrition dkg:proposedSameAs :Del_NutritionRequirementManagement .
:Cap_Refrigerator dkg:proposedSameAs :Idea_LarderTracker, :Idea_SearchWithThingsIAlreadyHave, :Idea_FridgePhotoRecipeGeneration ; rdfs:comment "'Refrigerator' is the map's word for the larder/fridge ideas; three stickies are candidates" .
:Cap_FreeHandControl dkg:proposedSameAs :Idea_VoiceControl ; rdfs:comment "'Free hand control' vs 'Voice control'" .
:Cap_AdvancedSearch dkg:supports :Goal_SearchRecipesWithNutritionMeals .
:Goal_SearchRecipesWithNutritionMeals dkg:proposedSameAs :Imp_FindEasilyRecipes ; rdfs:comment "Wardley need vs impact-map impact" .
:Goal_BetterCookingSkills dkg:proposedSameAs :Imp_LearnCooking ; rdfs:comment "Wardley need vs impact-map impact" .
:Goal_EfficientUsageOfGroceries dkg:proposedSameAs :Imp_UseEffectiveLimitedBudget ; rdfs:comment "groceries vs budget — related, possibly not the same need" .
:Goal_BecomeAMember dkg:proposedSameAs :Imp_ConvertToPaidPlan ; rdfs:comment "the map says member; the impact map says paying" .

