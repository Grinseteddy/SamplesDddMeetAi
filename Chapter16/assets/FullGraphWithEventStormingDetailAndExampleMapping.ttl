    dkg:to :Ctx_MealPreparation ; dkg:messageKind "?" ;
    dkg:carries "GET /preparations/{preparationId} | parameters: preparation Id | request: — | responses: 200: preparation · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_PreparationId, :Con_Preparation_MPC ;
    dkg:source :Art_APC_MealPreparation ; dkg:locator "operation row 2" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_MPR_03 a dkg:Message ; skos:prefLabel "GET /preparations/{preparationId}/how-to-steps/{stepId}" ;
    dkg:to :Ctx_MealPreparation ; dkg:messageKind "?" ;
    dkg:carries "GET /preparations/{preparationId}/how-to-steps/{stepId} | parameters: preparation Id, stepId | request: — | responses: 200: howToStep · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_PreparationId, :Con_StepId, :Con_HowToStep_MPC ;
    dkg:source :Art_APC_MealPreparation ; dkg:locator "operation row 3" ; dkg:confidence dkg:OnArtifact .
