larder:phase_sharing a dkg:BoundedContext ; rdfs:label "Sharing Phase" .
larder:phase_rating a dkg:BoundedContext ; rdfs:label "Rating Phase" .

larder:bc_cook_profile a dkg:BoundedContext, dkg:Node ;
                       skos:prefLabel "Cook Profile"@en ;
                       dkg:source larder:ES_Board_20260910_01, larder:ContextMap_20260910_01 ;
                       dkg:confidence dkg:OnArtifact .

larder:bc_meal_planning a dkg:BoundedContext, dkg:Node ;
                        skos:prefLabel "Meal Planning"@en ;
                        dkg:source larder:ES_Board_20260910_01, larder:ContextMap_20260910_01 ;
                        dkg:confidence dkg:OnArtifact ;
                        dkg:proposedSameAs larder:cluster_planner, larder:cap_planner .

