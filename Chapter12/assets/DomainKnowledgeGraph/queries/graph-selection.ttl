# ^ singular term (Recipe contains 1..* Ingredient) vs plural business object
:Q_ThanksToChef a dkg:Question ;
    skos:prefLabel "Chef is a Help provider who provides Help, but Thanks goes 'to 0..1 Community' or 'to 0..1 Grandma Avatar' and Help Request is 'at' those two only — can a Chef be asked and thanked?" ;
    dkg:source :Art_GlossaryEnhanced ;
    dkg:locator "Thanks / Help Request arrows" ;
    dkg:mentions :Con_Chef ;
    dkg:mentions :Con_Thanks ;
    dkg:confidence dkg:Implied .
:Q_HelpRequestBelongsToMeal a dkg:Question ;
    skos:prefLabel "Every Help Request 'belongs 1 Meal', yet Help Meal plan is a Help Request raised before any Meal exists — what does it belong to?" ;
    dkg:source :Art_GlossaryEnhanced ;
    dkg:locator "belongs arrow" ;
    dkg:mentions :Con_HelpMealPlan ;
    dkg:mentions :Con_Meal ;
    dkg:confidence dkg:Implied .
:Q_GlossaryColours a dkg:Question ;
    skos:prefLabel "Blue, green, grey and yellow terms, plus-icons, and no legend — contexts, or 'added in this revision'?" ;
    dkg:source :Art_GlossaryEnhanced ;
    dkg:locator "whole glossary" ;
    dkg:confidence dkg:Implied .
:Q_MenuVsMealPlan a dkg:Question ;
    skos:prefLabel "Glossary has Dinner–Menu–Course–Meal and no 'Meal plan'; board and map have 'Menu' and 'Meal plan' and no Dinner/Course — same thing?" ;
    dkg:source :Art_GlossaryEnhanced ;
    dkg:locator "blue terms" ;
    dkg:mentions :Con_Menu ;
    dkg:mentions :Con_Dinner ;
    dkg:confidence dkg:Implied .
:Q_DanglingBelongsTo a dkg:Question ;
    skos:prefLabel "Where does Ingredient Substitute's 'belongs to' arrow end in the Enhanced drawing?" ;
    dkg:source :Art_GlossaryEnhanced ;
    dkg:locator "left of Ingredient Substitute" ;
    dkg:mentions :Con_IngredientSubstitute ;
    dkg:confidence dkg:Implied .


