# Ingest — API contract 'Cooking Assistance API 1.0.0 (OpenAPI 3.1)' (cooking-assistance.openapi.yaml), 2026-10-10. Grow.
# DERIVED DOCUMENT: generated from canvas + model; everything new is dkg:Inferred,
# sourced to the contract. Existing nodes are NOT re-sourced (no false corroboration).
##############################################################################
:Art_API_CookingAssistance_OAS a dkg:Artifact ;
    rdfs:label "Cooking Assistance API — OpenAPI 3.1, version 1.0.0 (cooking-assistance.openapi.yaml)" ;
    rdfs:comment "OpenAPI draft from the Cooking Assistance sync canvas and Help Request / Help models. Bearer auth, audience external-public. Request status derived from helps (none = OPEN, ≥1 = ANSWERED; deleting the last help reopens). /helps type filter read as answerType. 'Grandma Avartar' normalised to GRANDMA_AVATAR, 'Gramm' to GRAM. Chef help visible only to the original requester. PATCH /helps 'link to changed help request' treated as a copy error. Says 'No pagination or maximum text lengths are invented' — its AsyncAPI sibling does invent them." ;
    dkg:mentions :Ctx_CookingAssistance ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:R_API_ChefHelpOnlyForRequester a dkg:Rule ; skos:prefLabel "Chef help is visible only to the original requester" ; rdfs:comment "contract proposal ('Chef privacy'); a Chef provider does not gain read access by authorship. No artifact draws this — closest is the glossary 'chef help is provided exclusively'." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_Help, :Con_Chef_HRProvider ; dkg:source :Art_API_CookingAssistance_OAS ; dkg:locator "GET /helps, GET /helps/{helpId}" ; dkg:confidence dkg:Inferred .
:R_API_DeleteHelpRequestOnlyOpen a dkg:Rule ; skos:prefLabel "A help request can be deleted only by its requester and only while OPEN" ; rdfs:comment "contract proposal; canvas DELETE row carries no such rule" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_HelpRequest ; dkg:source :Art_API_CookingAssistance_OAS ; dkg:locator "DELETE /help-requests/{helpRequestId}" ; dkg:confidence dkg:Inferred .
:Q_HelpRequestReopens a dkg:Question ; skos:prefLabel "Does deleting the last Help reopen its request?" ;
    rdfs:comment "Contract proposes status derived from existing helps, so removing the final answer sets OPEN again; the Help Request model has states but no transition back." ; dkg:mentions :Q_HelpRequestStateNames ;
    dkg:source :Art_API_CookingAssistance_OAS ; dkg:locator "x-design-assumptions; DELETE /helps/{helpId}" ; dkg:confidence dkg:Inferred .
:Art_API_CookingAssistance_OAS dkg:raises :Q_HelpRequestReopens .
:Q_HelpPatchResponse rdfs:comment "Cooking Assistance OpenAPI treats 'Link to changed help request' as a copy error and returns a link to the changed Help — a proposal, not a decision." ; dkg:source :Art_API_CookingAssistance_OAS .
:Q_TypeValuesVsHelpContents rdfs:comment "Cooking Assistance OpenAPI reads the /helps 'type' filter as answer type, not provider type." ; dkg:source :Art_API_CookingAssistance_OAS .

