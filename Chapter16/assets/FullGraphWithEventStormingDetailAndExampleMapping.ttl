:Rel_Notif_ContainsLink a dkg:Relationship ; skos:prefLabel "Notification contains link" ;
    dkg:from :Con_Notification ; dkg:verb "contains" ; dkg:to :Con_Link_Notif ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Notification ; dkg:locator "arrow 'contains' Notification → link" ; dkg:confidence dkg:OnArtifact .
