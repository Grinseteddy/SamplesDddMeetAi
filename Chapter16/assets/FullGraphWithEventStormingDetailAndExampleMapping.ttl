# ===== Example Maps — cross-artifact merge ledger, contradictions, questions =====
# Stories ~ the glossary's kinds of Help Request and the detail boards' request commands (cross-class)
:Story_US_CA_01 dkg:proposedSameAs :Con_HelpMealPlan ; rdfs:comment "proposedSameAs Con_HelpMealPlan: 'Help with Menu' vs glossary 'Help Meal plan' — Menu vs Meal plan naming" .
:Story_US_CA_01 dkg:proposedSameAs :Cmd_RequestHelpMealPlan ; rdfs:comment "proposedSameAs Cmd_RequestHelpMealPlan (cross-class)" .
:Story_US_CA_02 dkg:proposedSameAs :Con_HelpWithIngredients ; rdfs:comment "proposedSameAs Con_HelpWithIngredients: exact title, story vs glossary term (cross-class)" .
:Story_US_CA_02 dkg:proposedSameAs :Cmd_RequestHelpIngredients ; rdfs:comment "proposedSameAs Cmd_RequestHelpIngredients (cross-class)" .
:Story_US_CA_03 dkg:proposedSameAs :Con_HelpForMealPreparationStep ; rdfs:comment "proposedSameAs Con_HelpForMealPreparationStep: card title 'Help for Meal Preparation' drops 'Step'; story text says 'Help with a Meal Preparation Step'" .
:Story_US_CA_03 dkg:proposedSameAs :Cmd_RequestHelpPreparationStep ; rdfs:comment "proposedSameAs Cmd_RequestHelpPreparationStep (cross-class)" .
:Story_US_CA_04 dkg:proposedSameAs :Con_MealPreparationCatastrophe ; rdfs:comment "proposedSameAs Con_MealPreparationCatastrophe: exact title, story vs glossary term (cross-class)" .
:Story_US_CA_04 dkg:proposedSameAs :Cmd_RequestHelpCatastrophe ; rdfs:comment "proposedSameAs Cmd_RequestHelpCatastrophe (cross-class)" .

# Map terms ~ existing terms (one word, two concepts → split)
:Con_Note_EM dkg:proposedSameAs :Con_Note ; rdfs:comment "proposedSameAs Con_Note: SAME WORD, NOT MERGED. Help model 'note' is the provider's remark inside a menu proposal ('Be carefule, prepare everything'); the maps' Note is the Cook's feedback on a rejected answer or a cancel, kept for future requests." .
:Con_PreparationStep_EM dkg:proposedSameAs :Con_Step ; rdfs:comment "proposedSameAs Con_Step: glossary v2 'Step'" .
:Con_PreparationStep_EM dkg:proposedSameAs :Con_HowToStep ; rdfs:comment "proposedSameAs Con_HowToStep: Help Request model 'howTo Step' 0..1" .
:Con_PreparationStep_EM dkg:proposedSameAs :Con_RecipePreparationStep_RM ; rdfs:comment "proposedSameAs: Preparation-step detail board read model 'Recipe Preparation step'" .
:Con_Request_EM dkg:proposedSameAs :Con_HelpRequest ; rdfs:comment "proposedSameAs Con_HelpRequest: the maps say 'request' throughout" .
:Con_Deadline_EM dkg:mentions :HS_ESD_DefineTimeouts .

# Map rules ~ detail-board rules
:R_EM01_R6 dkg:proposedSameAs :R_ESD_ChefReviewsGrandmaPlan ; rdfs:comment "proposedSameAs: 'A Chef can review any Menu from the Grandma Avatar' vs board 'Chef can review a dinner plan of Grandma Avartar.' — Menu vs dinner plan" .
:R_EM01_R3 dkg:proposedSameAs :R_ESD_OnlyPremiumAskChef ; rdfs:comment "proposedSameAs: map adds 'an open request closes when premium ends'" .
:R_EM01_R4 dkg:proposedSameAs :R_ESD_ChefNeedsToBeSelected ; rdfs:comment "proposedSameAs: 'picks a Chef by name' vs 'Chef needs to be selected'" .
:R_EM01_R7 dkg:proposedSameAs :R_ESD_CookCanAcceptAnswer ; rdfs:comment "proposedSameAs: map adds reject and leave" .
:R_EM03_R7 dkg:proposedSameAs :R_ESD_CookCanCancelOnTimeout ; rdfs:comment "proposedSameAs: map 'at any time' is broader than board 'when answer takes too long'" .
:R_EM02_R7 dkg:proposedSameAs :R_ESD_SystemCancelsOnTimeout ; rdfs:comment "proposedSameAs: map gives 24 h and adds 'a provider not yet asked is suggested'" .
:R_EM03_R8 dkg:proposedSameAs :R_ESD_SystemCancelsOnTimeout ; rdfs:comment "proposedSameAs: map gives 12 h" .
:R_EM04_R9 dkg:proposedSameAs :R_ESD_SystemCancelsOnTimeout ; rdfs:comment "proposedSameAs: map gives 15 min Community / 5 min Grandma" .
:R_EM01_R8 dkg:proposedSameAs :R_ESD_SystemCancelsOnTimeout ; rdfs:comment "proposedSameAs: map says 'times out' and suggests another Chef; it does not say the request is cancelled" .
:R_EM02_R1 dkg:proposedSameAs :R_ESD_HelpSubstitutionsProviders ; rdfs:comment "proposedSameAs: map adds 'never to a Chef; every Cook can ask'" .
:R_EM02_R1 dkg:proposedSameAs :R_ESD_NoChefIngredientSubstitution .
:R_EM03_R1 dkg:proposedSameAs :R_ESD_HelpPrepStepProviders .
:R_EM03_R1 dkg:proposedSameAs :R_ESD_NoChefPrepStep .
:R_EM04_R1 dkg:proposedSameAs :R_ESD_HelpPrepStepProviders ; rdfs:comment "proposedSameAs: the Catastrophe board's provider sticky reads 'Help Preparation step …' — the map says the same providers for catastrophes, so the sticky's content is right even if its wording was copied" .
:R_EM04_R1 dkg:proposedSameAs :R_ESD_NoChefPrepStepCatastrophe .
:R_EM04_R7 dkg:proposedSameAs :R_EM03_R6 ; rdfs:comment "proposedSameAs: near-identical; US-CA-03 adds 'for the same step'" .
:R_EM04_R5 dkg:proposedSameAs :R_HR2_AtLeastOneHelpAccepted ; rdfs:comment "proposedSameAs: accepting closes the request (Help Request v2: at least one Help must be accepted)" .
:R_EM01_R2 dkg:proposedSameAs :R_HR_ChefSupportOnlyForMenuProposal ; rdfs:comment "proposedSameAs: 'Chefs never handle substitutions'" .
:R_EM02_R2 dkg:mentions :Con_Ingredient . :R_EM03_R2 dkg:mentions :Con_PreparationStep_EM, :Con_Recipe .
:R_EM04_R2 dkg:mentions :Con_Catastrophe, :Con_Recipe . :R_EM01_R1 dkg:mentions :Con_Occasion . :R_EM01_R7 dkg:mentions :Con_Menu .
:R_EM01_R3 dkg:mentions :Con_Premium_SubscriptionTier, :Con_Premium_CookStatus .

# Timeout rules → the hotspot all four boards drew (an answer proposed by the maps; the hotspot stays open until the room records a decision)
:R_EM01_R8 dkg:mentions :HS_ESD_DefineTimeouts, :Con_Deadline_EM . :R_EM01_R9 dkg:mentions :HS_ESD_DefineTimeouts .
:R_EM02_R7 dkg:mentions :HS_ESD_DefineTimeouts, :Con_Deadline_EM . :R_EM02_R4 dkg:mentions :Con_Deadline_EM .
:R_EM03_R8 dkg:mentions :HS_ESD_DefineTimeouts, :Con_Deadline_EM . :R_EM03_R5 dkg:mentions :Con_Deadline_EM, :Con_Note_EM .
:R_EM04_R9 dkg:mentions :HS_ESD_DefineTimeouts, :Con_Deadline_EM . :R_EM04_R6 dkg:mentions :Con_Deadline_EM, :Con_Note_EM .
:R_EM02_R5 dkg:mentions :Con_Note_EM . :R_EM03_R6 dkg:mentions :Con_Note_EM . :R_EM04_R7 dkg:mentions :Con_Note_EM . :R_EM03_R7 dkg:mentions :Con_Note_EM .

# ---- Contradictions ----
:As_Def_EM01_Con_Menu dkg:contradicts :Rel_CourseContainsMeal ;
    rdfs:comment "US-CA-01: 'Menu — one meal with several courses and a recipe for each'. Glossary v2: Menu has Course 1..*, Course contains Meal 1..*. The map puts courses inside a meal; the glossary puts meals inside a course." .
:R_EM01_R7 dkg:contradicts :Rel_HelpContainsMenuProposal ;
    rdfs:comment "US-CA-01 R7: 'An Answer is the complete Menu'. Glossary v2: Help contains Menu proposal 1..3." .
:R_EM02_R2 dkg:contradicts :Rel_HR_ContainsIngredients_HR ;
    rdfs:comment "US-CA-02 R2: 'A request covers one ingredient' (crème fraîche and bacon → two requests). Help Request model: contains ingredients 0..*." .
:R_EM01_R6 dkg:contradicts :R_HR_ChefHelpExclusive ;
    rdfs:comment "Same conditional contradiction as the board's review sticky: only if 'exclusively' means Chef is the sole provider of a request." .

# ---- Effect on existing questions (annotated; none closed — no Decision exists) ----
:HS_ESD_DefineTimeouts rdfs:comment "Example Maps (2026-10-27) propose values per kind of help: Menu 48 h, or 24 h before the Occasion if earlier, 48 h per reset, at least 48 h before the Occasion to ask; Ingredients 24 h; Preparation step 12 h; Catastrophe 15 min Community / 5 min Grandma. Each resets when the request is sent again. Proposals on four maps, not a Decision." .
:Q_ESD_CancelActor rdfs:comment "Example Maps: both. The Cook may cancel an open request at any time (US-CA-02 R6, -03 R7, -04 R8, -01 R7.E7); the system cancels when unanswered (US-CA-02 R7, -03 R8, -04 R9)." .
:Q_ESD_AcceptNoCommand rdfs:comment "Example Maps define accepting (US-CA-01 R7, -02 R3, -03 R4, -04 R5) and add rejecting (US-CA-01 R7; -02 R4, -03 R5, -04 R6 'not accepted') — still no command or event on any board." .
:Q_ESD_CancelledStatus rdfs:comment "Example Maps use 'closed' for accepted AND for Cook-cancelled, 'cancelled' for unanswered timeouts, and US-CA-01 adds 'withdrawn' and 'times out'. The board's single event 'Help request cancelled' covers what the maps call three outcomes." .
:Q_ESD_CookNotifiedWho rdfs:comment "Example Maps: Community members notified of every request sent to the Community (US-CA-04 R4); providers 'told' when a request closes or is withdrawn (US-CA-01 R3.E3, R4.E3, R7.E7); Lena 'told' when all providers time out. None of these notifications is on the boards." .
:Q_ESD_RecipeIntoMealPlanRequest rdfs:comment "US-CA-01: the Cook gives an Occasion, and the Chef proposes the recipes (R1.E1 'Marco gets the Occasion, no courses'; R2). Nothing on the map sends a recipe INTO a Menu request." .
:Q_ESD_CatastropheRecipe rdfs:comment "US-CA-04 R2: 'a recipe can be given'; 'Lena gives no recipe → sent without recipe' — agrees with the board's 'can be provided not mandatory'." .
:Q_PremiumVsPaying rdfs:comment "US-CA-01 R3: only a premium Cook can ask a Chef; an open request closes when premium ends. US-CA-02/03/04 R1: 'every Cook can ask' (Tom, free plan). Premium buys Chef help only." .
:Q_HRClosedTransition rdfs:comment "Example Maps: a request closes when an answer is accepted, when the Cook cancels, and (US-CA-01 R3) when premium ends." .
:Q_ESD_FourBoardsOneProcess rdfs:comment "Example Maps: the four kinds share accept / not accepted / cancel / timeout rules, but Menu differs in shape — one Chef per request, several requests in parallel (US-CA-01 R4), reject-and-pass-to-another-Chef (R7) — while the other three send ONE request to Community and/or Grandma." .
:Q_ESD_CopyResidues rdfs:comment "US-CA-04 R1 gives catastrophes the same providers (Community and/or Grandma Avatar) as the board's 'Help Preparation step can be provided…' sticky says — wording copied, content consistent." .

# ---- New questions the maps raise against the rest of the graph ----
:Q_EM_PerProviderState a dkg:Question ; skos:prefLabel "Does a request to two providers carry one state or one per provider?" ;
    rdfs:comment "US-CA-04 R9.E3: 'Grandma silent at 18:45 → only Grandma's side cancelled, Community until 18:55'; R6.E2 gives each provider its own deadline. Help Request model: one status (Open / Answered / Closed) and preferred Provider 1..2." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :R_EM04_R9, :R_EM04_R6, :Con_Status, :Con_PreferredProvider ;
    dkg:source :Art_ExMap_US_CA_04 ; dkg:confidence dkg:Implied .
:Q_EM_OccasionInHelpRequest a dkg:Question ; skos:prefLabel "Where does the Occasion live on a Menu help request?" ;
    rdfs:comment "US-CA-01 R1: a request covers exactly one Occasion (date, guests, dietary needs, budget, tastes). Help Request model has title, description, recipe, howTo Step, ingredients, pictures — no Occasion. Occasion appears on the Meal Plan model and as a GET /meal-plans parameter." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :R_EM01_R1, :Con_Occasion, :Con_HelpRequest ;
    dkg:source :Art_ExMap_US_CA_01 ; dkg:confidence dkg:Implied .
:Q_EM_PicturesPerType a dkg:Question ; skos:prefLabel "Which kinds of request may carry pictures?" ;
    rdfs:comment "US-CA-03 R3: a preparation-step request is text only. US-CA-04 R3: a catastrophe request can contain photos. Help Request model: picture 0..* with no type restriction, while ingredients and howTo Step each carry an 'Only for type' invariant." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :R_EM03_R3, :R_EM04_R3, :Rel_HR2_ContainsPicture ;
    dkg:source :Art_ExMap_US_CA_03, :Art_ExMap_US_CA_04 ; dkg:confidence dkg:Implied .
:Q_EM_RejectVsCancelWords a dkg:Question ; skos:prefLabel "closed, cancelled, withdrawn, times out — how many end states?" ;
    rdfs:comment "Maps: accepted → closed; Cook cancels → closed (-02, -03, -04) or withdrawn (-01); unanswered → cancelled (-02, -03, -04) or times out (-01, which then suggests another Chef rather than ending the request); premium ends → closed. Help Request model statuses: Open, Answered, Closed. Board event: Help request cancelled." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Q_ESD_CancelledStatus, :Con_Status, :Ev_HelpRequestCancelled ;
    dkg:source :Art_ExMap_US_CA_01, :Art_ExMap_US_CA_02, :Art_ExMap_US_CA_03, :Art_ExMap_US_CA_04 ; dkg:confidence dkg:Implied .
:Art_ExMap_US_CA_04 dkg:raises :Q_EM_PerProviderState, :Q_EM_PicturesPerType, :Q_EM_RejectVsCancelWords .
:Art_ExMap_US_CA_01 dkg:raises :Q_EM_OccasionInHelpRequest, :Q_EM_RejectVsCancelWords .
