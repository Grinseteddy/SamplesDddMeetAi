# --- Added: timeline order (board v2 lanes, left to right) ---
:Ev_CookRegistered dkg:precedes :Ev_DinnerPlanned .
:Ev_DinnerPlanned dkg:precedes :Ev_RecipesSearched .
:Ev_RecipesSearched dkg:precedes :Ev_RecipeSelected .
:Ev_RecipeSelected dkg:precedes :Ev_IngredientsMissing .
:Ev_IngredientsMissing dkg:precedes :Ev_MealPlanningStalled .
:Ev_MealPlanningStalled dkg:precedes :Ev_HelpRequested .
:Ev_HelpRequested dkg:precedes :Ev_HelpProvided .
:Ev_HelpProvided dkg:precedes :Ev_IngredientsSubstituted .
:Ev_IngredientsSubstituted dkg:precedes :Ev_PlanSetteled .
:Ev_PlanSetteled dkg:precedes :Ev_MealPreparationStarted .
:Ev_MealPreparationStarted dkg:precedes :Ev_StepUnclear .
:Ev_StepUnclear dkg:precedes :Ev_CatastropheHappened .
:Ev_CatastropheHappened dkg:precedes :Ev_PicturesTaken .
:Ev_PicturesTaken dkg:precedes :Ev_HelpRequested .
:Ev_HelpRequested dkg:precedes :Ev_HelpProvided .
:Ev_HelpProvided dkg:precedes :Ev_StepCompeteted .
:Ev_StepCompeteted dkg:precedes :Ev_MealRescued .
:Ev_MealRescued dkg:precedes :Ev_MealPrepared .
:Ev_MealPrepared dkg:precedes :Ev_PicturesTaken .
:Ev_PicturesTaken dkg:precedes :Ev_ThanksGiven .

# --- Questions: new, and effect on existing ones (none closed) ---
:Q_StateOwner a dkg:Question ;
    skos:prefLabel "Which aggregates carry the states on board v2?" ;
    rdfs:comment "State words name Plan (CREATED, STALLED, SETTLED), Help (REQUESTED, PROVIDED), Preparation (STARTED), Step (UNCLEAR, COMPLETED), CATASTROPHE, Meal (RESCUED, PREPARED) and Thanks (GIVEN). The board has no aggregate stickies; 'Plan' is not a sticky (closest: business object 'Meal plan', glossary 'Help Meal plan')." ;
    dkg:source :Art_ESBoard_2026_10_v2 ; dkg:locator "purple stickies, all lanes" ; dkg:confidence dkg:Implied .
:Art_ESBoard_2026_10_v2 dkg:raises :Q_StateOwner .
:Q_StrayEventIcon a dkg:Question ;
    skos:prefLabel "What is the text-less event icon, and the floating Recipe / Help Response / Ingredients, at the bottom of the first Meal Planning lane?" ;
    dkg:source :Art_ESBoard_2026_10_v2 ; dkg:locator "first Meal Planning lane, bottom" ; dkg:confidence dkg:OnArtifact .
:Art_ESBoard_2026_10_v2 dkg:raises :Q_StrayEventIcon .
:Q_NoStatesNoHotspots rdfs:comment "Board v2 adds 14 state stickies; still no hotspots, aggregates or policies." ; dkg:source :Art_ESBoard_2026_10_v2 .
:Q_HelpProvidedCommand rdfs:comment "Board v2 unchanged: event 8 'Provide help', event 16 'Request help'." ; dkg:source :Art_ESBoard_2026_10_v2 .
:Q_PrepareMealSevenEvents rdfs:comment "Board v2 unchanged: 'Prepare meal' under the same 7 events, now each with its own state sticky (Plan STALLED, Preparation STARTED, Step UNCLEAR, CATASTROPHE, Step COMPLETED, Meal RESCUED, Meal PREPARED)." ; dkg:source :Art_ESBoard_2026_10_v2 .
:Q_MissingPrepEvents rdfs:comment "Board v2 keeps Step competeted, Meal rescued and Meal prepared (with states), so their absence from the context map is the map's, not the board's." .

##############################################################################
# Ingest — Context Map v2, REVISION of :Art_ContextMap_2026_10 (attached image), 2026-10-10.
# Revise. Overlap vs v1: share 94%, cover 63% → "partition"; overridden: the low
# cover is v1's 14 arrow labels, which a sticky transcription never repeats.
# Same 10 contexts and contents. Arrows are dkg:Message (kind '?'), as in v1.
##############################################################################
:Art_ContextMap_2026_10_v2 a dkg:Artifact ;
    rdfs:label "Larder context map v2 (attached image)" ;
    dkg:revisionOf :Art_ContextMap_2026_10 ;
    rdfs:comment "Context map (dkg has no subclass for it). Same 10 contexts. HTTP verbs added as stickies (blue GET, green POST) on 10 sync arrows. 3 arrows reversed (Sharing now points at Media, Meal Preparation and Consent Management). Meal Planning → Meal Preparation arrow removed with Meal Preparation's left OHS. Markers changed: Notification OHS→CF, Cooking Assistance (right) OHS→CF, Sharing left OHS→CF and bottom CF→OHS. Events Help requested / Help provided now travel on the async arrows. Meal Preparation shows only the Menu read model (v1: Menu and Recipe). No Decision in the graph asked for this revision." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .

