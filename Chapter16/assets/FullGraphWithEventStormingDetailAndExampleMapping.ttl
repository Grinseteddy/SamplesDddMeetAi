    rdfs:comment "status values drawn on the Notification model" ; dkg:source :Art_Glossary_Notification ; dkg:confidence dkg:OnArtifact .
:R_HelpRequestsGoToCommunityOrChef a dkg:Rule ; skos:prefLabel "Help requests go to whole community or Chef" ;
    dkg:mentions :Con_Receiver, :Con_HelpRequest, :Con_Community, :Con_Chef ;
    dkg:source :Art_Glossary_Notification ; dkg:locator "purple sticky beside Receiver" ; dkg:confidence dkg:OnArtifact .

# --- merge ledger ---
:Con_Title_Notif dkg:proposedSameAs :Con_Title ; rdfs:comment "proposedSameAs Con_Title: same word; Help Request 'title' — different aggregate" .
:Con_Text_Notif dkg:proposedSameAs :Con_Text ; rdfs:comment "proposedSameAs Con_Text: same word; Consent Text 'text' — different aggregate" .
:Con_Receiver dkg:proposedSameAs :Con_CookId ; rdfs:comment "proposedSameAs Con_CookId: receivers are cooks per the value proposition ('to Cooks'); example equals the cook Id example — but see Q_ExampleUUIDsReused" .
:Con_Link_Notif dkg:mentions :Con_HelpRequestId ;
    rdfs:comment "the link example ends in 23a8eeed-35f6-460b-892e-7bb458a8fded — the Help Request model's help request Id example: a reference used consistently across two models" .

# --- questions and notes ---
:Q_HelpRequestAtWhom rdfs:comment "Notification model invariant: 'Help requests go to whole community or Chef' — Grandma Avatar is not named among the notified; a third formulation next to the glossary ('at Community AND Grandma Avatar') and the Help Request model (preferred Provider 1..2 of Chef | Grandma Avatar | Community)." ; dkg:source :Art_Glossary_Notification .
:Q_ExampleUUIDsReused rdfs:comment "Counter-example: the Notification link ends in the Help Request model's help request Id example 23a8eeed-… — here a shared UUID IS a deliberate reference." ; dkg:source :Art_Glossary_Notification .
:Q_CookOrCookingAssistancePath a dkg:Question ;
    skos:prefLabel "Is the path 'cook-assistance' or 'cooking-assistance'?" ;
    rdfs:comment "Notification link example: https://larder.org/cook-assistance/help-requests/…; Cooking Assistance sync canvas server: https://larder.org/cooking-assistance. Board v2 names the context 'Cook Assistance'; context maps and canvases 'Cooking Assistance'." ;
    dkg:source :Art_Glossary_Notification, :Art_APC_CookingAssistance_Sync ; dkg:locator "link example; canvas server" ; dkg:confidence dkg:OnArtifact .
:Art_Glossary_Notification dkg:raises :Q_CookOrCookingAssistancePath .
:Q_NotificationOperationsGaps a dkg:Question ;
    skos:prefLabel "Sync Notifications canvas: DELETE without 404, PUT …/status without the notificationId parameter" ;
    dkg:source :Art_APC_Notifications_Sync ; dkg:locator "operation rows 3 and 4" ; dkg:confidence dkg:OnArtifact .
:Art_APC_Notifications_Sync dkg:raises :Q_NotificationOperationsGaps .
:Q_ApcTemplateFields rdfs:comment "Notifications sync canvas: 'e.g. http' / 'e.g. RESTful oriented' as well." ; dkg:source :Art_APC_Notifications_Sync .
:Q_ConsentNotification rdfs:comment "Notification now has two canvases and a model; Consent Management has a canvas and a model — both appeared first on the context map and are now specified, but still have no story, board event or capability behind them." ; dkg:source :Art_Glossary_Notification .

