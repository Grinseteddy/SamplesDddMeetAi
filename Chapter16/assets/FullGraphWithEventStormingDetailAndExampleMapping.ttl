    rdfs:comment "Auto-merged with canvas 'Notification Id' (case-folding). Example 0b81c1e6-0c55-4b2b-8fe0-c122bd688203." .
:Con_Receiver a dkg:ValueObject ; dkg:source :Art_Glossary_Notification ; dkg:locator "green box 'Receiver'" ;
    rdfs:comment "Auto-merged with canvas 'Receiver' (exact). Example f64e07f0-… (the cook Id example)." .
:Con_Status_Notif a dkg:ValueObject ; dkg:source :Art_Glossary_Notification ; dkg:locator "green box 'status'" ;
    rdfs:comment "Auto-merged with canvas 'Status' (case-folding)." .
:Con_Title_Notif a dkg:ValueObject ; skos:prefLabel "title" ; rdfs:comment "example 'Help for burning catastrophe provided'" ;
    dkg:source :Art_Glossary_Notification ; dkg:locator "green box 'title'" ; dkg:confidence dkg:OnArtifact .
:Con_Text_Notif a dkg:ValueObject ; skos:prefLabel "text" ; rdfs:comment "example 'Stay calm look at the help'" ;
