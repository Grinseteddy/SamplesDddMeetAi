<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.larder</groupId>
        <artifactId>larder-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <groupId>org.larder.bc</groupId>
    <artifactId>bounded-contexts-parent</artifactId>
    <packaging>pom</packaging>
    <name>Larder Bounded Contexts</name>
    <description>
        One module per Bounded Context. A context module may depend on the platform and on the
        contracts of its upstreams, never on another context module (enforced below).
    </description>

    <modules>
        <module>recipe-catalog</module>
        <module>meal-planning</module>
        <module>meal-preparation</module>
        <module>cooking-assistance</module>
        <module>grandma-avatar-ai</module>
        <module>notification</module>
        <module>media</module>
        <module>sharing</module>
        <module>cook-profile</module>
        <module>consent-management</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>org.larder.platform</groupId>
            <artifactId>platform-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.larder.platform</groupId>
            <artifactId>platform-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.larder.platform</groupId>
            <artifactId>platform-persistence</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.larder.platform</groupId>
            <artifactId>platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.openapitools</groupId>
                    <artifactId>openapi-generator-maven-plugin</artifactId>
                    <version>${openapi-generator.version}</version>
                    <configuration>
                        <generateApiTests>false</generateApiTests>
                        <generateModelTests>false</generateModelTests>
                        <generateApiDocumentation>false</generateApiDocumentation>
                        <generateModelDocumentation>false</generateModelDocumentation>
                        <configOptions>
                            <useJakartaEe>true</useJakartaEe>
                            <openApiNullable>false</openApiNullable>
                            <useBeanValidation>true</useBeanValidation>
                            <dateLibrary>java8</dateLibrary>
                            <hideGenerationTimestamp>true</hideGenerationTimestamp>
                        </configOptions>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bounded-context-isolation</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.larder.bc</exclude>
                                    </excludes>
                                    <message>A Bounded Context must not depend on another Bounded Context. Generate a client from the upstream's contract instead.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
