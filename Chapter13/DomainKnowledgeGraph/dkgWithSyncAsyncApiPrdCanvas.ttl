    skos:prefLabel "prepares" ;
    dkg:source :Art_Story_GrandmaCopy ;
    dkg:locator "GrandmaCopy sentence 1" ;
    dkg:confidence dkg:OnArtifact .
:Sen_GrandmaCopy_01 a dkg:Sentence ;
    skos:prefLabel "Cook prepares Meal" ;
    dkg:source :Art_Story_GrandmaCopy ;
    dkg:locator "sentence 1" ;
    dkg:sequence 1 ;
    dkg:performedBy :Act_Cook ;
