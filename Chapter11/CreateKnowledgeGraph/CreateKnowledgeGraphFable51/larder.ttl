# --- questions the stories raise ---
:Q_HelpRequestOrResponse a dkg:Question ; skos:prefLabel "Is 'Help' one work object or two — the request the Cook asks for and the response the responder provides?" ; rdfs:comment "Every story uses one pictogram for both." ; dkg:source :Art_StoryGrandma, :Art_StoryAskChef, :Art_StoryAskCommunity, :Art_StoryGrandmaII ; dkg:confidence dkg:OnArtifact .
:Q_PicturesTwoSenses a dkg:Question ; skos:prefLabel "Are the Pictures taken during trouble the same kind of thing as the Pictures shared with the Community?" ; rdfs:comment "Story Grandma qualifies the first use as 'Catastrophe Pictures'; story II uses plain 'Pictures' for both." ; dkg:source :Art_StoryGrandma, :Art_StoryGrandmaII ; dkg:confidence dkg:OnArtifact .
:Q_GrandmaVsGrandmaAvatar a dkg:Question ; skos:prefLabel "Is 'Grandma' in story II sentence 6 the same actor as 'Grandma Avatar'?" ; dkg:source :Art_StoryGrandmaII ; dkg:confidence dkg:OnArtifact .
:Q_CompetitionNumbering a dkg:Question ; skos:prefLabel "Competition story: sentences 3 and 4 each appear twice — are they parallel or was the numbering a slip?" ; dkg:source :Art_StoryCompetition ; dkg:confidence dkg:OnArtifact .
:Q_CommunityAudienceOrResponder a dkg:Question ; skos:prefLabel "Is 'Community' the responder (story AskCommunity, sentence 4) the same thing as 'Community' the audience (every story, sentence 6)?" ; dkg:source :Art_StoryAskCommunity, :Art_StoryGrandma ; dkg:confidence dkg:OnArtifact .

# --- merge ledger ---
:Act_Grandma dkg:proposedSameAs :Act_GrandmaAvatar ; rdfs:comment "story II writes 'Grandma' once, 'Grandma Avatar' three times" .
:Act_Cooks dkg:proposedSameAs :Act_OtherCooks, :Act_Cook ; rdfs:comment "Competition story: 'Cooks' (sentence 1) vs 'Other cooks' (4, 5)" .
:Act_Cook dkg:proposedSameAs :Act_HomeCook, :KR_Cooks, :Act_CookAsAuthor ; rdfs:comment "operational 'Cook' vs Wardley 'Home cook', BMC 'Cooks', impact-map 'Cook as author'" .
:Act_Chef dkg:proposedSameAs :Act_Chefs, :Act_ChefsAsSeniorPartner, :Cap_AskChef ; rdfs:comment "story 'Chef' vs BMC 'Chefs' vs impact-map 'Chefs as senior partner'" .
:Act_Community dkg:proposedSameAs :CR_Community, :Cap_AskCommunity, :Cluster_Community ; rdfs:comment "story actor vs BMC relationship vs Wardley component vs brainstorm cluster" .
:Act_GrandmaAvatar dkg:proposedSameAs :Del_GrandmaGrandpaAI, :Cap_AskGrandmaGrandpa, :Cap_GrandmaGrandpa_CM, :Idea_AskGrandma ; rdfs:comment "the stories name only Grandma; every strategy artifact says Grandma / Grandpa" .
:Act_ParentsInLaw dkg:proposedSameAs :Act_YoungFamily ; rdfs:comment "guests, not a segment — weak" .
:Con_CatastrophePictures dkg:proposedSameAs :Con_Pictures ; rdfs:comment "containment: the qualifier probably means a second concept; NOT merged" .
:Con_IngredientsSubstitutes dkg:proposedSameAs :Con_Ingredients ; rdfs:comment "containment; NOT merged" .
:Con_Competition dkg:proposedSameAs :Cap_Competitions, :Idea_SponsorContest ; rdfs:comment "story work object vs Wardley component vs brainstorm idea" .
:Con_Rating dkg:proposedSameAs :Del_Rating, :Cap_Rating_CM, :Idea_Rating ; rdfs:comment "story work object vs deliverable/capability/idea" .
:Con_Recipe dkg:proposedSameAs :KR_Recipes ; rdfs:comment "singular work object vs plural BMC resource" .
:Con_Meal dkg:proposedSameAs :Cap_Meal ; rdfs:comment "story work object vs Wardley component 'Meal' (cross-class)" .
:Con_MealPreparation dkg:proposedSameAs :Con_Preparation ; rdfs:comment "'Meal Preparation' (story II) vs 'Preparation' (Competition story)" .
:Con_MealPlanning dkg:proposedSameAs :Cluster_Planner, :VP_Planner ; rdfs:comment "story work object 'Meal Planning' vs the strategy artifacts' 'Planner'" .
:Con_Pictures dkg:proposedSameAs :KR_Media, :Cap_UploadMedia, :Idea_MakingPhotos ; rdfs:comment "story 'Pictures' vs BMC 'Media' vs Wardley 'Upload media' vs brainstorm 'Making Photos'" .
:Cmd_Shares dkg:proposedSameAs :Idea_SharingOnInstagram, :CR_DailyForSharing ; rdfs:comment "the verb 'shares' vs the brainstorm/BMC sharing stickies" .


##############################################################################
# INGEST 7 — EventStorming board — 2026-09-10
# Files: EventStormingWithBoundedContext.jpg (primary — seven distinct bubble
# names) and EventStormingBoardWithBcs.jpg (same stickies; the two bubbles
# labelled 'Cooking Help' read 'Cooking Assistance' there).
# Colour/icon convention as read: orange = event · blue ⌘ = command · bright
# yellow (person) = actor · green (eye) = read model · pale yellow (briefcase)
# = business object · pink (gear) = external system. Sparkle icon on many
# events and robot icon on 6 and 18: meaning unconfirmed, recorded only in
# comments. NO state stickies. NO hotspots. NO policies. NO large-yellow
# aggregates.
# Same cluster drawn twice: Help requested/Help provided (7/8 and 15/16),
# Pictures taken (14, 20). One node per command/event with two locators,
# EXCEPT 'Pictures' as a business object, which is split (_14 evidence, _20
# result) per the one-label-two-purposes rule. 'Prepare meal' is one command
# sticky repeated under seven events (6, 11, 12, 13, 17, 18, 19).
# Bubbles drawn twice with the same name (Meal Planning ×2, Meal Preparation
# ×2, Media ×2) are one context node each with two locators.
##############################################################################

:Art_ES a dkg:EventStormingBoard ;
    rdfs:label "Community Cooking EventStorming board, with bounded contexts (EventStormingWithBoundedContext.jpg + EventStormingBoardWithBcs.jpg)" ;
    rdfs:comment "21 event stickies in three rows, 9 bubbles carrying 7 distinct names; no states, hotspots, policies or aggregates." ;
    dkg:ingestedAt "2026-09-10"^^xsd:date .

# --- context bubbles ---
:Ctx_CookProfile a dkg:BoundedContext ; skos:prefLabel "Cook Profile" ; dkg:source :Art_ES ; dkg:locator "bubble top-left" ; dkg:confidence dkg:OnArtifact .
:Ctx_MealPlanning a dkg:BoundedContext ; skos:prefLabel "Meal Planning" ; rdfs:comment "drawn twice: the top bubble (events 2–6) and a second bubble beneath it (events 9–10)" ; dkg:source :Art_ES ; dkg:locator "bubble top-centre", "bubble centre-left" ; dkg:confidence dkg:OnArtifact .
:Ctx_CookingAssistance a dkg:BoundedContext ; skos:prefLabel "Cooking Assistance" ; rdfs:comment "two bubbles: top-right (event 7) and middle-left (event 8). On EventStormingBoardWithBcs.jpg all four help bubbles carry this name." ; dkg:source :Art_ES ; dkg:locator "bubble top-right", "bubble middle-left" ; dkg:confidence dkg:OnArtifact .
:Ctx_CookingHelp a dkg:BoundedContext ; skos:prefLabel "Cooking Help" ; skos:altLabel "Cooking Assistance" ; rdfs:comment "two bubbles: middle-right (event 15) and bottom-left (event 16). Named 'Cooking Help' on EventStormingWithBoundedContext.jpg and 'Cooking Assistance' on EventStormingBoardWithBcs.jpg." ; dkg:source :Art_ES ; dkg:locator "bubble middle-right", "bubble bottom-left" ; dkg:confidence dkg:OnArtifact .
:Ctx_MealPreparation a dkg:BoundedContext ; skos:prefLabel "Meal Preparation" ; rdfs:comment "drawn twice: centre (events 11–13) and bottom-centre (events 17–19)" ; dkg:source :Art_ES ; dkg:locator "bubble centre", "bubble bottom-centre" ; dkg:confidence dkg:OnArtifact .
:Ctx_Media a dkg:BoundedContext ; skos:prefLabel "Media" ; rdfs:comment "drawn twice: right (event 14) and bottom (event 20)" ; dkg:source :Art_ES ; dkg:locator "bubble right", "bubble bottom-right-centre" ; dkg:confidence dkg:OnArtifact .
:Ctx_Sharing a dkg:BoundedContext ; skos:prefLabel "Sharing" ; dkg:source :Art_ES ; dkg:locator "bubble bottom-right" ; dkg:confidence dkg:OnArtifact .

[] a dkg:spelling ; dkg:literal "Cooking Assistance" ; dkg:spelledOn :Art_ES ;
   rdfs:comment "EventStormingBoardWithBcs.jpg labels the bubbles around events 15 and 16 'Cooking Assistance'; EventStormingWithBoundedContext.jpg labels them 'Cooking Help'. Two renderings of one wall disagree on whether help at the stove is the same context as help while planning." .
:Ctx_CookingHelp dkg:proposedSameAs :Ctx_CookingAssistance ; rdfs:comment "same commands (Request help / Provide help), same objects (Help request / Help response), overlapping responders incl. Grandma Avatar; one rendering already uses one name for all four bubbles" .

:Q_HelpOneContextOrTwo a dkg:Question ; skos:prefLabel "Are Cooking Assistance (planning-time help) and Cooking Help (cooking-time help) one bounded context or two?" ; rdfs:comment "The two board photos answer differently." ; dkg:source :Art_ES ; dkg:confidence dkg:OnArtifact .
:Q_ESIcons a dkg:Question ; skos:prefLabel "What do the sparkle icon (many events) and the robot icon (Meal planning stalled, Meal rescued) mean on the board?" ; dkg:source :Art_ES ; dkg:confidence dkg:OnArtifact .
:Q_PrepareMealOneCommand a dkg:Question ; skos:prefLabel "Is 'Prepare meal' really one command for seven events (6, 11, 12, 13, 17, 18, 19), or a placeholder?" ; dkg:source :Art_ES ; dkg:confidence dkg:OnArtifact .
:Q_NoStatesNoHotspots a dkg:Question ; skos:prefLabel "The board has no state stickies and no hotspots — on a domain with 'stalled', 'unclear', 'catastrophe'. Were disagreements captured anywhere?" ; dkg:source :Art_ES ; dkg:confidence dkg:OnArtifact .
:Q_PlanSetteledLabel a dkg:Question ; skos:prefLabel "Is event 10 'plan setteled' or 'Meal plan setteled'? The sticky is partly covered by the Menu read model." ; dkg:source :Art_ES ; dkg:confidence dkg:OnArtifact .

# --- events ---
:Ev_CookRegistered a dkg:DomainEvent ; skos:prefLabel "Cook registered" ; dkg:sequence 1 ; dkg:inContext :Ctx_CookProfile ; dkg:source :Art_ES ; dkg:locator "event 1" ; dkg:confidence dkg:OnArtifact .
:Ev_DinnerPlanned a dkg:DomainEvent ; skos:prefLabel "Dinner planned" ; dkg:sequence 2 ; dkg:inContext :Ctx_MealPlanning ; dkg:source :Art_ES ; dkg:locator "event 2" ; dkg:confidence dkg:OnArtifact .
:Ev_RecipesSearched a dkg:DomainEvent ; skos:prefLabel "Recipes searched" ; dkg:sequence 3 ; dkg:inContext :Ctx_MealPlanning ; rdfs:comment "loop with 4" ; dkg:source :Art_ES ; dkg:locator "event 3" ; dkg:confidence dkg:OnArtifact .
:Ev_RecipeSelected a dkg:DomainEvent ; skos:prefLabel "Recipe selected" ; dkg:sequence 4 ; dkg:inContext :Ctx_MealPlanning ; rdfs:comment "loop with 3; command sticky reads 'Search recipes'" ; dkg:source :Art_ES ; dkg:locator "event 4" ; dkg:confidence dkg:OnArtifact .
:Ev_IngredientsMissing a dkg:DomainEvent ; skos:prefLabel "Ingredients missing" ; dkg:sequence 5 ; dkg:inContext :Ctx_MealPlanning ; rdfs:comment "branch; stickies half outside the bubble" ; dkg:source :Art_ES ; dkg:locator "event 5" ; dkg:confidence dkg:OnArtifact .
:Ev_MealPlanningStalled a dkg:DomainEvent ; skos:prefLabel "Meal planning stalled" ; dkg:sequence 6 ; dkg:inContext :Ctx_MealPlanning ; rdfs:comment "robot icon (unconfirmed); command sticky reads 'Prepare meal'" ; dkg:source :Art_ES ; dkg:locator "event 6" ; dkg:confidence dkg:OnArtifact .
:Ev_HelpRequested a dkg:DomainEvent ; skos:prefLabel "Help requested" ; dkg:sequence 7 ; dkg:inContext :Ctx_CookingAssistance ; rdfs:comment "recurs: drawn at events 7 and 15", :Ctx_CookingHelp ; dkg:source :Art_ES ; dkg:locator "event 7", "event 15" ; dkg:confidence dkg:OnArtifact .
:Ev_HelpProvided a dkg:DomainEvent ; skos:prefLabel "Help provided" ; dkg:sequence 8 ; dkg:inContext :Ctx_CookingAssistance ; rdfs:comment "recurs: drawn at events 8 and 16", :Ctx_CookingHelp ; dkg:source :Art_ES ; dkg:locator "event 8", "event 16" ; dkg:confidence dkg:OnArtifact .
:Ev_IngredientsSubstituted a dkg:DomainEvent ; skos:prefLabel "Ingredients substituted" ; dkg:sequence 9 ; dkg:inContext :Ctx_MealPlanning ; rdfs:comment "second Meal Planning bubble" ; dkg:source :Art_ES ; dkg:locator "event 9" ; dkg:confidence dkg:OnArtifact .
:Ev_PlanSetteled a dkg:DomainEvent ; skos:prefLabel "plan setteled" ; dkg:sequence 10 ; dkg:inContext :Ctx_MealPlanning ; rdfs:comment "sticky partly covered; likely 'Meal plan setteled'; diagram spelling" ; dkg:source :Art_ES ; dkg:locator "event 10" ; dkg:confidence dkg:OnArtifact .
:Ev_MealPreparationStarted a dkg:DomainEvent ; skos:prefLabel "Meal preparation started" ; dkg:sequence 11 ; dkg:inContext :Ctx_MealPreparation ; dkg:source :Art_ES ; dkg:locator "event 11" ; dkg:confidence dkg:OnArtifact .
:Ev_StepUnclear a dkg:DomainEvent ; skos:prefLabel "Step unclear" ; dkg:sequence 12 ; dkg:inContext :Ctx_MealPreparation ; rdfs:comment "loop" ; dkg:source :Art_ES ; dkg:locator "event 12" ; dkg:confidence dkg:OnArtifact .
:Ev_CatastropheHappened a dkg:DomainEvent ; skos:prefLabel "Catastrophe happened" ; dkg:sequence 13 ; dkg:inContext :Ctx_MealPreparation ; rdfs:comment "branch" ; dkg:source :Art_ES ; dkg:locator "event 13" ; dkg:confidence dkg:OnArtifact .
:Ev_PicturesTaken a dkg:DomainEvent ; skos:prefLabel "Pictures taken" ; dkg:sequence 14 ; dkg:inContext :Ctx_Media ; rdfs:comment "recurs: drawn at events 14 and 20" ; dkg:source :Art_ES ; dkg:locator "event 14", "event 20" ; dkg:confidence dkg:OnArtifact .
:Ev_StepCompeted a dkg:DomainEvent ; skos:prefLabel "Step competed" ; dkg:sequence 17 ; dkg:inContext :Ctx_MealPreparation ; rdfs:comment "loop; diagram spelling; second Meal Preparation bubble" ; dkg:source :Art_ES ; dkg:locator "event 17" ; dkg:confidence dkg:OnArtifact .
:Ev_MealRescued a dkg:DomainEvent ; skos:prefLabel "Meal rescued" ; dkg:sequence 18 ; dkg:inContext :Ctx_MealPreparation ; rdfs:comment "robot icon (unconfirmed)" ; dkg:source :Art_ES ; dkg:locator "event 18" ; dkg:confidence dkg:OnArtifact .
:Ev_MealPrepared a dkg:DomainEvent ; skos:prefLabel "Meal prepared" ; dkg:sequence 19 ; dkg:inContext :Ctx_MealPreparation ; dkg:source :Art_ES ; dkg:locator "event 19" ; dkg:confidence dkg:OnArtifact .
:Ev_ThanksGiven a dkg:DomainEvent ; skos:prefLabel "Thanks given" ; dkg:sequence 21 ; dkg:inContext :Ctx_Sharing ; dkg:source :Art_ES ; dkg:locator "event 21" ; dkg:confidence dkg:OnArtifact .
:Ev_CookRegistered dkg:precedes :Ev_DinnerPlanned .
:Ev_DinnerPlanned dkg:precedes :Ev_RecipesSearched .
:Ev_RecipesSearched dkg:precedes :Ev_RecipeSelected .
:Ev_RecipeSelected dkg:precedes :Ev_IngredientsMissing .
:Ev_IngredientsMissing dkg:precedes :Ev_MealPlanningStalled .
:Ev_MealPlanningStalled dkg:precedes :Ev_HelpRequested .
:Ev_HelpRequested dkg:precedes :Ev_HelpProvided .
:Ev_HelpProvided dkg:precedes :Ev_IngredientsSubstituted .
:Ev_IngredientsSubstituted dkg:precedes :Ev_PlanSetteled .
:Ev_PlanSetteled dkg:precedes :Ev_MealPreparationStarted .
:Ev_MealPreparationStarted dkg:precedes :Ev_StepUnclear .
:Ev_StepUnclear dkg:precedes :Ev_CatastropheHappened .
:Ev_CatastropheHappened dkg:precedes :Ev_PicturesTaken .
:Ev_PicturesTaken dkg:precedes :Ev_HelpRequested .
:Ev_HelpRequested dkg:precedes :Ev_HelpProvided .
:Ev_HelpProvided dkg:precedes :Ev_StepCompeted .
:Ev_StepCompeted dkg:precedes :Ev_MealRescued .
:Ev_MealRescued dkg:precedes :Ev_MealPrepared .
:Ev_MealPrepared dkg:precedes :Ev_PicturesTaken .
:Ev_PicturesTaken dkg:precedes :Ev_ThanksGiven .
# --- commands ---
:Cmd_RegisterCook a dkg:Command ; skos:prefLabel "Register cook" ; dkg:triggers :Ev_CookRegistered ; dkg:performedBy :Act_User ; dkg:reads :Con_User_ES ; dkg:produces :Con_Cook_ES ; dkg:source :Art_ES ; dkg:locator "event 1" ; dkg:confidence dkg:OnArtifact .
:Cmd_PlanDinner a dkg:Command ; skos:prefLabel "Plan dinner" ; dkg:triggers :Ev_DinnerPlanned ; dkg:performedBy :Act_Cook ; dkg:reads :Con_Guests_ES ; dkg:produces :Con_Menu_ES ; dkg:source :Art_ES ; dkg:locator "event 2" ; dkg:confidence dkg:OnArtifact .
:Cmd_SearchRecipes a dkg:Command ; skos:prefLabel "Search recipes" ; dkg:triggers :Ev_RecipesSearched, :Ev_RecipeSelected ; dkg:performedBy :Act_Cook ; dkg:reads :Con_Recipe, :Con_RecipeCatalog_ES ; rdfs:comment "one command sticky repeated under 2 events" ; dkg:source :Art_ES ; dkg:locator "event 3", "event 4" ; dkg:confidence dkg:OnArtifact .
:Cmd_SearchIngredients a dkg:Command ; skos:prefLabel "Search Ingredients" ; dkg:triggers :Ev_IngredientsMissing ; dkg:performedBy :Act_Cook ; dkg:reads :Con_Recipe ; dkg:source :Art_ES ; dkg:locator "event 5" ; dkg:confidence dkg:OnArtifact .
:Cmd_PrepareMeal a dkg:Command ; skos:prefLabel "Prepare meal" ; dkg:triggers :Ev_MealPlanningStalled, :Ev_MealPreparationStarted, :Ev_StepUnclear, :Ev_CatastropheHappened, :Ev_StepCompeted, :Ev_MealRescued, :Ev_MealPrepared ; dkg:performedBy :Act_Cook ; dkg:reads :Con_Catastrophe_ES, :Con_Guests_ES, :Con_HelpResponse_ES, :Con_Menu_ES, :Con_Recipe ; rdfs:comment "one command sticky repeated under 7 events" ; dkg:source :Art_ES ; dkg:locator "event 6", "event 11", "event 12", "event 13", "event 17", "event 18", "event 19" ; dkg:confidence dkg:OnArtifact .
:Cmd_RequestHelp a dkg:Command ; skos:prefLabel "Request help" ; dkg:triggers :Ev_HelpRequested, :Ev_HelpRequested, :Ev_HelpProvided ; dkg:performedBy :Act_CommunityCook, :Act_Cook, :Act_GrandmaAvatar ; dkg:reads :Con_Catastrophe_ES, :Con_HelpRequest_ES, :Con_Ingredients, :Con_Menu_ES, :Con_Pictures_ES, :Con_Recipe ; dkg:produces :Con_HelpRequest_ES, :Con_HelpResponse_ES ; rdfs:comment "one command sticky repeated under 3 events" ; dkg:source :Art_ES ; dkg:locator "event 7", "event 15", "event 16" ; dkg:confidence dkg:OnArtifact .
:Cmd_ProvideHelp a dkg:Command ; skos:prefLabel "Provide help" ; dkg:triggers :Ev_HelpProvided ; dkg:performedBy :Act_Chef, :Act_CommunityCook, :Act_GrandmaAvatar ; dkg:reads :Con_HelpRequest_ES ; dkg:produces :Con_HelpResponse_ES ; dkg:source :Art_ES ; dkg:locator "event 8" ; dkg:confidence dkg:OnArtifact .
:Cmd_SubstituteIngredients a dkg:Command ; skos:prefLabel "Substitute ingredients" ; dkg:triggers :Ev_IngredientsSubstituted ; dkg:performedBy :Act_Cook ; dkg:reads :Con_HelpResponse_ES, :Con_Recipe ; dkg:produces :Con_Ingredients ; dkg:source :Art_ES ; dkg:locator "event 9" ; dkg:confidence dkg:OnArtifact .
:Cmd_PlanMeal a dkg:Command ; skos:prefLabel "Plan meal" ; dkg:triggers :Ev_PlanSetteled ; dkg:performedBy :Act_Cook ; dkg:reads :Con_HelpResponse_ES, :Con_Menu_ES ; dkg:produces :Con_MealPlan_ES ; dkg:source :Art_ES ; dkg:locator "event 10" ; dkg:confidence dkg:OnArtifact .
:Cmd_TakePictures a dkg:Command ; skos:prefLabel "Take pictures" ; dkg:triggers :Ev_PicturesTaken, :Ev_PicturesTaken ; dkg:performedBy :Act_Cook ; dkg:reads :Con_Catastrophe_ES ; dkg:produces :Con_Pictures14_ES, :Con_Pictures20_ES ; rdfs:comment "one command sticky repeated under 2 events" ; dkg:source :Art_ES ; dkg:locator "event 14", "event 20" ; dkg:confidence dkg:OnArtifact .
:Cmd_ProvideThanks a dkg:Command ; skos:prefLabel "Provide thanks" ; dkg:triggers :Ev_ThanksGiven ; dkg:performedBy :Act_Cook ; dkg:reads :Con_HelpProvider_ES, :Con_Pictures_ES ; dkg:produces :Con_Thanks_ES ; dkg:source :Art_ES ; dkg:locator "event 21" ; dkg:confidence dkg:OnArtifact .
# --- actors (Cook, Chef, Grandma Avatar auto-merge into the story nodes: exact label, same spine class) ---
:Act_User a dkg:Actor ; skos:prefLabel "User" ; dkg:source :Art_ES ; dkg:locator "event 1" ; dkg:confidence dkg:OnArtifact .
:Act_Cook dkg:source :Art_ES ; dkg:locator "event 2", "event 3", "event 4", "event 5", "event 6", "event 7", "event 9", "event 10", "event 11", "event 12", "event 13", "event 14", "event 15", "event 17", "event 18", "event 19", "event 20", "event 21" .
:Act_CommunityCook a dkg:Actor ; skos:prefLabel "Community Cook" ; dkg:source :Art_ES ; dkg:locator "event 8", "event 16" ; dkg:confidence dkg:OnArtifact .
:Act_Chef dkg:source :Art_ES ; dkg:locator "event 8" .
:Act_GrandmaAvatar dkg:source :Art_ES ; dkg:locator "event 8", "event 16" ; a dkg:ExternalSystem ; rdfs:comment "pink gear sticky on the board: external system; a person-actor in the stories" .
# --- read models (green) and business objects (pale yellow) ---
:Con_User_ES a dkg:ReadModel ; skos:prefLabel "User" ; dkg:source :Art_ES ; dkg:locator "event 1" ; dkg:confidence dkg:OnArtifact .
:Con_Guests_ES a dkg:ReadModel ; skos:prefLabel "Guests" ; dkg:source :Art_ES ; dkg:locator "event 2", "event 6" ; dkg:confidence dkg:OnArtifact .
:Con_RecipeCatalog_ES a dkg:ReadModel ; skos:prefLabel "Recipe Catalog" ; dkg:source :Art_ES ; dkg:locator "event 3" ; dkg:confidence dkg:OnArtifact .
:Con_Recipe a dkg:ReadModel ; dkg:source :Art_ES ; dkg:locator "event 4", "event 5", "event 9", "event 11", "event 12", "event 13", "event 15", "event 19" .
:Con_Menu_ES a dkg:ReadModel, dkg:BusinessObject ; skos:prefLabel "Menu" ; dkg:source :Art_ES ; dkg:locator "event 6", "event 7", "event 10" ; dkg:confidence dkg:OnArtifact .
:Con_Ingredients a dkg:ReadModel ; dkg:source :Art_ES ; dkg:locator "event 7" .
:Con_HelpRequest_ES a dkg:ReadModel, dkg:BusinessObject ; skos:prefLabel "Help request" ; dkg:source :Art_ES ; dkg:locator "event 8", "event 16" ; dkg:confidence dkg:OnArtifact .
:Con_HelpResponse_ES a dkg:ReadModel ; skos:prefLabel "Help Response" ; dkg:source :Art_ES ; dkg:locator "event 9", "event 10" ; dkg:confidence dkg:OnArtifact .
:Con_Catastrophe_ES a dkg:ReadModel ; skos:prefLabel "Catastrophe" ; dkg:source :Art_ES ; dkg:locator "event 13", "event 14", "event 15" ; dkg:confidence dkg:OnArtifact .
:Con_Pictures_ES a dkg:ReadModel ; skos:prefLabel "Pictures" ; dkg:source :Art_ES ; dkg:locator "event 15", "event 21" ; dkg:confidence dkg:OnArtifact .
:Con_HelpResponse_ES a dkg:ReadModel, dkg:BusinessObject ; skos:prefLabel "Help response" ; dkg:source :Art_ES ; dkg:locator "event 17", "event 18" ; dkg:confidence dkg:OnArtifact .
:Con_HelpProvider_ES a dkg:ReadModel ; skos:prefLabel "Help provider" ; dkg:source :Art_ES ; dkg:locator "event 21" ; dkg:confidence dkg:OnArtifact .
:Con_Cook_ES a dkg:BusinessObject ; skos:prefLabel "Cook" ; dkg:source :Art_ES ; dkg:locator "event 1" ; dkg:confidence dkg:OnArtifact .
:Con_Menu_ES dkg:locator "event 2" .
:Con_HelpRequest_ES dkg:locator "event 7", "event 15" .
:Con_HelpResponse_ES dkg:locator "event 8", "event 16" .
:Con_Ingredients dkg:locator "event 9" .
:Con_MealPlan_ES a dkg:BusinessObject ; skos:prefLabel "Meal plan" ; dkg:source :Art_ES ; dkg:locator "event 10" ; dkg:confidence dkg:OnArtifact .
:Con_Pictures14_ES a dkg:BusinessObject ; skos:prefLabel "Pictures" ; dkg:source :Art_ES ; dkg:locator "event 14" ; dkg:confidence dkg:OnArtifact .
:Con_Pictures20_ES a dkg:BusinessObject ; skos:prefLabel "Pictures" ; dkg:source :Art_ES ; dkg:locator "event 20" ; dkg:confidence dkg:OnArtifact .
:Con_Thanks_ES a dkg:BusinessObject ; skos:prefLabel "Thanks" ; dkg:source :Art_ES ; dkg:locator "event 21" ; dkg:confidence dkg:OnArtifact .

:Con_Pictures14_ES rdfs:comment "the 'Pictures' business object produced at event 14 — of the catastrophe, read by Help requested (15)" .
:Con_Pictures20_ES rdfs:comment "the 'Pictures' business object produced at event 20 — of the finished meal, read by Thanks given (21). Same label as event 14's object; split per the one-label-two-purposes rule." .
:Con_HelpResponse_ES skos:altLabel "Help Response" ; rdfs:comment "spelled 'Help Response' on the read-model stickies at 9 and 10, 'Help response' elsewhere" .
:Con_Ingredients rdfs:comment "on the board: a green read model at event 7 and a pale-yellow business object at event 9 (produced by Substitute ingredients)" .
:Con_User_ES dkg:renamedTo :Con_Cook_ES ; rdfs:comment "User goes in at Register cook, Cook comes out; 'User' never appears again on the board" .
:Act_User dkg:renamedTo :Act_Cook .

# --- merge ledger (beyond the auto-merges above) ---
:Act_CommunityCook dkg:proposedSameAs :Act_Community ; rdfs:comment "board 'Community Cook' vs the stories' 'Community' (responder in AskCommunity)" .
:Con_Pictures14_ES dkg:proposedSameAs :Con_CatastrophePictures ; rdfs:comment "board evidence photo vs story 'Catastrophe Pictures'" .
:Con_Pictures20_ES dkg:proposedSameAs :Con_Pictures ; rdfs:comment "board result photo vs story 'Pictures' shared with Community" .
:Con_Pictures_ES dkg:proposedSameAs :Con_Pictures14_ES, :Con_Pictures20_ES ; rdfs:comment "green 'Pictures' read models at 15 and 21 — which of the two produced objects each reads is the split question" .
:Con_HelpRequest_ES dkg:proposedSameAs :Con_Help ; rdfs:comment "board splits the stories' one 'Help' into request and response" .
:Con_HelpResponse_ES dkg:proposedSameAs :Con_Help .
:Con_Thanks_ES dkg:proposedSameAs :Cmd_Thanks ; rdfs:comment "board business object vs story verb (cross-class)" .
:Con_Menu_ES dkg:proposedSameAs :Con_Dinner, :Con_MealPlanning ; rdfs:comment "board 'Menu' vs story 'Dinner' / 'Meal Planning'" .
:Con_MealPlan_ES dkg:proposedSameAs :Con_MealPlanning, :Del_Planner, :VP_Planner .
:Con_Guests_ES dkg:proposedSameAs :Act_ParentsInLaw ; rdfs:comment "board read model vs story actor (cross-class)" .
:Con_Catastrophe_ES dkg:proposedSameAs :Cmd_Burns ; rdfs:comment "board read model 'Catastrophe' vs story verb 'burns' (cross-class)" .
:Con_RecipeCatalog_ES dkg:proposedSameAs :Cap_RecipeDatabase, :KR_Recipes ; rdfs:comment "board read model vs Wardley component vs BMC resource" .
:Con_HelpProvider_ES dkg:proposedSameAs :Act_GrandmaAvatar, :Act_Chef, :Act_CommunityCook ; rdfs:comment "the board's read model over whoever answered" .
:Con_Cook_ES dkg:proposedSameAs :Act_Cook ; rdfs:comment "the business object 'Cook' produced at registration vs the actor 'Cook'" .
:Ev_CookRegistered dkg:proposedSameAs :Goal_BecomeAMember, :Cap_MemberManagement_CM ; rdfs:comment "event vs Wardley need vs capability (cross-class)" .
:Ev_PicturesTaken dkg:proposedSameAs :Cmd_Takes .
:Ev_ThanksGiven dkg:proposedSameAs :Cmd_Thanks .
:Ev_HelpRequested dkg:proposedSameAs :Cmd_Asks, :Cmd_Needs .
:Ev_HelpProvided dkg:proposedSameAs :Cmd_Provides .
:Ev_MealRescued dkg:proposedSameAs :Cmd_Rescues .
:Ev_CatastropheHappened dkg:proposedSameAs :Cmd_Burns .
:Ev_IngredientsSubstituted dkg:proposedSameAs :Con_IngredientsSubstitutes .
:Cmd_PrepareMeal dkg:proposedSameAs :Cmd_Prepares, :Con_MealPreparation .
:Cmd_PlanDinner dkg:proposedSameAs :Cmd_Plans .
:Cmd_ProvideHelp dkg:proposedSameAs :Cmd_Provides .
:Cmd_RequestHelp dkg:proposedSameAs :Cmd_Asks .
:Cmd_ProvideThanks dkg:proposedSameAs :Cmd_Thanks .
:Cmd_TakePictures dkg:proposedSameAs :Cmd_Takes .
:Cmd_SearchRecipes dkg:proposedSameAs :Cap_RecipeSearch, :Cap_AdvancedSearch ; rdfs:comment "board command vs BMC key activity vs Wardley component (cross-class)" .
:Ctx_CookingAssistance dkg:proposedSameAs :Cap_CookingSupport, :Cap_CookingSupport_L1, :VP_CookingSupport ; rdfs:comment "bounded context vs key activity / capability / VP named 'Cooking Support' (cross-class)" .
:Ctx_MealPlanning dkg:proposedSameAs :Cap_Planner_CM, :Con_MealPlanning .
:Ctx_MealPreparation dkg:proposedSameAs :Con_MealPreparation, :Cap_Cooking_L1 .
:Ctx_Sharing dkg:proposedSameAs :Cap_Sharing_L1, :CR_DailyForSharing ; rdfs:comment "exact label with the capability-map level-1 'Sharing' (cross-class)" .
:Ctx_Media dkg:proposedSameAs :KR_Media, :Cap_MediaStorage .
:Ctx_CookProfile dkg:proposedSameAs :Cap_MemberManagement_CM, :Cap_Onboarding_L1, :Cluster_Authentication .


##############################################################################
# INGEST 8 — Visual Glossary, VisualGlossaryEnhanced.jpg — 2026-09-10
# 25 term boxes, 36 verb arrows, 7 is-a arrows. Cardinalities transcribed
# verbatim at the arrowhead end; where no number is drawn, none is recorded.
# Box colours (blue: Dinner/Menu/Course · green: Help provider/Chef/Help Meal
# plan/Menu proposal · grey: Meal) and the ⊞ icon on seven boxes carry no
# legend — recorded as a Question, NOT as bounded contexts.
# Terms whose exact label already exists as a Concept auto-merge (source
# added, dkg:Term type added); actor-named terms (Cook is the exception —
# the board's business object 'Cook' already exists) get _VG nodes with
# proposedSameAs to the story actors, because Actor and Concept are different
# spine classes.
##############################################################################

:Art_VG a dkg:VisualGlossary ;
    rdfs:label "Community Cooking visual glossary (VisualGlossaryEnhanced.jpg)" ;
    rdfs:comment "25 terms, 36 relationships, 7 is-a edges; no entity/value-object markings; colour groups unlabelled." ;
    dkg:ingestedAt "2026-09-10"^^xsd:date .

:Con_Dinner a dkg:Term ; dkg:source :Art_VG ; rdfs:comment "glossary: blue; ⊞" .
:Con_Menu_ES a dkg:Term ; dkg:source :Art_VG ; rdfs:comment "glossary: blue; ⊞" .
:Con_Course_VG a dkg:Term ; skos:prefLabel "Course" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact ; rdfs:comment "glossary: blue; ⊞" .
:Con_Cook_ES a dkg:Term ; dkg:source :Art_VG .
:Con_Meal a dkg:Term ; dkg:source :Art_VG ; rdfs:comment "glossary: grey box" .
:Con_Recipe a dkg:Term ; dkg:source :Art_VG .
:Con_Ingredient_VG a dkg:Term ; skos:prefLabel "Ingredient" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_Step_VG a dkg:Term ; skos:prefLabel "Step" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_Substitute_VG a dkg:Term ; skos:prefLabel "Substitute" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_Community_VG a dkg:Term ; skos:prefLabel "Community" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_GrandmaAvatar_VG a dkg:Term ; skos:prefLabel "Grandma Avatar" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_Chef_VG a dkg:Term ; skos:prefLabel "Chef" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact ; rdfs:comment "glossary: green; ⊞" .
:Con_HelpProvider_ES a dkg:Term ; dkg:source :Art_VG ; rdfs:comment "glossary: green; ⊞" .
:Con_HelpRequest_ES a dkg:Term ; dkg:source :Art_VG ; skos:altLabel "Help Request" .
:Con_Help a dkg:Term ; dkg:source :Art_VG .
:Con_Thanks_ES a dkg:Term ; dkg:source :Art_VG .
:Con_Picture_VG a dkg:Term ; skos:prefLabel "Picture" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_MealPreparationCatastrophe_VG a dkg:Term ; skos:prefLabel "Meal Preparation Catastrophe" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_HelpForMealPreparationStep_VG a dkg:Term ; skos:prefLabel "Help for Meal Preparation Step" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_HelpWithIngredients_VG a dkg:Term ; skos:prefLabel "Help with Ingredients" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_HelpMealPlan_VG a dkg:Term ; skos:prefLabel "Help Meal plan" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact ; rdfs:comment "glossary: green; ⊞" .
:Con_IngredientSubstitute_VG a dkg:Term ; skos:prefLabel "Ingredient Substitute" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Con_PreparationStepExplanation_VG a dkg:Term ; skos:prefLabel "Preparation Step Explanation" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
