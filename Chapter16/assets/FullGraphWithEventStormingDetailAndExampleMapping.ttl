    dkg:source :Art_APC_MealPreparation ; dkg:locator "operation row 5" ; dkg:confidence dkg:OnArtifact .

:Q_MealPrepVsBoard a dkg:Question ;
    skos:prefLabel "Where do Step unclear, Catastrophe happened and Meal rescued live in the Meal Preparation API?" ;
    rdfs:comment "Board v2: Meal Preparation lanes carry Preparation STARTED, Step UNCLEAR, CATASTROPHE, Step COMPLETED, Meal RESCUED, Meal PREPARED. The canvas offers start, read, next and previous step only — no catastrophe, no completion, no help. Context map v2: Cooking Assistance POSTs into and GETs Help response from Meal Preparation; Sharing GETs Help response from it — no operation serves either." ;
    dkg:source :Art_APC_MealPreparation ; dkg:locator "whole canvas" ; dkg:confidence dkg:Implied .
:Art_APC_MealPreparation dkg:raises :Q_MealPrepVsBoard .
:Q_PrepareMealSevenEvents rdfs:comment "Meal Preparation canvas: POST /preparations and next/previous step — 'Prepare meal' is still one interaction at the API." ; dkg:source :Art_APC_MealPreparation .

##############################################################################
# (image 1 of this batch: Meal Preparation canvas, identical to
#  :Art_APC_MealPreparation ingested earlier — nothing re-emitted.)
#
# Ingest — Meal preparation model (image 2), 2026-10-10. Grow — new Visual
# Glossary (per-aggregate model; same legend as the others, no invariants).
##############################################################################
:Art_Glossary_MealPreparation a dkg:VisualGlossary ;
    rdfs:label "Meal preparation model — aggregate, entity and value objects (image 2)" ;
    rdfs:comment "Aggregate Meal preparation: contains preparation Id 1, refers to recipe 1, contains current step 1 (entity); current step → howToStep Id and → sequence Number, both arrows without verb or cardinality. No status, no invariants. Example preparation Id 7cf09822-… is the UUID other models use as their recipe example; this model's recipe example is a different UUID." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Con_MealPreparation_Agg a dkg:AggregateRoot ; skos:prefLabel "Meal preparation" ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "dark yellow box 'Meal preparation'" ; dkg:confidence dkg:OnArtifact .
:Con_PreparationId a dkg:ValueObject ; dkg:source :Art_Glossary_MealPreparation ; dkg:locator "green box 'preparation Id'" ;
    rdfs:comment "Auto-merged: model 'preparation Id' = canvas 'preparation Id' (exact). Example 7cf09822-77a1-46bb-812f-b7852bca0913 — the recipe example UUID on the Help Request and Meal Plan models." .
:Con_Recipe_HR dkg:source :Art_Glossary_MealPreparation ; dkg:locator "green box 'recipe' (refers to 1)" ;
    rdfs:comment "Auto-merged: Meal preparation model 'recipe' = value object 'recipe' (exact, both value objects). Example here e1e82a2e-9555-49fc-9df0-b85edb5b5997, unlike the other two models." .
:Con_CurrentStep a dkg:Entity ; skos:prefLabel "current step" ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "yellow box 'current step'" ; dkg:confidence dkg:OnArtifact .
:Con_HowToStepId a dkg:ValueObject ; skos:prefLabel "howToStep Id" ; rdfs:comment "example 65610dee-fb83-4341-a730-26a4a99a621a" ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "green box 'howToStep Id'" ; dkg:confidence dkg:OnArtifact .
:Con_SequenceNumber a dkg:ValueObject ; skos:prefLabel "sequence Number" ; rdfs:comment "example 1" ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "green box 'sequence Number'" ; dkg:confidence dkg:OnArtifact .
:Rel_MPrep_ContainsPreparationId a dkg:Relationship ; skos:prefLabel "Meal preparation contains preparation Id" ;
    dkg:from :Con_MealPreparation_Agg ; dkg:verb "contains" ; dkg:to :Con_PreparationId ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "arrow 'contains' → preparation Id" ; dkg:confidence dkg:OnArtifact .
:Rel_MPrep_RefersToRecipe a dkg:Relationship ; skos:prefLabel "Meal preparation refers to recipe" ;
    dkg:from :Con_MealPreparation_Agg ; dkg:verb "refers to" ; dkg:to :Con_Recipe_HR ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "arrow 'refers to' → recipe" ; dkg:confidence dkg:OnArtifact .
:Rel_MPrep_ContainsCurrentStep a dkg:Relationship ; skos:prefLabel "Meal preparation contains current step" ;
    dkg:from :Con_MealPreparation_Agg ; dkg:verb "contains" ; dkg:to :Con_CurrentStep ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "arrow 'contains' → current step" ; dkg:confidence dkg:OnArtifact .
:Rel_CurrentStep_HowToStepId a dkg:Relationship ; skos:prefLabel "current step → howToStep Id" ;
    dkg:from :Con_CurrentStep ; dkg:to :Con_HowToStepId ; rdfs:comment "arrow drawn without verb or cardinality" ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "unlabelled arrow current step → howToStep Id" ; dkg:confidence dkg:OnArtifact .
:Rel_CurrentStep_SequenceNumber a dkg:Relationship ; skos:prefLabel "current step → sequence Number" ;
    dkg:from :Con_CurrentStep ; dkg:to :Con_SequenceNumber ; rdfs:comment "arrow drawn without verb or cardinality" ;
    dkg:source :Art_Glossary_MealPreparation ; dkg:locator "unlabelled arrow current step → sequence Number" ; dkg:confidence dkg:OnArtifact .
:Con_MealPreparation_Agg dkg:mentions :Con_PreparationId, :Con_Recipe_HR, :Con_CurrentStep .
:Con_CurrentStep dkg:mentions :Con_HowToStepId, :Con_SequenceNumber .

# --- merge ledger ---
:Con_MealPreparation_Agg dkg:proposedSameAs :Con_Preparation_MPC ;
    rdfs:comment "proposedSameAs Con_Preparation_MPC: canvas resource 'preparation' (GET /preparations/{id}) — containment" .
:Con_MealPreparation_Agg dkg:proposedSameAs :Ctx_MealPreparation ;
    rdfs:comment "proposedSameAs Ctx_MealPreparation: same words, aggregate vs context (cross-class) — listed, not expected to merge" .
:Con_HowToStepId dkg:proposedSameAs :Con_StepId ;
    rdfs:comment "proposedSameAs Con_StepId: canvas path parameter 'stepId' on the how-to-steps paths" .
:Con_HowToStepId dkg:proposedSameAs :Con_HowToStep ;
    rdfs:comment "proposedSameAs Con_HowToStep: Help Request model 'howTo Step' has the identical example UUID 65610dee-… — but see Q_ExampleUUIDsReused" .
:Con_CurrentStep dkg:proposedSameAs :Con_HowToStep_MPC ;
    rdfs:comment "proposedSameAs Con_HowToStep_MPC: canvas responses return 'howToStep' for current/next/previous" .

# --- questions ---
:Q_ExampleUUIDsReused a dkg:Question ;
    skos:prefLabel "Can identical example UUIDs be taken as evidence of identity?" ;
    rdfs:comment "The models reuse example UUIDs across unrelated things: f64e07f0-… is cook Id, requester, subject AND meal plan Id; 7cf09822-… is recipe (Help Request, Meal Plan) AND preparation Id (Meal preparation). Proposals resting on shared examples (cook Id ~ requester ~ subject; howToStep Id ~ howTo Step) are weaker than they looked. Not withdrawn — the room decides." ;
    dkg:source :Art_Glossary_MealPreparation, :Art_Glossary_Cook, :Art_Glossary_HelpRequest, :Art_Glossary_Consent, :Art_Glossary_MealPlan ;
    dkg:locator "example stickies" ; dkg:confidence dkg:OnArtifact .
:Art_Glossary_MealPreparation dkg:raises :Q_ExampleUUIDsReused .
:Con_CookId rdfs:comment "Caution: identity proposals to requester and subject rest on a shared example UUID, which the models also reuse for unrelated ids (see Q_ExampleUUIDsReused)." .
:Q_MealPrepStates a dkg:Question ;
    skos:prefLabel "Where are the preparation states on the Meal preparation aggregate?" ;
    rdfs:comment "Board v2 draws Preparation STARTED, Step UNCLEAR, CATASTROPHE, Step COMPLETED, Meal RESCUED, Meal PREPARED in the Meal Preparation lanes. The model has no status — only current step with a sequence Number." ;
    dkg:source :Art_Glossary_MealPreparation, :Art_ESBoard_2026_10_v2 ; dkg:locator "whole model" ; dkg:confidence dkg:Implied .
:Art_Glossary_MealPreparation dkg:raises :Q_MealPrepStates .
:Q_StateOwner rdfs:comment "Meal preparation model: an aggregate now exists for the Preparation/Step/Meal states, but draws none of them." ; dkg:source :Art_Glossary_MealPreparation .
:Q_MealPrepVsBoard rdfs:comment "Meal preparation model: no catastrophe, no help, no completion — consistent with its canvas, not with the board." ; dkg:source :Art_Glossary_MealPreparation .

