:Idea_LoginWithSocialAccount a dkg:Idea ; skos:prefLabel "Login with social account" ; dkg:inCluster :Cluster_Authentication ; dkg:source :Art_Brainstorm ; dkg:locator "Authentication" ; dkg:confidence dkg:OnArtifact .
