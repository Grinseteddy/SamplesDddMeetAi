    dkg:locator "read at event 21" ;
    dkg:confidence dkg:OnArtifact .
:Con_Pictures dkg:locator "read at event 21" .
:Con_Thanks dkg:source :Art_ESBoard ;
    dkg:locator "produced at event 21" .
:Cmd_ProvideThanks a dkg:Command ;
    skos:prefLabel "Provide thanks" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "event 21" ;
    dkg:confidence dkg:OnArtifact .
:Ev_ThanksGiven dkg:source :Art_ESBoard ;
    dkg:locator "event 21" ;
    dkg:sequence 21 ;
    dkg:inContext :Ctx_Thanks ;
    dkg:performedBy :Act_Cook ;
    dkg:reads :Con_HelpProvider ;
    dkg:reads :Con_Pictures ;
    dkg:produces :Con_Thanks .
:Cmd_ProvideThanks dkg:triggers :Ev_ThanksGiven .
:Ev_PicturesTaken dkg:precedes :Ev_ThanksGiven .
:Con_HelpResponse skos:altLabel "Help Response" .  # ES-I writes it with a capital R, ES-II without
:Ev_StepCompeteted skos:altLabel "Step completed" .  # the status sticky's spelling
:Con_Ingredients dkg:locator "ES-I, bottom-left of Meal Planning: loose Recipe / Help Response / Ingredients stickies with no event" .
:Con_User dkg:renamedTo :Con_Cook .
# ^ event 1 reads User and produces Cook; the actor sticky is User at event 1 and Cook on all 20 others
:Act_Cook dkg:proposedSameAs :Con_Cook .
# ^ one word as an actor sticky (20×) and as a business object (event 1) — cross-class
:Con_Recipes dkg:proposedSameAs :Con_Recipe .
# ^ plural read model at 'Recipes searched' vs singular everywhere else; may be result list vs entry
:Q_PrepareMealSevenTimes a dkg:Question ;
    skos:prefLabel "'Prepare meal' is the command on seven events (6, 11, 12, 13, 17, 18, 19) — placeholder for several commands, or one interaction?" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "blue stickies" ;
    dkg:confidence dkg:Implied .
:Cmd_PrepareMeal dkg:raises :Q_PrepareMealSevenTimes .
:Q_StatesWithoutAggregate a dkg:Question ;
    skos:prefLabel "Fourteen lilac status stickies (Plan CREATED … Thanks GIVEN) and no aggregate sticky — what carries these states?" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "top row of both photos" ;
    dkg:confidence dkg:Implied .
:Q_NoHotspots a dkg:Question ;
    skos:prefLabel "No red hotspot on a board whose events include stalled, unclear and catastrophe — was disagreement captured?" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "whole board" ;
    dkg:confidence dkg:Implied .
:Q_MealPlanReadByNobody a dkg:Question ;
    skos:prefLabel "Business object 'Meal plan' is produced at event 10 and read by no event — who consumes it?" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "event 10" ;
    dkg:mentions :Con_MealPlan ;
    dkg:confidence dkg:Implied .
:Q_PicturesOneOrTwo a dkg:Question ;
    skos:prefLabel "Pictures is produced at 14 (before a help request) and at 20 (before thanks) — one concept or two?" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "events 14, 20" ;
    dkg:mentions :Con_Pictures ;
    dkg:confidence dkg:Implied .
:Q_BoardEventsMissingOnMap a dkg:Question ;
    skos:prefLabel "'Step competeted', 'Meal rescued' and 'Meal prepared' are on the board but not in the context map's Meal Preparation bubble — dropped or forgotten?" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "ES-II bubble 4 vs map" ;
    dkg:confidence dkg:Implied .
:Ev_StepCompeteted dkg:raises :Q_BoardEventsMissingOnMap .
:Ev_MealRescued dkg:raises :Q_BoardEventsMissingOnMap .
:Ev_MealPrepared dkg:raises :Q_BoardEventsMissingOnMap .
:Q_MapContextsMissingOnBoard a dkg:Question ;
    skos:prefLabel "Recipe Catalog, Grandma Avatar AI, Notification and Consent Management are contexts on the map with no bubble on the board — where do they come from?" ;
    dkg:source :Art_ESBoard ;
    dkg:locator "map vs board" ;
    dkg:confidence dkg:Implied .


