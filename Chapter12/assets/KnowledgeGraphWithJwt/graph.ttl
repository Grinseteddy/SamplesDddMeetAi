:Q_HelpSameTerm_SADR0004 a dkg:Question ;
    skos:prefLabel "In the glossary 'Help' is the response (provided, contains substitutes/explanations); in the stories 'Help' is also what the Cook asks for. Same term?" ;
    dkg:source :Art_ADRLog_SadrsLarder ; dkg:locator "SADR0004, Question" ; dkg:confidence dkg:OnArtifact .

:D_SADR0004 a dkg:Decision ;
    skos:prefLabel "Help" ; dkg:decisionId "SADR0004" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-11"^^xsd:date ; dkg:decidedBy "Junker" ;
    dkg:decidedOption "Help response / Help request" ;
    dkg:consideredOption "Help or Help response for given Help; Help request for asking for help" ;
    dkg:sourceFormat "small-log" ; dkg:answers :Q_HelpSameTerm_SADR0004 ;
    dkg:mentions :Con_Help, :Con_HelpRequest, :Con_HelpResponse ;
    rdfs:comment "A split, not a rename: the one-word 'Help' becomes two terms for two senses (per ingest-small-adr.md's own reading of this exact row), so no dkg:renamedTo is emitted — both new Concepts carry this Decision as an added dkg:source instead." ;
    dkg:source :Art_ADRLog_SadrsLarder ; dkg:locator "SADR0004" ; dkg:confidence dkg:OnArtifact .

