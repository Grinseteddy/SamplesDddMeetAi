:Rel_Notif_ContainsStatus a dkg:Relationship ; skos:prefLabel "Notification contains status" ;
    dkg:from :Con_Notification ; dkg:verb "contains" ; dkg:to :Con_Status_Notif ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
