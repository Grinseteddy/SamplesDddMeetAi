@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/dkg/graph/larder>
    a owl:Ontology ;
    owl:imports <https://w3id.org/dkg/ns>, <https://w3id.org/dkg/ns/adr> ;
    rdfs:label "Larder — ADR & Principles knowledge graph" .

##############################################################################
# 0. Artifacts
##############################################################################

:Art_Principles_Larder a dkg:PrinciplesDocument , dkg:Artifact ;
    rdfs:label "LarderArchitecturalPrinciples.md" ;
    rdfs:comment "9 entries under 8 stated IDs (AP0001-AP0008); AP0005 is used twice for two unrelated principles (Automatic Testing, Micro-UIs) — see dkg:defect." ;
    dkg:defect "Two principles both carry the id 'AP0005': 'We can test our system by 95% automatically' (Automatic Testing) and 'The Bounded Context publish their own UI as micro-UIs' (Micro-UIs). Disambiguated here as AP0005a and AP0005b; principleId kept verbatim as 'AP0005' on both." ;
    dkg:defect "AP0005 (Micro-UIs) and AP0007 (Monitoring) carry an identical Implications sentence, 'Using a large monolithic frontend would us slow down.', which is on-topic for AP0005 but not for AP0007 (Monitoring) — a copy-paste, emitted verbatim on both rather than corrected." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Art_ADR_ADR0001 a dkg:ADRDocument , dkg:Artifact ;
    rdfs:label "ADR0001-Monolith.md" ;
    rdfs:comment "Adopted 2026-09-10, Annegret Junker." ;
    dkg:defect "The bolded Decision reads 'We will implement Larder as Monolith' (the plain-Monolith option), but the Context ('We defined Bounded Contexts of the Larder application. Those Bounded Contexts are modules in our application.'), the ten-module list, the per-module database-user note, and the explicit AP0001 citation all sit under the 'Modular monolith' option heading. The cross-check below is run on the Modular Monolith reading, per the skill's rule for a Decision line that contradicts its own Options section; dkg:decidedOption is kept verbatim as written." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Art_ADR_ADR0002 a dkg:ADRDocument , dkg:Artifact ;
    rdfs:label "ADR0002-Database.md" ;
    rdfs:comment "Adopted 2026-09-10, Annegret Junker." ;
    dkg:defect "The Consequences table is headed 'Modular Monolith | Microservices | Monolith' — copied verbatim from ADR0001 — but this ADR's own three options are 'One database instance with schemas per Bounded Context', 'One database instance per Bounded Contexts', 'One database for all', which do not line up one-to-one with those column headers." ;
    dkg:defect "The 'One database for all' option reads: 'Disadvantage: The Domain Models are easily (contradicts (see AP0001)).' — grammatically incomplete as written (missing the predicate after 'easily'); emitted verbatim." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Art_ADR_ADR0003 a dkg:ADRDocument , dkg:Artifact ;
    rdfs:label "ADR0003-AsynchronousCommunication.md" ;
    rdfs:comment "Adopted 2026-09-10, Annegret Junker. References an external Context Map image (../09_ContextMap.jpg), not itself ingested here." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Art_ADR_ADR0004 a dkg:ADRDocument , dkg:Artifact ;
    rdfs:label "ADR0004-SynchronousCommunicationViaMicroUi.md" ;
    rdfs:comment "Adopted 2026-09-10, Annegret Junker." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Art_ADR_ADR0005 a dkg:ADRDocument , dkg:Artifact ;
    rdfs:label "ADR0005-Orchestrator.md" ;
    rdfs:comment "Adopted 2026-09-10, Annegret Junker. Cites no principle by id anywhere in the document." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Art_ADRLog_SadrsLarder a dkg:ADRLog , dkg:Artifact ;
    rdfs:label "SadrsLarder.md — small ADR log" ;
    rdfs:comment "8 rows under 7 nominal ids; SADR0001-SADR0006 unique, SADR0007 used twice — see dkg:defect. One author (Junker) throughout." ;
    dkg:defect "Two rows both carry the id 'SADR0007': 'Capability Map with Legend' (2026-09-11) and 'JWT with cookId' (2026-09-20). Disambiguated here as SADR0007a and SADR0007b; decisionId kept verbatim as 'SADR0007' on both." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

##############################################################################
# 1. Principles Register
##############################################################################

:Prin_AP0001_MonolithBeforeMicroservices a dkg:Principle ;
    skos:prefLabel "Monolith before Microservices" ; dkg:principleId "AP0001" ;
    dkg:statement "We will always start with a deployment monolith before cutting services out. However, the modules are modular regarding DDD principles." ;
    dkg:rationale "In the beginning, we do not know exactly the load and performance issues the single services have to face. Therefore, we will cut later with more experience." ;
    dkg:implication "We will have later costs for cutting out services. The teams need to be disciplined to follow the strict boundaries of the Bounded Contexts." ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0001" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0002_AsyncBeforeSync a dkg:Principle ;
    skos:prefLabel "Asynchronous Communication before Synchronous" ; dkg:principleId "AP0002" ;
    dkg:statement "For communication between Bounded Contexts asynchronous communication is preferred." ;
    dkg:rationale "Asynchronous communication guarantees the loose coupling between Bounded Contexts." ;
    dkg:implication "Loose coupling guarantees that we can later maintain and operate our application without large downtimes." ;
    dkg:scope "between Bounded Contexts" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0002" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0003_UsingDDD a dkg:Principle ;
    skos:prefLabel "Using DDD" ; dkg:principleId "AP0003" ;
    dkg:statement "For design of our functional architecture, we will apply the principles of DDD." ;
    dkg:rationale "Architecture coming out of the blue does not support the business requirements functionally." ;
    dkg:implication "We need to support the functions required by business. Moreover, we need to support the maintenance of those functions for the upcoming years." ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    rdfs:comment "Borderline testability, like AP0004: 'apply the principles of DDD' names a methodology but no concrete practice. Called testable here because both full-form ADRs in this batch ground themselves explicitly in bounded-context / DDD-analysis language, which gives the cross-check something concrete to point at." ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0003" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0004_UsingResiduality a dkg:Principle ;
    skos:prefLabel "Using Residuality" ; dkg:principleId "AP0004" ;
    dkg:statement "For design of our technical architecture, we will apply the principles of Residuality Theory." ;
    dkg:rationale "Stressing an architecture with randomly selected stressors creates more sustaining architectures." ;
    dkg:implication "We do not know what future brings, therefore, we need the robust and best equipped architecture." ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    rdfs:comment "Borderline testability, like AP0003 — see that node's comment. No decision in this batch engages stressor analysis at all; flagged as a dead letter in the report rather than forced to a verdict here." ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0004" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0005a_AutomaticTesting a dkg:Principle ;
    skos:prefLabel "Automatic Testing" ; dkg:principleId "AP0005" ;
    dkg:statement "We can test our system by 95% automatically." ;
    dkg:rationale "Manual tests are too slow to allow us to test our system manually." ;
    dkg:implication "We need to follow a Test-Driven-Approach consequently." ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0005 (first occurrence, Automatic Testing)" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0005b_MicroUIs a dkg:Principle ;
    skos:prefLabel "Micro-UIs" ; dkg:principleId "AP0005" ;
    dkg:statement "The Bounded Context publish their own UI as micro-UIs." ;
    dkg:rationale "The teams developing the Bounded Contexts must be as independent as possible. The UIs are part of the Bounded Contexts projects. The micro UIs can use a common platform, so that they appear out of one hand." ;
    dkg:implication "Using a large monolithic frontend would us slow down." ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0005 (second occurrence, Micro-UIs)" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0006_SyncForUIs a dkg:Principle ;
    skos:prefLabel "Synchronous communication for UIs" ; dkg:principleId "AP0006" ;
    dkg:statement "UI communication is done synchronously." ;
    dkg:rationale "UIs require synchronous communication." ;
    dkg:implication "UIs must communicate with humans, who expect to get immediate answers." ;
    dkg:scope "UI communication" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0006" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0007_Monitoring a dkg:Principle ;
    skos:prefLabel "Monitoring" ; dkg:principleId "AP0007" ;
    dkg:statement "The system can be monitored to identify system-critical states reliable and fast." ;
    dkg:rationale "The operation of the software must be almost completely automated. We need to get a reliable alarm system based on a reliable monitoring system" ;
    dkg:implication "Using a large monolithic frontend would us slow down." ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    rdfs:comment "Implication field is copy-pasted from AP0005b — see dkg:defect on the artifact. Statement kept verbatim regardless." ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0007" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0008_FineGrainedAccessRights a dkg:Principle ;
    skos:prefLabel "Fine grained access rights" ; dkg:principleId "AP0008" ;
    dkg:statement "Domain artifacts are controlled by a fine-grained access control." ;
    dkg:rationale "The software will increase with time, and we need to respect the personal and author rights of our users." ;
    dkg:implication "With more coarse grained rights, we could contradict legal regulations." ;
    dkg:scope "domain artifacts" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ; dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0008" ; dkg:confidence dkg:OnArtifact .

