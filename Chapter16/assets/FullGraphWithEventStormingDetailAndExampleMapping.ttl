# --- Rule shared by boards A and C (exact label) ---
:R_ESD_HelpPrepStepProviders a dkg:Rule ; skos:prefLabel "Help Preparation step can be provided by community, or Grandma" ;
    rdfs:comment "Drawn on the Preparation-step board AND on the Catastrophe board, where no preparation step is otherwise in play — probably a copy left over; the Catastrophe board has no provider rule of its own." ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Community, :Act_GrandmaAvatar, :Con_HelpPreparationStep_ESD ;
    dkg:source :Art_ESDetail_PreparationStep_2026_10, :Art_ESDetail_Catastrophe_2026_10 ;
    dkg:locator "Preparation-step board: shield sticky right, 3rd", "Catastrophe board: shield sticky right, 3rd" ; dkg:confidence dkg:Implied .

# --- Business object / read model shared by boards (exact label) ---
:Con_HelpRequestPreparationStep a dkg:BusinessObject ; skos:prefLabel "Help request Preparation step" ;
    rdfs:comment "Preparation-step board: rows 1 and 2. Also the cancel-row business object on the Catastrophe board (as written)." ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_ESDetail_PreparationStep_2026_10, :Art_ESDetail_Catastrophe_2026_10 ;
    dkg:locator "Preparation-step board: row 1 and cancel row, pale yellow briefcase", "Catastrophe board: cancel row, pale yellow briefcase" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequestIngredient_RM a dkg:ReadModel ; skos:prefLabel "Help request Ingredient" ;
    rdfs:comment "Ingredient board: rows 1 and 2. Also the cancel-row read model on the Catastrophe AND Preparation-step boards (as written) — the same sticky on three boards." ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:source :Art_ESDetail_IngredientSubstitution_2026_10, :Art_ESDetail_Catastrophe_2026_10, :Art_ESDetail_PreparationStep_2026_10 ;
    dkg:locator "Ingredient board: row 1 and cancel row, green eye", "Catastrophe board: cancel row, green eye", "Preparation-step board: cancel row, green eye" ; dkg:confidence dkg:OnArtifact .

