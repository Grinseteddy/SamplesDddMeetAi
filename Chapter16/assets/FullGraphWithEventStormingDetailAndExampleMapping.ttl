##############################################################################
:Art_Glossary_MealPlan a dkg:VisualGlossary ;
    rdfs:label "Meal Plan model — aggregate, entity and value objects (image 2)" ;
    rdfs:comment "Aggregate Meal Plan; entity course (1..10) containing step and meal; meal (in course) refers recipe. Plan-level 'meal' has values breakfast, lunch, dinner, supper. 'meal' therefore names two different things on one model. 1 purple invariant, 1 pink question. Example meal plan Id equals the Cook model's example cook Id; recipe example equals the Help Request model's recipe example." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Con_MealPlan a dkg:AggregateRoot ; dkg:source :Art_Glossary_MealPlan ; dkg:locator "dark yellow box 'Meal Plan'" ;
    rdfs:comment "Auto-merged: model aggregate 'Meal Plan' = canvas/board 'Meal plan' (exact after case-folding)." .
:Con_MealPlanId a dkg:ValueObject ; dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'meal plan Id'" ;
    rdfs:comment "Auto-merged with canvas 'meal plan Id'. Example f64e07f0-f9e7-4b7a-8695-e7a8b3ef5074 — identical to the Cook model's cook Id example." .
:Con_Occasion a dkg:ValueObject ; dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'occasion'" ;
    rdfs:comment "Auto-merged with canvas 'Occasion' (case-folding). Example 'parents in law visiting'." .
:Con_Owner a dkg:ValueObject ; skos:prefLabel "owner" ; rdfs:comment "example 90f63dd9-ab62-4e7f-a69a-4ec89fa033ec" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'owner'" ; dkg:confidence dkg:OnArtifact .
:Con_Servings a dkg:ValueObject ; skos:prefLabel "servings" ; rdfs:comment "example 6" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'servings'" ; dkg:confidence dkg:OnArtifact .
:Con_MealType_MP a dkg:ValueObject ; skos:prefLabel "meal" ;
    rdfs:comment "plan-level 'meal' with values breakfast / lunch / dinner / supper — a kind of meal; NOT the 'meal' inside course (split: one word, two concepts on one model)" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'meal' (Meal Plan contains 1)" ; dkg:confidence dkg:OnArtifact .
:Con_HowToServe a dkg:ValueObject ; skos:prefLabel "how to serve" ; rdfs:comment "example 'hold course 2 warm while serving soup'" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'how to serve'" ; dkg:confidence dkg:OnArtifact .
:Con_Course a dkg:Entity ; dkg:source :Art_Glossary_MealPlan ; dkg:locator "yellow box 'course'" ;
    rdfs:comment "Auto-merged: model entity 'course' = glossary v2 term 'Course' (exact after case-folding)." .
:Con_CourseStep a dkg:ValueObject ; skos:prefLabel "step" ; rdfs:comment "example 2 — a position in the serving order" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'step' (course contains 1)" ; dkg:confidence dkg:OnArtifact .
:Con_CourseMeal a dkg:ValueObject ; skos:prefLabel "meal" ;
    rdfs:comment "'meal' inside course, refers 1 recipe — NOT the plan-level 'meal' (breakfast…supper)" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'meal' (course contains 1)" ; dkg:confidence dkg:OnArtifact .
:Con_Recipe_HR dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'recipe' (meal refers 1)" ;
    rdfs:comment "Auto-merged: Meal Plan model value object 'recipe' = Help Request model value object 'recipe' (exact, both value objects; identical example UUID 7cf09822-…)." .
:Con_Breakfast_MealType a dkg:ValueObject ; skos:prefLabel "breakfast" ; rdfs:subClassOf :Con_MealType_MP ;
    rdfs:comment "a value of plan-level 'meal' ('is' arrow)" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'breakfast'" ; dkg:confidence dkg:OnArtifact .
:Con_Lunch_MealType a dkg:ValueObject ; skos:prefLabel "lunch" ; rdfs:subClassOf :Con_MealType_MP ;
    rdfs:comment "a value of plan-level 'meal' ('is' arrow)" ;
    dkg:source :Art_Glossary_MealPlan ; dkg:locator "green box 'lunch'" ; dkg:confidence dkg:OnArtifact .
