<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.larder</groupId>
        <artifactId>larder-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>larder-app</artifactId>
    <name>Larder :: Application</name>
    <description>The one deployable of the modular monolith (ADR0001). Assembles all Bounded Contexts and contains no domain code.</description>

    <dependencies>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>recipe-catalog</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>meal-planning</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>meal-preparation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>cooking-assistance</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>grandma-avatar-ai</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>notification</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>media</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>sharing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>cook-profile</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder.bc</groupId>
            <artifactId>consent-management</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.larder</groupId>
            <artifactId>app-shell</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- End-to-end rescue story and provider contract tests (RescueStoryEndToEndTest) -->
        <dependency>
            <groupId>org.larder.platform</groupId>
            <artifactId>platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
