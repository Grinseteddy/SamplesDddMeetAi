    skos:prefLabel "Using One Database Instance" ; dkg:decisionId "ADR0002" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-10"^^xsd:date ; dkg:decidedBy "Annegret Junker" ;
    dkg:decidedOption "We will use one database instance for Larder." ;
    dkg:consideredOption "One database instance with schemas per Bounded Context", "One database instance per Bounded Contexts", "One database for all" ;
    dkg:consequence "Implementation: More discipline", "Maintenance: Easier", "Operation: Secure", "Enhancements: Small effort" ;
    dkg:rationale "The Bounded Contexts modules in the modular monolith need databases." ;
    dkg:sourceFormat "full-form" ; dkg:answers :Q_ADR0002_DatabaseTopology ;
    dkg:cites :Prin_AP0001_MonolithBeforeMicroservices ;
    dkg:defect "Consequences table headers and content do not match this ADR's own three options — see the Artifact's dkg:defect." ;
    dkg:source :Art_ADR_ADR0002 ; dkg:locator "ADR0002" ; dkg:confidence dkg:OnArtifact .

:D_ADR0002 dkg:honors :Prin_AP0001_MonolithBeforeMicroservices, :Prin_AP0003_UsingDDD .

:As_ADR0002_honors_AP0001 a dkg:Assertion ; rdf:subject :D_ADR0002 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0001_MonolithBeforeMicroservices ;
    dkg:citedBy "explicit" ;
    rdfs:comment "Chosen option: 'Advantages: Easy to maintain and to operate (see AP0001)'." ;
    dkg:source :Art_ADR_ADR0002 ; dkg:confidence dkg:OnArtifact .

:As_ADR0002_honors_AP0003 a dkg:Assertion ; rdf:subject :D_ADR0002 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0003_UsingDDD ;
    dkg:citedBy "incidental" ;
    rdfs:comment "One schema per Bounded Context module, with its own database user, mirrors the same DDD module boundaries ADR0001 draws; AP0003 is not cited by number." ;
    dkg:source :Art_ADR_ADR0002 ; dkg:confidence dkg:Implied .

