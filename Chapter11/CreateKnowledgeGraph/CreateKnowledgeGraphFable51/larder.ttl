@prefix dkg:  <https://w3id.org/dkg/ns#> .
@prefix :     <https://w3id.org/dkg/graph/larder#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/dkg/graph/larder>
    a owl:Ontology ;
    owl:imports <https://w3id.org/dkg/ns> ;
    rdfs:label "Larder (Community Cooking) — domain knowledge graph" .

##############################################################################
# INGEST 1 — Brainstorm, BrainstormingConvergence.jpg — 2026-09-10
# Mind map centred on "Larder". Green nodes = clusters the room drew.
# Yellow stickies = ideas. Blue italic stickies (8) = a second colour whose
# meaning is NOT on the picture; recorded as rdfs:comment, not as a class.
# No dot votes. No illegible stickies. Attachment of "Timer", "Cookbook
# publishing", "Food pairing" and "Fridge-photo recipe generation" to a cluster
# is read off crossing lines and marked Implied.
##############################################################################

:Art_Brainstorm a dkg:Brainstorm ;
    rdfs:label "Larder brainstorm — mind map (BrainstormingConvergence.jpg)" ;
    rdfs:comment "11 clusters, 42 idea stickies, 8 in a second (blue) colour of unconfirmed meaning, 0 illegible, no votes." ;
    dkg:ingestedAt "2026-09-10"^^xsd:date .

:Idea_Larder a dkg:Idea, dkg:Concept ;
    skos:prefLabel "Larder" ;
    rdfs:comment "the centre of the mind map; the name every cluster hangs off" ;
    dkg:source :Art_Brainstorm ; dkg:locator "centre" ; dkg:confidence dkg:OnArtifact .

# --- clusters ---
:Cluster_Shopping a dkg:Cluster ; skos:prefLabel "Shopping" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_Helper a dkg:Cluster ; skos:prefLabel "Helper" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_CreatorSupport a dkg:Cluster ; skos:prefLabel "Creator Support" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_Special a dkg:Cluster ; skos:prefLabel "Special" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_Community a dkg:Cluster ; skos:prefLabel "Community" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_Authentication a dkg:Cluster ; skos:prefLabel "Authentication" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_ContentCreation a dkg:Cluster ; skos:prefLabel "Content Creation" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_ContentRating a dkg:Cluster ; skos:prefLabel "Content Rating" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_Planner a dkg:Cluster ; skos:prefLabel "Planner" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_CookingSupport a dkg:Cluster ; skos:prefLabel "Cooking Support" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .
:Cluster_RecipeSearch a dkg:Cluster ; skos:prefLabel "Recipe Search" ; dkg:source :Art_Brainstorm ; dkg:confidence dkg:OnArtifact .

# --- ideas: Shopping ---
:Idea_KitchenTools a dkg:Idea ; skos:prefLabel "Kitchen tools" ; dkg:inCluster :Cluster_Shopping ; dkg:source :Art_Brainstorm ; dkg:locator "Shopping" ; dkg:confidence dkg:OnArtifact .
:Idea_NecessaryStuff a dkg:Idea ; skos:prefLabel "Necessary stuff" ; dkg:inCluster :Cluster_Shopping ; dkg:source :Art_Brainstorm ; dkg:locator "Shopping" ; dkg:confidence dkg:OnArtifact .
:Idea_OrderIngredientsDirectly a dkg:Idea ; skos:prefLabel "Order ingredients directly" ; dkg:inCluster :Cluster_Shopping ; dkg:source :Art_Brainstorm ; dkg:locator "Shopping" ; dkg:confidence dkg:OnArtifact .
:Idea_LarderTracker a dkg:Idea ; skos:prefLabel "Larder tracker" ; rdfs:comment "blue sticky" ; dkg:inCluster :Cluster_Shopping ; dkg:source :Art_Brainstorm ; dkg:locator "Shopping" ; dkg:confidence dkg:OnArtifact .
