##############################################################################
# 3. Decisions — full-form ADRs
##############################################################################

:Q_ADR0001_DeploymentShape a dkg:Question ;
    skos:prefLabel "Which deployment shape (module / Bounded-Context structure) will Larder use?" ;
    dkg:source :Art_ADR_ADR0001 ; dkg:locator "Context" ; dkg:confidence dkg:Implied .

:D_ADR0001 a dkg:Decision ;
    skos:prefLabel "Using Monolith" ; dkg:decisionId "ADR0001" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-10"^^xsd:date ; dkg:decidedBy "Annegret Junker" ;
    dkg:decidedOption "We will implement Larder as Monolith." ;
    dkg:consideredOption "Modular monolith", "Microservices", "Monolith" ;
    dkg:consequence "Implementation: Higher effort", "Maintenance: Higher effort", "Operation: Small effort", "Enhancements: Small effort" ;
    dkg:rationale "We defined Bounded Contexts of the Larder application. Those Bounded Contexts are modules in our application." ;
    dkg:sourceFormat "full-form" ; dkg:answers :Q_ADR0001_DeploymentShape ;
    dkg:cites :Prin_AP0001_MonolithBeforeMicroservices ;
    dkg:mentions :Ctx_RecipeCatalog, :Ctx_MealPlanning, :Ctx_CookProfile, :Act_GrandmaAvatar,
        :Ctx_Notification, :Ctx_CookingAssistance, :Ctx_Media, :Ctx_ConsentManagement,
        :Ctx_MealPreparation, :Ctx_Sharing ;
    dkg:defect "Decision line names plain 'Monolith'; the rest of the document argues 'Modular monolith' — see the Artifact's dkg:defect. Cross-check run on the Modular Monolith reading." ;
    dkg:source :Art_ADR_ADR0001 ; dkg:locator "ADR0001" ; dkg:confidence dkg:OnArtifact .

:D_ADR0001 dkg:honors :Prin_AP0001_MonolithBeforeMicroservices, :Prin_AP0003_UsingDDD .

:As_ADR0001_honors_AP0001 a dkg:Assertion ; rdf:subject :D_ADR0001 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0001_MonolithBeforeMicroservices ;
    dkg:citedBy "explicit" ;
    rdfs:comment "Modular monolith option: 'Advantages: Easy to maintain and to operate (see AP0001)'." ;
    dkg:source :Art_ADR_ADR0001 ; dkg:confidence dkg:OnArtifact .

:As_ADR0001_honors_AP0003 a dkg:Assertion ; rdf:subject :D_ADR0001 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0003_UsingDDD ;
    dkg:citedBy "incidental" ;
    rdfs:comment "Context: 'We defined Bounded Contexts of the Larder application. Those Bounded Contexts are modules in our application.' — DDD language throughout, but AP0003 is never cited by number." ;
    dkg:source :Art_ADR_ADR0001 ; dkg:confidence dkg:Implied .

