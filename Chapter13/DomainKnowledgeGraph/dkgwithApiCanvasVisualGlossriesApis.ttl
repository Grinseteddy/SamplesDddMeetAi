    dkg:path "/thanks" ;
    dkg:messageKind "qry" ;
    dkg:responseSchema :Sch_Sharing_Consents ;
    dkg:exposedBy :Api_Sharing ;
    dkg:source :Art_APC_Sharing ;
    dkg:locator "/thanks row, GET" ;
    dkg:confidence dkg:OnArtifact .

:Op_Sharing_POST_Thanks a dkg:Operation ;
    skos:prefLabel "POST /thanks" ;
    rdfs:comment "parameters: — · request: thanks · success: 201: Link to created thanks · errors: 400, 401, 403, 500, default" ;
    dkg:httpMethod "POST" ;
    dkg:path "/thanks" ;
    dkg:messageKind "cmd" ;
    dkg:requestSchema :Sch_Sharing_Thanks ;
    dkg:exposedBy :Api_Sharing ;
    dkg:source :Art_APC_Sharing ;
    dkg:locator "/thanks row, POST" ;
    dkg:confidence dkg:OnArtifact .
:Op_Sharing_POST_Thanks dkg:mentions :Con_Thanks .

:Op_Sharing_GET_ThanksByThanksId a dkg:Operation ;
    skos:prefLabel "GET /thanks/{thanksId}" ;
    rdfs:comment "parameters: thanks Id · request: — · success: 200: thanks · errors: 400, 401, 403, 404, 500, default" ;
    dkg:httpMethod "GET" ;
    dkg:path "/thanks/{thanksId}" ;
