# Ingest — API contract 'Cooking Assistance 1.0.0 (AsyncAPI 3.1)' (cooking-assistance.asyncapi.yaml), 2026-10-10. Grow.
# DERIVED DOCUMENT: generated from canvas + model; everything new is dkg:Inferred,
# sourced to the contract. Existing nodes are NOT re-sourced (no false corroboration).
##############################################################################
:Art_API_CookingAssistance_AAS a dkg:Artifact ;
    rdfs:label "Cooking Assistance — AsyncAPI 3.1, version 1.0.0 (cooking-assistance.asyncapi.yaml)" ;
    rdfs:comment "AsyncAPI draft from the Cooking Assistance async canvas and the Help Request / Help models. RabbitMQ amqps larder.org:5671, credentials via a user-password scheme, NOT in the URL. Exchange 'cooking-assistance' (topic). Publishes HelpRequestCreated (routing key cooking-assistance.help-request.created) and HelpProvided (cooking-assistance.help.provided); consumes HelpProvided from queue cooking-assistance.help-provided. MessageHeader: correlationId, messageId, source. Encodes the Help Request invariants (recipe/howToStep/ingredients by type; CHEF only with MENU_PROPOSAL and then sole provider) and Help invariants (answerType = request type). Invents length limits (title ≤200, description ≤2000)." ;
    dkg:mentions :Ctx_CookingAssistance ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Con_CorrelationId a dkg:Concept ; skos:prefLabel "correlationId" ;
    rdfs:comment "message header field: 'Identifier to trace one help journey end to end (request → help → thanks)'; the Notifications AsyncAPI says it carries the helpRequestId" ;
    dkg:mentions :Con_HelpRequestId, :Con_Thanks ;
    dkg:source :Art_API_CookingAssistance_AAS ; dkg:locator "components.schemas.MessageHeader" ; dkg:confidence dkg:Inferred .
:Msg_API_CA_Pub_HelpRequestCreated a dkg:Message ; skos:prefLabel "publishes HelpRequestCreated" ; dkg:from :Ctx_CookingAssistance ; dkg:messageKind "evt" ;
    dkg:carries "exchange cooking-assistance · routing key cooking-assistance.help-request.created · message HelpRequestCreated · payload Help Request (status OPEN)" ; dkg:mentions :Ev_HelpRequestCreated, :Con_HelpRequest, :Msg_APC_CA_Out_HelpRequestCreated ; rdfs:comment "Description names consumers 'such as Notification and the Grandma Avatar'." ;
    dkg:source :Art_API_CookingAssistance_AAS ; dkg:locator "operations.publishHelpRequestCreated" ; dkg:confidence dkg:Inferred .
:Msg_API_CA_Pub_HelpProvided a dkg:Message ; skos:prefLabel "publishes HelpProvided" ; dkg:from :Ctx_CookingAssistance ; dkg:messageKind "evt" ;
    dkg:carries "exchange cooking-assistance · routing key cooking-assistance.help.provided · message HelpProvided · payload Help (+ helpRequestStatus ANSWERED, required)" ; dkg:mentions :Ev_HelpProvided, :Con_Help, :Msg_APC_CA_Out_HelpProvided ; rdfs:comment "Description names consumers 'such as Meal Planning, Meal Preparation and Sharing'." ;
    dkg:source :Art_API_CookingAssistance_AAS ; dkg:locator "operations.publishHelpProvided" ; dkg:confidence dkg:Inferred .
:Msg_API_CA_Sub_HelpProvided a dkg:Message ; skos:prefLabel "consumes HelpProvided" ; dkg:to :Ctx_CookingAssistance ; dkg:messageKind "evt" ;
    dkg:carries "queue cooking-assistance.help-provided (bound to exchange cooking-assistance) · message HelpProvided" ; dkg:mentions :Ev_HelpProvided, :Msg_APC_CA_In_HelpProvided ; rdfs:comment "Marks the referenced request Answered; manual ack." ;
    dkg:source :Art_API_CookingAssistance_AAS ; dkg:locator "operations.consumeHelpProvided" ; dkg:confidence dkg:Inferred .
:Q_HelpProvidedConsumers a dkg:Question ; skos:prefLabel "Do Meal Planning, Meal Preparation and Sharing consume HelpProvided as an event?" ;
    rdfs:comment "The Cooking Assistance AsyncAPI says they react to it; context map v2 draws Meal Planning and Meal Preparation as synchronous 'GET Help response' and Sharing as GET from Meal Preparation; no canvas of those three receives an event." ; dkg:mentions :Msg_CM2_03_CookingAssistance_MealPlanning, :Msg_CM2_08_CookingAssistance_MealPreparation, :Msg_CM2_12_Sharing_MealPreparation ;
    dkg:source :Art_API_CookingAssistance_AAS ; dkg:locator "operations.publishHelpProvided description" ; dkg:confidence dkg:Inferred .
:Art_API_CookingAssistance_AAS dkg:raises :Q_HelpProvidedConsumers .
:Q_HelpRequestAtWhom rdfs:comment "Cooking Assistance AsyncAPI and OpenAPI both encode preferredProvider 1..2 with CHEF exclusive — they follow the Help Request model, not the glossary's two mandatory ends. A derived reading, not a decision." ; dkg:source :Art_API_CookingAssistance_AAS .
:Q_CredentialOnCanvases rdfs:comment "Cooking Assistance AsyncAPI keeps the credential out of the server URL (user-password security scheme)." ; dkg:source :Art_API_CookingAssistance_AAS .

