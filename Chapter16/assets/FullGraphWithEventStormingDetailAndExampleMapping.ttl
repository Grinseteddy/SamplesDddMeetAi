    dkg:to :Ctx_MealPreparation ; dkg:messageKind "?" ;
    dkg:carries "POST /preparations | parameters: — | request: recipe | responses: 201: Link to created meal prepartion · 400, 401, 403, 500, default" ; dkg:mentions :Con_Recipe_HR, :Con_Preparation_MPC ;
