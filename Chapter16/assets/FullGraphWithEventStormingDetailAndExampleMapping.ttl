:Con_Requester a dkg:Concept ; skos:prefLabel "Requester" ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "parameter of GET /help-requests" ; dkg:confidence dkg:OnArtifact .
:Con_Status a dkg:Concept ; skos:prefLabel "Status" ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "parameter of GET /help-requests" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequestId a dkg:Concept ; skos:prefLabel "help Request Id" ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "parameter of /help-requests/{helpRequestId} and GET /helps" ; dkg:confidence dkg:OnArtifact .
:Con_AggregateID a dkg:Concept ; skos:prefLabel "Aggregate ID" ;
    rdfs:comment "parameter name on DELETE /help-requests/{helpRequestId}; its GET and PATCH siblings say 'help Request Id'" ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "DELETE /help-requests/{helpRequestId}" ; dkg:confidence dkg:OnArtifact .
:Con_AggregateID dkg:proposedSameAs :Con_HelpRequestId ; rdfs:comment "proposedSameAs Con_HelpRequestId: same path parameter, different name on one row" .
:Con_Type a dkg:Concept ; skos:prefLabel "type" ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "parameter of GET /helps" ; dkg:confidence dkg:OnArtifact .
:Con_HelpId a dkg:Concept ; skos:prefLabel "help Id" ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "parameter of /helps/{helpId}" ; dkg:confidence dkg:OnArtifact .
:R_OnlyRequesterIsAllowedTo a dkg:Rule ; skos:prefLabel "Only requester is allowed to" ;
    rdfs:comment "purple 🔒 sticky, drawn twice: PATCH and DELETE /help-requests/{helpRequestId}" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_HelpRequest, :Con_Requester ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "PATCH and DELETE /help-requests/{helpRequestId}" ; dkg:confidence dkg:OnArtifact .
:R_OnlyInStatusOpen a dkg:Rule ; skos:prefLabel "Only in status open" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_HelpRequest, :Con_Status ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "DELETE /help-requests/{helpRequestId}" ; dkg:confidence dkg:OnArtifact .
:R_ChefHelpOnlyForRequester a dkg:Rule ; skos:prefLabel "If help provider is Chef only original requester can see the help" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_Help, :Con_HelpProvider, :Con_Requester ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "GET /helps, Requests column" ; dkg:confidence dkg:OnArtifact .
:R_OnlyProviderIsAllowedTo a dkg:Rule ; skos:prefLabel "Only provider is allowed to" ;
    rdfs:comment "purple 🔒 sticky, drawn twice: PATCH and DELETE /helps/{helpId}" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Con_Help, :Con_HelpProvider ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "PATCH and DELETE /helps/{helpId}" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_01 a dkg:Message ; skos:prefLabel "GET /help-requests" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "GET /help-requests | parameters: Requester, Status | request: — | responses: 200: help requests · 400, 401, 403, 500, default" ; dkg:mentions :Con_Requester, :Con_Status, :Con_HelpRequest ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 1" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_02 a dkg:Message ; skos:prefLabel "POST /help-requests" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "POST /help-requests | parameters: — | request: Help request | responses: 201: Link to created help request · 400, 401, 403, 500, default" ; dkg:mentions :Con_HelpRequest ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 2" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_03 a dkg:Message ; skos:prefLabel "GET /help-requests/{helpRequestId}" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "GET /help-requests/{helpRequestId} | parameters: help Request Id | request: — | responses: 200: help Request · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_HelpRequestId, :Con_HelpRequest ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 3" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_04 a dkg:Message ; skos:prefLabel "PATCH /help-requests/{helpRequestId}" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "PATCH /help-requests/{helpRequestId} | parameters: help Request Id; Only requester is allowed to | request: Help request | responses: 200: Link to changed help request · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_HelpRequestId, :Con_HelpRequest, :R_OnlyRequesterIsAllowedTo ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 4" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_05 a dkg:Message ; skos:prefLabel "DELETE /help-requests/{helpRequestId}" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "DELETE /help-requests/{helpRequestId} | parameters: Aggregate ID; Only requester is allowed to; Only in status open | request: — | responses: 204 · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_AggregateID, :Con_HelpRequest, :R_OnlyRequesterIsAllowedTo, :R_OnlyInStatusOpen ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 5" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_06 a dkg:Message ; skos:prefLabel "GET /helps" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "GET /helps | parameters: help Request Id, type, help provider; If help provider is Chef only original requester can see the help | request: — | responses: 200: helps · 400, 401, 403, 500, default" ; dkg:mentions :Con_HelpRequestId, :Con_Type, :Con_HelpProvider, :Con_Help, :R_ChefHelpOnlyForRequester ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 6" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_07 a dkg:Message ; skos:prefLabel "POST /helps" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "POST /helps | parameters: — | request: Help | responses: 201: Link to created help · 400, 401, 403, 500, default" ; dkg:mentions :Con_Help ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 7" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_08 a dkg:Message ; skos:prefLabel "GET /helps/{helpId}" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "GET /helps/{helpId} | parameters: help Id | request: — | responses: 200: help · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_HelpId, :Con_Help ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 8" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_09 a dkg:Message ; skos:prefLabel "PATCH /helps/{helpId}" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "PATCH /helps/{helpId} | parameters: help Id; Only provider is allowed to | request: Help | responses: 200: Link to changed help request · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_HelpId, :Con_Help, :R_OnlyProviderIsAllowedTo ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 9" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_CAS_10 a dkg:Message ; skos:prefLabel "DELETE /helps/{helpId}" ;
    dkg:to :Ctx_CookingAssistance ; dkg:messageKind "?" ;
    dkg:carries "DELETE /helps/{helpId} | parameters: help Id; Only provider is allowed to | request: — | responses: 204 · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_HelpId, :Con_Help, :R_OnlyProviderIsAllowedTo ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "operation row 10" ; dkg:confidence dkg:OnArtifact .

:Q_CASyncSide rdfs:comment "The sync canvas (image 2 of the second API batch) now describes Cooking Assistance's REST side: /help-requests and /helps. Not closed: context map v2 has callers POST Menu, Ingredients, Recipe and Pictures, which no operation takes, and GET 'Help response', which the canvas calls 'help'." ; dkg:source :Art_APC_CookingAssistance_Sync .
:Q_HelpPatchResponse a dkg:Question ;
    skos:prefLabel "Does PATCH /helps/{helpId} return a link to the changed help or to a help request?" ;
    rdfs:comment "Its response sticky reads 'Link to changed help request'; POST /helps returns 'Link to created help'." ;
    dkg:source :Art_APC_CookingAssistance_Sync ; dkg:locator "PATCH /helps/{helpId}, Responses" ; dkg:confidence dkg:OnArtifact .
:Art_APC_CookingAssistance_Sync dkg:raises :Q_HelpPatchResponse .

##############################################################################
# Ingest — Help Request model (image 3), 2026-10-10. Grow — new Visual Glossary
# (vs glossary v2: share 45%, cover 32% → not a revision; a per-aggregate model).
# Legend on the artifact: aggregate / entity / value object / example /
# invariant (purple, 🔒). No context drawn.
##############################################################################
:Art_Glossary_HelpRequest a dkg:VisualGlossary ;
    rdfs:label "Help Request model — aggregate, value objects and invariants (image 3)" ;
    rdfs:comment "Aggregate Help Request with 10 'contains' arrows (cardinalities drawn), 3 value sets drawn as 'is' arrows (type, preferred Provider, status), 12 invariant stickies (9 distinct texts, some split across two stickies). Examples include requester f64e07f0-f9e7-4b7a-8695-e7a8b3ef5074 — the same UUID the Consent model gives as a 'subject' example." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Con_HelpRequest a dkg:AggregateRoot ; dkg:source :Art_Glossary_HelpRequest ; dkg:locator "dark yellow box 'Help Request'" ;
    rdfs:comment "Auto-merged: model aggregate 'Help Request' = glossary term (exact, both dkg:Concept)." .
:Con_HelpRequestId a dkg:ValueObject ; skos:altLabel "help request Id" ; dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'help request Id'" ;
    rdfs:comment "Auto-merged: model 'help request Id' = sync canvas 'help Request Id' (exact after case-folding). Example: a UUID." .
:Con_Requester a dkg:ValueObject ; dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'requester'" ;
    rdfs:comment "Auto-merged: model 'requester' = sync canvas 'Requester' (exact after case-folding). Example UUID f64e07f0-f9e7-4b7a-8695-e7a8b3ef5074." .
:Con_Type a dkg:ValueObject ; dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'type'" ;
    rdfs:comment "Auto-merged: model 'type' = sync canvas 'type' (exact)." .
:Con_Status a dkg:ValueObject ; dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'status'" ;
    rdfs:comment "Auto-merged: model 'status' = sync canvas 'Status' (exact after case-folding)." .
:Con_Title a dkg:ValueObject ; skos:prefLabel "title" ;
    rdfs:comment "example 'Burning Catastrophe'" ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'title'" ; dkg:confidence dkg:OnArtifact .
:Con_Description a dkg:ValueObject ; skos:prefLabel "description" ;
    rdfs:comment "example 'Scones are burned and mother in law is coming in 30 minutes'" ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'description'" ; dkg:confidence dkg:OnArtifact .
:Con_Recipe_HR a dkg:ValueObject ; skos:prefLabel "recipe" ;
    rdfs:comment "a reference (example: a UUID)" ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'recipe'" ; dkg:confidence dkg:OnArtifact .
:Con_HowToStep a dkg:ValueObject ; skos:prefLabel "howTo Step" ;
    rdfs:comment "a reference (example: a UUID)" ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'howTo Step'" ; dkg:confidence dkg:OnArtifact .
:Con_Ingredients_HR a dkg:ValueObject ; skos:prefLabel "ingredients" ;
    rdfs:comment "references (example: a UUID)" ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'ingredients'" ; dkg:confidence dkg:OnArtifact .
:Con_PreferredProvider a dkg:ValueObject ; skos:prefLabel "preferred Provider" ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "green box 'preferred Provider'" ; dkg:confidence dkg:OnArtifact .
:Rel_HR_ContainsHelpRequestId a dkg:Relationship ; skos:prefLabel "Help Request contains help request Id" ;
    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_HelpRequestId ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → help request Id" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequest dkg:mentions :Con_HelpRequestId .
:Rel_HR_ContainsRequester a dkg:Relationship ; skos:prefLabel "Help Request contains requester" ;
    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_Requester ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_HelpRequest ; dkg:locator "arrow 'contains' Help Request → requester" ; dkg:confidence dkg:OnArtifact .
:Con_HelpRequest dkg:mentions :Con_Requester .
:Rel_HR_ContainsTitle a dkg:Relationship ; skos:prefLabel "Help Request contains title" ;
    dkg:from :Con_HelpRequest ; dkg:verb "contains" ; dkg:to :Con_Title ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
