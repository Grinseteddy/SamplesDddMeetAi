# Ingest — Consent model (image 2), 2026-10-10. Grow — new Visual Glossary
# (0% overlap with the domain-wide glossary). Legend on the artifact:
# dark yellow aggregate, yellow entity, green value object, grey example,
# purple invariant (none used). No context drawn: no dkg:inContext from here.
##############################################################################
:Art_Glossary_Consent a dkg:VisualGlossary ;
    rdfs:label "Consent model — aggregate, entities and value objects (image 2)" ;
    rdfs:comment "8 terms, 7 'contains' arrows with drawn cardinalities, grey example stickies. Legend present; the invariant colour is defined but unused. givenAt/revokedAt example written '2026-09-2026-09-21T12:34+02:00' (malformed as written)." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Con_Consent a dkg:AggregateRoot ; dkg:source :Art_Glossary_Consent ; dkg:locator "dark yellow box 'Consent'" ;
    rdfs:comment "Auto-merged: Consent model aggregate 'Consent' = existing 'Consent' (exact, both dkg:Concept)." .
:Con_Subject a dkg:ValueObject ; dkg:source :Art_Glossary_Consent ; dkg:locator "green box 'subject'" ;
    rdfs:comment "examples on the model: a UUID; 'The one who gives the consent'" .
:Con_ConsentId a dkg:ValueObject ; dkg:source :Art_Glossary_Consent ; dkg:locator "green box 'consent Id'" ; rdfs:comment "example: a UUID" .
:Con_ConsentTextId a dkg:ValueObject ; dkg:source :Art_Glossary_Consent ; dkg:locator "green box 'consent Text Id'" ; rdfs:comment "example: a UUID" .
:Con_ConsentText a dkg:Entity ; skos:prefLabel "consent Text" ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "yellow box 'consent Text'" ; dkg:confidence dkg:OnArtifact .
:Con_Text a dkg:ValueObject ; skos:prefLabel "text" ;
    rdfs:comment "example on the model: 'I allow to use my photos in public thanks and recipes.'" ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "green box 'text'" ; dkg:confidence dkg:OnArtifact .
:Con_GivenAt a dkg:ValueObject ; skos:prefLabel "givenAt" ;
    rdfs:comment "example as written: '2026-09-2026-09-21T12:34+02:00'" ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "green box 'givenAt'" ; dkg:confidence dkg:OnArtifact .
:Con_RevokedAt a dkg:ValueObject ; skos:prefLabel "revokedAt" ;
    rdfs:comment "example as written: '2026-09-2026-09-21T12:34+02:00'" ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "green box 'revokedAt'" ; dkg:confidence dkg:OnArtifact .
:Rel_ConsentContainsConsentId a dkg:Relationship ; skos:prefLabel "Consent contains consent Id" ;
    dkg:from :Con_Consent ; dkg:verb "contains" ; dkg:to :Con_ConsentId ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "arrow 'contains' Consent → consent Id" ; dkg:confidence dkg:OnArtifact .
:Con_Consent dkg:mentions :Con_ConsentId .
:Rel_ConsentContainsSubject a dkg:Relationship ; skos:prefLabel "Consent contains subject" ;
    dkg:from :Con_Consent ; dkg:verb "contains" ; dkg:to :Con_Subject ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "arrow 'contains' Consent → subject" ; dkg:confidence dkg:OnArtifact .
:Con_Consent dkg:mentions :Con_Subject .
:Rel_ConsentContainsConsentText a dkg:Relationship ; skos:prefLabel "Consent contains consent Text" ;
    dkg:from :Con_Consent ; dkg:verb "contains" ; dkg:to :Con_ConsentText ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "arrow 'contains' Consent → consent Text" ; dkg:confidence dkg:OnArtifact .
:Con_Consent dkg:mentions :Con_ConsentText .
:Rel_ConsentContainsGivenAt a dkg:Relationship ; skos:prefLabel "Consent contains givenAt" ;
    dkg:from :Con_Consent ; dkg:verb "contains" ; dkg:to :Con_GivenAt ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "arrow 'contains' Consent → givenAt" ; dkg:confidence dkg:OnArtifact .
:Con_Consent dkg:mentions :Con_GivenAt .
:Rel_ConsentContainsRevokedAt a dkg:Relationship ; skos:prefLabel "Consent contains revokedAt" ;
    dkg:from :Con_Consent ; dkg:verb "contains" ; dkg:to :Con_RevokedAt ; dkg:cardinality "0..1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "arrow 'contains' Consent → revokedAt" ; dkg:confidence dkg:OnArtifact .
:Con_Consent dkg:mentions :Con_RevokedAt .
:Rel_ConsentTextContainsConsentTextId a dkg:Relationship ; skos:prefLabel "consent Text contains consent Text Id" ;
    dkg:from :Con_ConsentText ; dkg:verb "contains" ; dkg:to :Con_ConsentTextId ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "arrow 'contains' consent Text → consent Text Id" ; dkg:confidence dkg:OnArtifact .
:Con_ConsentText dkg:mentions :Con_ConsentTextId .
:Rel_ConsentTextContainsText a dkg:Relationship ; skos:prefLabel "consent Text contains text" ;
    dkg:from :Con_ConsentText ; dkg:verb "contains" ; dkg:to :Con_Text ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "arrow 'contains' consent Text → text" ; dkg:confidence dkg:OnArtifact .
:Con_ConsentText dkg:mentions :Con_Text .

# merge ledger for the Consent model
:Con_ConsentText dkg:proposedSameAs :Con_ConsentText_APC ;
    rdfs:comment "proposedSameAs Con_ConsentText_APC: 'consent Text' (model) vs 'consent-text' (canvas response) — punctuation differs" .
:Q_ConsentScope a dkg:Question ;
    skos:prefLabel "Does consent cover photos used in thanks and recipes — and is that why Sharing reads Consent?" ;
    rdfs:comment "The only example consent text: 'I allow to use my photos in public thanks and recipes.' Context map v2: Sharing GETs Consent from Consent Management. The model draws no link from Consent to Pictures, Thanks or Recipe; an example is not a relationship." ;
    dkg:source :Art_Glossary_Consent ; dkg:locator "example beside 'text'" ; dkg:confidence dkg:Implied .
:Art_Glossary_Consent dkg:raises :Q_ConsentScope .
:Q_ConsentInvariants a dkg:Question ;
    skos:prefLabel "Which invariants hold for Consent?" ;
    rdfs:comment "The model's legend defines a purple invariant sticky but uses none; the canvas has 'Revokes consent' and 'consent texts only via backend' in purple. revokedAt 0..1 suggests 'revoked at most once' — not drawn." ;
    dkg:source :Art_Glossary_Consent, :Art_APC_ConsentManagement ; dkg:locator "legend" ; dkg:confidence dkg:Implied .
:Art_Glossary_Consent dkg:raises :Q_ConsentInvariants .

