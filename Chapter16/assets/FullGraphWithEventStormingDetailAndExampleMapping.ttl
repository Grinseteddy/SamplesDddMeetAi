##############################################################################
# Ingest — API Product Canvas 'Sharing' v1.0.0 (image 1), 2026-10-10. Grow.
# Canvas about Ctx_Sharing (board bubble 'Thanks' / 'Sharing'): enriched, not re-minted.
##############################################################################
:Art_APC_Sharing a dkg:Artifact ;
    rdfs:label "Sharing — API Product Canvas (sync) v1.0.0 (image 1)" ;
    rdfs:comment "API Product Canvas (Junker & Lazzaretti). Server https://larder.org/sharing; 'e.g. http' / 'e.g. RESTful oriented' read as unfilled template text. Contact: the canvas owner. 2 paths, 5 operations, 1 purple sticky ('only giver allowed' on DELETE). GET /thanks returns '200: consents'. No events." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Ctx_Sharing dkg:source :Art_APC_Sharing ; dkg:locator "canvas title 'Sharing'" ;
    rdfs:comment "Enriched by the API Product Canvas 'Sharing': REST API at https://larder.org/sharing; for the moment only thanks." .
:VP_ForTheMomentOnlyThanks a dkg:ValueProposition ; skos:prefLabel "For the moment only thanks" ;
    rdfs:comment "scopes Sharing down to Thanks — consistent with the board bubble named 'Thanks'" ;
    dkg:inContext :Ctx_Sharing ; dkg:mentions :Con_Thanks ; dkg:source :Art_APC_Sharing ; dkg:locator "Value propositions" ; dkg:confidence dkg:OnArtifact .
:Cap_ProvideThanksVisibleToCommunity a dkg:Capability ; skos:prefLabel "Provide thanks visible to other community cooks" ;
    dkg:inContext :Ctx_Sharing ; dkg:mentions :Con_Thanks, :Con_Community ; dkg:source :Art_APC_Sharing ; dkg:locator "Core functions, bullet 1" ; dkg:confidence dkg:OnArtifact .
:Cap_ProvideThanksVisibleToCommunity dkg:proposedSameAs :Cmd_ProvideThanks ; rdfs:comment "proposedSameAs Cmd_ProvideThanks: board command 'Provide thanks' in the Sharing bubble — cross-class" .
:Cap_ProvideThanksVisibleToCommunity dkg:proposedSameAs :Cap_Sharing ; rdfs:comment "proposedSameAs Cap_Sharing: level-1 capability 'Sharing' — the canvas narrows it to thanks" .
:Con_Thanks dkg:inContext :Ctx_Sharing ; dkg:source :Art_APC_Sharing ; dkg:locator "request of POST/PATCH; response of GET /thanks/{thanksId}" ;
    rdfs:comment "Auto-merged: canvas 'thanks' = glossary term 'Thanks' (exact after case-folding)." .
:Con_Giver a dkg:Concept ; skos:prefLabel "giver" ; dkg:inContext :Ctx_Sharing ; dkg:source :Art_APC_Sharing ; dkg:locator "parameter of GET /thanks" ; dkg:confidence dkg:OnArtifact .
:Con_Recipient a dkg:Concept ; skos:prefLabel "recipient" ; dkg:inContext :Ctx_Sharing ; dkg:source :Art_APC_Sharing ; dkg:locator "parameter of GET /thanks" ; dkg:confidence dkg:OnArtifact .
:Con_ThanksId a dkg:Concept ; skos:prefLabel "thanks Id" ; dkg:inContext :Ctx_Sharing ; dkg:source :Art_APC_Sharing ; dkg:locator "parameter of /thanks/{thanksId}" ; dkg:confidence dkg:OnArtifact .
:Con_Consents_SH a dkg:Concept ; skos:prefLabel "consents" ;
    rdfs:comment "response of GET /thanks — kept as written; presumably a slip for 'thanks' (see Q_SharingGetReturnsConsents)" ;
    dkg:source :Art_APC_Sharing ; dkg:locator "GET /thanks, Responses ('200: consents')" ; dkg:confidence dkg:OnArtifact .
:Con_Consents_SH dkg:proposedSameAs :Con_Consent ; rdfs:comment "proposedSameAs Con_Consent: same word (plural) as the Consent aggregate — only if the canvas really means consents" .
:R_SH_OnlyGiverAllowed a dkg:Rule ; skos:prefLabel "only giver allowed" ;
    rdfs:comment "purple sticky on DELETE /thanks/{thanksId} only — PATCH carries no such rule" ;
    dkg:inContext :Ctx_Sharing ; dkg:mentions :Con_Giver, :Con_Thanks ;
    dkg:source :Art_APC_Sharing ; dkg:locator "DELETE /thanks/{thanksId}, Parameters column (purple)" ; dkg:confidence dkg:OnArtifact .
:R_SH_OnlyGiverAllowed dkg:proposedSameAs :R_RC_OnlyOwnerCanDelete ; rdfs:comment "proposedSameAs R_RC_OnlyOwnerCanDelete: same shape ('only the owner may delete'), giver in the owner role" .
:R_SH_OnlyGiverAllowed dkg:proposedSameAs :R_OnlyOwnerCanDelete ; rdfs:comment "proposedSameAs R_OnlyOwnerCanDelete: Meal Planning's version of the same policy" .
:Q_SharingGetReturnsConsents a dkg:Question ;
    skos:prefLabel "GET /thanks returns '200: consents' — thanks, surely?" ;
    rdfs:comment "Like the 'changed recipient' slips on Meal Planning and Recipe Catalog: a copied row from the Consent Management canvas?" ;
    dkg:source :Art_APC_Sharing ; dkg:locator "GET /thanks, Responses" ; dkg:confidence dkg:Implied .
:Art_APC_Sharing dkg:raises :Q_SharingGetReturnsConsents .
:Q_SharingPatchNoGiverRule a dkg:Question ;
    skos:prefLabel "May anyone but the giver change a thanks?" ;
    rdfs:comment "DELETE carries 'only giver allowed'; PATCH carries nothing. Meal Planning and Recipe Catalog put an owner rule on both change and delete." ;
    dkg:mentions :R_SH_OnlyGiverAllowed ;
    dkg:source :Art_APC_Sharing ; dkg:locator "PATCH vs DELETE /thanks/{thanksId}" ; dkg:confidence dkg:Implied .
:Art_APC_Sharing dkg:raises :Q_SharingPatchNoGiverRule .
:Msg_APC_SH_01 a dkg:Message ; skos:prefLabel "GET /thanks" ;
    dkg:to :Ctx_Sharing ; dkg:messageKind "?" ;
    dkg:carries "GET /thanks | parameters: giver, recipient | request: — | responses: 200: consents · 400, 401, 403, 500, default" ; dkg:mentions :Con_Giver, :Con_Recipient, :Con_Consents_SH ;
    dkg:source :Art_APC_Sharing ; dkg:locator "operation row 1" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_SH_02 a dkg:Message ; skos:prefLabel "POST /thanks" ;
    dkg:to :Ctx_Sharing ; dkg:messageKind "?" ;
    dkg:carries "POST /thanks | parameters: — | request: thanks | responses: 201: Link to created thanks · 400, 401, 403, 500, default" ; dkg:mentions :Con_Thanks ;
    dkg:source :Art_APC_Sharing ; dkg:locator "operation row 2" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_SH_03 a dkg:Message ; skos:prefLabel "GET /thanks/{thanksId}" ;
    dkg:to :Ctx_Sharing ; dkg:messageKind "?" ;
    dkg:carries "GET /thanks/{thanksId} | parameters: thanks Id | request: — | responses: 200: thanks · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_ThanksId, :Con_Thanks ;
    dkg:source :Art_APC_Sharing ; dkg:locator "operation row 3" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_SH_04 a dkg:Message ; skos:prefLabel "PATCH /thanks/{thanksId}" ;
    dkg:to :Ctx_Sharing ; dkg:messageKind "?" ;
    dkg:carries "PATCH /thanks/{thanksId} | parameters: thanks Id | request: thanks | responses: 200: Link to changed thanks · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_ThanksId, :Con_Thanks ;
    dkg:source :Art_APC_Sharing ; dkg:locator "operation row 4" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_SH_05 a dkg:Message ; skos:prefLabel "DELETE /thanks/{thanksId}" ;
    dkg:to :Ctx_Sharing ; dkg:messageKind "?" ;
    dkg:carries "DELETE /thanks/{thanksId} | parameters: thanks Id; only giver allowed | request: — | responses: 204 · 400, 401, 403, 404, 500, default" ; dkg:mentions :Con_ThanksId, :R_SH_OnlyGiverAllowed ;
    dkg:source :Art_APC_Sharing ; dkg:locator "operation row 5" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_SH_02 dkg:mentions :Ev_ThanksGiven ; rdfs:comment "POST /thanks is presumably where the board's 'Provide thanks' → 'Thanks given' lands; the canvas sends no event." .

##############################################################################
# Ingest — Thanks model (image 2), 2026-10-10. Grow (new per-aggregate model;
# overlap only on common words with boards and stories).
##############################################################################
:Art_Glossary_Thanks a dkg:VisualGlossary ;
    rdfs:label "Thanks model — aggregate, entity, value objects and invariants (image 2)" ;
    rdfs:comment "Aggregate Thanks: contains thanks Id 1, given by giver 1, contains recipient 0..* (entity), thanks Text 1, pictures 1. recipient contains type 1 (values Grandma Avatar, Cook, Chef via 'is'), Chef name 0..1 (invariant 'only if type is Chef'), Cook 0..* (invariant 'only if consent is given for mentioning'). Example giver UUID = example thanks Id UUID. No link to Help." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Con_Thanks a dkg:AggregateRoot ; dkg:source :Art_Glossary_Thanks ; dkg:locator "dark yellow box 'Thanks'" ;
    rdfs:comment "Auto-merged: model aggregate 'Thanks' = glossary term / canvas 'Thanks' (exact)." .
:Con_ThanksId a dkg:ValueObject ; dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'thanks Id'" ;
    rdfs:comment "Auto-merged with canvas 'thanks Id' (exact). Example e1e82a2e-9555-49fc-9df0-b85edb5b5997." .
:Con_Giver a dkg:ValueObject ; dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'giver'" ;
    rdfs:comment "Auto-merged with canvas parameter 'giver' (exact). Example e1e82a2e-… — the same UUID as the thanks Id example." .
:Con_Recipient a dkg:Entity ; dkg:source :Art_Glossary_Thanks ; dkg:locator "yellow box 'recipient'" ;
    rdfs:comment "Auto-merged with canvas parameter 'recipient' (exact)." .
:Con_RecipientType a dkg:ValueObject ; skos:prefLabel "type" ; dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'type' (inside recipient)" ; dkg:confidence dkg:OnArtifact .
:Con_GrandmaAvatar_RecipientType a dkg:ValueObject ; skos:prefLabel "Grandma Avatar" ; rdfs:subClassOf :Con_RecipientType ; rdfs:comment "a value of recipient type ('is' arrow)" ;
    dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'Grandma Avatar' (is → type)" ; dkg:confidence dkg:OnArtifact .
:Con_Cook_RecipientType a dkg:ValueObject ; skos:prefLabel "Cook" ; rdfs:subClassOf :Con_RecipientType ; rdfs:comment "a value of recipient type ('is' arrow)" ;
    dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'Cook' (is → type)" ; dkg:confidence dkg:OnArtifact .
:Con_Chef_RecipientType a dkg:ValueObject ; skos:prefLabel "Chef" ; rdfs:subClassOf :Con_RecipientType ; rdfs:comment "a value of recipient type ('is' arrow)" ;
    dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'Chef' (is → type)" ; dkg:confidence dkg:OnArtifact .
:Con_ChefName a dkg:ValueObject ; skos:prefLabel "Chef name" ; rdfs:comment "a Chef is referenced by name, a Cook by reference" ;
    dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'Chef name'" ; dkg:confidence dkg:OnArtifact .
:Con_MentionedCook a dkg:ValueObject ; skos:prefLabel "Cook" ;
    rdfs:comment "the 'Cook' box contained 0..* by recipient — a second 'Cook' on the same model next to the type value 'Cook' (one word, two concepts on one model); read as cooks mentioned in the thanks" ;
    dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'Cook' (recipient contains 0..*)" ; dkg:confidence dkg:OnArtifact .
:Con_ThanksText a dkg:ValueObject ; skos:prefLabel "thanks Text" ; dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'thanks Text'" ; dkg:confidence dkg:OnArtifact .
:Con_Pictures_Thanks a dkg:ValueObject ; skos:prefLabel "pictures" ; rdfs:comment "example https://larder.org/media/images/b009a5d1-0205-4b0c-af82-822229cf243a (the Recipe model's image example)" ;
    dkg:mentions :Con_Image ; dkg:source :Art_Glossary_Thanks ; dkg:locator "green box 'pictures'" ; dkg:confidence dkg:OnArtifact .
:R_TH_ChefNameOnlyIfChef a dkg:Rule ; skos:prefLabel "only if type is Chef" ;
    rdfs:comment "invariant on recipient contains Chef name 0..1" ; dkg:mentions :Con_ChefName, :Con_Chef_RecipientType ;
