##############################################################################
# Questions raised by batch 2
##############################################################################
:Q_ESD_CopyResidues a dkg:Question ; skos:prefLabel "Are the other-type stickies on the Catastrophe and Preparation-step boards meant?" ;
    rdfs:comment "Catastrophe board carries 'No Chef support for Preparation step Catastrophe', 'Help Preparation step can be provided by community, or Grandma', cancel-row 'Help request Preparation step' and 'Help request Ingredient'. Preparation-step board's cancel-row read model is 'Help request Ingredient'. Likely leftovers from copying the board; recorded as written, not corrected." ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:mentions :R_ESD_NoChefPrepStepCatastrophe, :R_ESD_HelpPrepStepProviders, :Con_HelpRequestPreparationStep, :Con_HelpRequestIngredient_RM ;
    dkg:source :Art_ESDetail_Catastrophe_2026_10, :Art_ESDetail_PreparationStep_2026_10 ; dkg:confidence dkg:Inferred .
:Q_ESD_FourBoardsOneProcess a dkg:Question ; skos:prefLabel "One help process with a type, or four processes?" ;
    rdfs:comment "Four detail boards share every event, Provide Help, Cancel help request, both UI stickies and five rules; they differ in request command, the business objects, the Recipe Catalog read model and the provider rule. Contracts have one POST /help-requests with a type; the Help Request model has one aggregate with a type." ;
    dkg:inContext :Ctx_CookingAssistance ;
    dkg:mentions :Cmd_RequestHelpMealPlan, :Cmd_RequestHelpCatastrophe, :Cmd_RequestHelpIngredients, :Cmd_RequestHelpPreparationStep, :Con_HelpRequest ;
    dkg:source :Art_ESDetail_Catastrophe_2026_10, :Art_ESDetail_IngredientSubstitution_2026_10, :Art_ESDetail_PreparationStep_2026_10 ; dkg:confidence dkg:Inferred .
:Q_ESD_CatastropheRecipe a dkg:Question ; skos:prefLabel "Is the recipe optional only for catastrophes — and for meal plans?" ;
    rdfs:comment "Only the Catastrophe arrow says 'can be provided not mandatory'. Help Request model: mandatory for Preparation Step Explanation and Ingredient Substitute only. The meal-plan arrow is unlabelled, so whether a meal-plan request may carry no recipe is still open (Q_ESD_RecipeIntoMealPlanRequest)." ;
    dkg:mentions :Msg_ESD_RecipeToHelpRequestCatastrophe, :R_HR_RecipeMandatoryForPSEAndIS, :Q_ESD_RecipeIntoMealPlanRequest ;
    dkg:source :Art_ESDetail_Catastrophe_2026_10 ; dkg:confidence dkg:Implied .
:Art_ESDetail_Catastrophe_2026_10 dkg:raises :Q_ESD_CopyResidues, :Q_ESD_FourBoardsOneProcess, :Q_ESD_CatastropheRecipe .
:Art_ESDetail_IngredientSubstitution_2026_10 dkg:raises :Q_ESD_FourBoardsOneProcess .
:Art_ESDetail_PreparationStep_2026_10 dkg:raises :Q_ESD_CopyResidues, :Q_ESD_FourBoardsOneProcess .

##############################################################################
# Ingest — four Example Maps (Matt Wynne's Example Mapping), 2026-10-27,
# in the order attached: US-CA-01, US-CA-03, US-CA-02, US-CA-04. GROW.
# No ingest reference and no dkg class exists for Example Mapping. Mapping
# used (a project-local extension, declared below):
#   map → dkg:Artifact (as the context maps) · yellow story → dkg:Deliverable
#   blue rule → dkg:Rule · red question → dkg:Question
#   green example → :Example (local, subClassOf dkg:Node), :illustrates its rule
#   story-card definitions → dkg:Assertion (skos:definition) per map
# Legend on every map: yellow Story, blue Rule, green Example, red Question
# — all dkg:OnArtifact. Cards with identical text on several maps are ONE node
# with a source and locator per map (exact-label auto-merge, same class).
# Persons in the cast (Lena, Tom, Marco, Ana, Sam, Jonas, Mia) are not minted.
##############################################################################
:Example a owl:Class ; skos:prefLabel "Example (Example Mapping)" ; dkg:source :Art_ExMap_US_CA_01 ; dkg:confidence dkg:Inferred ; rdfs:subClassOf dkg:Node ; rdfs:label "Example (Example Mapping)" ;
    rdfs:comment "Project-local: a green Example Mapping card — one concrete situation and its outcome, illustrating one rule. dkg has no class for it." .
:illustrates a owl:ObjectProperty ; skos:prefLabel "illustrates" ; dkg:source :Art_ExMap_US_CA_01 ; dkg:confidence dkg:Inferred ; rdfs:subPropertyOf dkg:mentions ; rdfs:comment "Project-local: Example → the Rule it sits under." .
:ruleOf a owl:ObjectProperty ; skos:prefLabel "rule of" ; dkg:source :Art_ExMap_US_CA_01 ; dkg:confidence dkg:Inferred ; rdfs:subPropertyOf dkg:mentions ; rdfs:comment "Project-local: Rule → the story (Deliverable) whose map holds it." .


# ===== Example Map US-CA-01 — Help with Menu =====
:Art_ExMap_US_CA_01 a dkg:Artifact ; rdfs:label "Example Map US-CA-01 — Help with Menu (attached image)" ;
    rdfs:comment "Example Map (dkg has no subclass). 1 story, 9 rules, 30 examples, 2 question(s). Cast: Lena, premium Cook in Munich · Tom, free plan · Chefs Marco and Ana, Munich · Chef Sam, New York (CET−6). 'SEE Q1' marker below R2's examples." ;
    dkg:ingestedAt "2026-10-27"^^xsd:date .
:Story_US_CA_01 a dkg:Deliverable ; skos:prefLabel "Help with Menu" ; skos:altLabel "US-CA-01" ;
    rdfs:comment "Story card: As a Cook, I want to ask a Chef to propose a Menu for my Occasion, so that I get help planning and preparing my meals. This is a premium feature. (inContext from the US-CA prefix.)" ;
    dkg:inContext :Ctx_CookingAssistance ; dkg:mentions :Act_Cook_DS, :Act_Chef ;
    dkg:source :Art_ExMap_US_CA_01 ; dkg:locator "story card (yellow, top left)" ; dkg:confidence dkg:OnArtifact .
:Con_Occasion dkg:source :Art_ExMap_US_CA_01 ; dkg:locator "US-CA-01 story card definition" .
:Story_US_CA_01 dkg:mentions :Con_Occasion .
:As_Def_EM01_Con_Occasion a dkg:Assertion ; rdf:subject :Con_Occasion ; rdf:predicate skos:definition ; rdf:object "why and when the Cook is cooking: date, guests, dietary needs, budget, tastes." ;
    dkg:source :Art_ExMap_US_CA_01 ; dkg:confidence dkg:OnArtifact .
:Con_Menu dkg:source :Art_ExMap_US_CA_01 ; dkg:locator "US-CA-01 story card definition" .
:Story_US_CA_01 dkg:mentions :Con_Menu .
:As_Def_EM01_Con_Menu a dkg:Assertion ; rdf:subject :Con_Menu ; rdf:predicate skos:definition ; rdf:object "one meal with several courses and a recipe for each, proposed by the Chef." ;
    dkg:source :Art_ExMap_US_CA_01 ; dkg:confidence dkg:OnArtifact .
