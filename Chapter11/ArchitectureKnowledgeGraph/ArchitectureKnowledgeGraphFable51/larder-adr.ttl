##############################################################################
# 3. Principles
##############################################################################

:Prin_AP0001_MonolithBeforeMicroservices a dkg:Principle ;
    skos:prefLabel "Monolith before Microservices" ;
    dkg:principleId "AP0001" ;
    dkg:statement "We will always start with a deployment monolith before cutting services out. However, the modules are modular regarding DDD principles." ;
    dkg:rationale "In the beginning, we do not know exactly the load and performance issues the single services have to face. Therefore, we will cut later with more experience." ;
    dkg:implication "We will have later costs for cutting out services. The teams need to be disciplined to follow the strict boundaries of the Bounded Contexts." ;
    dkg:scope "deployment shape; 'the modules are modular regarding DDD principles'" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0001" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0002_AsyncBetweenContexts a dkg:Principle ;
    skos:prefLabel "Asynchronous Communication before Synchronous" ;
    dkg:principleId "AP0002" ;
    dkg:statement "For communication between Bounded Contexts asynchronous communication is preferred." ;
    dkg:rationale "Asynchronous communication guarantees the loose coupling between Bounded Contexts." ;
    dkg:implication "Loose coupling guarantees that we can later maintain and operate our application without large downtimes." ;
    dkg:scope "between Bounded Contexts" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0002" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0003_UsingDDD a dkg:Principle ;
    skos:prefLabel "Using DDD" ;
    dkg:principleId "AP0003" ;
    dkg:statement "For design of our functional architecture, we will apply the principles of DDD." ;
    dkg:rationale "Architecture coming out of the blue does not support the business requirements functionally." ;
    dkg:implication "We need to support the functions required by business. Moreover, we need to support the maintenance of those functions for the upcoming years." ;
    dkg:scope "functional architecture" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    rdfs:comment "Close call on testability. Checkable in a weak sense: a decision that cuts modules along something other than Bounded Contexts, or names a module no DDD artifact has, would fail it. Kept testable on that reading (dkg:Inferred judgement)." ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0003" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0004_UsingResiduality a dkg:Principle ;
    skos:prefLabel "Using Residuality" ;
    dkg:principleId "AP0004" ;
    dkg:statement "For design of our technical architecture, we will apply the principles of Residuality Theory." ;
    dkg:rationale "Stressing an architecture with randomly selected stressors creates more sustaining architectures." ;
    dkg:implication "We do not know what future brings, therefore, we need the robust and best equipped architecture." ;
    dkg:scope "technical architecture" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    rdfs:comment "Testable as a process rule: an ADR either records the stressors it was tested against or it does not. None of the five does." ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0004" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0005a_AutomaticTesting a dkg:Principle ;
    skos:prefLabel "Automatic Testing" ;
    dkg:principleId "AP0005" ;
    dkg:statement "We can test our system by 95% automatically." ;
    dkg:rationale "Manual tests are too slow to allow us to test our system manually." ;
    dkg:implication "We need to follow a Test-Driven-Approach consequently." ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    dkg:defect "Shares the ID AP0005 with the Micro-UIs entry that follows it in the document." ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0005 (first occurrence)" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0005b_MicroUIs a dkg:Principle ;
    skos:prefLabel "Micro-UIs" ;
    dkg:principleId "AP0005" ;
    dkg:statement "The Bounded Context publish their own UI as micro-UIs." ;
    dkg:rationale "The teams developing the Bounded Contexts must be as independent as possible. The UIs are part of the Bounded Contexts projects. The micro UIs can use a common platform, so that they appear out of one hand." ;
    dkg:implication "Using a large monolithic frontend would us slow down." ;
    dkg:scope "UIs of Bounded Contexts" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    dkg:defect "Shares the ID AP0005 with the Automatic Testing entry that precedes it in the document." ;
    dkg:mentions :Con_UserInterface ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0005 (second occurrence)" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0006_SyncForUIs a dkg:Principle ;
    skos:prefLabel "Synchronous communication for UIs" ;
    dkg:principleId "AP0006" ;
    dkg:statement "UI communication is done synchronously." ;
    dkg:rationale "UIs require synchronous communication." ;
    dkg:implication "UIs must communicate with humans, who expect to get immediate answers." ;
    dkg:scope "UI communication" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    dkg:mentions :Con_UserInterface ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0006" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0007_Monitoring a dkg:Principle ;
    skos:prefLabel "Monitoring" ;
    dkg:principleId "AP0007" ;
    dkg:statement "The system can be monitored to identify system-critical states reliable and fast." ;
    dkg:rationale "The operation of the software must be almost completely automated. We need to get a reliable alarm system based on a reliable monitoring system" ;
    dkg:implication "Using a large monolithic frontend would us slow down." ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    dkg:defect "Implications line is a verbatim copy of AP0005 Micro-UIs' Implications and does not concern monitoring." ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0007" ; dkg:confidence dkg:OnArtifact .

:Prin_AP0008_FineGrainedAccessRights a dkg:Principle ;
    skos:prefLabel "Fine grained access rights" ;
    dkg:principleId "AP0008" ;
    dkg:statement "Domain artifacts are controlled by a fine-grained access control." ;
    dkg:rationale "The software will increase with time, and we need to respect the personal and author rights of our users." ;
    dkg:implication "With more coarse grained rights, we could contradict legal regulations." ;
    dkg:scope "domain artifacts" ;
    dkg:status "Adopted" ; dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:testable true ;
    dkg:source :Art_Principles_Larder ; dkg:locator "AP0008" ; dkg:confidence dkg:OnArtifact .

# Principle-vs-principle: AP0002 (async) and AP0006 (sync) look opposed but are
# scoped apart — "between Bounded Contexts" vs "UI communication". No
# dkg:inTensionWith is emitted; the near-miss is reported, not recorded.

##############################################################################
# 4. Questions the full-form ADRs answer (minted from their Context sections)
##############################################################################

:Q_DeploymentShape_ADR0001 a dkg:Question ;
    skos:prefLabel "Which deployment shape do Larder's Bounded Contexts take — modular monolith, microservices, or monolith?" ;
    dkg:source :Art_ADR_ADR0001 ; dkg:locator "Context" ; dkg:confidence dkg:Implied .

:Q_DatabaseArrangement_ADR0002 a dkg:Question ;
    skos:prefLabel "How are the modules' databases arranged — one instance with a schema per Bounded Context, one instance per context, or one shared database?" ;
    dkg:source :Art_ADR_ADR0002 ; dkg:locator "Context" ; dkg:confidence dkg:Implied .

:Q_AssistanceBordersCommunication_ADR0003 a dkg:Question ;
    skos:prefLabel "How do Cooking Assistance ↔ Notification and Cooking Assistance ↔ Grandma Avatar communicate?" ;
    rdfs:comment "Restates the sync-vs-async border questions the project's architecture-question agenda already raised; wire dkg:proposedSameAs to them on merge." ;
    dkg:source :Art_ADR_ADR0003 ; dkg:locator "Context" ; dkg:confidence dkg:OnArtifact .

:Q_UICommunication_ADR0004 a dkg:Question ;
    skos:prefLabel "How do the user interfaces communicate with the Bounded Contexts?" ;
    dkg:source :Art_ADR_ADR0004 ; dkg:locator "Context" ; dkg:confidence dkg:Implied .

:Q_MicroUIComposition_ADR0005 a dkg:Question ;
    skos:prefLabel "How are the Bounded Contexts' micro-UIs composed into one application — orchestrated by an AppShell or choreographed?" ;
    dkg:source :Art_ADR_ADR0005 ; dkg:locator "Context" ; dkg:confidence dkg:Implied .

# Open — raised by ADR0005, answered by nothing
:Q_OrchestratorAggregationReadsWhat a dkg:Question ;
    skos:prefLabel "When the orchestrator 'synthesizes live data' from Recipe Catalog, Meal Preparation and Cooking Assistance, does it read published read models or query each context live? Live queries would engage AP0002." ;
    dkg:mentions :Ctx_RecipeCatalog , :Ctx_MealPreparation , :Ctx_CookingAssistance ;
    dkg:source :Art_ADR_ADR0005 ; dkg:locator "Context, 'Unified View Aggregation & Gating'" ; dkg:confidence dkg:Implied .

# Open — raised by ADR0005's module list
:Q_ModulesOnlyInADR0005 a dkg:Question ;
    skos:prefLabel "Paywall for Premium Content and Ads Management appear only in ADR0005. Are they Bounded Contexts (then ADR0001's module list is short), features of existing ones, or out of scope?" ;
    dkg:mentions :Ctx_PaywallForPremiumContent , :Ctx_AdsManagement ;
    dkg:source :Art_ADR_ADR0005 ; dkg:locator "Context, Key Architectural Drivers" ; dkg:confidence dkg:Implied .

##############################################################################
# 5. Decisions — full-form ADRs
##############################################################################

:D_ADR0001 a dkg:Decision ;
    skos:prefLabel "Using Monolith" ;
    dkg:decisionId "ADR0001" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-10"^^xsd:date ; dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will implement Larder as Monolith." ;
    dkg:rationale "We defined Bounded Contexts of the Larder application. Those Bounded Contexts are modules in our application." ;
    dkg:consideredOption "Modular monolith" , "Microservices" , "Monolith" ;
    dkg:consequence "Implementation: Higher effort" , "Maintenance: Higher effort" , "Operation: Small effort" , "Enhancements: Small effort" ;
    dkg:sourceFormat "full-form" ;
    dkg:defect "The bolded Decision line reads 'We will implement Larder as Monolith.', but the Options section marks the plain 'Monolith' option as contradicting AP0001, lists ten modules under 'Modular monolith', and ADR0002's Context speaks of 'the modular monolith'. Cross-check done on the modular-monolith reading; consequences listed are the Modular Monolith column." ;
    dkg:cites :Prin_AP0001_MonolithBeforeMicroservices ;
    dkg:honors :Prin_AP0001_MonolithBeforeMicroservices , :Prin_AP0003_UsingDDD ;
    dkg:answers :Q_DeploymentShape_ADR0001 ;
    dkg:mentions :Ctx_RecipeCatalog , :Ctx_MealPlanning , :Ctx_CookProfile , :Ctx_GrandmaAvatarAI , :Ctx_Notification ,
                 :Ctx_CookingAssistance , :Ctx_Media , :Ctx_ConsentManagement , :Ctx_MealPreparation , :Ctx_Sharing ;
    dkg:source :Art_ADR_ADR0001 ; dkg:locator "ADR0001" ; dkg:confidence dkg:OnArtifact .

:As_ADR0001_honors_AP0001 a dkg:Assertion ;
    rdf:subject :D_ADR0001 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0001_MonolithBeforeMicroservices ;
    dkg:citedBy "explicit" ;
    rdfs:comment "Modular monolith option: 'Advantages: Easy to maintain and to operate (see AP0001)'; both alternatives marked '(contradicts AP0001)'. Holds only on the modular-monolith reading — see the Decision's dkg:defect." ;
    dkg:source :Art_ADR_ADR0001 ; dkg:confidence dkg:OnArtifact .

:As_ADR0001_honors_AP0003 a dkg:Assertion ;
    rdf:subject :D_ADR0001 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0003_UsingDDD ;
    dkg:citedBy "incidental" ;
    rdfs:comment "Context: 'Those Bounded Contexts are modules in our application.' The modules are cut along the DDD contexts; AP0003 is not named." ;
    dkg:source :Art_ADR_ADR0001 ; dkg:confidence dkg:Implied .

:D_ADR0002 a dkg:Decision ;
    skos:prefLabel "Using One Database Instance" ;
    dkg:decisionId "ADR0002" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-10"^^xsd:date ; dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will use one database instance for Larder." ;
    dkg:rationale "The Bounded Contexts modules in the modular monolith need databases." ;
    dkg:consideredOption "One database instance with schemas per Bounded Context" , "One database instance per Bounded Contexts" , "One database for all" ;
    dkg:consequence "Implementation: More discipline" , "Maintenance: Easier" , "Operation: Secure" , "Enhancements: Small effort" ;
    dkg:sourceFormat "full-form" ;
    dkg:defect "Decision line 'one database instance' fits both option 1 (one instance, schema per context) and option 3 (one database for all); read as option 1, the only one not marked as contradicting AP0001." ;
    dkg:defect "Consequences table column headers are 'Modular Monolith | Microservices | Monolith' — copied from ADR0001 and not the three database options this ADR compares." ;
    dkg:defect "Option 'One database for all' has a truncated sentence: 'Disadvantage: The Domain Models are easily (contradicts AP0001).'" ;
    dkg:cites :Prin_AP0001_MonolithBeforeMicroservices ;
    dkg:honors :Prin_AP0001_MonolithBeforeMicroservices , :Prin_AP0003_UsingDDD ;
    dkg:answers :Q_DatabaseArrangement_ADR0002 ;
    dkg:source :Art_ADR_ADR0002 ; dkg:locator "ADR0002" ; dkg:confidence dkg:OnArtifact .

:As_ADR0002_honors_AP0001 a dkg:Assertion ;
    rdf:subject :D_ADR0002 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0001_MonolithBeforeMicroservices ;
    dkg:citedBy "explicit" ;
    rdfs:comment "Option 1: 'Advantages: Easy to maintain and to operate (see AP0001)'; options 2 and 3 each '(contradicts AP0001)'." ;
    dkg:source :Art_ADR_ADR0002 ; dkg:confidence dkg:OnArtifact .

:As_ADR0002_honors_AP0003 a dkg:Assertion ;
    rdf:subject :D_ADR0002 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0003_UsingDDD ;
    dkg:citedBy "incidental" ;
    rdfs:comment "'decoupled schemas … its own database user who can only access the belonging schema' keeps each context's model private — the storage-level form of a Bounded Context. AP0003 not named." ;
    dkg:source :Art_ADR_ADR0002 ; dkg:confidence dkg:Implied .

:D_ADR0003 a dkg:Decision ;
    skos:prefLabel "Using Asynchronous Communication" ;
    dkg:decisionId "ADR0003" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-10"^^xsd:date ; dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will use asynchronous communication with RabbitMQ." ;
    dkg:rationale "Cooking Assistance and Notification and Cooking Assistance and Grandma Avatar need asynchronous communication based on the DDD analysis. (references ../09_ContextMap.jpg, not supplied)" ;
    dkg:consideredOption "Asynchronous communication via RabbitMQ" , "Asynchronous communication via Kafka" , "Using of synchronous communication" ;
    dkg:consequence "Implementation: Medium effort" , "Available skills: Available" , "Functional: suited" ;
    dkg:sourceFormat "full-form" ;
    dkg:cites :Prin_AP0002_AsyncBetweenContexts ;
    dkg:honors :Prin_AP0002_AsyncBetweenContexts , :Prin_AP0003_UsingDDD ;
    dkg:answers :Q_AssistanceBordersCommunication_ADR0003 ;
    dkg:mentions :Ctx_CookingAssistance , :Ctx_Notification , :Ctx_GrandmaAvatarAI , :Act_GrandmaAvatar ;
    dkg:source :Art_ADR_ADR0003 ; dkg:locator "ADR0003" ; dkg:confidence dkg:OnArtifact .

:As_ADR0003_honors_AP0002 a dkg:Assertion ;
    rdf:subject :D_ADR0003 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0002_AsyncBetweenContexts ;
    dkg:citedBy "explicit" ;
    rdfs:comment "'Advantages: It is supported by principles (see AP0002)'; the synchronous option 'contradicts AP0002'. Scope matches: the borders named are between Bounded Contexts." ;
    dkg:source :Art_ADR_ADR0003 ; dkg:confidence dkg:OnArtifact .

:As_ADR0003_honors_AP0003 a dkg:Assertion ;
    rdf:subject :D_ADR0003 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0003_UsingDDD ;
    dkg:citedBy "incidental" ;
    rdfs:comment "Context: 'need asynchronous communication based on the DDD analysis'; synchronous option 'contradicts the business analysis (see Context Map)'. Reasons from the DDD artifacts without naming AP0003." ;
    dkg:source :Art_ADR_ADR0003 ; dkg:confidence dkg:Implied .

:D_ADR0004 a dkg:Decision ;
    skos:prefLabel "Synchronous Communication per UI" ;
    dkg:decisionId "ADR0004" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-10"^^xsd:date ; dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will use synchronous communication for User Interfaces." ;
    dkg:rationale "Most of the Bounded Contexts need user interactions that should be done synchronously via REST API." ;
    dkg:consideredOption "Synchronous via REST API" , "Synchronous via GraphQL" , "Using of asynchronous communication with WebHooks" ;
    dkg:consequence "Implementation: Small effort" , "Security: Fine grained" ;
    dkg:sourceFormat "full-form" ;
    dkg:cites :Prin_AP0006_SyncForUIs , :Prin_AP0008_FineGrainedAccessRights ;
    dkg:honors :Prin_AP0006_SyncForUIs , :Prin_AP0008_FineGrainedAccessRights ;
    dkg:answers :Q_UICommunication_ADR0004 ;
    dkg:mentions :Con_UserInterface ;
    dkg:source :Art_ADR_ADR0004 ; dkg:locator "ADR0004" ; dkg:confidence dkg:OnArtifact .

:As_ADR0004_honors_AP0006 a dkg:Assertion ;
    rdf:subject :D_ADR0004 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0006_SyncForUIs ;
    dkg:citedBy "explicit" ;
    rdfs:comment "'Advantages: It is supported by principles (see AP0006)'; the WebHooks option 'contradicts AP0006'." ;
    dkg:source :Art_ADR_ADR0004 ; dkg:confidence dkg:OnArtifact .

:As_ADR0004_honors_AP0008 a dkg:Assertion ;
    rdf:subject :D_ADR0004 ; rdf:predicate dkg:honors ; rdf:object :Prin_AP0008_FineGrainedAccessRights ;
    dkg:citedBy "by-elimination" ;
    rdfs:comment "AP0008 is cited only against the losing GraphQL option ('contradicts a fine-grained control of access rights'). The winning REST option is never said to honor it; the Consequences row 'Security: Fine grained' is the only positive evidence." ;
    dkg:source :Art_ADR_ADR0004 ; dkg:confidence dkg:OnArtifact .

:D_ADR0005 a dkg:Decision ;
    skos:prefLabel "Orchestrator UI" ;
    dkg:decisionId "ADR0005" ;
    dkg:status "Adopted" ; dkg:decidedAt "2026-09-10"^^xsd:date ; dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will use an orchestrator for the UI or Larder. It ingests the micro UIs of the Bounded Context and provides an AppShell." ;
    dkg:rationale "Key Architectural Drivers: Guided Cooking Workflows (strict sequential progression, timers, hands-free voice); Catastrophe & Rescue Management (conditional modal branching across Meal Preparation, Cooking Assistance, Media, Grandma Avatar AI); Unified View Aggregation & Gating (live data from Recipe Catalog, Meal Preparation, Cooking Assistance; rules from Consent Management and Paywall); Choreography for Decoupled Extras (Notification toasts, Sharing feed, Ads Management subscribe to MealPrepared / ThanksGiven)." ;
    dkg:consideredOption "Orchestrator" , "Choreography" ;
    dkg:consequence "Implementation: Larger effort in AppShell" , "Team independence: All teams depend on AppShell team." ;
    dkg:sourceFormat "full-form" ;
    dkg:defect "The 'Choreography' option's text describes a hybrid ('Centralizing interactive user flows through a UI orchestrator while leveraging event-driven choreography for ambient widgets'), i.e. the chosen design, not the alternative it is meant to be." ;
    dkg:defect "Decision line typo: 'for the UI or Larder' (of Larder)." ;
    dkg:overrides :Prin_AP0005b_MicroUIs ;
    dkg:answers :Q_MicroUIComposition_ADR0005 ;
    dkg:raises :Q_OrchestratorAggregationReadsWhat , :Q_ModulesOnlyInADR0005 ;
    dkg:mentions :Con_UserInterface , :Con_AppShell , :Ctx_MealPreparation , :Ctx_CookingAssistance , :Ctx_Media , :Ctx_GrandmaAvatarAI ,
                 :Ctx_RecipeCatalog , :Ctx_ConsentManagement , :Ctx_Notification , :Ctx_Sharing , :Ctx_PaywallForPremiumContent , :Ctx_AdsManagement , :Act_Chef ;
    dkg:source :Art_ADR_ADR0005 ; dkg:locator "ADR0005" ; dkg:confidence dkg:OnArtifact .

:As_ADR0005_overrides_AP0005b a dkg:Assertion ;
    rdf:subject :D_ADR0005 ; rdf:predicate dkg:overrides ; rdf:object :Prin_AP0005b_MicroUIs ;
    dkg:acknowledged false ;
    rdfs:comment "AP0005 rationale: 'The teams developing the Bounded Contexts must be as independent as possible.' ADR0005 consequences: 'All teams depend on AppShell team.' The ADR records the consequence but never names the principle it cuts against, gives no reason for accepting the loss of independence, and is the only ADR of five that cites no principle at all. The statement's letter (contexts publish micro-UIs, which the orchestrator ingests) is kept; the rationale is contradicted." ;
    dkg:source :Art_ADR_ADR0005 ; dkg:confidence dkg:Implied .

