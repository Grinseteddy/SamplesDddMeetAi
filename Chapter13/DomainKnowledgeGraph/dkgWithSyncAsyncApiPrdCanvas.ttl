@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/dkg/graph/larder>
    a owl:Ontology ;
    owl:imports <https://w3id.org/dkg/ns> ;
    rdfs:label "Larder (community cooking) — domain knowledge graph" .


##############################################################################
# INGEST — Context Map (09_ContextMap.jpg)  (2026-09-20)
##############################################################################

:Art_ContextMap a dkg:Artifact ;
    rdfs:label "Context Map (09_ContextMap.jpg)" ;
    rdfs:comment "10 context bubbles with the stickies each holds, 14 arrows (solid = synchronous, dashed = asynchronous per the legend), pattern boxes OHS / ACL / CF. The vocabulary has no ContextMap subclass, so this is a plain dkg:Artifact; each arrow is recorded as a dkg:Message (from, to, carries) exactly as drawn, with no upstream/downstream claim added." ;
    dkg:ingestedAt "2026-09-20"^^xsd:date .

:Ctx_RecipeCatalog a dkg:BoundedContext ;
    skos:prefLabel "Recipe Catalog" ;
    dkg:source :Art_ContextMap ;
    dkg:locator "bubble" ;
    rdfs:comment "pattern boxes drawn on this bubble: OHS (bottom)" ;
    dkg:confidence dkg:OnArtifact .
