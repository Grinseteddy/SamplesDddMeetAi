graph LR
    RC["Recipe Catalog<br/><i>off-board</i>"]:::off
    CP["Cook Profile"]:::ctx
    MP["Meal Planning"]:::ctx
    CA["Cooking Assistance"]:::ctx
    PREP["Meal Preparation"]:::ctx
    MED["Media"]:::ctx
