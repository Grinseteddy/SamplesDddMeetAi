:Q_ImagesOrMedia a dkg:Question ;
    skos:prefLabel "Is the resource 'images' or 'media'?" ;
    rdfs:comment "Canvas: path /images, parameter mediaId, GET /images returns 'media', GET /images/{mediaId} returns 'image'. Model: aggregate Media containing 'media'. Stories, board and glossary: Pictures / Picture." ;
    dkg:source :Art_APC_Media, :Art_Glossary_Media ; dkg:locator "paths and responses" ; dkg:confidence dkg:OnArtifact .
:Art_APC_Media dkg:raises :Q_ImagesOrMedia .
:Q_PicturesTwoSenses rdfs:comment "Media model: one Media aggregate with links typed help Request (evidence) or thanks (trophy) — the two senses become two link types on one thing." ; dkg:source :Art_Glossary_Media .
:Q_ExampleUUIDsReused rdfs:comment "Media model: media Id example f0c03819-… is also the Consent model's consent Id example." ; dkg:source :Art_Glossary_Media .
:Ctx_RecipeCatalog rdfs:comment "Media model url example 'https://larder.org/recipe-catalog/recipes/{id}' — the first trace of a Recipe Catalog API; Recipe Catalog has no canvas or model yet." .
:Q_HelpRequestMealAndPictures rdfs:comment "Media model: pictures are attached from the Media side (link type 'help Request'), which may explain why the Help Request model holds no Picture." ; dkg:source :Art_Glossary_Media .

##############################################################################
# Ingest — API Product Canvas 'Notifications' (async) v1.0.0 (image 1), 2026-10-10. Grow.
# Canvas about the context the maps call 'Notification': enriched, not re-minted.
# SERVER FIELD CONTAINS AN EMBEDDED CREDENTIAL — NOT COPIED INTO THIS GRAPH.
##############################################################################
:Art_APC_Notifications a dkg:Artifact ;
    rdfs:label "Notifications — API Product Canvas (async) v1.0.0 (image 1)" ;
    rdfs:comment "API Product Canvas (Junker & Lazzaretti), async. RabbitMQ, event-driven architecture. Server: amqps://[credentials removed]@…larder.org — same user and password as the Cooking Assistance and Grandma Avatar canvases; redacted here. Receives Help requested and Help provided; sends nothing. Quality: 'Notifications are exclusively created on events'. Notes: 'Aggregation functionality like showing the number of notifications needs to be handled in the frontend'." ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Ctx_Notification skos:altLabel "Notifications" ; dkg:source :Art_APC_Notifications ; dkg:locator "canvas title" ;
    rdfs:comment "Enriched by the API Product Canvases titled 'Notifications' (async: RabbitMQ, event-driven; receives Help requested and Help provided, sends nothing). Notes: notification counts are a frontend concern." .
:VP_ProvidingNotificationsBasedOnEvents a dkg:ValueProposition ;
    skos:prefLabel "Providing of notifications to Cooks, based on events notifications are created" ;
    dkg:inContext :Ctx_Notification ; dkg:source :Art_APC_Notifications ; dkg:locator "Value propositions" ; dkg:confidence dkg:OnArtifact .
:Cap_ProvidingOfNotifications a dkg:Capability ; skos:prefLabel "Providing of notifications" ;
    dkg:inContext :Ctx_Notification ; dkg:source :Art_APC_Notifications ; dkg:locator "Core functions, bullet 1" ; dkg:confidence dkg:OnArtifact .
:Cap_MarkReadDeleteNotifications a dkg:Capability ; skos:prefLabel "Mark notifications as read, delete notifications" ;
    dkg:inContext :Ctx_Notification ; dkg:source :Art_APC_Notifications ; dkg:locator "Core functions, bullet 2" ; dkg:confidence dkg:OnArtifact .
:R_NotificationsOnlyOnEvents a dkg:Rule ; skos:prefLabel "Notifications are exclusively created on events" ;
    rdfs:comment "from the Quality requirements field" ;
    dkg:inContext :Ctx_Notification ; dkg:mentions :Con_Notification ;
    dkg:source :Art_APC_Notifications ; dkg:locator "Quality requirements" ; dkg:confidence dkg:OnArtifact .
:Ev_HelpRequested dkg:source :Art_APC_Notifications ; dkg:locator "Events Receive (Notifications)" .
:Ev_HelpProvided dkg:source :Art_APC_Notifications ; dkg:locator "Events Receive (Notifications)" .
:Con_HelpRequest dkg:source :Art_APC_Notifications ; dkg:locator "payload of Help requested (Notifications)" .
:Con_HelpProvidedPayload a dkg:Concept ; skos:prefLabel "Help provided" ;
    rdfs:comment "payload sticky named like the event; Grandma Avatar and Cooking Assistance canvases send Help provided with payload 'Help'/'help'" ;
    dkg:source :Art_APC_Notifications ; dkg:locator "payload of Help provided (Notifications)" ; dkg:confidence dkg:OnArtifact .
:Con_HelpProvidedPayload dkg:proposedSameAs :Con_Help ; rdfs:comment "proposedSameAs Con_Help: the senders' canvases name this payload 'Help'" .
:Msg_APC_NOT_In_HelpRequested a dkg:Message ; skos:prefLabel "receives Help requested (payload Help request)" ;
    dkg:to :Ctx_Notification ; dkg:messageKind "evt" ; dkg:carries "Help requested — payload: Help request" ;
    dkg:mentions :Ev_HelpRequested, :Con_HelpRequest ;
    rdfs:comment "Sender not named (context map v2: Cooking Assistance, whose canvas sends 'Help request created')." ;
    dkg:source :Art_APC_Notifications ; dkg:locator "Events Receive / Payload" ; dkg:confidence dkg:OnArtifact .
:Msg_APC_NOT_In_HelpProvided a dkg:Message ; skos:prefLabel "receives Help provided (payload Help provided)" ;
    dkg:to :Ctx_Notification ; dkg:messageKind "evt" ; dkg:carries "Help provided — payload: Help provided" ;
    dkg:mentions :Ev_HelpProvided, :Con_HelpProvidedPayload ;
    dkg:source :Art_APC_Notifications ; dkg:locator "Events Receive / Payload" ; dkg:confidence dkg:OnArtifact .
:Q_HelpEventName rdfs:comment "Notifications canvas also RECEIVES 'Help requested' — two receivers say 'Help requested', the one sender says 'Help request created'." ; dkg:source :Art_APC_Notifications .
:Q_HelpResponseOrHelp rdfs:comment "Notifications canvas names the Help provided payload 'Help provided' — a third name next to 'Help' and 'Help response'." ; dkg:source :Art_APC_Notifications .
:Q_CredentialOnCanvases rdfs:comment "Now on three async canvases: Cooking Assistance, Grandma Avatar, Notifications." ; dkg:source :Art_APC_Notifications .

