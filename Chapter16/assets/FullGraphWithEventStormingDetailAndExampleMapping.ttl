:Art_API_Media_OAS a dkg:Artifact ;
    rdfs:label "Media API — OpenAPI 3.1, version 1.0.0 (media.openapi.yaml)" ;
    rdfs:comment "OpenAPI draft from the Media canvas and Media model. OAuth2 media:read/write/admin. GET /images requires businessObjectId and businessObjectType (RECIPE, THANKS, HELP_REQUEST, HELP); matches link type + last URL segment. media = absolute download URL; GET /images/{mediaId} returns bytes. Links may be supplied at upload (proposed extension); no operation changes links afterwards. DELETE needs media:admin, 404 on repeat. Videos deferred." ;
    dkg:mentions :Ctx_Media ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:Q_MediaLinksAfterUpload a dkg:Question ; skos:prefLabel "How are an image's business-object links changed after upload?" ;
    rdfs:comment "Canvas has no such operation; contract allows links only at upload and lists the gap as an open requirement. Relevant to Q_RecipeImagesNoOperation: a recipe's images are URLs, the link back is Media's." ; dkg:mentions :Con_Links, :Q_RecipeImagesNoOperation ;
    dkg:source :Art_API_Media_OAS ; dkg:locator "x-design-assumptions" ; dkg:confidence dkg:Inferred .
:Art_API_Media_OAS dkg:raises :Q_MediaLinksAfterUpload .
:R_API_MediaDeleteAdminOnly a dkg:Rule ; skos:prefLabel "Deleting an image requires an admin scope" ; rdfs:comment "contract proposal; no artifact names an admin role" ;
    dkg:inContext :Ctx_Media ; dkg:mentions :Con_Media ; dkg:source :Art_API_Media_OAS ; dkg:locator "DELETE /images/{mediaId}" ; dkg:confidence dkg:Inferred .
:Q_ImagesOrMedia rdfs:comment "Media OpenAPI chooses: path /images, aggregate Media, field 'media' = download URL." ; dkg:source :Art_API_Media_OAS .

