:D_ADR0001 a dkg:Decision ;
    skos:prefLabel "Using Monolith" ;
    dkg:answers :Q_ADR0001 ;
    dkg:cites :Prin_AP0001 ;
    dkg:confidence dkg:OnArtifact ;
    dkg:consequence "Enhancements: ‼️High effort",
        "Implementation: ☑️ Small effort",
        "Maintenance: ‼️High effort",
        "Operation: ☑️ Small effort" ;
    dkg:consideredOption "Microservices",
        "Modular monolith",
        "Monolith" ;
    dkg:decidedAt "2026-09-10"^^xsd:date ;
    dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will implement Larder as Monolith." ;
    dkg:decisionId "ADR0001" ;
    dkg:defect "Decision says \"We will implement Larder as Monolith\", but Context defines Bounded Context modules and the Modular monolith option specifies schema isolation; the Monolith option explicitly says enhancements are difficult. The chosen deployment type is ambiguous." ;
    dkg:honors :Prin_AP0001,
        :Prin_AP0003 ;
    dkg:locator "ADR0001" ;
    dkg:rationale """We defined Bounded Contexts of the Larder application.
Those Bounded Contexts are modules in our application.""" ;
    dkg:source :Art_ADR_ADR0001 ;
    dkg:sourceFormat "full-form" ;
    dkg:status "Adopted" .

:D_ADR0002 a dkg:Decision ;
    skos:prefLabel "Using One Database Instance" ;
    dkg:answers :Q_ADR0002 ;
    dkg:cites :Prin_AP0001 ;
    dkg:confidence dkg:OnArtifact ;
    dkg:consequence "Enhancements: ☑️ Small effort",
        "Implementation: ⚠️️More discipline",
        "Maintenance: ⚠️️Easier",
        "Operation: ☑️ Secure" ;
    dkg:consideredOption "One database for all",
        "One database instance per Bounded Contexts",
        "One database instance with schemas per Bounded Context" ;
    dkg:decidedAt "2026-09-10"^^xsd:date ;
    dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will use one database instance for Larder." ;
    dkg:decisionId "ADR0002" ;
    dkg:defect "Context says \"modular monolith\" although ADR0001 operative decision says \"Monolith\"; the Consequences columns are copied from deployment alternatives and do not correspond to the database options." ;
    dkg:honors :Prin_AP0001,
        :Prin_AP0003 ;
    dkg:locator "ADR0002" ;
    dkg:rationale "The Bounded Contexts modules in the modular monolith need databases." ;
    dkg:source :Art_ADR_ADR0002 ;
    dkg:sourceFormat "full-form" ;
    dkg:status "Adopted" .

:D_ADR0004 a dkg:Decision ;
    skos:prefLabel "Synchronous Communication per UI" ;
    dkg:answers :Q_ADR0004 ;
    dkg:cites :Prin_AP0006,
        :Prin_AP0008 ;
    dkg:confidence dkg:OnArtifact ;
    dkg:consequence "Implementation: ☑️ Small effort",
        "Security: ☑️ Fine grained" ;
    dkg:consideredOption "Synchronous via GraphQL",
        "Synchronous via REST API",
        "Using of asynchronous communication with WebHooks" ;
    dkg:decidedAt "2026-09-10"^^xsd:date ;
    dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will use synchronous communication for User Interfaces." ;
    dkg:decisionId "ADR0004" ;
    dkg:honors :Prin_AP0006,
        :Prin_AP0008 ;
    dkg:locator "ADR0004" ;
    dkg:rationale "Most of the Bounded Contexts need user interactions that should be done synchronously via REST API." ;
    dkg:source :Art_ADR_ADR0004 ;
    dkg:sourceFormat "full-form" ;
    dkg:status "Adopted" .

:D_ADR0005 a dkg:Decision ;
    skos:prefLabel "Orchestrator UI" ;
    dkg:answers :Q_ADR0005 ;
    dkg:confidence dkg:OnArtifact ;
    dkg:consequence "Implementation: ! Larger effort in AppShell",
        "Team independence: ‼️ All teams depend on AppShell team." ;
    dkg:consideredOption "Choreography",
        "Orchestrator" ;
    dkg:decidedAt "2026-09-10"^^xsd:date ;
    dkg:decidedBy "Annegret Junker, Architect" ;
    dkg:decidedOption "We will use an orchestrator for the UI or Larder. It ingests the micro UIs of the Bounded Context and provides an AppShell." ;
    dkg:decisionId "ADR0005" ;
    dkg:defect "The Choreography option describes \"Centralizing interactive user flows through a UI orchestrator\" and thus does not describe choreography as a distinct alternative." ;
    dkg:honors :Prin_AP0003,
        :Prin_MicroUIs ;
    dkg:locator "ADR0005" ;
    dkg:rationale """**Key Architectural Drivers**

* **Guided Cooking Workflows**: Interactive capabilities like *Step-by-Step Cooking Mode* and the *Dinner Party Planner* depend on strict sequential progression. An orchestrator explicitly drives state transitions, active timers, and hands-free voice controls to ensure UI components remain synchronized while cooking.
* **Catastrophe & Rescue Management**: Responding to a cooking failure (`StepUnclear` or `CatastropheHappened` $\\rightarrow$ `TakePictures` $\\rightarrow$ `RequestHelp` $\\rightarrow$ `MealRescued`) requires conditional modal branching across `Meal Preparation`, `Cooking Assistance`, `Media`, and `Grandma Avatar AI`. A UI orchestrator dictates this multi-context dialog flow and manages real-time fallbacks seamlessly.
* **Unified View Aggregation & Gating**: The primary cooking UI synthesizes live data from the `Recipe Catalog` (ingredients and steps), `Meal Preparation` (active state), and `Cooking Assistance` (AI or Chef responses). Central orchestration aggregates these views cleanly while enforcing rules from `Consent Management` and the `Paywall for Premium Content`.
* **Choreography for Decoupled Extras**: Passive UI elements—such as t""" ;
    dkg:source :Art_ADR_ADR0005 ;
    dkg:sourceFormat "full-form" ;
    dkg:status "Adopted" .

:Prin_MicroUIs a dkg:Principle ;
    skos:prefLabel "Micro-UIs" ;
    dkg:amendedAt "2026-09-10"^^xsd:date ;
    dkg:confidence dkg:OnArtifact ;
    dkg:implication "Using a large monolithic frontend would us slow down." ;
    dkg:locator "AP0005" ;
    dkg:principleId "AP0005" ;
    dkg:rationale "The teams developing the Bounded Contexts must be as independent as possible. The UIs are part of the Bounded Contexts projects. The micro UIs can use a common platform, so that they appear out of one hand." ;
    dkg:scope "Bounded Context UIs" ;
    dkg:source :Art_Principles_Larder ;
    dkg:statement "The Bounded Context publish their own UI as micro-UIs." ;
    dkg:status "Adopted" ;
    dkg:testable true .

