# --- Rename across a boundary drawn on the board ---
:Act_User dkg:renamedTo :Act_Cook_DS .
:As_UserRenamedToCook a dkg:Assertion ;
    rdf:subject :Act_User ; rdf:predicate dkg:renamedTo ; rdf:object :Act_Cook_DS ;
    rdfs:comment "Cook Profile: actor 'User' issues 'Register cook', event 'Cook registered' produces business object 'Cook'; every other bubble says Cook." ;
    dkg:source :Art_ESBoard_2026_10 ; dkg:confidence dkg:Implied .

# --- Questions the board raises ---
:Q_PrepareMealSevenEvents a dkg:Question ;
    skos:prefLabel "Is 'Prepare meal' one interaction, or a placeholder for several commands?" ;
    rdfs:comment "Written under 7 events: Meal planning stalled, Meal preparation started, Step unclear, Catastrophe happened, Step competeted, Meal rescued, Meal prepared. 'Search recipes' sits under 2 (Recipes searched, Recipe selected)." ;
    dkg:source :Art_ESBoard_2026_10 ; dkg:locator "events 6, 11-13, 17-19; 3-4" ; dkg:confidence dkg:OnArtifact .
:Art_ESBoard_2026_10 dkg:raises :Q_PrepareMealSevenEvents .
:Q_HelpProvidedCommand a dkg:Question ;
    skos:prefLabel "Is 'Help provided' triggered by 'Provide help' or 'Request help'?" ;
    rdfs:comment "Event 8 (Cooking Assistance) has 'Provide help'; its second drawing, event 16 (Cooking Help), has 'Request help'." ;
    dkg:source :Art_ESBoard_2026_10 ; dkg:locator "events 8, 16" ; dkg:confidence dkg:OnArtifact .
:Art_ESBoard_2026_10 dkg:raises :Q_HelpProvidedCommand .
:Q_RobotIcon a dkg:Question ;
    skos:prefLabel "What does the robot icon on 'Meal planning stalled' and 'Meal rescued' mean?" ;
    dkg:source :Art_ESBoard_2026_10 ; dkg:locator "events 6, 18" ; dkg:confidence dkg:OnArtifact .
:Art_ESBoard_2026_10 dkg:raises :Q_RobotIcon .
:Q_NoStatesNoHotspots a dkg:Question ;
    skos:prefLabel "Where are the states and the disagreements?" ;
    rdfs:comment "No state stickies, no hotspots, no aggregates, no policies — on a board whose events include 'stalled', 'Step unclear' and 'Catastrophe happened'." ;
    dkg:source :Art_ESBoard_2026_10 ; dkg:locator "whole board" ; dkg:confidence dkg:Implied .
:Art_ESBoard_2026_10 dkg:raises :Q_NoStatesNoHotspots .
:Q_HelpRequestAtWhom rdfs:comment "Board: Help provided by Community Cook, Chef and Grandma Avatar together (event 8), or Community Cook and Grandma Avatar (event 16) — three providers on one sticky group." ; dkg:source :Art_ESBoard_2026_10 .
:Q_ChefNotInGlossary rdfs:comment "Board: Chef appears once, in Cooking Assistance (event 8); not in the Cooking Help redraw." ; dkg:source :Art_ESBoard_2026_10 .
:Q_PicturesTwoSenses rdfs:comment "Board: Pictures read by 'Help requested' in Cooking Help (evidence, event 15) and by 'Thanks given' in Sharing (trophy, event 21); both from 'Pictures taken' in Media." ; dkg:source :Art_ESBoard_2026_10 .
:Ctx_Media dkg:proposedSameAs :Con_Media ;
    rdfs:comment "proposedSameAs Con_Media: exact word; board context bubble vs canvas Key Resource 'Media' (cross-class)" .

