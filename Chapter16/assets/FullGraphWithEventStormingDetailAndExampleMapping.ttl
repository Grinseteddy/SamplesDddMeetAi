:Con_Notification dkg:mentions :Con_Title_Notif .
:Rel_Notif_ContainsText a dkg:Relationship ; skos:prefLabel "Notification contains text" ;
    dkg:from :Con_Notification ; dkg:verb "contains" ; dkg:to :Con_Text_Notif ; dkg:cardinality "1" ; dkg:cardinalityGiven true ;
    dkg:source :Art_Glossary_Notification ; dkg:locator "arrow 'contains' Notification → text" ; dkg:confidence dkg:OnArtifact .
