# --- contradiction: whom Thanks may go to ---
:As_ThanksToChef_Story a dkg:Assertion ; rdf:subject :Cmd_Thanks ; rdf:predicate dkg:actsOn ; rdf:object :Act_Chef ;
    rdfs:comment "story AskChef, sentence 6: Cook thanks Chef" ; dkg:source :Art_StoryAskChef ; dkg:confidence dkg:OnArtifact .
:As_ThanksToOnlyAvatarOrCommunity_VG a dkg:Assertion ; rdf:subject :Con_Thanks_ES ; rdf:predicate dkg:to ; rdf:object :Con_GrandmaAvatar_VG ;
    rdfs:comment "glossary draws Thanks —to 0..1→ Grandma Avatar and Thanks —to 0..1→ Community; no 'to' arrow reaches Chef, although Chef is a Help provider" ;
    dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact ; dkg:contradicts :As_ThanksToChef_Story .
:As_ThanksToChef_Story dkg:contradicts :As_ThanksToOnlyAvatarOrCommunity_VG .

# --- contradiction: whom a Help Request is at ---
:As_RequestAtChef_Story a dkg:Assertion ; rdf:subject :Cmd_Asks ; rdf:predicate dkg:actsOn ; rdf:object :Act_Chef ;
    rdfs:comment "story AskChef, sentence 3: Cook asks Chef for Help" ; dkg:source :Art_StoryAskChef ; dkg:confidence dkg:OnArtifact .
:As_RequestAtAvatarAndCommunity_VG a dkg:Assertion ; rdf:subject :Con_HelpRequest_ES ; rdf:predicate dkg:to ; rdf:object :Con_Community_VG ;
    rdfs:comment "glossary: Help Request —at 1→ Grandma Avatar AND —at 1→ Community; no 'at' arrow to Chef; both cardinalities are exactly 1" ;
    dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact ; dkg:contradicts :As_RequestAtChef_Story .
:As_RequestAtChef_Story dkg:contradicts :As_RequestAtAvatarAndCommunity_VG .

# --- questions ---
:Q_GlossaryColours a dkg:Question ; skos:prefLabel "What do the glossary's blue, green and grey boxes and the ⊞ icon mean — bounded contexts, or terms added in the 'enhanced' revision?" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Q_HelpRequestAtOneAndOne a dkg:Question ; skos:prefLabel "A Help Request is 'at 1 Grandma Avatar' and 'at 1 Community' — is every request addressed to both, and never to a Chef?" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Q_MealVsDinnerVsCourse a dkg:Question ; skos:prefLabel "Dinner has 1 Menu, Menu has 1..* Course, Course contains 1..* Meal, Meal with 1 Recipe — which of these does the board's 'Meal plan' correspond to?" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .
:Q_HelpIsTheResponse a dkg:Question ; skos:prefLabel "In the glossary 'Help' is the response (provided, contains substitutes/explanations); in the stories 'Help' is also what the Cook asks for. Same term?" ; dkg:source :Art_VG ; dkg:confidence dkg:OnArtifact .

# --- merge ledger ---
:Con_Community_VG dkg:proposedSameAs :Act_Community, :Act_CommunityCook ; rdfs:comment "glossary term vs story/board actor (cross-class)" .
:Con_GrandmaAvatar_VG dkg:proposedSameAs :Act_GrandmaAvatar ; rdfs:comment "glossary term vs story/board actor (cross-class)" .
:Con_Chef_VG dkg:proposedSameAs :Act_Chef ; rdfs:comment "glossary term vs story/board actor (cross-class)" .
:Con_Cook_ES dkg:proposedSameAs :Act_Cook ; rdfs:comment "glossary term 'Cook' merged into the board's business object 'Cook'; both are distinct from the actor" .
:Con_Ingredient_VG dkg:proposedSameAs :Con_Ingredients ; rdfs:comment "singular term vs plural story/board object" .
:Con_Picture_VG dkg:proposedSameAs :Con_Pictures, :Con_CatastrophePictures, :Con_Pictures14_ES, :Con_Pictures20_ES ; rdfs:comment "one glossary term for what the stories and board split into two" .
:Con_Substitute_VG dkg:proposedSameAs :Con_IngredientsSubstitutes .
:Con_IngredientSubstitute_VG dkg:proposedSameAs :Con_IngredientsSubstitutes, :Ev_IngredientsSubstituted .
:Con_HelpWithIngredients_VG dkg:proposedSameAs :Sen_D_2 ; rdfs:comment "the glossary term names exactly story AskCommunity's sentence 2" .
:Con_HelpMealPlan_VG dkg:proposedSameAs :Sen_C_2 ; rdfs:comment "the glossary term names exactly story AskChef's sentence 2" .
:Con_HelpForMealPreparationStep_VG dkg:proposedSameAs :Sen_B_2a, :Ev_StepUnclear .
:Con_MealPreparationCatastrophe_VG dkg:proposedSameAs :Ev_CatastropheHappened, :Con_Catastrophe_ES, :Cmd_Burns .
:Con_Step_VG dkg:proposedSameAs :Ev_StepUnclear, :Ev_StepCompeted, :Idea_StepByStepCookingMode .
:Con_MenuProposal_VG dkg:proposedSameAs :Del_AIProposals, :VP_AIProposals, :Cap_ProposalsBasedOnLarderEtc_CM ; rdfs:comment "the glossary's 'Menu proposal' is the only place a proposal is a domain noun" .
:Con_Help dkg:proposedSameAs :Con_HelpResponse_ES ; rdfs:comment "glossary 'Help' behaves like the board's 'Help response'" .
:Con_Course_VG rdfs:comment "no other artifact uses 'Course'" .


