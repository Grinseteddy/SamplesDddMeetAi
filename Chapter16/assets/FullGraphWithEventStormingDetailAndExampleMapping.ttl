# sourced to the contract. Existing nodes are NOT re-sourced (no false corroboration).
##############################################################################
:Art_API_CookProfile_OAS a dkg:Artifact ;
    rdfs:label "Cook Profile API — OpenAPI 3.1, version 1.0.0 (cook-profile.openapi.yaml)" ;
    rdfs:comment "OpenAPI draft from the Cook Profile canvas and Cook model. Claims canvas paths /cooks and /cook/{cookId}, a DELETE parameter labelled 'recipe Id' and a PATCH response 'changed recipient' — none of which the canvas image shows (it reads /cooks/{cookId}, cook Id, 'Link to changed cook'). User payload mapped to CookCreate (email, name, givenName); cookId, memberSince, status server-controlled; status ACTIVE/IN_ACTIVE/PREMIUM; DELETE body dropped; no login endpoint (owned by an identity provider)." ;
    dkg:mentions :Ctx_CookProfile ;
    dkg:ingestedAt "2026-10-10"^^xsd:date .
:As_CP_ItemPath_Canvas a dkg:Assertion ;
    rdf:subject :Msg_APC_CP_03 ; rdf:predicate skos:prefLabel ; rdf:object "GET /cooks/{cookId}" ;
    rdfs:comment "Cook Profile canvas: item path /cooks/{cookId} (re-checked against the image during this ingest)" ;
    dkg:source :Art_APC_CookProfile ; dkg:confidence dkg:OnArtifact .
:As_CP_ItemPath_Contract a dkg:Assertion ;
    rdf:subject :Msg_APC_CP_03 ; rdf:predicate skos:prefLabel ; rdf:object "GET /cook/{cookId}" ;
    rdfs:comment "Cook Profile contract: 'Paths retain the canvas spelling: /cooks and /cook/{cookId}; the singular item path is intentional.'" ;
    dkg:source :Art_API_CookProfile_OAS ; dkg:confidence dkg:Inferred ;
    dkg:contradicts :As_CP_ItemPath_Canvas .
:Q_CookProfileContractSourceMismatch a dkg:Question ; skos:prefLabel "Was the Cook Profile contract generated from a different canvas version?" ;
    rdfs:comment "The contract cites CookProfileApiProductCanvasSynchronous.jpg but quotes a singular /cook/{cookId}, a DELETE parameter 'recipe Id' and a PATCH response 'changed recipient'. The canvas in this graph shows /cooks/{cookId}, 'cook Id' and 'Link to changed cook'. The other two slips match the Meal Planning and Recipe Catalog canvases." ; dkg:mentions :Msg_APC_CP_03, :Msg_APC_CP_04, :Msg_APC_CP_05 ;
    dkg:source :Art_API_CookProfile_OAS ; dkg:locator "x-design-assumptions 1–2" ; dkg:confidence dkg:Inferred .
:Art_API_CookProfile_OAS dkg:raises :Q_CookProfileContractSourceMismatch .
:R_API_DeregisterOwnProfileOnly a dkg:Rule ; skos:prefLabel "Only the cook who owns the profile may deregister it" ; rdfs:comment "contract reading of the purple sticky 'Only when cook deregisters'" ;
    dkg:inContext :Ctx_CookProfile ; dkg:mentions :R_OnlyWhenCookDeregisters ; dkg:source :Art_API_CookProfile_OAS ; dkg:locator "DELETE /cook/{cookId}" ; dkg:confidence dkg:Inferred .
:R_API_DeregisterOwnProfileOnly dkg:proposedSameAs :R_OnlyWhenCookDeregisters ; rdfs:comment "proposedSameAs R_OnlyWhenCookDeregisters: the canvas invariant this contract interprets — voluntary deregistration read as an ownership check" .
:Q_DeleteCookBody rdfs:comment "Cook Profile OpenAPI: drops the DELETE Cook body provisionally; identity from cookId and the caller." ; dkg:source :Art_API_CookProfile_OAS .
:Q_NameGivenName rdfs:comment "Cook Profile OpenAPI: keeps name 'Joe' / givenName 'Doe' and says their semantics need confirmation." ; dkg:source :Art_API_CookProfile_OAS .
:Q_PremiumVsPaying rdfs:comment "Cook Profile OpenAPI: status (incl. PREMIUM) is service-controlled; premium entitlement workflow unspecified." ; dkg:source :Art_API_CookProfile_OAS .

